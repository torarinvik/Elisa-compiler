# The first import is in an inactive arm. Try must use the ErrorSet from the
# active public import in the static-else arm, not the raw first annotation row.
const USE_INACTIVE_PROVIDER: bool = false

module InactiveProvider:
    public:
        error InactiveFault:
            Inactive

        def origin(value: bool) -> i64 error[InactiveProvider::InactiveFault]:
            return 1

module ActiveProvider:
    public:
        error ActiveFault:
            Active

        def origin(value: bool) -> i64 error[ActiveProvider::ActiveFault]:
            return 2

static if USE_INACTIVE_PROVIDER:
    from InactiveProvider import origin
static else:
    from ActiveProvider import origin

module Consumer:
    public:
        def caller(value: bool) -> i64 error[ActiveProvider::ActiveFault]:
            return try origin(value)

def main() -> i64:
    return 0
