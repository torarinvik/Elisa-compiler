# Two modules can use the same logical source line. A catch in CatchSide must not
# make the ordinary match in MatchSide use Catch reachability when checking loop progress.
error LoadError:
    Failed

def load() -> i64 error[LoadError]:
    return 1

module CatchSide:
    def catch_loop() -> void:
        n: mutable i64 = 0
#line 81 shared-catch-match.elisa
        while n < 2:
            catch load():
                value:
                    can Progress.Tick:
                        signal Progress.Tick
                    0
                error err:
                    can Progress.Tick:
                        signal Progress.Tick
                    0

module MatchSide:
    def match_loop() -> void:
        n: mutable i64 = 0
#line 81 shared-catch-match.elisa
        while n < 2:
            match 0:
                1:
                    pass
                _:
                    can Progress.Tick:
                        signal Progress.Tick
