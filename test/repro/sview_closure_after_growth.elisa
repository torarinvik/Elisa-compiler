include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

def read_first(view: sview) -> i64:
    return sview_at(view, 0.usize()).i64()

def bad() -> i64 can[Memory.Allocate, Abort.Panic]:
    values: mutable darray[u8] = [65.u8()]
    view: sview = bytes_view(values)
    reader: fn() -> i64 = fn() => read_first(view)
    values.push(67.u8())
    return reader()

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    return bad()
