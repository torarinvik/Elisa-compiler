const enum Mode of i64:
    Off = 2
    Ready = 7
    Next

def defaulted(mode: Mode = Mode.Ready) -> Mode:
    return mode

def list_default(modes: darray[Mode] = [Mode.Off, Mode.Ready, Mode.Next]) -> darray[Mode]:
    return modes

def dict_default(modes: dict[i64, Mode] = {1: Mode.Ready, 2: Mode.Next}) -> dict[i64, Mode]:
    return modes

export pymodule enum_defaults:
    fn defaulted
    fn list_default
    fn dict_default
