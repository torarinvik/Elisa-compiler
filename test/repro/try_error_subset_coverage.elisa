module First:
    public:
        error Fault:
            Bad
            Other

module Second:
    public:
        error Fault:
            Bad
            Other

module API:
    extern restricted_bad() -> i64 error[First::Fault{Bad}]
    extern full_first_fault() -> i64 error[First::Fault]

    def restricted_to_full() -> i64 error[Second::Fault]:
        return try restricted_bad()

    def restricted_to_wrong_subset() -> i64 error[Second::Fault{Other}]:
        return try restricted_bad()

    def full_to_subset() -> i64 error[Second::Fault{Bad}]:
        return try full_first_fault()

def main() -> i64:
    return 0
