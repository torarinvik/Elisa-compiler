module First:
    public:
        error Fault:
            Bad
            Other

module Second:
    public:
        error Fault:
            Bad
            Other

module Other:
    public:
        error Fault:
            Bad
            Gone

module API:
    extern restricted_bad() -> i64 error[First::Fault{Bad}]
    extern full_first_fault() -> i64 error[First::Fault]

    def same_family_restricted_to_full() -> i64 error[First::Fault]:
        return try restricted_bad()

    def same_family_restricted_to_wrong_subset() -> i64 error[First::Fault{Other}]:
        return try restricted_bad()

    def same_family_full_to_subset() -> i64 error[First::Fault{Bad}]:
        return try full_first_fault()

    def restricted_to_full() -> i64 error[Second::Fault]:
        return try restricted_bad()

    def restricted_to_wrong_subset() -> i64 error[Second::Fault{Other}]:
        return try restricted_bad()

    def full_to_subset() -> i64 error[Second::Fault{Bad}]:
        return try full_first_fault()

    extern both_families() -> i64 error[First::Fault, Other::Fault]

    def composite_source_requires_every_family() -> i64 error[First::Fault]:
        return try both_families()

    extern two_selected_tags() -> i64 error[First::Fault.Bad, First::Fault.Other]

    def repeated_family_subset_to_same_subset() -> i64 error[First::Fault.Bad, First::Fault.Other]:
        return try two_selected_tags()

    def repeated_family_subset_to_full_family() -> i64 error[First::Fault]:
        return try two_selected_tags()

    def repeated_family_subset_missing_other() -> i64 error[First::Fault.Bad]:
        return try two_selected_tags()

    def propagation_to_empty_subset() -> i64 error[First::Fault{}]:
        return try full_first_fault()

    extern empty_subset_source() -> i64 error[First::Fault{}]

    def propagation_from_empty_subset() -> i64 error[First::Fault]:
        return try empty_subset_source()

    def propagation_to_unrelated_empty_subset() -> i64 error[Second::Fault{}]:
        return try full_first_fault()

    # A short variant must be unique across the entire destination union. Each
    # family below contains Bad, so First::Fault.Bad is not covered by either
    # family independently or by the union as a whole.
    def duplicate_short_tag_across_destination_union() -> i64 error[Second::Fault, Other::Fault]:
        return try restricted_bad()

def main() -> i64:
    return 0
