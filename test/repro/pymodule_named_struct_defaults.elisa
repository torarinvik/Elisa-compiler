struct Point:
    x: i64
    y: i64

def list_default(points: darray[Point] = [Point{x: 1, y: 2}, Point{x: 3, y: 4}]) -> darray[Point]:
    return points

def map_default(points: dict[i64, Point] = {1: Point{x: 5, y: 6}}) -> dict[i64, Point]:
    return points

def map_list_default(points: dict[i64, darray[Point]] = {1: [Point{x: 11, y: 12}]}) -> dict[i64, darray[Point]]:
    return points

def nested_default(points: darray[darray[Point]] = [[Point{x: 7, y: 8}], [Point{x: 9, y: 10}]]) -> darray[darray[Point]]:
    return points

export pymodule named_struct_defaults:
    fn list_default
    fn map_default
    fn map_list_default
    fn nested_default
