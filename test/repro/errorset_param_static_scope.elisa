# Inactive declaration and statement scopes must not contribute ErrorSet parameter
# candidates or diagnostics. The active call remains the only positive diagnostic.
error CallerFault:
    Failed

static if false:
    def hidden_wrap[errorset H]() -> i64 error[H]:
        return 0

    def inactive_declaration_call() -> i64 error[CallerFault]:
        return hidden_wrap()

def active_wrap[errorset A]() -> i64 error[A]:
    return 1

def inactive_statement_call() -> i64:
    static if false:
        active_wrap()
    return 0

def active_call() -> i64 error[CallerFault]:
    return active_wrap()

def main() -> i64:
    return 0
