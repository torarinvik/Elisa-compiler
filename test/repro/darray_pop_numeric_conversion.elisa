include "../../elisacore_std/elisacore_runtime.elisa"

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    unsigned: mutable darray[u32] = [4294967295u32]
    wide: usize = unsigned.pop().usize()
    return 1 if wide != 4294967295usize
    signed: mutable darray[i32] = [-17i32]
    negative: i64 = signed.pop().i64()
    return 2 if negative != -17
    bytes: mutable darray[u8] = [255u8]
    byte: u64 = bytes.pop().u64()
    return 3 if byte != 255u64
    0
