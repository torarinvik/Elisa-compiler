module API:
    public:
        error Expected:
            Good

        error Actual:
            Bad

        def consume(value: i64, callback: fn() -> i64 error[Expected]) -> i64 error[Expected]:
            return try callback()

        def consume(value: bool, callback: fn() -> i64 error[Actual]) -> i64 error[Actual]:
            return try callback()

def mismatched_overload() -> i64 error[API::Expected]:
    return API::consume(1, fn() => raise API::Actual.Bad)

def matching_overload() -> i64 error[API::Actual]:
    return API::consume(true, fn() => raise API::Actual.Bad)

def main() -> i64:
    return 0

def mismatched_bool() -> i64 error[API::Actual]:
    return API::consume(true, fn() => raise API::Expected.Good)

def matching_integer() -> i64 error[API::Expected]:
    return API::consume(1, fn() => raise API::Expected.Good)

from API import consume

def bad_bare() -> i64 error[API::Expected]:
    return consume(1, fn() => raise API::Actual.Bad)

def bad_named() -> i64 error[API::Expected]:
    return API::consume(value: 1, callback: fn() => raise API::Actual.Bad)

def good_bare() -> i64 error[API::Actual]:
    return consume(true, fn() => raise API::Actual.Bad)

def good_named_reordered() -> i64 error[API::Actual]:
    return API::consume(callback: fn() => raise API::Actual.Bad, value: true)

def bad_named_reordered() -> i64 error[API::Expected]:
    return API::consume(callback: fn() => raise API::Actual.Bad, value: 1)
