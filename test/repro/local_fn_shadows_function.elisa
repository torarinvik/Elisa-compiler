# A parameter or local `fn` value shadows every same-named function, in this module or any
# other: `chrome(a, b)` through `chrome: fn(usize, usize) -> i64` calls that value. stage1
# checked such calls against the FUNCTION's signature -- argument types, literal arguments,
# overload selection and return type -- and rejected valid programs ("argument 1 to
# "chrome" expects sview, got usize", "variable "total" expects i64, got sview"). stage0
# accepts all of them.
module SceneForms:
    def chrome(words: sview, y: f64, bold: bool = false) -> sview:
        words

def chrome(words: sview) -> sview:
    words

def add(a: usize, b: usize) -> i64:
    (a + b).i64()

module Host:
    def run(seed: usize) -> i64:
        chrome: fn(usize, usize) -> i64 = add
        total: i64 = chrome(seed, seed)
        total + 1

def through_parameter(chrome: fn(usize, usize) -> i64, seed: usize) -> i64:
    chrome(seed, seed)

def in_expressions() -> i64:
    chrome: fn(usize, usize) -> i64 = add
    values: darray[i64] = [chrome(1, 2), chrome(3, 4)]
    return values[0] if chrome(1, 1) > 5 else values[1]

def main() -> i64:
    # 7 + 8 + 7 = 22
    Host::run(3) + through_parameter(add, 4) + in_expressions()
