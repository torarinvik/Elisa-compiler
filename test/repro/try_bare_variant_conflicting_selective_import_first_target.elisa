# The first selective import owns the bare alias when providers export the same name.
module ProviderA:
    public:
        error Expected:
            First

module ProviderB:
    public:
        error Expected:
            Second

module Origin:
    public:
        def origin() -> i64 error[ProviderA::Expected]:
            return 1

from ProviderA import Expected
from ProviderB import Expected

error Fault:
    Expected

module Consumer:
    public:
        def good_set_destination() -> i64 error[Expected]:
            return try Origin::origin()

        def wrong_variant_destination() -> i64 error[Fault]:
            return try Origin::origin()

def main() -> i64:
    return 0
