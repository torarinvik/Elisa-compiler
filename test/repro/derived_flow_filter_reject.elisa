# A tracked value changed to Dead must still be rejected at an Alive call.
struct DerivedFilterPlayer[state Alive | Dead]:
    health: mutable i64
    derive state:
        Alive when self.health > 0
        Dead when self.health <= 0

def derived_filter_require_alive(value: mutable DerivedFilterPlayer[Alive]&) -> void:
    pass

def derived_filter_change(value: mutable DerivedFilterPlayer[Alive]&) -> void:
    value.health <- 0
    derived_filter_require_alive(value)

def main() -> i64:
    return 0
