error FeatureWireError:
    Invalid

law ValidFeatureHandle(self: u64):
    return self > 0

type FeatureHandle = u64 is ValidFeatureHandle

module UiFeatureView:
    struct FeatureHandle:
        slot: u32

    def is_valid(handle: FeatureHandle) -> bool:
        return handle.slot > 0

module WasmBrowser::FeatureActivation:
    public:
        def feature_handle(raw: u64) -> FeatureHandle error[FeatureWireError]:
            raise FeatureWireError.Invalid if raw == 0
            return raw

def main() -> i64:
    return 0
