# A struct holding darrays, stored into a field reached through a `mutable T&` parameter,
# is built in the CALLER's region. stage1 used to thread the caller's region only when the
# stored field was itself a darray: `game.desk <- start(seed)` built the desk's darrays in
# the callee's auto region, freed on return, so the caller read zeroed elements with the
# right count. Covers a direct factory call and a named local passed by value to the
# factory. Exits 0 under both compilers.
struct Card:
    rank: i64
    suit: i64

struct Deal:
    cards: mutable darray[Card]

struct Desk:
    cards: mutable darray[Card]
    score: i64

struct Session:
    desk: mutable Desk
    seed: mutable i64

def start(seed: i64) -> Desk:
    can Memory.Allocate:
        cards: mutable darray[Card] = []
        cards.push(Card{rank: seed, suit: seed + 1})
        Desk{cards: cards, score: seed * 2}

def deal(seed: i64) -> Deal:
    can Memory.Allocate:
        cards: mutable darray[Card] = []
        cards.push(Card{rank: seed, suit: seed + 1})
        Deal{cards: cards}

def start_from(dealt: Deal) -> Desk:
    Desk{cards: dealt.cards, score: 0}

def reset_direct(game: mutable Session&) -> void:
    can Memory.Allocate, Abort.Panic:
        game.desk <- start(game.seed)

def reset_through_named_deal(game: mutable Session&) -> void:
    can Memory.Allocate, Abort.Panic:
        dealt: Deal = deal(game.seed)
        game.desk <- start_from(dealt)

# Builds and drops scratch cards in this call's own region, so a block freed by an earlier
# call's region is reused and overwritten here: a dangling desk then reads these values.
def clobber() -> i64:
    can Memory.Allocate, Abort.Panic:
        scratch: mutable darray[Card] = []
        for index in 0..<256 |scratch|:
            scratch.push(Card{rank: -1, suit: -1})
        scratch.count.i64()

def main() -> i32:
    can Memory.Allocate, Abort.Panic:
        game: mutable Session = Session{desk: Desk{cards: [], score: 0}, seed: 41}
        reset_direct(&game)
        _ = clobber()
        return 1 if game.desk.cards.count != 1 or game.desk.cards[0].rank != 41 or game.desk.cards[0].suit != 42
        game.seed <- 63
        reset_through_named_deal(&game)
        _ = clobber()
        return 3 if game.desk.cards.count != 1 or game.desk.cards[0].rank != 63 or game.desk.cards[0].suit != 64
        0
