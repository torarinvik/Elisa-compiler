# Calls inside nested expression nodes still need ErrorSet-parameter inference.
error CallerFault:
    Failed

def wrap[errorset R]() -> i64 error[R]:
    return 1

def nested_conditional_call() -> i64 error[CallerFault]:
    return 7 if try wrap() == 1 else 0

def default_parameter_call(value: i64 = wrap()) -> i64:
    return value

struct DefaultFieldCall:
    value: i64 = wrap()

module QualifiedProvider:
    module Nested:
        def wrap[errorset Q]() -> i64 error[Q]:
            return 1

module QualifiedConsumer:
    def qualified_call() -> i64:
        return QualifiedProvider::Nested::wrap()

using QualifiedProvider as QP

module AliasQualifiedConsumer:
    def alias_qualified_call() -> i64:
        return QP::Nested::wrap()

def main() -> i64:
    return 0
