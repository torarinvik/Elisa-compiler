# A wasm32 `usize` index lowers to i32, but darray counts are i64 in the ABI.
# Keep a bounds-checked read in the emitted module so both compiler stages must
# produce a type-valid comparison before a browser attempts instantiation.
def read_or_zero(values: darray[i64], index: i64) -> i64:
    return get values[index.usize()] else 0

def main() -> i64:
    values: mutable darray[i64] = []
    values.push(42)
    return read_or_zero(values, 0) - 42
