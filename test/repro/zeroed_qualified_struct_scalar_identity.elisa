module Safe:
    struct Carrier:
        value: mutable i64

    def run() -> i64:
        carrier: mutable Carrier = zeroed
        carrier.value <- 42
        return carrier.value

module Borrowed:
    struct Carrier:
        view: sview

using Safe as S

def main() -> i64:
    carrier: mutable S::Carrier = zeroed
    carrier.value <- 42
    return Safe::run() if carrier.value == 42 else 1
