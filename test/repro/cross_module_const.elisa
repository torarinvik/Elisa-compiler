# A module reading ANOTHER module's constant. Constants register under their bare
# name, and the bare-ident path resolves them -- but the `Module::NAME` form had
# no const branch at all, so it fell through every arm and DECLINED, which takes
# the whole unit with it. stage0 resolves it.
#
# Found because PyPoint reads PySet's MINSIZE/EMPTY/LINEAR_PROBES: every function
# of PyPoint that touched one declined, and every function that did not compiled.
#
# Exits 18 = cross_use(1)=1+8 plus own_use(1)=1+8. The value matters, not just
# that it compiles: rewriting the scoped form to the bare ident must reach the
# SAME constant.

module Owner:
    const LIMIT: i64 = 8
    def own_use(x: i64) -> i64:
        return x + LIMIT

module Borrower:
    def cross_use(x: i64) -> i64:
        return x + Owner::LIMIT

def main() -> i64:
    can Abort.Panic:
        return Borrower::cross_use(1) + Owner::own_use(1)
