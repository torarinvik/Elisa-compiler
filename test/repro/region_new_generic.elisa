# `new[r]` inside a region-polymorphic function must allocate in the caller's
# region parameter `@r`, not erase the wrapper or allocate in a callee scratch
# region.
def make[@r](owner: i64& @r, value: i64) -> i64& @r:
    return new[r] value

def main() -> i64:
    region scratch(1024)
    seed: i64& @scratch = new[scratch] 0
    value: i64& @scratch = make(seed, 7)
    result: i64 = value[0]
    destroy scratch
    return result
