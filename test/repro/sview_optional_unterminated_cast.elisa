include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

def bad() -> i64 can[Abort.Panic, Memory.Allocate]:
    byte: u8 = 65.u8()
    raw: u8&? = &byte
    view: sview = raw.sview()
    return view.len

def bad_constructor() -> i64:
    byte: u8 = 65.u8()
    raw: u8&? = &byte
    view: sview = sview(raw, 0, 1)
    return view.len

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    return bad()
