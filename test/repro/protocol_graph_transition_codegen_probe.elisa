module LeaseOwner:
    affine struct Lease[state Observed | Published]:
        event: u8
        status: u8
        value: u64
        checksum: u64
        transitions:
            Observed -> Published

    def publish(observation: Lease[Observed]) -> Lease[Published]:
        return transition[Published](move observation)

    def probe() -> bool:
        observed: Lease[Observed] = Lease[Observed]{event: 16, status: 1, value: 1, checksum: 1701}
        published: Lease[Published] = publish(move observed)
        return published.event == 16 and published.status == 1 and published.value == 1 and published.checksum == 1701

def main() -> i32:
    return 0 if LeaseOwner::probe() else 1
