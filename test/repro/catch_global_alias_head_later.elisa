# An ancestor block's direct alias is pre-registered before its nested modules,
# even when its source text follows the child alias that refers to it.
module AliasInstaller:
    module NestedProvider:
        public:
            module Nested:
                public:
                    error Fault:
                        Expected
                        Missing
                    extern load() -> i64 error[Fault]

    module AliasUser:
        using First::Nested as Second

    using NestedProvider as First

extern aliased_family_load() -> i64 error[Second::Fault]

def catch_later_parent_alias() -> i64:
    catch Second::load():
        value: 0
        AliasInstaller::NestedProvider::Nested::Fault.Expected: 1
    catch aliased_family_load():
        value: 0
        AliasInstaller::NestedProvider::Nested::Fault.Expected: 1
    return 0

def main() -> i64:
    return 0
