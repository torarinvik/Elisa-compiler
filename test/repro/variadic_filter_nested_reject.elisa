module VariadicFilterReject:
    public:
        def required(first: i64, ...) -> i64:
            return first

        def fixed(value: i64) -> i64:
            return value

        def rejected_calls() -> i64:
            _ = required()
            return fixed(1, 2)

def main() -> i64:
    return VariadicFilterReject::rejected_calls()
