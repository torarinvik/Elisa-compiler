module North:
    affine struct Lease[state Open | Closed]:
        event: u8
        status: u8
        value: u64
        checksum: u64
        transitions:
            Open -> Closed

    def close(lease: Lease[Open]) -> Lease[Closed]:
        return transition[Closed](move lease)

    def open() -> Lease[Open]:
        return Lease[Open]{event: 17, status: 1, value: 701, checksum: 1701}

module South:
    affine struct Lease[state Open | Closed]:
        event: u8
        status: u8
        value: u64
        checksum: u64
        transitions:
            Open -> Closed

    def close(lease: Lease[Open]) -> Lease[Closed]:
        return transition[Closed](move lease)

    def open() -> Lease[Open]:
        return Lease[Open]{event: 28, status: 2, value: 802, checksum: 2802}

def main() -> i32:
    north_open: North::Lease[Open] = North::open()
    south_open: South::Lease[Open] = South::open()
    north_closed: North::Lease[Closed] = North::close(move north_open)
    south_closed: South::Lease[Closed] = South::close(move south_open)
    return 0 if north_closed.event == 17 and north_closed.status == 1 and north_closed.value == 701 and north_closed.checksum == 1701 and south_closed.event == 28 and south_closed.status == 2 and south_closed.value == 802 and south_closed.checksum == 2802 else 1
