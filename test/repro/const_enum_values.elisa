# A const enum member compiles to its DECLARED VALUE, not its declaration ordinal.
#
# stage1 answered 10 here where stage0 answers 52: `Lo = 2` and `Hi = 5` compiled as 0 and 1.
# A silent wrong answer — no decline, no diagnostic, just different arithmetic.
#
# WHY NOTHING CAUGHT IT. src/ and elisacore_std/ contain ZERO const enums whose values differ
# from their ordinals (FileDescriptor is Input=0/Output=1/Error=2, and so on), so the
# compiler only ever exercises the degenerate case where the two coincide: the gen3 fixpoint
# and semantic_gate_selfhost_smoke are structurally blind to it. It took adversarial
# differential testing against stage0 to surface it.
#
# AND THE OBVIOUS FIXTURE WOULD NOT HAVE. test/repro/const_enum_extern_param.elisa uses
# Input=0/Output=1 — where value == ordinal — so it passes under the bug. A fixture whose
# expected result is identical with and without the defect proves nothing. Hence the
# deliberately NON-sequential values below, the gap, and the implicit continuation.
const enum Code of int:
    Lo = 2
    Hi = 5

const enum Gapped of int:
    A = 1
    B = 7
    C = 9

const enum Continued of int:
    First = 5
    Second
    Third

const enum Defaulted of int:
    Zero
    One
    Two

def main() -> i64:
    # 5*10 + 2 = 52 — the case that regressed.
    a: i64 = Code.Hi.i64() * 10 + Code.Lo.i64()
    # 1 + 7 + 9 = 17 — non-contiguous values.
    b: i64 = Gapped.A.i64() + Gapped.B.i64() + Gapped.C.i64()
    # An omitted `= N` continues from the previous member: 5, 6, 7 -> 7*10 + 6 = 76.
    c: i64 = Continued.Third.i64() * 10 + Continued.Second.i64()
    # All-default: value == ordinal, the case the compiler's own source uses. 2*10 + 0 = 20.
    d: i64 = Defaulted.Two.i64() * 10 + Defaulted.Zero.i64()
    return (a + b + c + d) % 251
