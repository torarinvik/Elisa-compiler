# A relative selective import source stays raw in annotations but resolves against its
# containing module when matching a canonical callable module.
module Installer:
    public:
        error Fault:
            Other

        module Provider:
            public:
                module Nested:
                    public:
                        error SourceError:
                            Bad

                        def origin() -> i64 error[SourceError]:
                            return 1

        from Provider::Nested import origin

        def direct() -> i64 error[Provider::Nested::SourceError]:
            return try origin()

        def mismatched() -> i64 error[Fault]:
            payload = origin()
            return try payload

def main() -> i64:
    return 0
