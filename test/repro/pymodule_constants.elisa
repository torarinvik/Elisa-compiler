# Scalar Python-module constants are exposed as ordinary module attributes.
const API_LEVEL: i32 = 7
const RATIO: f64 = 0.25f64
const MASK: u8 = 255
const ENABLED: bool = true
const INFERRED = 9
global mutable counter: i64 = 3

export pymodule constants:
    const level = API_LEVEL
    const ratio = RATIO
    const mask = MASK
    const enabled = ENABLED
    const inferred = INFERRED
    const count = counter
