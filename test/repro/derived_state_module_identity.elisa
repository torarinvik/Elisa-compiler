# Same-leaf derived-state rules must be selected from the module that owns the type.
struct Gauge[state Active]:
    value: i64
    derive state:
        Active when self.value == 42

module Left:
    public:
        struct Gauge[state Active]:
            value: i64
            derive state:
                Active when self.value > 0

        def is_active(value: Gauge) -> bool:
            return value is Gauge[Active]

module Right:
    public:
        struct Gauge[state Active]:
            value: i64
            derive state:
                Active when self.value < 0

        def is_active(value: Gauge) -> bool:
            return value is Gauge[Active]

        # Exercise the derived-state annotation erasure lookup in this lexical module too.
        def active_value(value: Gauge[Active]) -> i64:
            return value.value

def main() -> i64:
    return 1 if not Left::is_active(Left::Gauge{value: 1})
    return 2 if Right::is_active(Right::Gauge{value: 1})
    return 3 if not Right::is_active(Right::Gauge{value: -1})
    return 0
