# An OPTIONAL REFERENCE (`void&?`) passed as a call ARGUMENT must pass its VALUE.
#
# The auto-borrow path exists so a place argument (`tokens[i]`, `a.b`) reaching a `T&`
# parameter hands over a real address instead of silently passing the value. An EXTERN's
# reference parameter has its referent ERASED to `void&` by declare_extern, so that path
# grew a rule: a `void&` parameter is "some pointer", any place may borrow into it.
#
# That rule is wrong for an OPTIONAL parameter. A niche optional already IS the pointer the
# callee wants, so borrowing passes `&h.p` where stage0 passes the field's value — and
# `&h.p` is never null, so every `p == null` test in the callee flips.
#
# It is not a corner case: ConcurrencyPoolState.mutex / work_cond / done_cond are all
# `mutable void&?`, and pool_submit_raw calls `ctx_sync_handle(state.mutex)`. Borrowing made
# stage1 lock a POINTER TO THE FIELD as if it were the pthread mutex, after which the work
# queue was mutated unsynchronised and a worker dequeued a corrupt record — `nursery
# workers(1): submit …` segfaulted.
#
# The argument POSITION is what matters. A bare local was always right (the borrow branch
# skips a plain Ident), and so was a non-optional `void&` field (its own type is Ref, which
# the branch excludes) — so a fixture that only tried those would have passed throughout.
# Each bit below is a position that failed differently.
#
# stage0 answers 15.
struct Holder:
    p: mutable void&?
    q: i64


struct Nested:
    inner: Holder
    tag: i64


def takes_optional(p: void&?) -> i64:
    return 1 if p == null else 2


def takes_plain(p: u8&?) -> i64:
    return 1 if p == null else 2


def main() -> i64:
    score: mutable i64 = 0

    # A FIELD argument — the position that broke.
    holder: mutable Holder = zeroed
    score <- score + 1 if takes_optional(holder.p) == 1

    # A NESTED field chain, which resolves its address a different way.
    nested: mutable Nested = zeroed
    score <- score + 2 if takes_optional(nested.inner.p) == 1

    # A bare LOCAL — always worked; pinned so the fix cannot regress it.
    local: void&? = holder.p
    score <- score + 4 if takes_optional(local) == 1

    # A NARROW optional ref, which took a different branch (the referent-kind test) and was
    # also always right. Same reason: it must not start borrowing either.
    plain: mutable u8&? = null
    score <- score + 8 if takes_plain(plain) == 1

    return score
