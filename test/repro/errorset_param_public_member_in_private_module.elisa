# Public ErrorSets inside private module paths must not be visible to outside modules.
module Installer:
    private module Hidden:
        public:
            error Fault:
                Failed

            def inside[errorset Fault](callback: fn() -> i64 error[Fault]) -> i64 error[Fault]:
                return try callback()

    from Hidden import Fault

module Consumer:
    def outside[errorset Fault](callback: fn() -> i64 error[Fault]) -> i64 error[Fault]:
        return try callback()

def main() -> i64:
    return 0
