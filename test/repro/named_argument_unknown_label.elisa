def sink(value: i64) -> i64:
    return value

def main() -> i64:
    return sink(wrong: true)

def ping() -> i64:
    return 1

def no_parameters() -> i64:
    return ping(wrong: 1)

def in_condition() -> i64:
    if ping(wrong: 1) == 1:
        return 1
    return 0

def in_array() -> i64:
    values: darray[i64] = [ping(wrong: 1)]
    return 0

def named(value: i64) -> i64:
    return value

def local_shadow() -> i64:
    ping = named
    if ping(value: 1) == 1:
        return 1
    return 0

def before_shadow() -> i64:
    if ping(wrong: 1) == 1:
        return 1
    ping = named
    return ping(value: 1)

def after_inner_shadow() -> i64:
    if true:
        ping = named
        ping(value: 1)
    return ping(wrong: 1)
