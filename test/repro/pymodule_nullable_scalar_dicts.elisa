# Probe nullable scalar dictionary values.
def optional_signed(values: dict[cstr, i64?]) -> dict[cstr, i64?]:
    return values

def optional_unsigned(values: dict[cstr, u8?]) -> dict[cstr, u8?]:
    return values

def optional_bool(values: dict[cstr, bool?]) -> dict[cstr, bool?]:
    return values

def optional_float(values: dict[cstr, f32?]) -> dict[cstr, f32?]:
    return values

export pymodule nullable_scalar_dicts:
    fn optional_signed
    fn optional_unsigned
    fn optional_bool
    fn optional_float
