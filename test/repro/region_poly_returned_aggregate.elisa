# Returning an aggregate must preserve nested darray backings copied into it.
struct Arm:
    body: darray[i64]
    tag: i64

def build() -> darray[Arm]:
    arms: mutable darray[Arm] = []
    body: mutable darray[i64] = []
    body.push(41)
    arms.push(Arm{body: body, tag: 1})
    return arms

def main() -> int:
    arms: darray[Arm] = build()
    return (arms[0].body[0] + arms[0].tag) - 42
