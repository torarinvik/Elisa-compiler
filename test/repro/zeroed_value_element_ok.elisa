# Element, record-update, function-value, and aliased-module positions accept zeroed
# where zero is a valid value.
struct Holder:
    s: sview
    n: i64

module Inner:
    def add(a: i64, r: i64&?) -> i64:
        return a + 40

using Inner as I

def twice(n: i64) -> i64:
    return n + n

def main() -> i64:
    counts: mutable i64[2] = [1, zeroed]
    counts[0] <- zeroed
    h: Holder = Holder{s: "a", n: 2}
    g: Holder = h{n = zeroed}
    f: fn(i64) -> i64 = twice
    return counts[0] + counts[1] + g.n + f(zeroed) + I::add(zeroed, zeroed) + 2
