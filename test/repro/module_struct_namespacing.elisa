# Two modules each declaring a `Work`, plus a top-level `Work`.
#
# Struct names shared ONE flat table keyed by bare name, so the second `Work`
# overwrote the first and `Grade::Work{total: 3}` was checked against Score's
# fields: `struct literal "Work" is missing field "tally"` -- for a program
# stage0 compiles and runs. Constants were fixed the same way; this is structs.
#
# Three cases in one, because they are three different lookups:
#
#   Grade::Work / Score::Work   the qualified name selects the module's own row
#   Work inside a module        a bare name means the ENCLOSING module's
#   Work at top level           still the top-level one, not either module's
#
# Exits 123 = Grade(3) + Score(20) + top-level(100).

include "../../elisacore_std/elisacore_runtime.elisa"

module Grade:
    struct Work:
        total: mutable i64

    def Work() -> Work:
        can Abort.Panic:
            return Work{total: 3}

module Score:
    struct Work:
        tally: mutable i64

    def Work() -> Work:
        can Abort.Panic:
            return Work{tally: 20}

struct Work:
    plain: mutable i64

def main() -> i64:
    can Abort.Panic:
        g: Grade::Work = Grade::Work()
        s: Score::Work = Score::Work()
        t: Work = Work{plain: 100}
        return g.total + s.tally + t.plain
