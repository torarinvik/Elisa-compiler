include "../../elisacore_std/elisacore_runtime.elisa"

# `d <- d.put(k, v)` — the REASSIGNMENT spelling of a dict put. The helper mutates the map
# through the receiver and returns a ref to the ELEMENT, so the assignment must store
# NOTHING. Storing it overwrites the header's `items` with a pointer into the middle of the
# bucket array, and the next probe past that offset walks off the end of the block.
#
# The dict must GROW for the damage to show: with 40 keys it rehashes several times, and a
# corrupted `items` survives as a wrong lookup rather than a crash only because the block
# happens to be large enough. Read every key back — the count is the answer.
#
# The dict lives in a STRUCT FIELD and is mutated through a callee, which is the shape the
# semantic analyzer's SymbolTable.name_primary has.
struct Index:
    primary: mutable dict[u64, i64]
    overflow: darray[i64]

def record(table: lmut Index, key: u64, value: i64) -> void can[Memory.Allocate, Abort.Panic]:
    table.primary <- table.primary.put(key, value)

def lookup(table: Index&, key: u64) -> i64 can[Abort.Panic]:
    return stored if table.primary.get(key) is stored else -1

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    table: mutable Index = Index{primary: {}, overflow: []}
    for i in 0..<40 |table| -> table:
        table <- record(table, i.u64(), i.i64() * 2)
    hits: mutable i64 = 0
    for i in 0..<40 |table, hits|:
        hits <- hits + 1 if lookup(table, i.u64()) == i.i64() * 2
    return hits
