struct ProbeTable:
    left: i64
    right: i64
def struct_index_of(structs: mutable ProbeTable&, name: sview) -> i64: return structs.left
def ref_target_of(value_type: ProbeTable, structs: mutable ProbeTable&) -> ProbeTable: return structs
def darray_element_of(value_type: darray[i64], structs: mutable ProbeTable&) -> i64: return structs.right
def enum_index_of(structs: mutable ProbeTable&, name: sview) -> i64: return structs.left
def caller(structs: mutable ProbeTable&) -> i64:
    struct_index_of(structs, "x")
    ref_target_of(zeroed, structs)
    darray_element_of([], structs)
    return enum_index_of(structs, "x")
def main() -> i64:
    table: mutable ProbeTable = ProbeTable{left: 1, right: 2}
    return caller(table)
