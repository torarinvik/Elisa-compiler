include "../../elisacore_std/elisacore_runtime.elisa"

def bad_runtime_strlen(raw: u8&?) -> usize:
    return runtime_strlen(raw)

def bad_libc_strlen(raw: u8&?) -> usize:
    return strlen(raw)

def bad_string_index(raw: u8&?) -> i64:
    return string_index(raw, 0)

def bad_string_slice_eq(raw: u8&?) -> int:
    return string_slice_eq(raw, 0, 1, "A")

def bad_string_slices_eq(raw: u8&?) -> int:
    return string_slices_eq(raw, 0, 1, "A", 0, 1)

def main() -> i64 can[Abort.Panic]:
    byte: u8 = 65.u8()
    raw: u8&? = &byte
    _ = bad_runtime_strlen(raw)
    _ = bad_libc_strlen(raw)
    _ = bad_string_index(raw)
    _ = bad_string_slice_eq(raw)
    _ = bad_string_slices_eq(raw)
    return 0
