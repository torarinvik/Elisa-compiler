# The bool overload activates Core's free-call receiver-overload rewrite gate.
# Argument-zero specificity selects imported concrete choose(i64) over the local
# generic infallible overload; EWR must not treat the local overload as a shadow.
module Provider:
    public:
        error ProviderFault:
            Failed

        def choose(value: i64) -> i64 error[Provider::ProviderFault]:
            return 1

        def choose(value: bool) -> i64 error[Provider::ProviderFault]:
            return 3

from Provider import choose

module Consumer:
    public:
        error ConsumerFault:
            Failed

        def choose[T](value: T) -> i64:
            return 2

        def wrapper(value: i64) -> i64 error[Consumer::ConsumerFault]:
            return choose(value)

def main() -> i64:
    return 0
