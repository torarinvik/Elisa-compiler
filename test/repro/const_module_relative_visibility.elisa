# Relative visibility: a `private:` section marks the const module it wraps, not the
# constants inside it, so the parent reads them and nothing outside the parent can.
# Also pins the formatter: `const module` must not reprint as `module` (its members
# would stop being constants), a section wrapping a module must not be dropped (the
# module would come back public), and a const module's body prints PACKED.
module Geo:
    private:
        const module Tune:
            START_LIVES: i64 = 3
            FOG_RADIUS: i64 = 4

    public:
        const module Open:
            ZERO: i64 = 0

    const module Mixed:
        public:
            ONE: i64 = 1
        private:
            HIDDEN: i64 = 9

    # A DESCENDANT reaches its ancestor's private module: `canAccessPrivateName` grants
    # the owning namespace and everything under it. The path is spelled in full because a
    # nested module does not see its parent's members unqualified.
    module Plain:
        def a() -> i64:
            return Geo::Tune::START_LIVES

        def b() -> i64:
            return Geo::Mixed::ONE

    def total() -> i64:
        return Tune::FOG_RADIUS + Open::ZERO + Mixed::ONE + Plain::a()

def main() -> i64:
    return Geo::total()
