# An unconditional alias wins over an unresolved static-branch alias with the same
# spelling. The later definite alias must canonicalize through that stable winner.
module FirstProvider:
    public:
        module Nested:
            public:
                const enum Mode of i64:
                    High = 41

module SecondProvider:
    public:
        module Nested:
            public:
                const enum Mode of i64:
                    High = 52

module NestedBranchProvider:
    public:
        module Mode:
            public:
                const enum Value of i64:
                    High = 84

module OuterBranchProvider:
    public:
        module Mode:
            public:
                const enum Value of i64:
                    High = 85

module FirstSiblingBranchProvider:
    public:
        module Mode:
            public:
                const enum Value of i64:
                    High = 86

module SecondSiblingBranchProvider:
    public:
        module Mode:
            public:
                const enum Value of i64:
                    High = 87

module AliasContainer:
    public:
        module Provider:
            public:
                module Nested:
                    public:
                        const enum Mode of i64:
                            High = 73
        module Child:
            public:
                using ParentAlias::Nested as NestedGlobal
        # Core pre-registers direct aliases in this namespace before descending into Child.
        using Provider as ParentAlias

static if UNKNOWN_ALIAS_CHOICE:
    using SecondProvider as Maybe

using FirstProvider as Maybe

# A definite branch alias is unordered against a branch-local requester in a child
# module. The unconditional alias is still the provable winner for target expansion.
static if true:
    using SecondProvider as Maybe

module CutoffChild:
    static if true:
        using Maybe::Nested as CutoffNested

# The outer branch body's direct alias is pre-registered before Core descends into
# its nested static branch, even though that outer alias appears later in source.
static if true:
    static if true:
        using NestedBranchProvider as BranchPick
    using OuterBranchProvider as BranchPick

# Different active branch roots are traversed in source order. Their branch identities
# differ, but both rows are definite and cannot be alternate arms of one static-if chain.
static if true:
    using FirstSiblingBranchProvider as SiblingBranchPick

static if true:
    using SecondSiblingBranchProvider as SiblingBranchPick

using Maybe::Nested as SelectedNested

def direct_alias_default(value: i64 = Maybe::Nested::Mode.High) -> i64:
    return value

def chained_alias_default(value: i64 = SelectedNested::Mode.High) -> i64:
    return value

def nested_branch_alias_cutoff_default(value: i64 = CutoffNested::Mode.High) -> i64:
    return value

def nested_branch_alias_default(value: i64 = BranchPick::Mode::Value.High) -> i64:
    return value

def sibling_branch_alias_default(value: i64 = SiblingBranchPick::Mode::Value.High) -> i64:
    return value

def nested_global_alias_default(value: i64 = NestedGlobal::Mode.High) -> i64:
    return value

export pymodule alias_direct_static_branch_precedence:
    fn direct_alias_default = direct_alias_default
    fn chained_alias_default = chained_alias_default
    fn nested_branch_alias_cutoff_default = nested_branch_alias_cutoff_default
    fn nested_branch_alias_default = nested_branch_alias_default
    fn sibling_branch_alias_default = sibling_branch_alias_default
    fn nested_global_alias_default = nested_global_alias_default
