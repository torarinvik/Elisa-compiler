# Python string-list boundary fixture.
def text_count(values: darray[sview]) -> usize:
    return values.count

def text_echo(values: darray[sview]) -> darray[sview]:
    return values

def cstr_echo(values: darray[cstr]) -> darray[cstr]:
    return values

export pymodule text_lists:
    fn count = text_count
    fn echo = text_echo
    fn echo_cstr = cstr_echo
