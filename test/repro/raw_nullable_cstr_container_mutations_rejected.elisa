include "../../elisacore_std/elisacore_runtime.elisa"

def bad_dict_mutations(raw: u8&?) -> i64 can[Memory.Allocate, Abort.Panic]:
    mutable values: dict[cstr, cstr?] = {}
    values.put("put", raw)
    values.get_or_insert("get-or-insert", raw)
    values.entry("entry-insert").insert(raw)
    values.entry("entry-get-or-insert").get_or_insert(raw)
    return 0

def bad_set_mutations(raw: u8&?) -> i64 can[Memory.Allocate, Abort.Panic]:
    mutable added: set[cstr?] = {}
    added <- added.add(raw)
    mutable inserted: set[cstr?] = {}
    inserted <- inserted.insert(raw)
    return 0

def bad_dict_mutation_through_borrow(values: mutable dict[cstr, cstr?]&, raw: u8&?) -> i64 can[Memory.Allocate, Abort.Panic]:
    values.put("borrowed", raw)
    return 0

def bad_dict_mutable_slot_write(raw: u8&?) -> i64 can[Memory.Allocate, Abort.Panic]:
    mutable values: dict[cstr, cstr?] = {"key": null}
    slot: mutable cstr?&? = values.get("key")
    if slot != null:
        slot as & <- raw
    return 0

def main() -> i64:
    return 0
