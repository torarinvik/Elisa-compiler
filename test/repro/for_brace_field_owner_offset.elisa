# Both headers are logical line 0, but the swapped brace fields belong to separate loops.
struct Pair:
    left: i64
    right: i64

def main() -> i64:
    pairs: Pair[1] = [Pair{left: 7, right: 35}]
    total: mutable i64 = 0

#line 0 for-brace-fields.elisa
    for {left: first_left, right: first_right} in pairs:
        total <- total + first_left * 100 + first_right

#line 0 for-brace-fields.elisa
    for {right: second_right, left: second_left} in pairs:
        total <- total + second_left * 10 + second_right

    return 1 if total != 840
    return 0
