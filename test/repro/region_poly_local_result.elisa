# A region-polymorphic caller may receive a returned container into a local
# scratch arena while retaining its caller-owned output in the threaded arena.
# If both allocations share the reserve/fixed caller arena, growing the output
# after the returned temporary is created incorrectly rejects a non-tail realloc.

def make_bytes() -> darray[u8]:
    values: mutable darray[u8] = []
    for index in 0..<256 |values|:
        values.push(index.u8())
    return values

def consume(report: mutable darray[u8]&) -> void:
    captured: darray[u8] = make_bytes()
    for value in captured |report|:
        report.push(value)

def main() -> i64:
    report: mutable darray[u8] = [0]
    consume(report)
    return report.count.i64()
