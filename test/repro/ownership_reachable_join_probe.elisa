include "../../src/semantic/ownership_flow_domain.elisa"

def main() -> i32:
    for index in 0..<16:
        left_reachable: bool = index >= 8
        left: bool = index % 8 >= 4
        right_reachable: bool = index % 4 >= 2
        right: bool = index % 2 == 1
        expected_possible: mutable bool = false
        expected_known: mutable bool = false
        if left_reachable:
            expected_possible <- left
            expected_known <- left
        if right_reachable:
            expected_possible <- expected_possible or right
            if left_reachable:
                expected_known <- expected_known and right
            else:
                expected_known <- right
        return 1 if OwnershipFlow::join_reachable_possible(left_reachable, left, right_reachable, right) != expected_possible
        return 2 if OwnershipFlow::join_reachable_known(left_reachable, left, right_reachable, right) != expected_known
    return 0
