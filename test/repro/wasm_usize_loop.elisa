# The reported shape: a usize range loop with a LITERAL bound of 1024 over a fixed array.
# The counter and the bound must lower to ONE width on wasm32 (usize is 32-bit there).
global mutable cells: mutable i32[1024] = zeroed

def fill_and_sum() -> i32:
    for i in 0..<1024:
        cells[i] <- i.i32()
    total: mutable i32 = 0
    for i in 0..<1024:
        total <- total + cells[i]
    return total

export fn fill_and_sum() -> i32 = fill_and_sum
