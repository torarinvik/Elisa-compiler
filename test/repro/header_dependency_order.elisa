struct Event layout(c):
    code: mutable i32

struct Scheduled layout(c):
    note: mutable Event

struct Player layout(c):
    scheduled: mutable Scheduled
    event: mutable Event

struct Audio layout(c):
    player: mutable Player

export type Audio as PublicAudio
export type Player as PublicPlayer
export type Scheduled as PublicScheduled
export type Event as PublicEvent
