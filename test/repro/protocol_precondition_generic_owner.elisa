protocol Counted:
    def count(self: Self) -> i64
    def check(self: Self) -> i64
        requires self.count() > 0

struct C:
    count_value: i64

impl Counted for C:
    def count(self: Self) -> i64:
        return self.count_value
    def check(self: Self) -> i64:
        return self.count()

