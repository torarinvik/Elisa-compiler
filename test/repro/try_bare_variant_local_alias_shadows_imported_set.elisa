# A local type alias shadows an imported same-named error set, leaving the unique bare variant.
module SetProvider:
    public:
        error Expected:
            SetTag

from SetProvider import Expected

module ImportedAlias:
    type Expected = i64

    public:
        error Fault:
            Expected

        error Other:
            Trouble

        def origin() -> i64 error[Expected]:
            return 1

        def good_destination() -> i64 error[Fault]:
            return try origin()

        def wrong_destination() -> i64 error[Other]:
            return try origin()

def main() -> i64:
    return 0
