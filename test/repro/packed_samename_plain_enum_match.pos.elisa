module Outer:
    module Right:
        packed enum Message:
            A(x: i64)
            B(y: i64, z: i64)

module Other:
    enum Message:
        A(x: i64)

def pick(m: Other::Message) -> i64:
    match m:
        Other::Message.A(x): return x

def main() -> i64:
    return pick(Other::Message.A(x: 7))
