# A const-enum member used as a match/when PATTERN must compare against the VALUE the member
# compiles to, not its declaration index.
#
# `Lo = 1, Mid = 7, Hi = 9` has ordinals 0,1,2 — so a `Code.Lo ->` arm tested for 0, a
# `Code.Mid ->` arm for 1, and `Code.Hi ->` for 2. The scrutinee holds 1/7/9, so `Code.Lo`
# took the `Code.Mid` row and `Code.Hi` matched nothing at all. A wrong ANSWER, not a decline,
# and invisible to self-hosting: no const enum in src/ or elisacore_std/ has values that
# differ from its ordinals, so the degenerate case was the only one ever exercised.
#
# The VALUE side of this was fixed once already (an expression `Code.Mid` yields 7); the
# PATTERN side kept using the ordinal.
const enum Code of i64:
    Lo = 1
    Mid = 7
    Hi = 9

# Every arm returns a distinct value, so a row that matches the wrong way is a wrong answer.
def classify(c: Code) -> i64:
    return when c:
        Code.Lo -> 3
        Code.Mid -> 4
        Code.Hi -> 5
        _ -> 6

# An OR-pattern column goes through the same helper.
def is_extreme(c: Code) -> i64:
    return when c:
        Code.Lo | Code.Hi -> 7
        _ -> 8

# And a multi-column table.
def paired(c: Code, n: i64) -> i64:
    return when c, n:
        Code.Lo, 0 -> 1
        Code.Hi, 0 -> 2
        _, _ -> 9

# The statement form, whose arms take a different emitter.
def statement_form(c: Code) -> i64:
    match c:
        Code.Lo:
            return 1
        Code.Mid:
            return 2
        _:
            return 3

# A member with NO explicit value still equals its ordinal — the control that the change is
# not simply swapping one wrong number for another.
const enum Plain of i64:
    A
    B

def plain(p: Plain) -> i64:
    return when p:
        Plain.A -> 0
        Plain.B -> 1
        _ -> 9

def main() -> i64:
    total: mutable i64 = 0
    total <- total * 10 + classify(Code.Lo)        # 3
    total <- total * 10 + classify(Code.Mid)       # 4
    total <- total * 10 + classify(Code.Hi)        # 5
    total <- total * 10 + is_extreme(Code.Lo)      # 7
    total <- total * 10 + is_extreme(Code.Mid)     # 8
    total <- total * 10 + paired(Code.Hi, 0)       # 2
    total <- total * 10 + paired(Code.Lo, 1)       # 9
    total <- total * 10 + statement_form(Code.Mid) # 2
    total <- total * 10 + plain(Plain.B)           # 1
    return total % 251
