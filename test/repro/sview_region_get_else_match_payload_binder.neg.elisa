error RecoveryStoreFailure:
    Failed

enum Payload:
    View(sview)

def maybe() -> i64 error[RecoveryStoreFailure]:
    raise RecoveryStoreFailure.Failed
    return 1

def bad() -> i64:
    can Memory.Allocate, Abort.Panic:
        region outer(4096):
            outer_bytes: mutable darray[u8] @outer = [65.u8()]
            retained: mutable sview @outer = outer_bytes.as_sview()
            region inner(4096):
                inner_bytes: mutable darray[u8] @inner = [66.u8()]
                payload: Payload = Payload.View(inner_bytes.as_sview())
                result: i64 = try maybe() else err:
                    match payload:
                        Payload.View(view):
                            retained <- view
                            return 0
                    0
                return result
            return 0

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        return bad()
