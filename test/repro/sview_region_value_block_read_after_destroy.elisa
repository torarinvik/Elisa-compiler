# nopath
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

def main() -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release]:
    region scratch(64):
        bytes: mutable darray[u8] @scratch = [65.u8(), 0.u8()]
        borrowed: sview @scratch = bytes_view_range(bytes, 0, 1.usize())
        destroy scratch
        result: i64 =
            value = sview_at(borrowed, 0)
            value.i64()
        return result
