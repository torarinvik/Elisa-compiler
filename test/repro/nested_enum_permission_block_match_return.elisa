enum Event:
    None
enum InputEvent is Event:
    pass
enum KeyEvent is InputEvent:
    Up(code: i32)
enum PointerEvent is InputEvent:
    Move(x: f32, y: f32)
struct Contact:
    id: u32
    phase: i32
    tool: i32
    x: f32
    y: f32
    timestamp: f32
enum ContactEvent is InputEvent:
    Update(contact: Contact)
struct EventRecord:
    kind: i32
    x: f32
    y: f32
    dx: f32
    dy: f32
    code: i32

def from_record(record: EventRecord) -> Event:
    can Global{Read, Write}:
        return match record.kind:
            7:
                can Global{Read, Write}:
                    return Event.None if record.code < 0
                    KeyEvent.Up(code: record.code)
            _: Event.None

def to_record(event: Event) -> EventRecord:
    match event:
        KeyEvent.Up(code):
            return EventRecord{kind: 7, x: 0.0, y: 0.0, dx: 0.0, dy: 0.0, code: code}
        _:
            return EventRecord{kind: 0, x: 0.0, y: 0.0, dx: 0.0, dy: 0.0, code: 0}

def normalize(event: Event) -> Event:
    can Global{Read, Write}:
        return from_record(to_record(event))

def main() -> i32:
    can Global{Read, Write}:
        record: EventRecord = EventRecord{kind: 7, x: 0.0, y: 0.0, dx: 0.0, dy: 0.0, code: 65}
        decoded: Event = from_record(record)
        match decoded:
            KeyEvent.Up(code):
                return 1 if code != 65 else 0
            _:
                return 2
        normalized: Event = normalize(KeyEvent.Up(code: 65))
        match normalized:
            KeyEvent.Up(code):
                return 3 if code != 65 else 0
            _:
                return 4
