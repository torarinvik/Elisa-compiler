module Vault:
    affine struct File[state Closed | Open]:
        handle: i64
        transitions:
            Closed -> Open
            Open -> Closed

    def make_initial() -> File[Closed]:
        return File[Closed]{handle: 73}

    module Child:
        module Deep:
            def acquire(file: Vault::File[Closed]) -> Vault::File[Open]:
                transition[Open](move file)

            def release(file: Vault::File[Open]) -> Vault::File[Closed]:
                transition[Closed](move file)

            def run() -> i32:
                initial: Vault::File[Closed] = Vault::make_initial()
                opened: Vault::File[Open] = acquire(move initial)
                closed: Vault::File[Closed] = release(move opened)
                return 0 if closed.handle == 73
                return 1

def main() -> i32:
    return Vault::Child::Deep::run()
