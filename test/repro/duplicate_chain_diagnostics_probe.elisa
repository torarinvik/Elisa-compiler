# Differential oracle for per-scope duplicate chains. The legacy scalar scan is
# test-only; every diagnostic field and source position must remain in stream order.
include "../../src/semantic/semantic.elisa"

extend Semantic:
    private:
        def legacy_scope_duplicates(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&, table: lmut SymbolTable) -> void:
            can Memory.Allocate, Abort.Panic:
                # Do not copy the recursive Ast::Decl union for every pair in the quadratic
                # scan below. The compiler source itself contains thousands of declarations;
                # repeatedly materializing both declarations in the inner loop made gen3 grow
                # its stack until it hit the guard page, and also made self-compilation much
                # slower. These immutable facts are enough for the common rejection path. The
                # full AST is consulted only after category and name already match, where the
                # signature/alias comparison is semantically required.
                categories: mutable darray[int] = []
                names: mutable darray[sview] = []
                lines: mutable darray[u32] = []
                positions: mutable darray[Ast::Pos] = []
                for declaration in declarations |categories, names, lines, annotations|:
                    categories.push(4 if declaration_is_protocol(declaration, annotations) else declaration_duplicate_category(declaration))
                    names.push(declaration_duplicate_name(declaration))
                    lines.push(declaration_duplicate_line(declaration))
                    positions.push(declaration_duplicate_pos(declaration))
                while decl_index < declarations.count |decl_index: usize = 0|:
                    current_category: int = categories[decl_index]
                    current_name: sview = names[decl_index]
                    if current_category != 0 and current_name != "" and not (current_category == 1 and (current_name == "Region" or current_name == "ArenaMark")):
                        # A type decl (category 1) reusing a builtin type name collides with
                        # the pre-registered builtin, so it is a duplicate even with no earlier
                        # user decl in this scope.
                        seeded_builtin: bool = current_category == 1 and is_builtin_type_name(current_name)
                        # Stage0 treats the two runtime-carrier structs as built-in types and
                        # skips their source declarations rather than reporting collisions.
                        # The stdlib and user code may therefore repeat these declarations;
                        # counting them here falsely rejects valid ArenaMark/Region field use.
                        stage0_ignores_carrier_decl: bool = current_category == 1 and current_name in {"Region", "ArenaMark"}
                        is_duplicate: bool =
                            while earlier_index < decl_index |is_duplicate = seeded_builtin and not stage0_ignores_carrier_decl, earlier_index: usize = 0| -> is_duplicate:
                                earlier_category: int = categories[earlier_index]
                                # Functions and globals share the value namespace, even
                                # though only functions can overload by signature.
                                if names[earlier_index] == current_name and ((earlier_category == 2 and current_category == 3) or (earlier_category == 3 and current_category == 2)):
                                    is_duplicate <- true
                                if not is_duplicate and earlier_category == current_category and names[earlier_index] == current_name:
                                    # Types (1) and globals (3) collide unconditionally; functions
                                    # (2) only when their signatures match (overloads are distinct).
                                    if current_category == 4:
                                        is_duplicate <- true
                                    elif current_category == 1:
                                        # struct/enum name clash: always a duplicate. Two type
                                        # aliases: a duplicate only when their targets differ
                                        # (identical `type X = T` repeats are idempotent).
                                        if declaration_is_alias(declarations[decl_index]) and declaration_is_alias(declarations[earlier_index]):
                                            is_duplicate <- true if alias_declarations_conflict(declarations[decl_index], declarations[earlier_index])
                                        else:
                                            is_duplicate <- true
                                    elif current_category == 3:
                                        is_duplicate <- true
                                    elif function_declarations_same_signature(declarations[decl_index], declarations[earlier_index]):
                                        is_duplicate <- true
                                earlier_index <- earlier_index + 1
                        table.duplicates <- table.duplicates + 1 if is_duplicate
                        # Types (category 1) and functions (2) use distinct messages,
                        # matching stage0's `duplicate type` vs `duplicate declaration`.
                        duplicate_kind: DiagnosticKind = DiagnosticKind.DuplicateInterface if current_category == 4 else DiagnosticKind.DuplicateType if current_category == 1 else DiagnosticKind.DuplicateDecl
                        duplicate_as: sview = "global" if current_category == 3 else sview("", 0, 0)
                        table.diagnostics <- table.diagnostics.push(Diagnostic{kind: duplicate_kind, name: current_name, pos: positions[decl_index], line: lines[decl_index], expected: "", actual: duplicate_as}) if is_duplicate
                    decl_index <- decl_index + 1

    public:
        def duplicate_probe_diagnostic_equal(left: Diagnostic&, right: Diagnostic&) -> bool can[Abort.Panic]:
            can Abort.Panic:
                return left.name == right.name and left.line == right.line and left.kind == right.kind and left.expected == right.expected and left.actual == right.actual and left.expected_count == right.expected_count and left.actual_count == right.actual_count and left.detail == right.detail and left.const_enum_module_expected == right.const_enum_module_expected and left.const_enum_module_actual == right.const_enum_module_actual and left.state_code == right.state_code and left.secondary_line == right.secondary_line and left.secondary_column == right.secondary_column and left.secondary_end_column == right.secondary_end_column and left.detail2 == right.detail2 and left.detail3 == right.detail3 and left.effect_ref_count == right.effect_ref_count and left.effect_ref_1 == right.effect_ref_1 and left.effect_ref_2 == right.effect_ref_2 and left.effect_ref_3 == right.effect_ref_3 and left.effect_ref_4 == right.effect_ref_4 and left.effect_ref_5 == right.effect_ref_5 and left.effect_ref_6 == right.effect_ref_6 and left.effect_ref_7 == right.effect_ref_7 and left.effect_ref_8 == right.effect_ref_8 and left.error_set == right.error_set and left.pos.line == right.pos.line and left.pos.column == right.pos.column and left.pos.offset == right.pos.offset and left.pos.end_line == right.pos.end_line and left.pos.end_column == right.pos.end_column and left.pos.end_offset == right.pos.end_offset

        def duplicate_chains_match_legacy(declarations: darray[Ast::Decl]&, annotations: darray[Ast::EnumAnnotation]&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                expected: mutable SymbolTable = SymbolTable()
                actual: mutable SymbolTable = SymbolTable()
                expected <- legacy_scope_duplicates(declarations, annotations, expected)
                actual <- check_scope_duplicates(declarations, annotations, actual)
                return false if expected.duplicates != actual.duplicates or expected.diagnostics.count != actual.diagnostics.count
                for index in 0..<expected.diagnostics.count:
                    return false if not duplicate_probe_diagnostic_equal(&expected.diagnostics[index], &actual.diagnostics[index])
                for declaration in declarations:
                    match declaration:
                        Ast::Decl.Module(_, body, _) | Ast::Decl.Scoped(body, _):
                            return false if not duplicate_chains_match_legacy(body, annotations)
                        _:
                            pass
                return true

        def duplicate_source_matches_legacy(source: sview) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                raw: u8& = source.data
                tokens: darray[Token] = frontend_tokenize_with_length(raw, raw, source.len.usize())
                file: Ast::File = frontend_parser_parse_file(raw, tokens) can Global{Read,Write}
                return false if file.errors.count != 0
                return duplicate_chains_match_legacy(file.top_decls, file.enum_annotations)

def main() -> i32:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        return 1 if not (Semantic::duplicate_source_matches_legacy("") can Global{Read,Write})
        return 2 if not (Semantic::duplicate_source_matches_legacy("def first() -> i64:\n    1\ndef second() -> i64:\n    2\n") can Global{Read,Write})
        return 3 if not (Semantic::duplicate_source_matches_legacy("def same(value: i64) -> i64:\n    value\ndef same(other: i64) -> i64:\n    other\n") can Global{Read,Write})
        return 4 if not (Semantic::duplicate_source_matches_legacy("def same(value: i64) -> i64:\n    value\ndef same(value: f64) -> f64:\n    value\n") can Global{Read,Write})
        return 5 if not (Semantic::duplicate_source_matches_legacy("def prefix(value: i64) -> i64:\n    value\ndef prefix(value: i64, other: i64) -> i64:\n    value\n") can Global{Read,Write})
        return 6 if not (Semantic::duplicate_source_matches_legacy("def prefix(value: i64, other: i64 = 0) -> i64:\n    value\ndef prefix(value: i64) -> i64:\n    value\n") can Global{Read,Write})
        return 7 if not (Semantic::duplicate_source_matches_legacy("global mutable same: i64 = 0\ndef same() -> i64:\n    0\n") can Global{Read,Write})
        return 8 if not (Semantic::duplicate_source_matches_legacy("def same() -> i64:\n    0\nglobal mutable same: i64 = 0\n") can Global{Read,Write})
        return 9 if not (Semantic::duplicate_source_matches_legacy("global mutable same: i64 = 0\nglobal mutable same: i64 = 1\n") can Global{Read,Write})
        return 10 if not (Semantic::duplicate_source_matches_legacy("struct Same:\n    value: i64\nstruct Same:\n    other: i64\n") can Global{Read,Write})
        return 11 if not (Semantic::duplicate_source_matches_legacy("struct Same:\n    value: i64\nenum Same:\n    Value\n") can Global{Read,Write})
        return 12 if not (Semantic::duplicate_source_matches_legacy("enum Same:\n    Value\nstruct Same:\n    value: i64\n") can Global{Read,Write})
        return 13 if not (Semantic::duplicate_source_matches_legacy("type Same = i64\ntype Same = i64\n") can Global{Read,Write})
        return 14 if not (Semantic::duplicate_source_matches_legacy("type Same = i64\ntype Same = f64\n") can Global{Read,Write})
        return 15 if not (Semantic::duplicate_source_matches_legacy("struct i64:\n    value: i64\nstruct Region:\n    value: i64\nstruct Region:\n    other: i64\nstruct ArenaMark:\n    value: i64\n") can Global{Read,Write})
        return 16 if not (Semantic::duplicate_source_matches_legacy("module Left:\n    def same() -> i64:\n        1\nmodule Right:\n    def same() -> i64:\n        2\n") can Global{Read,Write})
        return 17 if not (Semantic::duplicate_source_matches_legacy("module Both:\n    def same() -> i64:\n        1\n    def same() -> i64:\n        2\n") can Global{Read,Write})
        return 18 if not (Semantic::duplicate_source_matches_legacy("permission Grant:\n    Read\npermission Grant:\n    Read\n") can Global{Read,Write})
        return 19 if not (Semantic::duplicate_source_matches_legacy("protocol Same:\n    def run(self: Same&) -> void\nprotocol Same:\n    def run(self: Same&) -> void\n") can Global{Read,Write})
        return 20 if not (Semantic::duplicate_source_matches_legacy("def cycle() -> i64:\n    1\ndef unrelated() -> i64:\n    0\ndef cycle() -> i64:\n    2\ndef other() -> i64:\n    3\ndef cycle() -> i64:\n    4\n") can Global{Read,Write})
        return 0
