module Outer:
    public:
        module Provider:
            public:
                error Fault:
                    Bad
                    Zed

module API:
    using Outer as Root
    using Root::Provider as Family

    def split_alias() -> i64 error[Family::Fault{Bad}, Outer::Provider::Fault{Zed}]:
        raise Family::Fault.Bad(7)

    def wrap[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
        return try callback()

    def repeated_alias_missing_zed() -> i64 error[Outer::Provider::Fault{Bad}]:
        return wrap(split_alias)
