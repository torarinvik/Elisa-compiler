error ProbeError:
    Failed

def maybe() -> i64 error[ProbeError]:
    raise ProbeError.Failed
    return 1

def consume(value: i64) -> void:
    pass

def bad() -> sview:
    can Memory.Allocate, Abort.Panic:
        region inner(4096):
            inner_bytes: mutable darray[u8] @inner = [65.u8()]
            consume(try maybe() else return inner_bytes.as_sview())
        return ""

def main() -> i64:
    return 0
