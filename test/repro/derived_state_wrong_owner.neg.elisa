# A root Gauge has no Ready state. The unique Left::Gauge[Ready] rule must not
# be applied to a root Gauge merely because it has the same leaf name.
struct Gauge[state Active]:
    value: i64
    derive state:
        Active when self.value > 0

module Left:
    public:
        struct Gauge[state Ready]:
            value: i64
            derive state:
                Ready when self.value > 0

def root_cannot_borrow_left_ready(value: Gauge) -> bool:
    return value is Gauge[Ready]
