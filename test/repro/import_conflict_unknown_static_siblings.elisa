# On an unknown target, only one arm of this single chain can register the import.
module FirstProvider:
    public:
        def choose() -> i64:
            return 1

module SecondProvider:
    public:
        def choose() -> i64:
            return 2

static if ELISA_TARGET_OS_WASI:
    from FirstProvider import choose
static else:
    from SecondProvider import choose

def main() -> i64:
    return choose()
