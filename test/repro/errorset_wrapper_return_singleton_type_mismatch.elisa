# Core keeps a directly bound singleton's ErrorSet after an argument type error.
module Provider:
    public:
        error Fault:
            Failed

        def select(value: i64) -> i64 error[Provider::Fault]:
            return value

from Provider import select

module Consumer:
    public:
        error Expected:
            Rejected

        def wrapper(value: bool) -> i64 error[Consumer::Expected]:
            return select(value)

def main() -> i64:
    return 0
