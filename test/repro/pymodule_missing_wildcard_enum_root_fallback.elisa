# A wildcard import that lacks Mode must fall through to the raw root enum candidate.
module Values:
    public:
        const enum OtherMode of i64:
            High = 41

const enum Mode of i64:
    High = 97

using Values

def root_fallback(value: i64 = Mode.High) -> i64:
    return value

export pymodule missing_wildcard_enum_root_fallback:
    fn root_fallback
