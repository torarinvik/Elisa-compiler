# nopath
# Rebinding a mutable Arena& alias must update the storage identity used by later resets.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"

def main() -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release]:
    first_arena: mutable Arena = zeroed
    first: mutable Arena& = &first_arena
    second_arena: mutable Arena = zeroed
    second: mutable Arena& = &second_arena
    second_values: mutable darray[i64] @second = [65]
    mutable alias: mutable Arena& = first
    alias <- second
    arena_reset(alias)
    replacement: mutable darray[i64] @second = [7]
    return second_values[0]
