# Literal container defaults are materialized by the generated wrapper on every omitted call.
def bad(values: darray[i64] = [1]) -> i64:
    return values.count

def mapping(values: dict[i64, i64] = {1: 2}) -> usize:
    return values.count

def unique(values: set[i64] = {1, 2}) -> usize:
    return values.count

def bytes_default(values: darray[u8] = [1, 2, 255]) -> usize:
    return values.count

def nested(values: darray[darray[i64]] = [[1, 2], [3]]) -> usize:
    return values.count

def viewed(values: view[i64] = [1, 2]) -> usize:
    return values.len

export pymodule defaults_unsupported:
    fn bad
    fn mapping
    fn unique
    fn bytes_default
    fn nested
    fn viewed
