module Outer:
    module Views:
        type BorrowedText = sview
        type NullableBorrowedText = BorrowedText?

    module Client:
        def empty_text() -> Outer::Views::NullableBorrowedText:
            text: Outer::Views::NullableBorrowedText = zeroed
            return text

def main() -> i64:
    return 42 if Outer::Client::empty_text() == null else 1
