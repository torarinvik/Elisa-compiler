# Regression fixture for a carried-payload machine that exits through the while guard.
# The payload advances on every transition; the result must be 3 under both compilers.
def main() -> i64:
    n: mutable i64 = 0
    machine over n while n < 3:
        state Scan(step: i64)
        start Scan(0)
        Scan(step), _:
            n <- n + 1
            -> Scan(step + 1)
    return n
