# A refinement expression used directly as an argument to another call.
#
# The direct call must lower the inner error call, select its success value or
# propagate its error, and then pass that value to the outer call.
error ProbeError:
    Failed

def produce(value: i64) -> i64 error[ProbeError]:
    return value

def consume(value: i64) -> i64:
    return value * 2

def forwarded_text() -> i64 error[ProbeError]:
    return consume(try produce(21))

def main() -> i64:
    return (try forwarded_text() else 0)
