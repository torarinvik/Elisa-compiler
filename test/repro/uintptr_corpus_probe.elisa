# Corpus program for the behavioural differential: `.uintptr()` on a ref must yield the
# ADDRESS, so two different elements are 4 apart. stage1 once dereferenced instead, making
# both read back 0 — a silent miscompile no acceptance check could see.
def main() -> i64:
    can Unsafe.PointerCast, Abort.Panic:
        local: mutable u8[16] = zeroed
        p0: u8& = &local[0]
        p4: u8& = &local[4]
        return (p4.uintptr() - p0.uintptr()).usize().i64()
