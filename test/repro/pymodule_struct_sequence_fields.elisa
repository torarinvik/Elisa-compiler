struct Child:
    x: i64

struct Batch:
    points: darray[Child]
    view_points: view[Child]
    rows: darray[dict[i64,i64]]
    point_rows: darray[dict[i64,Child]]
    nested_rows: dict[i64,darray[dict[cstr,i64]]]

def roundtrip_batch(batch: Batch) -> Batch:
    return batch

export pymodule struct_sequence_fields:
    fn roundtrip_batch
