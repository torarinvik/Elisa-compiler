error DictSetPayloadError:
    Bad(values: dict[i64, set[i64]])

def fail(values: dict[i64, set[i64]]) -> i64 error[DictSetPayloadError]:
    raise DictSetPayloadError.Bad(values)

error StructuredDictSetPayloadError:
    Bad(code: i64, values: dict[i64, set[i64]])

def fail_structured(code: i64, values: dict[i64, set[i64]]) -> i64 error[StructuredDictSetPayloadError]:
    raise StructuredDictSetPayloadError.Bad(code, values)

error NestedDictSetPayloadError:
    Bad(values: dict[i64, dict[cstr, set[i64]]])

def fail_nested(values: dict[i64, dict[cstr, set[i64]]]) -> i64 error[NestedDictSetPayloadError]:
    raise NestedDictSetPayloadError.Bad(values)

export pymodule error_payload_dict_set:
    fn fail
    fn fail_structured
    fn fail_nested
