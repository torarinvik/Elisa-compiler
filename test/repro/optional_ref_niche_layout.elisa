# An optional REFERENCE is a NICHE-OPTIMIZED bare pointer (8 bytes), matching stage0 —
# never the `{i1, ptr}` 16-byte pair. ABI-visible wherever the layout is a struct field
# offset or an array stride; a struct shared with the stage0-built runtime object would
# otherwise be read at the wrong offsets. This divergence was live from 2026-07-29 to
# early 2026-08-02 (both probes measured 2x) and closed during the struct-layout work;
# this fixture pins BOTH shapes so it cannot silently reopen. Expected exit: 8+8 = 16.
struct Mark:
    region: mutable heap Mark&?
    count: mutable i64

struct Entry:
    value: i64

def main() -> i64:
    m: mutable Mark = Mark{region: null, count: 7}
    field_offset: i64 = (&m.count).uintptr().usize().i64() - (&m).uintptr().usize().i64()
    cache: mutable heap Entry&?[4] = [null, null, null, null]
    stride: i64 = (&cache[1]).uintptr().usize().i64() - (&cache[0]).uintptr().usize().i64()
    return field_offset + stride
