include "../../elisacore_std/elisacore_runtime.elisa"

# A nullable C string converts to a present, valid view; absence maps to the canonical empty
# string. A raw optional byte pointer is intentionally not accepted: it does not promise a NUL
# terminator, so scanning it to construct a view could escape the pointed-to object.
def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    score: mutable i64 = 0

    p: cstr? = "hello"
    present: sview = p.sview()
    score <- score + 1 if present.len == 5
    direct_present: sview = sview(p, 0, -1)
    score <- score + 1 if direct_present.len == 5

    # A null receiver reads as the EMPTY view — never a strlen of address 0.
    absent: cstr? = null
    missing: sview = absent.sview()
    score <- score + 4 if missing.len == 0
    direct_missing: sview = sview(absent, 0, -1)
    score <- score + 4 if direct_missing.len == 0

    return score
