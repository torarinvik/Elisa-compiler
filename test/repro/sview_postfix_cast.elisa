include "../../elisacore_std/elisacore_runtime.elisa"

# The postfix cast `p.sview()` — the std's `__cast__(value: u8&?) -> sview`, which is
# exactly `sview(value, 0, -1)`.
#
# stage1 rejected it TWICE over, in two different layers:
#
#   semantic  check_nullable_flow descended into a CALL's callee, so the method NAME in
#             `p.sview()` was checked as if it were a field READ on a nullable receiver:
#             "field access requires proven non-null reference". That hard-rejected EVERY
#             method call on a nullable receiver, not just this one. stage0 arbitrates a
#             call on a nullable receiver by the callee's PARAMETER type instead —
#             `p.takes_ref()` fails with `expects u8&, got u8&?&` and `p.takes_nullable()`
#             is simply accepted — so no non-null proof is owed at the receiver.
#
#   backend   `x.NAME()` resolves NAME through scalar_type_of_name, which DOES answer
#             SView, and then handed the receiver to emit_conversion — which has no SView
#             rule at all, so the cast declined.
#
# The receiver must be an OPTIONAL ref. stage0 resolves this cast against the overload's
# declared parameter type, so `s.sview()` on a cstr and `p.sview()` on a `u8&` are both
# "invalid cast from … to sview" there — the fix must not turn either into a stage1-only
# extension.
#
# stage0 answers 5.
def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    score: mutable i64 = 0

    s: cstr = "hello"
    p: u8&? = s
    present: sview = p.sview()
    score <- score + 1 if present.len == 5

    # A null receiver reads as the EMPTY view — never a strlen of address 0.
    absent: u8&? = null
    missing: sview = absent.sview()
    score <- score + 4 if missing.len == 0

    return score
