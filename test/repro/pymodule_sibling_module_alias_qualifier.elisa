# Core's module-alias table is program-wide. The alias in AliasDecl must rewrite the
# qualified default in sibling Caller, ahead of a real root module named V.
module AliasDecl:
    module Provider:
        public:
            const enum Mode of i64:
                High = 41
    using Provider as V

module V:
    public:
        const enum Mode of i64:
            High = 97

module Caller:
    def sibling_alias(value: i64 = V::Mode.High) -> i64:
        return value

export pymodule sibling_module_alias_qualifier:
    fn sibling_alias = Caller::sibling_alias
