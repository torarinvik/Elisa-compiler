struct Point:
    x: i64
    label: sview

error PointListPayloadError:
    Bad(points: darray[Point])

def fail_list(points: darray[Point]) -> i64 error[PointListPayloadError]:
    raise PointListPayloadError.Bad(points)

error PointViewPayloadError:
    Bad(points: view[Point])

def fail_view(points: view[Point]) -> i64 error[PointViewPayloadError]:
    raise PointViewPayloadError.Bad(points)

error StructuredPointAggregatePayloadError:
    Bad(code: i64, points: darray[Point], view_points: view[Point])

def fail_structured(code: i64, points: darray[Point], view_points: view[Point]) -> i64 error[StructuredPointAggregatePayloadError]:
    raise StructuredPointAggregatePayloadError.Bad(code, points, view_points)

export pymodule error_payload_named_aggregate:
    fn fail_list
    fn fail_view
    fn fail_structured
