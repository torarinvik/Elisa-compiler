# Compiler-only capacity regression: repeated counted fills must retain
# amortized growth. Capacity is not a language-level differential contract.
include "../../elisacore_std/elisacore_runtime.elisa"

def main() -> i32:
    # Explicit reserve retains its exact requested capacity and never shrinks.
    explicit: mutable darray[u8] = []
    explicit.reserve(13)
    return 4 if explicit.capacity != 13 or explicit.count != 0
    explicit.push(7)
    explicit.reserve(12)
    return 5 if explicit.capacity != 13 or explicit.count != 1 or explicit[0] != 7
    # A single counted scalar fill still preserves values.
    scalar: mutable darray[i64] = []
    for index in 0..<17:
        scalar.push(index * 3)
    return 6 if scalar.count != 17 or scalar.capacity < 17 or scalar[16] != 48
    bytes: mutable darray[u8] = []
    prior_capacity: mutable usize = 0
    for chunk in 0..<32:
        for index in 0..<65536:
            bytes.push((index % 251).u8())
        return 1 if prior_capacity != 0 and bytes.capacity > prior_capacity and bytes.capacity < prior_capacity * 2
        prior_capacity <- bytes.capacity
    return 2 if bytes.count != 32 * 65536
    for index in 0..<bytes.count:
        return 3 if bytes[index] != (index % 65536 % 251).u8()
    return 0
