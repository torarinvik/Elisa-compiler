module Wrong:
    enum Message:
        Some(left: i64, right: i64)
module Right:
    enum Message:
        Some(value: i64)
enum Envelope:
    Wrap(message: Right::Message)
def main() -> i64:
    envelope: Envelope = Envelope.Wrap(Right::Message.Some(42))
    match envelope:
        Envelope.Wrap(Wrong::Message.Some(left, right)):
            return left + right
    return -1
