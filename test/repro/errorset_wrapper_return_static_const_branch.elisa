# The inactive App-local constant must not shadow the active root constant when
# EWR selects the callable family imported by the static-if branches.
const CHOOSE_A: bool = true

module App:
    module ProviderA:
        public:
            error FaultA:
                A

            def origin() -> i64 error[App::ProviderA::FaultA]:
                raise App::ProviderA::FaultA.A

    module ProviderB:
        public:
            error FaultB:
                B

            def origin() -> i64 error[App::ProviderB::FaultB]:
                raise App::ProviderB::FaultB.B

    static if false:
        static if true:
            const CHOOSE_A: bool = false

    static if CHOOSE_A:
        using ProviderA as Pick
    static else:
        using ProviderB as Pick

    public:
        def caller() -> i64 error[App::ProviderA::FaultA]:
            return Pick::origin()

def main() -> i64:
    return 0
