struct P:
    store: mutable darray[u8]
    n: i64

struct D:
    name: sview

def persist_name(bytes: darray[u8]&, start: usize, count: usize) -> static u8&:
    out: mutable darray[u8] = []
    out.reserve(count + 1)
    for i in 0 ..< count:
        out.push(bytes[start + i])
    out.push(0)
    return (&out[0]).cast[static u8&]

def persisted_view(bytes: darray[u8]&, start: usize, count: usize) -> sview:
    data: static u8& = persist_name(bytes, start, count)
    trusted Unsafe.PointerCast:
        return StringView{data: data, len: count.i64()}

def mk(p: mutable P&) -> sview:
    start: usize = p.store.count
    p.store.push(65)
    p.store.push(66)
    return persisted_view(&p.store, start, 2)

def build(k: i64) -> darray[D]:
    p: mutable P = P{store: [], n: k}
    out: mutable darray[D] = []
    out.push(D{name: mk(&p)})
    return out

def main() -> i32:
    ds = build(3)
    return i32(ds[0].name[1])
