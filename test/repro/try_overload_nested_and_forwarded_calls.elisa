# A nested direct call with a unique primitive result must keep an unrelated private
# overload from blocking the public receiver winner. Forwarded overloaded calls stay
# unresolved for family propagation, while forwarded singleton calls remain inferable.
module Forwarded:
    public:
        error PublicFault:
            PublicFailure

        error OtherFault:
            OtherFailure

        def produce_i64() -> i64:
            return 1

        def choose(value: i64) -> i64 error[Forwarded::PublicFault]:
            return value

    private:
        error PrivateFault:
            PrivateFailure

        def choose(value: bool) -> i64 error[Forwarded::PrivateFault]:
            return 0

    public:
        def nested_actual() -> i64 error[Forwarded::PrivateFault]:
            return try choose(produce_i64())

        def forwarded_overload(value: i64) -> i64 error[Forwarded::OtherFault]:
            return try choose(..)

        def singleton(value: i64) -> i64 error[Forwarded::PublicFault]:
            return value

        def forwarded_singleton(value: i64) -> i64 error[Forwarded::OtherFault]:
            return try singleton(..)

def main() -> i64:
    return 0
