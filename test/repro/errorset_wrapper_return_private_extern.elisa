# A private infallible extern must not hide the visible fallible callable with the same name.
module Provider:
    public:
        error Fault:
            Failed

        def fetch() -> i64 error[Provider::Fault]:
            raise Provider::Fault.Failed

module Hidden:
    private:
        extern fetch() -> i64

using Provider::fetch

module App:
    using Hidden

    public:
        error Expected:
            Rejected

        def wrap[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
            return try callback()

        def invalid_shadowed_private_extern() -> i64 error[App::Expected]:
            return wrap(fetch)

def main() -> i64:
    return 0
