def nonnull[T](value: mutable T&?) -> mutable T& can[Abort.Panic]:
    can Abort.Panic:
        if value == null:
            panic("null pointer")
        return value

def nonnull_readonly[T](value: T&?) -> T& can[Abort.Panic]:
    can Abort.Panic:
        if value == null:
            panic("null pointer")
        return value

def mutate_inner_pointer(slot: mutable (mutable i32&?) &?) -> i64 can[Abort.Panic]:
    can Abort.Panic:
        nonnull(nonnull(slot)[0])[0] += 5
        return nonnull(nonnull(slot)[0])[0]

def replace_inner_pointer(slot: mutable (i32&?) &?) -> i64 can[Abort.Panic]:
    can Abort.Panic:
        nonnull_readonly(slot)[0] <- zeroed
        return 42 if nonnull_readonly(slot)[0] == null else 0

def main() -> i64 can[Abort.Panic]:
    value: mutable i32 = 37
    mutable_pointer: mutable i32&? = &value
    mutable_slot: mutable (mutable i32&?) &? = &mutable_pointer
    if mutate_inner_pointer(mutable_slot) != 42:
        return 1
    readonly_pointer: i32&? = &value
    readonly_slot: mutable (i32&?) &? = &readonly_pointer
    return replace_inner_pointer(readonly_slot)
