# Same logical line and parameter count, but only append_value grows its darray argument.
#line 0 region-fact-owner.elisa
def value_count(values: darray[i64]&) -> usize:
    return values.count

#line 0 region-fact-owner.elisa
def append_value(values: mutable darray[i64]&) -> void:
    values.push(42)

def main() -> i64:
    values: mutable darray[i64] = []
    append_value(&values)
    return 0 if value_count(values) == 1 and values[0] == 42 else 1
