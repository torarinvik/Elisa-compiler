# A qualified, module-local error call must survive another sibling module
# with its own state/event/error vocabulary.
enum DeliveryState:
    Absent
    Complete

enum DeliveryEvent:
    Resolve
    Complete

error DeliveryTransitionError:
    InvalidTransition
    Terminal

struct DeliveryStatus:
    state: DeliveryState

module Workflow::Delivery:
    public:
        def initial() -> DeliveryStatus:
            return DeliveryStatus{state: DeliveryState.Absent}

        def step(status: DeliveryStatus, event: DeliveryEvent) -> DeliveryStatus error[DeliveryTransitionError]:
            return DeliveryStatus{state: DeliveryState.Complete} if event is DeliveryEvent.Complete
            raise DeliveryTransitionError.InvalidTransition

        def probe() -> bool error[DeliveryTransitionError]:
            status: mutable DeliveryStatus = initial()
            done: DeliveryStatus = try step(status, DeliveryEvent.Complete)
            status <- done
            return status.state is DeliveryState.Complete

enum OperationState:
    Idle
    Queued

enum OperationEvent:
    Start
    Begun

error OperationTransitionError:
    InvalidTransition
    Terminal

struct OperationStatus:
    state: OperationState
    attempt: OperationAttempt

law ValidOperationAttempt(self: u32) = self <= 8
type OperationAttempt = u32 is ValidOperationAttempt

module Workflow::Operations:
    public:
        def initial() -> OperationStatus:
            return OperationStatus{state: OperationState.Idle, attempt: 0}

        def advance(status: OperationStatus, event: OperationEvent) -> OperationStatus error[OperationTransitionError]:
            return OperationStatus{state: OperationState.Queued, attempt: status.attempt + 1} if event is OperationEvent.Start
            raise OperationTransitionError.InvalidTransition

        def probe_operation(event: OperationEvent) -> bool error[OperationTransitionError]:
            status: mutable OperationStatus = initial()
            queued: OperationStatus = try Workflow::Operations::advance(status, event)
            status <- queued
            return status.state is OperationState.Queued and status.attempt == 1

def main() -> i64:
    first: bool = try Workflow::Delivery::probe() else false
    second: bool = try Workflow::Operations::probe_operation(OperationEvent.Start) else false
    failed: bool = try Workflow::Operations::probe_operation(OperationEvent.Begun) else false
    return 0 if first and second and not failed else 1
