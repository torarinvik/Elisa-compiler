# A local nominal type wins Core's bare-name lookup before a later selective import.
# The imported Provider.Fault must not trigger the errorset-parameter shadow warning.
module Provider:
    public:
        error Fault:
            Failed

module Consumer:
    struct Fault:
        code: i64

    def forward[errorset Fault](callback: fn() -> i64 error[Fault]) -> i64 error[Fault]:
        return try callback()

from Provider import Fault

def main() -> i64:
    return 0
