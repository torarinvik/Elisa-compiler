include "../../src/backend/codegen_const_checked_arithmetic.elisa"
include "../../src/semantic/semantic.elisa"
extend Semantic:
    public:
        def extern_index_probe() -> bool can[Abort.Panic, Memory.Allocate, Global{Read,Write}]:
            can Abort.Panic, Memory.Allocate, Global{Read,Write}:
                table: mutable SymbolTable = SymbolTable()
                table.current_module <- "M"
                table <- table.add_symbol("target", SymbolKind.Func, 1)
                table <- extern_declaration_index_add("M", "target", table) can Global{Read,Write}
                return false if not extern_regular_function_owner_is_unique("M", "target", &table)
                return false if not extern_module_owner_is_extern_only("M", "target", &table)
                other: u32 = table.symbols.count.u32()
                table <- table.add_symbol("other", SymbolKind.Func, 2)
                first: u32 = symbol_chain_head(&table, "target")
                table.symbol_name_next[first.usize()] <- other
                table.symbol_name_tail <- table.symbol_name_tail.put(name_hash("target"), other) can Global{Read,Write}
                return false if not extern_regular_function_owner_is_unique("M", "target", &table)
                return false if not extern_module_owner_is_extern_only("M", "target", &table)
                table.symbol_name_indexed_rows <- 0
                return false if not extern_regular_function_owner_is_unique("M", "target", &table)
                return false if not extern_module_owner_is_extern_only("M", "target", &table)
                table <- table.add_symbol("target", SymbolKind.Func, 3)
                return false if extern_regular_function_owner_is_unique("M", "target", &table)
                return false if extern_module_owner_is_extern_only("M", "target", &table)
                return true

def main() -> i64:
    can Memory.Allocate, Abort.Panic, Global{Read,Write}:
        return 0 if Semantic::extern_index_probe() else 1
