# An inactive declaration's errorset parameter must not produce a shadow warning.
error Fault:
    Failed

def active_forward[errorset Fault](callback: fn() -> i64 error[Fault]) -> i64 error[Fault]:
    return try callback()

static if false:
    def inactive_forward[errorset Fault](callback: fn() -> i64 error[Fault]) -> i64 error[Fault]:
        return try callback()

def main() -> i64:
    return 0
