struct Stat:
    flags: mutable u32

struct Info:
    specialFlags: mutable u32

global mutable stat: Stat = zeroed
global mutable infos: array[Info, 1] = zeroed
global mutable stat_ref: Stat&? = zeroed

def main() -> i32:
    index: i32 = 0
    stat_ref <- &stat
    elisa_nonnull(stat_ref).flags <- elisa_nonnull(stat_ref).flags | infos[index].specialFlags
    return stat.flags.i32()

def elisa_nonnull[T](value: mutable T&?) -> mutable T&:
    if value == null:
        return zeroed
    return value
