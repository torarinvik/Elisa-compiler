# Type aliases have the same lexical owner rules as structs. Two modules may use the
# same alias name for different same-named structs without silently sharing one layout.

module Alpha:
    struct Value:
        left: i64

    type Item = Value

    def make() -> Item:
        can Abort.Panic:
            return Item{left: 11}

module Beta:
    struct Value:
        right: i64

    type Item = Value

    def make() -> Item:
        can Abort.Panic:
            return Item{right: 31}

def main() -> i64:
    can Abort.Panic:
        alpha: Alpha::Item = Alpha::make()
        beta: Beta::Item = Beta::make()
        return alpha.left + beta.right
