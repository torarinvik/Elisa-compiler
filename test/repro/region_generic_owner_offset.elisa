# The generic helpers share a logical line, leaf name, and parameter count.
# Their type-parameter spelling differs, so placeholder lookup must use owner
# and declaration offset before inferring each body's arena-growth facts.
module ReadOwner:
    public:
#line 0 region-generic-owner.elisa
        def mutate[T](values: darray[T]&, value: T) -> bool:
            return values.count == 0

module GrowOwner:
    public:
#line 0 region-generic-owner.elisa
        def mutate[Element](values: mutable darray[Element]&, value: Element) -> void:
            values.push(value)

def main() -> i64:
    values: mutable darray[i64] = []
    GrowOwner::mutate[i64](&values, 42)
    return 0 if values.count == 1 and values[0] == 42 and not ReadOwner::mutate[i64](values, 0) else 1
