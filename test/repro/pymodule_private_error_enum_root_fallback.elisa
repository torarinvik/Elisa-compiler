# Core rejects the private imported ErrorSet outside Values, then resolves the public root enum.
module Values:
    private:
        error Fault:
            Hidden

const enum Fault of i64:
    Hidden = 97

using Values

def root_fallback(value: i64 = Fault.Hidden) -> i64:
    return value

export pymodule pymodule_private_error_enum_root_fallback:
    fn root_fallback
