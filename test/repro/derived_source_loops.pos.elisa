struct Player[state Alive | Dead]:
    health: mutable i64
    tag: mutable i64
    derive state:
        Alive when self.health > 0
        Dead when self.health <= 0

def preserve_for(player: mutable Player[Alive], count: i64) -> Player[Alive]:
    for index in 0..<count |player|:
        player.tag <- 2
    return player{tag = 1}

def preserve_while(player: mutable Player[Alive], again: bool) -> Player[Alive]:
    while again:
        player.tag <- 2
    return player{tag = 1}

def preserve_while_counter(player: mutable Player[Alive], count: mutable i64) -> Player[Alive]:
    while count > 0:
        player.tag <- 2
        count <- count - 1
    return player{tag = 1}

def empty_loop(player: mutable Player[Alive]) -> Player[Alive]:
    for index in 0..<0 |player|:
        player.health <- 0
    return player{tag = 1}

def false_while(player: mutable Player[Alive]) -> Player[Alive]:
    while false:
        player.health <- 0
    return player{tag = 1}

def nonempty_loop(player: mutable Player[Alive]) -> Player[Dead]:
    for index in 0..<3 |player|:
        player.health <- 0
    return player{tag = 1}

def single_iteration(player: mutable Player[Alive]) -> Player[Dead]:
    for index in 0..=0 |player|:
        player.health <- 0
    return player{tag = 1}

def main() -> i32:
    original: Player[Alive] = Player[Alive]{health: 7, tag: 0}
    none: Player[Alive] = preserve_for(original, 0)
    many: Player[Alive] = preserve_for(original, 4)
    not_while: Player[Alive] = preserve_while(original, false)
    counted: Player[Alive] = preserve_while_counter(original, 3)
    empty: Player[Alive] = empty_loop(original)
    false_loop: Player[Alive] = false_while(original)
    dead: Player[Dead] = nonempty_loop(original)
    once: Player[Dead] = single_iteration(original)
    return 1 if none.health != 7 or many.health != 7 or not_while.health != 7 or counted.health != 7
    return 2 if empty.health != 7 or false_loop.health != 7
    return 3 if dead.health != 0 or once.health != 0
    return 4 if dead.tag != 1 or many.tag != 1 or original.health != 7 or original.tag != 0
    return 0
