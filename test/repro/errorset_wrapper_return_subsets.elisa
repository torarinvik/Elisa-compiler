module Provider:
    public:
        error Fault:
            Available
            Busy

        def get_available() -> i64 error[Provider::Fault{Available}]:
            raise Provider::Fault.Available

        def get_all() -> i64 error[Provider::Fault]:
            raise Provider::Fault.Available

        def get_both() -> i64 error[Provider::Fault{Available, Busy}]:
            raise Provider::Fault.Available

        def get_busy() -> i64 error[Provider::Fault{Busy}]:
            raise Provider::Fault.Busy

        def wrap[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
            return try callback()

module Peer:
    public:
        error Fault:
            Available
            Busy

using Provider::get_available
using Provider::get_all
using Provider::get_both
using Provider::get_busy
using Provider::wrap

def restricted_to_full() -> i64 error[Provider::Fault]:
    return wrap(get_available)

def restricted_to_wrong_subset() -> i64 error[Provider::Fault{Busy}]:
    return wrap(get_available)

def full_to_subset() -> i64 error[Provider::Fault{Available}]:
    return wrap(get_all)

def later_destination_tag_is_covered() -> i64 error[Provider::Fault{Available, Busy}]:
    return wrap(get_busy)

def multiple_source_tags_to_subset() -> i64 error[Provider::Fault{Available}]:
    return wrap(get_both)

def restricted_cross_module_same_tag() -> i64 error[Peer::Fault]:
    return wrap(get_available)

def restricted_cross_module_wrong_subset() -> i64 error[Peer::Fault{Busy}]:
    return wrap(get_available)

def parameter_error_set_is_not_return_set(callback: fn() -> i64 error[Provider::Fault]) -> i64 error[Provider::Fault{Busy}]:
    return wrap(get_available)

def wrap_value_with_observer[errorset R](value: i64 error[R], observer: fn() -> i64 error[Provider::Fault{Busy}]) -> i64 error[R]:
    return value

def unrelated_observer_does_not_supply_R() -> i64 error[Provider::Fault{Available}]:
    return wrap_value_with_observer(get_available(), get_busy)

def wrap_with_observer[errorset R](observer: fn() -> i64 error[Provider::Fault{Busy}], callback: fn() -> i64 error[R]) -> i64 error[R]:
    return try callback()

def positional_errorset_binding_uses_matching_formal() -> i64 error[Provider::Fault{Busy}]:
    return wrap_with_observer(get_busy, get_available)

def named_errorset_binding_uses_matching_formal() -> i64 error[Provider::Fault{Busy}]:
    return wrap_with_observer(callback: get_available, observer: get_busy)

def parameter_shadows_global_callable(get_available: fn() -> i64 error[Provider::Fault{Busy}]) -> i64 error[Provider::Fault{Busy}]:
    return wrap(get_available)

def local_callable_shadows_global() -> i64 error[Provider::Fault{Busy}]:
    get_available: fn() -> i64 error[Provider::Fault{Busy}] = get_busy
    return wrap(get_available)

def wrap_two_callbacks[errorset R](first: fn() -> i64 error[R], second: fn() -> i64 error[R]) -> i64 error[R]:
    return try first()

def empty_callback() -> i64:
    return 0

def union_contributors_require_union_coverage() -> i64 error[Provider::Fault{Available}]:
    return wrap_two_callbacks(get_available, get_busy)

def empty_errorset_contributor_is_the_unit() -> i64 error[Provider::Fault{Busy}]:
    return wrap_two_callbacks(empty_callback, get_available)

module Outer:
    def adapt[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
        return try callback()

    module Inner:
        def adapt(callback: fn() -> i64 error[Provider::Fault{Busy}]) -> i64:
            return 0

        def get_available() -> i64 error[Provider::Fault{Available}]:
            raise Provider::Fault.Available

        def nearer_infallible_callable_shadows_parent() -> i64 error[Provider::Fault{Busy}]:
            return adapt(get_available)

def wrap_with_default[errorset R](callback: fn() -> i64 error[R] = get_available) -> i64 error[R]:
    return try callback()

def omitted_default_callback_to_wrong_subset() -> i64 error[Provider::Fault{Busy}]:
    return wrap_with_default()

def qualified_wrapper_and_callback() -> i64 error[Provider::Fault{Busy}]:
    return Provider::wrap(Provider::get_available)

using Provider as P

def aliased_qualified_wrapper_and_callback() -> i64 error[Provider::Fault{Busy}]:
    return P::wrap(P::get_available)

def wrap_value_for_family[errorset R](value: i64 error[R]) -> i64 error[R]:
    return value

def choose(value: i64) -> i64:
    return value

def choose(value: bool) -> i64 error[Provider::Fault{Available}]:
    return 0

def infallible_overload_is_not_mistaken_for_fallible() -> i64 error[Provider::Fault{Busy}]:
    return wrap_value_for_family(choose(1))

extern empty_extern_callback() -> i64

def empty_extern_callback_is_a_unit_contributor() -> i64 error[Provider::Fault{Busy}]:
    return wrap_two_callbacks(empty_extern_callback, get_available)

def main() -> i64:
    return 0
