# ITERATING a fixed `array[T, N]` — the `for` header and every query fold.
#
# Indexing one (`xs[1]`) always worked; walking one did not. The iterable ladder resolved a
# darray or an integer range and nothing else, so `for x in xs` declined and took the whole
# function with it. A fixed array's storage is contiguous but carries NO header, which is the
# whole difficulty: the darray walk reads `{ptr items, i64 count, i64 capacity}`.
#
# Rather than a second copy of the loop plumbing in five places (the `for` header plus the
# four query emitters), a header is SYNTHESIZED over the array's storage — `items` pointing at
# element 0 and both counts the compile-time extent — and the existing darray walk runs on it.
# Read-only by construction: iteration binds a COPY of each element.
#
# Three storage positions, which resolve their address differently: a LOCAL array is its own
# slot, an `array[T, N]&` PARAMETER's slot holds a pointer to the caller's, and a STRUCT FIELD
# is a GEP. struct_address_of serves none of them — it answers null for an Array — so each is
# a separate way to get this wrong.
#
# stage0 answers 255 — every bit.
struct Grid:
    cells: array[i64, 4]
    tag: i64


def through_parameter(xs: array[i64, 3]&) -> i64:
    running: mutable i64 = 0
    for value in xs |running|:
        running <- running + value
    return running


def main() -> i64:
    score: mutable i64 = 0

    # A LOCAL array, walked by `for`.
    local: array[i64, 3] = [1, 2, 3]
    local_total: mutable i64 = 0
    for value in local |local_total|:
        local_total <- local_total + value
    score <- score + 1 if local_total == 6

    # The QUERY folds over the same array — each is a different accumulator over the walk,
    # and `all` over a fixed array is a different quantifier from `any`.
    wide: array[i64, 5] = [3, 1, 4, 1, 5]
    score <- score + 8 if (sum value in wide) == 14
    score <- score + 16 if (count value in wide where value > 1) == 3
    score <- score + 32 if all value in wide where value > 0
    score <- score + 64 if not (all value in wide where value > 1)

    # A `array[T, N]&` PARAMETER — the slot holds a POINTER, so it takes one more load.
    borrowed: array[i64, 3] = [4, 5, 6]
    score <- score + 128 if through_parameter(borrowed) == 15

    # A STRUCT FIELD — a GEP rather than a binding.
    grid: Grid = Grid{cells: [1, 2, 3, 4], tag: 9}
    field_total: mutable i64 = 0
    for cell in grid.cells |field_total|:
        field_total <- field_total + cell
    score <- score + 2 if field_total == 10

    # A NARROWER element than a word: the synthesized header's `items` must point at the
    # array's own storage, so the walk strides by the ELEMENT and not by 8.
    narrow: array[u8, 4] = [1, 2, 3, 4]
    narrow_total: mutable i64 = 0
    for byte_value in narrow |narrow_total|:
        narrow_total <- narrow_total + byte_value.i64()
    score <- score + 4 if narrow_total == 10

    return score
