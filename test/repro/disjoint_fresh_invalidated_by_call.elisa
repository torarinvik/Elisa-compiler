# A call to an unknown mutating helper can replace either darray descriptor. Freshness of
# local allocations must be retired before a later candidate call is proved.
def rebind(first: mutable darray[i64]&, second: mutable darray[i64]&) -> void:
    first <- second

def update_pair(first: mutable darray[i64]&, second: mutable darray[i64]&) -> void:
    first[0] <- second[0]

def route() -> void:
    left: mutable darray[i64] = [1]
    right: mutable darray[i64] = [2]
    rebind(&left, &right)
    update_pair(&left, &right)

def main() -> i64:
    route()
    return 0
