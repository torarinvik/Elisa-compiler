struct Point:
    x: i64
    label: sview
    payload: py::Object

type Points = darray[Point]
type PointView = view[Point]

def roundtrip_points(points: Points) -> Points:
    return points

def count_points(points: PointView) -> usize:
    return points.len

def identity_points(points: PointView) -> PointView:
    return points

export pymodule struct_sequences:
    fn roundtrip_points
    fn count_points
    fn identity_points
