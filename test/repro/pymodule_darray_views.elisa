# A darray of read-only views is represented as an outer list of independent
# `{data, len}` headers.  Python inputs are copied into the call arena and the
# result is copied back before that arena is released.
struct Point:
    x: i64

def roundtrip_i64(values: darray[view[i64]]) -> darray[view[i64]]:
    return values

def roundtrip_text(values: darray[view[sview]]) -> darray[view[sview]]:
    return values

def roundtrip_optional(values: darray[view[i64?]]) -> darray[view[i64?]]:
    return values

def roundtrip_objects(values: darray[view[py::Object]]) -> darray[view[py::Object]]:
    return values

def roundtrip_points(values: darray[view[Point]]) -> darray[view[Point]]:
    return values

export pymodule darray_views:
    fn roundtrip_i64
    fn roundtrip_text
    fn roundtrip_optional
    fn roundtrip_objects
    fn roundtrip_points
