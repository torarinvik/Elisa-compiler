# Minimal arity-table probes used while reducing the staged self-host failure.
def takes_views(values: darray[sview], count: usize) -> void:
    return

def takes_structs(values: darray[darray[i64]]) -> void:
    return

def takes_default(value: i64, extra: i64 = 1) -> void:
    return

def main() -> i64:
    views: darray[sview] = []
    takes_views(views, 0)
    statements: darray[darray[i64]] = []
    takes_structs(statements)
    takes_default(0)
    return 0
