error FeatureWireError:
    InvalidHandle

error FeatureTransitionError:
    InvalidHandle
    Terminal

enum FeatureState:
    Loading
    Ready

type FeatureHandle = u64

struct FeatureStatus:
    handle: FeatureHandle
    state: FeatureState

module UiFeatureView:
    struct FeatureHandle:
        slot: u32

    def is_valid(handle: FeatureHandle) -> bool:
        return handle.slot > 0

module WasmBrowser::FeatureActivation:
    public:
        def initial(handle: FeatureHandle) -> FeatureStatus:
            return FeatureStatus{handle: handle, state: FeatureState.Loading}

        def ready(status: FeatureStatus) -> FeatureStatus error[FeatureWireError]:
            raise FeatureWireError.InvalidHandle if status.handle == 0
            return FeatureStatus{handle: status.handle, state: FeatureState.Ready}

        def advance(status: FeatureStatus, succeeds: bool) -> FeatureStatus error[FeatureTransitionError]:
            raise FeatureTransitionError.InvalidHandle if status.handle == 0
            raise FeatureTransitionError.Terminal if status.state == FeatureState.Ready
            return FeatureStatus{handle: status.handle, state: FeatureState.Ready} if succeeds
            raise FeatureTransitionError.InvalidHandle

def main() -> i64:
    loading: FeatureStatus = WasmBrowser::FeatureActivation::initial(41)
    via_ready: FeatureStatus = try WasmBrowser::FeatureActivation::ready(loading) else return 1
    via_advance: FeatureStatus = try WasmBrowser::FeatureActivation::advance(loading, true) else return 2
    if via_ready.state == FeatureState.Ready and via_advance.state == FeatureState.Ready:
        return 42
    return 1
