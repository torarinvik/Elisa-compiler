module FirstValues:
    public:
        const enum Mode of i64:
            High = 41

module SecondValues:
    public:
        const enum Mode of i64:
            High = 42

module AliasValues:
    public:
        const enum AliasMode of i64:
            High = 54

module SelectiveAliasValues:
    public:
        const enum SelectiveMode of i64:
            High = 64

module LocalShadow:
    public:
        const enum Mode of i64:
            High = 93
    def local_shadow(value: i64 = Mode.High) -> i64:
        return value

using FirstValues
using SecondValues
using AliasValues as AliasValuesAlias
using AliasValuesAlias
using SelectiveAliasValues as SelectiveValuesAlias
using SelectiveValuesAlias::SelectiveMode

def wildcard_first(value: i64 = Mode.High) -> i64:
    return value

def wildcard_alias(value: i64 = AliasMode.High) -> i64:
    return value

def selective_alias(value: i64 = SelectiveMode.High) -> i64:
    return value

export pymodule wildcard_enum_defaults:
    fn wildcard_first
    fn wildcard_alias
    fn selective_alias
    fn local_shadow = LocalShadow::local_shadow
