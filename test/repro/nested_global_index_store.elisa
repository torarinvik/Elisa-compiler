struct Objstruct:
    flags: mutable u32

global mutable matrix: array[array[i32, 2], 4] = zeroed
global mutable actorat: array[array[mutable Objstruct&?, 64], 64] = zeroed

def scalar_store(x: i32, y: i32) -> void:
    matrix[x][y] <- 3

def pointer_store(x: i32, y: i32) -> void:
    actorat[x][y] <- (64).cast[mutable Objstruct&?]

def main() -> i64:
    scalar_store(0, 0)
    pointer_store(0, 0)
    return matrix[0][0]
