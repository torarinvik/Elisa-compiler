enum Widget layout(handle: u32):
    common:
        x: f32
        y: f32
        w: f32
        h: f32
    pass

enum Control is Widget:
    Label(text: sview)

enum Button is Control:
    Push(label: sview)

def make_button(label: sview) -> Widget:
    return Button.Push(x: 1.0, y: 2.0, w: 30.0, h: 10.0, label: label)

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        b: Widget = make_button("go")
        return 0
