error First:
    Bad
error Second:
    Bad
def consume(value: i64, callback: fn() -> i64 error[First]) -> i64 error[First]:
    return try callback()
def consume(value: bool, callback: fn() -> i64 error[Second]) -> i64 error[Second]:
    return try callback()
def test(consume: fn(i64, fn() -> i64 error[Second]) -> i64 error[Second]) -> i64 error[Second]:
    return consume(1, fn() => raise Second.Bad)
