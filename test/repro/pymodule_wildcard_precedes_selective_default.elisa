# Core tries wildcard using targets before selective aliases, regardless of source order.
module SelectiveValues:
    public:
        const enum Mode of i64:
            High = 41

module WildcardValues:
    public:
        const enum Mode of i64:
            High = 73

const enum Mode of i64:
    High = 97

using SelectiveValues::Mode
using WildcardValues

def wildcard_beats_selective(value: i64 = Mode.High) -> i64:
    return value

export pymodule wildcard_precedes_selective_default:
    fn wildcard_beats_selective
