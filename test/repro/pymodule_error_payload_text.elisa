# Text and opaque-object payloads become ElisaError.payload at the Python boundary.
error TextPayloadError:
    Bad(text: sview)

error CStrPayloadError:
    Bad(text: cstr)

error ObjectPayloadError:
    Bad(value: py::Object)

def fail_sview(text: sview) -> void error[TextPayloadError]:
    raise TextPayloadError.Bad(text)

def fail_cstr(text: cstr) -> void error[CStrPayloadError]:
    raise CStrPayloadError.Bad(text)

def fail_object(value: py::Object) -> void error[ObjectPayloadError]:
    raise ObjectPayloadError.Bad(value)

export pymodule payload_text:
    fn fail_sview
    fn fail_cstr
    fn fail_object
