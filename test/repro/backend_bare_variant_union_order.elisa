module Alpha:
    error ZuluFault:
        Expected(payload: i64)

module Beta:
    error Other:
        Tail(payload: i64)

# The bare tag's canonical owner key is Alpha.ZuluFault, which sorts before
# Beta.Other. Sorting by the leaf `ZuluFault` instead would put it after Beta.Other.
def produce_expected() -> i64 error[Expected, Beta::Other{Tail}]:
    raise Alpha::ZuluFault.Expected(37)

def produce_other() -> i64 error[Expected, Beta::Other{Tail}]:
    raise Beta::Other.Tail(53)

def catch_expected() -> i64:
    return catch produce_expected():
        value: -1
        Alpha::ZuluFault.Expected(payload): payload
        Beta::Other.Tail(payload): -2

def catch_middle() -> i64:
    return catch produce_other():
        value: -1
        Alpha::ZuluFault.Expected(payload): -2
        Beta::Other.Tail(payload): payload

def main() -> i64:
    return 1 if catch_expected() != 37
    return 2 if catch_middle() != 53
    return 0
