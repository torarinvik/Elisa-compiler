def sum_fixed(xs: array[i64, 3]&) -> i64:
    return xs[0] + xs[1] + xs[2]

def sum_fixed_postfix(xs: i64[3]&) -> i64:
    return xs[0] + xs[1] + xs[2]

def sum_fixed_value(xs: i64[3]) -> i64:
    return xs[0] + xs[1] + xs[2]

def sum_darray_ref(xs: darray[i64]&) -> i64:
    return xs[0] + xs[1] + xs[2]

export pymodule fixed_array_refs:
    fn sum_fixed
    fn sum_fixed_postfix
    fn sum_fixed_value
    fn sum_darray_ref
