include "../../elisacore_std/elisacore_runtime.elisa"

struct AppendBuffer:
    rows: mutable darray[i64]

def append_owned(buffer: lmut AppendBuffer, values: darray[i64]&) -> void can[Memory.Allocate, Abort.Panic]:
    buffer.rows <- buffer.rows.extend(values)

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    buffer: mutable AppendBuffer = AppendBuffer{rows: [1, 2]}
    values: darray[i64] = [3, 4]
    buffer <- append_owned(buffer, &values)
    return 1 if buffer.rows.count != 4 or buffer.rows[0] != 1 or buffer.rows[3] != 4
    empty: darray[i64] = []
    buffer <- append_owned(buffer, &empty)
    return 2 if buffer.rows.count != 4
    buffer.rows <- buffer.rows.extend(buffer.rows)
    return 3 if buffer.rows.count != 8 or buffer.rows[7] != 4
    for index in 0..<4:
        return 4 if buffer.rows[index] != buffer.rows[index + 4]
    return 0
