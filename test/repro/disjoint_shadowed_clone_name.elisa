# A source function with the bare name `clone` is not the type-applied clone builtin.
# Returning a darray parameter aliases its backing allocation; it is not a fresh initializer.
def clone(values: mutable darray[i64]) -> mutable darray[i64]:
    return values

def update_pair(first: mutable darray[i64]&, second: mutable darray[i64]&) -> void:
    first[0] <- second[0]

def main() -> i64:
    first: mutable darray[i64] = [1]
    second: mutable darray[i64] = clone(first)
    update_pair(&first, &second)
    return 0
