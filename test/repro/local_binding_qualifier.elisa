# Binding mutability is independent from the capability carried by a reference.
# The first local may rebind a readonly reference value; the second keeps an
# immutable binding while allowing writes through a mutable reference.
def main() -> i64:
    first: i64 = 5
    second: mutable i64 = 7
    mutable readonly_view: i64& = &first
    readonly_view <- &second
    writable_view: mutable i64& = &second
    writable_view <- 9
    return second
