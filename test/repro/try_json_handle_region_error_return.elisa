include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

module Json:
    private:
        enum JsonValue:
            Null
            Bool(value: bool)
            Number(value: f64)

    public:
        error JsonError:
            UnexpectedEnd(pos: i64)
            UnexpectedChar(pos: i64)
            InvalidLiteral(pos: i64)
            InvalidNumber(pos: i64)
            InvalidString(pos: i64)
            InvalidEscape(pos: i64)
            ExpectedColon(pos: i64)
            ExpectedCommaOrEnd(pos: i64)
            TrailingData(pos: i64)
            DepthExceeded(pos: i64)

        struct JsonValueHandle[@r]:
            private:
                node: JsonValue

        struct JsonParseResult[@r]:
            value: JsonValueHandle[r]

    public:
        def json_parse_checked[@r](a: mutable Arena& @r, text: sview) -> JsonParseResult[r]:
            value: JsonValueHandle[r] = JsonValueHandle{node: JsonValue.Null}
            return JsonParseResult{value: value}

        def json_parse_plain[@r](result: JsonParseResult[r]) -> JsonValueHandle[r]:
            return result.value

        def json_parse[@r](a: mutable Arena& @r, text: sview) -> JsonValueHandle[r] error[JsonError]:
            outcome: JsonParseResult[r] = json_parse_checked(a, text)
            return outcome.value

        def json_parse_cstr[@r](a: mutable Arena& @r, text: cstr) -> JsonValueHandle[r] error[JsonError]:
            can Abort.Panic:
                return try json_parse(a, sview(text, 0, -1))

def main() -> i64:
    return 0
