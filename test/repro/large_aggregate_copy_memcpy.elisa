# Regression: copies of a large aggregate (a struct holding a fixed array of 64
# structs that themselves hold fixed arrays, ~130 KB) through an optional and back
# must lower to llvm.memcpy, not first-class `load %T` / `store %T`. LLVM's
# SelectionDAG scalarizes first-class aggregate copies into tens of thousands of
# nodes and its CSE goes quadratic, so -O2 of such a copy took minutes.
module Big:
    public:
        struct Op:
            values: mutable f64[16]
            tag: mutable i64

        struct Stack:
            ops: mutable Op[16]
            count: mutable i64

        struct History:
            states: mutable Stack[64]
            cursor: mutable i64
            count: mutable i64

        def create(initial: Stack) -> History:
            mutable h: History = History{states: zeroed, cursor: 0, count: 1}
            h.states[0] <- initial
            return h

        def current(h: History&) -> Stack:
            return h.states[h.cursor]

        def push(h: mutable History&, s: Stack) -> void:
            c: i64 = h.cursor + 1
            h.states[c] <- s
            h.cursor <- c
            h.count <- h.count + 1

global mutable history: Big::History? = null

def make_stack(seed: i64) -> Big::Stack:
    mutable s: Big::Stack = Big::Stack{ops: zeroed, count: seed}
    s.ops[3].values[5] <- 1.5 * f64(seed)
    s.ops[3].tag <- seed
    return s

def step(seed: i64) -> void:
    if history is h:
        mutable hh: Big::History = h
        Big::push(&hh, make_stack(seed))
        history <- hh

def total() -> i64:
    if history is h:
        mutable sum: i64 = h.cursor * 1000 + h.count
        for i in 0..<64:
            s: Big::Stack = h.states[i]
            sum <- sum + s.count + s.ops[3].tag
        return sum
    -1

def main() -> i32:
    history <- Big::create(make_stack(7))
    step(11)
    step(13)
    if history is h:
        mutable copy: Big::History = h
        cur: Big::Stack = Big::current(&copy)
        return 1 if cur.count != 13
        return 2 if cur.ops[3].values[5] != 19.5
    else:
        return 3
    # cursor 2, count 3 (2003) + counts 7+11+13 + tags 7+11+13 (62).
    return 4 if total() != 2065
    0
