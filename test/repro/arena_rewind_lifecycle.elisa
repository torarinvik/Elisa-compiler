# Rewind retains a prefix, resets later regions, and permits tail-address reuse.
include "../../elisacore_std/arena.elisa"

module ArenaRewindRegression:
    private:
        const CAPACITY_SLOTS: usize = 8
        const ALLOCATION_SLOTS: usize = 4
        const LATER_SLOTS: usize = 12
        const FIRST_REGION: usize = 0
        const EMPTY_SLOTS: usize = 0
        const SUCCESS_STATUS: i64 = 0
        const FAILURE_STATUS: i64 = 1

    public:
        def run() -> i64:
            backing: mutable heap Region& = new_region_backend(CAPACITY_SLOTS, ARENA_STRATEGY_CHAINED)
            arena: mutable Arena = Arena{begin: backing, end: backing, end_index: FIRST_REGION, strategy: ARENA_STRATEGY_CHAINED}
            _ = arena_alloc(&arena, ALLOCATION_SLOTS * size_of(uintptr))
            mark: ArenaMark = arena_snapshot(&arena)
            discarded: mutable heap void& = arena_alloc(&arena, ALLOCATION_SLOTS * size_of(uintptr))
            discarded_address: uintptr = discarded.cast[uintptr]
            _ = arena_alloc(&arena, LATER_SLOTS * size_of(uintptr))
            assert arena.end != null
            later: heap Region& = arena.end
            arena_rewind(&arena, mark)
            rewind_correct: bool = backing.count == ALLOCATION_SLOTS and later.count == EMPTY_SLOTS and arena.end_index == FIRST_REGION
            replacement: mutable heap void& = arena_alloc(&arena, ALLOCATION_SLOTS * size_of(uintptr))
            correct: bool = rewind_correct and replacement.cast[uintptr] == discarded_address
            arena_rewind(&arena, ArenaMark{region: null, count: EMPTY_SLOTS})
            empty_correct: bool = backing.count == EMPTY_SLOTS and later.count == EMPTY_SLOTS
            arena_free(&arena)
            return SUCCESS_STATUS if correct and empty_correct else FAILURE_STATUS

def main() -> i64:
    return ArenaRewindRegression::run()
