# Each __aggregate_state row is one slot, even when owner/name repeat.
# A bare local defaults to [?, ?]; filtering must not collapse it to [?].
struct AggregateFilterPair[?, ?]:
    value: i32

const AGGREGATE_FILTER_VALUE: i32 = 42

def aggregate_filter_accept(value: AggregateFilterPair[?, ?]) -> i32:
    return value.value

def main() -> i64:
    pair: AggregateFilterPair = AggregateFilterPair{value: AGGREGATE_FILTER_VALUE}
    return aggregate_filter_accept(pair).i64()
