struct Player[state Alive | Dead]:
    health: mutable i64
    tag: i64
    derive state:
        Alive when self.health > 0
        Dead when self.health <= 0

def kill_both(player: mutable Player[Alive], choice: bool) -> Player[Dead]:
    if choice:
        player.health <- 0
    else:
        player.health <- -1
    return player{tag = 1}

def main() -> i32:
    first: Player[Alive] = Player[Alive]{health: 7, tag: 0}
    left: Player[Dead] = kill_both(first, true)
    right: Player[Dead] = kill_both(first, false)
    return 1 if left.health != 0 or right.health != -1
    return 2 if left.tag != 1 or right.tag != 1 or first.health != 7
    return 0
