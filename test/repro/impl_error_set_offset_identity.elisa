def push(value: i64) -> i64 error[Allowed]:
    return value

error Allowed:
    Good

error Extra:
    Bad

protocol Sink:
    def push(value: i64) -> i64 error[Allowed]

struct Log:
    tag: i64

impl Sink for Log:
#line 1 same-offset-impl.elisa
    def push(value: i64) -> i64 error[Extra]:
        return value

def main() -> i64:
    return 0
