# Regression: loop binders must shadow same-named locals in every semantic pass.
# Both stage0 and stage1 compile this and return 5.
#
#     for disks in 3..<5:
#         moves: mutable darray[i64] = []      # a container local
#     for moves in 1..<3:                      # a BINDER of the same name
#         take(moves)
#
#   argument 1 to "take" expects i64, got container
#
# The old stage1 diagnostic was:
#
# The fix scopes the flat, structural, and typestate channels in the firm
# argument checker and in the tuple/container-to-scalar checker. Range binders
# are recorded as i64, while container binders use their element TypeId.

include "../../elisacore_std/elisacore_runtime.elisa"

def take(value: i64) -> i64:
    return value

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        total: mutable i64 = 0
        for disks in 3..<5:
            moves: mutable darray[i64] = []
            moves.push(disks)
            total <- total + moves.count.i64()
        for moves in 1..<3:
            total <- total + take(moves)
        return total
