# REGRESSION, fixed 2026-08-31. stage0 compiles this and exits 5; before the
# scope fixes, stage1 rejected it with `argument 1 to "take" expects i64, got container`.
#
#     for disks in 3..<5:
#         moves: mutable darray[i64] = []      # a container local
#     for moves in 1..<3:                      # a BINDER of the same name
#         take(moves)
#
# The two affected semantic passes now scope their local channels. The firm
# argument pass also treats an unknown loop binder as a deliberate shadow so it
# cannot fall through to a stale structural type entry. Keep this case as an
# adversarial regression for both implementations.

include "../../elisacore_std/elisacore_runtime.elisa"

def take(value: i64) -> i64:
    return value

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        total: mutable i64 = 0
        for disks in 3..<5:
            moves: mutable darray[i64] = []
            moves.push(disks)
            total <- total + moves.count.i64()
        for moves in 1..<3:
            total <- total + take(moves)
        return total
