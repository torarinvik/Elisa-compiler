# OPEN BUG, stage1 only. stage0 compiles this and exits 5.
#
#     for disks in 3..<5:
#         moves: mutable darray[i64] = []      # a container local
#     for moves in 1..<3:                      # a BINDER of the same name
#         take(moves)
#
#   argument 1 to "take" expects i64, got container
#
# What is established, by measurement:
#
#   * The emitter is FirmArgTypeMismatch, from
#     semantic/check_firm_arg_type_mismatch.elisa. Confirmed by marking each
#     candidate renderer and reseeding -- three of them render this same
#     sentence, so grep alone does not tell you which.
#   * That walker keeps a flat name/type stack with NO scoping at all: a
#     VarDecl pushes and nothing ever pops, and its `Stmt.For` arm does not
#     register the loop binders.
#   * `infer_expression_type` reads the flat channel first and falls through to
#     the structural id table whenever the flat answer is Unknown.
#   * A CAPTURE LIST hides it: `for moves in 1..<3 |total|:` compiles. That is
#     why nw-core did not hit this for twenty task ports -- almost every loop
#     there carries captures -- and why it first showed up in a sweep.
#   * `close_type_scope` in semantic/resolve_types.elisa truncates BOTH the
#     flat and the structural channel to the FLAT stack's mark, on a comment
#     claiming they move in lockstep. They do not: eighty-four
#     note_local_type calls against eight note_local_type_id*. That is a
#     separate latent defect found on the way, not this one.
#
# What is NOT established: the fix. Adding scoping to the firm walker and
# registering the binders there does not change the message -- not even when
# the binder is registered with a concrete `i64`, which should short-circuit
# `infer_expression_type` before the structural fallback is ever reached. So
# the push is not landing where that lookup reads, and the reason is still
# unknown. Reverted rather than shipped: a compiler change that cannot be shown
# to fix anything is not worth the risk to the sixty-six suites that depend on
# this compiler.
#
# Worked around in nw-core by not naming a loop binder after a container local
# (test/hanoi_sweep.elisa).

include "../../elisacore_std/elisacore_runtime.elisa"

def take(value: i64) -> i64:
    return value

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        total: mutable i64 = 0
        for disks in 3..<5:
            moves: mutable darray[i64] = []
            moves.push(disks)
            total <- total + moves.count.i64()
        for moves in 1..<3:
            total <- total + take(moves)
        return total
