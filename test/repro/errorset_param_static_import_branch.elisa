# An inactive import with the same name must not make the active imported
# errorset-generic callable ambiguous during ErrorSet parameter inference.
module InactiveProvider:
    public:
        def wrap[errorset R]() -> i64 error[R]:
            return 1

module ActiveProvider:
    public:
        def wrap[errorset S]() -> i64 error[S]:
            return 2

const USE_INACTIVE_PROVIDER: bool = false

static if USE_INACTIVE_PROVIDER:
    from InactiveProvider import wrap
static else:
    from ActiveProvider import wrap

module Consumer:
    def caller() -> i64:
        return wrap()

def main() -> i64:
    return 0
