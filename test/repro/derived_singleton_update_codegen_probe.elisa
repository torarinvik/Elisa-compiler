struct Positive[state Valid]:
    value: i64
    tag: i64
    derive state:
        Valid when self.value > 0

def retag(player: Positive[Valid], tag: i64) -> Positive[Valid]:
    return player{tag = tag}

def replace(player: Positive[Valid]) -> Positive[Valid]:
    return player{value = 7}

def main() -> i32:
    original: Positive[Valid] = Positive[Valid]{value: 1, tag: 2}
    tagged: Positive[Valid] = retag(original, 4)
    replaced: Positive[Valid] = replace(original)
    return 1 if tagged.value != 1 or tagged.tag != 4
    return 2 if replaced.value != 7 or replaced.tag != 2
    return 3 if original.value != 1 or original.tag != 2
    return 0
