# A module-qualified pointer-sized constant must keep its declared wasm32 width
# when a postfix scalar cast widens it to the surrounding i64 expression.

module UiCore:
    public:
        const MAX_TEXT_BYTES: usize = 1024

def guest_start(value: u32) -> void:
    count: mutable i64 = value.i64()
    if count > UiCore::MAX_TEXT_BYTES.i64():
        pass

export fn start(value: u32) -> void = guest_start
