struct Point:
    x: i64
    label: sview

struct Catalog:
    values: dict[cstr, Point]

def roundtrip(values: dict[cstr, Point]) -> dict[cstr, Point]:
    return values

def roundtrip_catalog(catalog: Catalog) -> Catalog:
    return catalog

export pymodule dict_struct_values:
    fn roundtrip
    fn roundtrip_catalog
