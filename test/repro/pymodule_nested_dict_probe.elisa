struct NestedPayload:
    values: dict[i64, dict[cstr, i64]]

def roundtrip(values: dict[i64, dict[i64, i64]]) -> dict[i64, dict[i64, i64]]:
    return values

def roundtrip_struct(value: NestedPayload) -> NestedPayload:
    return value

def roundtrip_text(values: dict[cstr, dict[i64, cstr]]) -> dict[cstr, dict[i64, cstr]]:
    return values

def roundtrip_lists(values: dict[i64, dict[cstr, darray[i64]]]) -> dict[i64, dict[cstr, darray[i64]]]:
    return values

def roundtrip_optional(values: dict[i64, dict[cstr, i64?]]) -> dict[i64, dict[cstr, i64?]]:
    return values

def roundtrip_objects(values: dict[i64, dict[cstr, py::Object]]) -> dict[i64, dict[cstr, py::Object]]:
    return values

export pymodule nested_dict_probe:
    fn roundtrip
    fn roundtrip_struct
    fn roundtrip_text
    fn roundtrip_lists
    fn roundtrip_optional
    fn roundtrip_objects
