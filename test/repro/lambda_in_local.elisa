# A lambda stored in a LOCAL, rather than passed straight to a call.
#
# The `__lambda_param` rows the parser records are keyed only by LINE, and
# `lambda_expression` records them for a VALUE lambda as well as for a fn TYPE. On
#     shift: fn(i64) -> i64 = fn(n: i64) => n + bump
# the line therefore carried TWO rows, the annotation's Fn type came out with arity 2, and
# emit_lambda_value's arity guard declined every lambda in this position — even one that
# captures nothing. Passing the same lambda directly as an argument always worked, because
# there the expected type comes from the callee's own declaration line.
#
# All four positions are here so a fix to one cannot silently break another.
def apply(f: fn(i64) -> i64, n: i64) -> i64:
    return f(n)


def add_ten(n: i64) -> i64:
    return n + 10


def main() -> i64:
    bump: i64 = 5
    capturing: fn(i64) -> i64 = fn(n: i64) => n + bump
    plain: fn(i64) -> i64 = fn(n: i64) => n + 1
    named: fn(i64) -> i64 = add_ten
    total: i64 = apply(capturing, 10) + apply(plain, 5) + apply(named, 5)
    # (10+5) + (5+1) + (5+10) = 15 + 6 + 15 = 36, plus the direct form's 6.
    return total + apply(fn(n: i64) => n + bump, 1)
