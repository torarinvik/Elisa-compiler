include "../../src/semantic/semantic.elisa"

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    source: u8& = "module Left:\n    affine struct File[state Closed | Open]:\n        handle: i64\n        transitions:\n            Closed -> Open\n    type Owned = File[Closed]\n    type Borrowed = Owned&\nmodule Right:\n    affine struct File[state Closed | Open]:\n        handle: i64\n        transitions:\n            Open -> Closed\nstruct Plain[state Closed | Open]:\n    handle: i64\nlinear struct Strict[state Closed | Open]:\n    handle: i64\ndef inspect(owned: Left::Owned, borrowed: Left::Borrowed, ref: Left::File[Closed]&, linear: lmut Left::File[Closed], value: mutable Left::File[Closed], right: Right::File[Closed], plain: Plain[Closed], strict: Strict[Closed]) -> void:\n    pass\n"
    tokens: darray[Lexer::Token] = frontend_tokenize(source, source)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    return 1 if file.errors.count != 0
    table: Semantic::SymbolTable = Semantic::check(&file)
    return 2 if table.binding_declared_types.count != 8 or table.resolved_state_families.count != 4
    left: Semantic::DeclId = table.resolved_state_families[0].declaration_id
    right: Semantic::DeclId = table.resolved_state_families[1].declaration_id
    for source_state in 0..<2:
        for target_state in 0..<2:
            return 3 if Semantic::protocol_state_edge_allowed(&table, left, source_state.u32(), target_state.u32()) != (source_state == target_state or (source_state == 0 and target_state == 1))
            return 4 if Semantic::protocol_state_edge_allowed(&table, right, source_state.u32(), target_state.u32()) != (source_state == target_state or (source_state == 1 and target_state == 0))
    for index in 0..<table.binding_declared_types.count:
        row: Semantic::BindingDeclaredType = table.binding_declared_types[index]
        expected: bool = index == 0 or index == 4 or index == 5 or index == 7
        return 5 if Semantic::protocol_binding_owned_type(&table, row.binding_id) != expected
    return 6 if Semantic::protocol_state_edge_allowed(&table, left, 0, 4294967295) or Semantic::protocol_state_edge_allowed(&table, Semantic::DeclId{value: 4294967295}, 0, 0)
    duplicate_family: Semantic::SymbolTable = table{resolved_state_families = [table.resolved_state_families[0], table.resolved_state_families[0]]}
    return 7 if Semantic::protocol_state_edge_allowed(&duplicate_family, left, 0, 0)
    bad_family: Semantic::SymbolTable = table{resolved_state_families = [Semantic::ResolvedStateFamily{declaration_id: left, source_index: 4294967295}]}
    return 8 if Semantic::protocol_state_edge_allowed(&bad_family, left, 0, 0)
    wrong_edge: Semantic::SymbolTable = table{resolved_state_edges = [Semantic::ResolvedStateEdge{declaration_id: left, source_index: 1}]}
    return 9 if Semantic::protocol_state_edge_allowed(&wrong_edge, left, 0, 0)
    bad_edge: Semantic::SymbolTable = table{resolved_state_edges = [Semantic::ResolvedStateEdge{declaration_id: left, source_index: 4294967295}]}
    return 10 if Semantic::protocol_state_edge_allowed(&bad_edge, left, 0, 0)
    missing_edge: Semantic::SymbolTable = table{resolved_state_edges = []}
    return 11 if Semantic::protocol_state_edge_allowed(&missing_edge, left, 0, 0)
    duplicate_edge: Semantic::SymbolTable = table{resolved_state_edges = [table.resolved_state_edges[0], table.resolved_state_edges[0]]}
    return 12 if Semantic::protocol_state_edge_allowed(&duplicate_edge, left, 0, 0)
    family: Ast::StateFamily = table.state_family_declarations[0]
    derived: Semantic::SymbolTable = table{state_family_declarations = [family{has_derive = true}]}
    return 13 if Semantic::protocol_state_edge_allowed(&derived, left, 0, 0) or Semantic::protocol_binding_owned_type(&derived, table.binding_declared_types[0].binding_id)
    duplicate_states: Semantic::SymbolTable = table{state_family_declarations = [family{states = [family.states[0], family.states[0]]}]}
    return 14 if Semantic::protocol_state_edge_allowed(&duplicate_states, left, 0, 0)
    row: Semantic::BindingDeclaredType = table.binding_declared_types[0]
    duplicate_binding: Semantic::SymbolTable = table{binding_declared_types = [row, row]}
    return 15 if Semantic::protocol_binding_owned_type(&duplicate_binding, row.binding_id)
    mismatched: Semantic::BindingCapabilities = row.capabilities{declaration_id = right}
    wrong_type: Semantic::SymbolTable = table{binding_declared_types = [row{capabilities = mismatched}]}
    return 16 if Semantic::protocol_binding_owned_type(&wrong_type, row.binding_id)
    invalid_state: Semantic::BindingStateIdentity = row.state_identity{state_index = 4294967295}
    wrong_state: Semantic::SymbolTable = table{binding_declared_types = [row{state_identity = invalid_state}]}
    return 17 if Semantic::protocol_binding_owned_type(&wrong_state, row.binding_id)
    edge: Ast::StateTransitionEdge = table.state_transition_declarations[0]
    bad_endpoint: Semantic::SymbolTable = table{state_transition_declarations = [edge{target_state = "Missing"}]}
    return 18 if Semantic::protocol_state_edge_allowed(&bad_endpoint, left, 0, 0)
    repeated_declaration: Semantic::SymbolTable = table{state_transition_declarations = [edge, edge], resolved_state_edges = [Semantic::ResolvedStateEdge{declaration_id: left, source_index: 0}, Semantic::ResolvedStateEdge{declaration_id: left, source_index: 1}]}
    return 19 if Semantic::protocol_state_edge_allowed(&repeated_declaration, left, 0, 0)
    detached: Semantic::SymbolTable = table{state_family_declarations = [family{pos = Ast::pos_at_line(0)}]}
    return 20 if Semantic::protocol_state_edge_allowed(&detached, left, 0, 0)
    return 0
