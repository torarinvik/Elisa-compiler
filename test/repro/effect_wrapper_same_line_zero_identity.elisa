# Same logical line, distinct declaration offsets: wrapper and permission markers must not
# make neighboring declarations inherit each other's effect classification.
#line 0 effect-wrapper-owner.elisa
def concrete_wrapper(callback: fn() -> void can[Console.Write]) -> void:
    callback()

#line 0 effect-wrapper-owner.elisa
def permission_wrapper[permission P](callback: fn() -> void can[P]) -> void:
    can[P]:
        callback()

#line 0 effect-wrapper-owner.elisa
def plain_callback(callback: fn() -> void) -> void:
    callback()

module First:
    def mixed_name(callback: fn() -> void can[Console.Write]) -> void:
        callback()

module Second:
    def mixed_name(value: i64) -> i64:
        return value
