# Generated structured-error payload declarations must not shadow user structs.
struct CollisionBadPayload:
    marker: i64

struct CollisionPayload:
    marker: i64

error Collision:
    Bad(code: i64, detail: i64)

def fail() -> i64 error[Collision]:
    raise Collision.Bad(1, 2)

export pymodule pyi_payload_collision:
    fn fail
