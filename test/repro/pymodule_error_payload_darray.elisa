# Aggregate error payloads stay useful at the Python boundary: list payloads become lists,
# byte payloads remain bytes, and structured variants use the same dict shape as scalar fields.
error ListPayloadError:
    Empty(items: darray[i64])

error BytesPayloadError:
    Empty(data: darray[u8])

error StructuredListPayloadError:
    Empty(items: darray[i64], label: sview)

def fail_list(values: darray[i64]) -> i64 error[ListPayloadError]:
    raise ListPayloadError.Empty(values)

def fail_constructed() -> i64 error[ListPayloadError]:
    values: mutable darray[i64] = [9, 10]
    raise ListPayloadError.Empty(values)

def fail_bytes(values: darray[u8]) -> i64 error[BytesPayloadError]:
    raise BytesPayloadError.Empty(values)

def fail_structured(values: darray[i64], label: sview) -> i64 error[StructuredListPayloadError]:
    raise StructuredListPayloadError.Empty(values, label)

export pymodule error_payload_darray:
    fn fail_list
    fn fail_constructed
    fn fail_bytes
    fn fail_structured
