include "../../src/semantic/semantic.elisa"

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    source: u8& = "struct File[state Valid]:\n    value: i64\n    derive state:\n        Valid when self.value > 0\nmodule Left:\n    struct File[state Valid]:\n        value: i64\n        derive state:\n            Valid when self.value > 0\nmodule Right:\n    struct File[state Valid]:\n        value: i64\n        derive state:\n            Valid when self.value < 0\nmodule Left::Deep:\n    struct File[state Valid]:\n        value: i64\n        derive state:\n            Valid when self.value == 0\n"
    tokens: darray[Lexer::Token] = frontend_tokenize(source, source)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    return 1 if file.errors.count != 0 or file.derived_state_rules.count != 4
    table: Semantic::SymbolTable = Semantic::collect_symbols(&file)
    return 2 if table.resolved_state_families.count != 4 or table.resolved_derived_state_rules.count != 4 or table.derived_state_declarations.count != 4
    for index in 0..<4:
        rule: Ast::DerivedStateRule = file.derived_state_rules[index]
        family: Ast::StateFamily = file.state_families[index]
        resolved: Semantic::ResolvedDerivedStateRule = table.resolved_derived_state_rules[index]
        return 3 if rule.owner != family.owner or rule.module_name != family.module_name or rule.declaration_line != family.declaration_line or rule.declaration_offset != family.pos.offset
        return 4 if resolved.source_index != index.u32() or resolved.declaration_id.value == 4294967295 or resolved.declaration_id.value != table.resolved_state_families[index].declaration_id.value
        for previous in 0..<index:
            return 5 if resolved.declaration_id.value == table.resolved_derived_state_rules[previous].declaration_id.value
    detached: Ast::File = file{top_decls = []}
    detached_table: Semantic::SymbolTable = Semantic::collect_symbols(&detached)
    return 6 if detached_table.resolved_derived_state_rules.count != 4
    for row in detached_table.resolved_derived_state_rules:
        return 7 if row.declaration_id.value != 4294967295
    corrupted: mutable Ast::File = file{derived_state_rules = [rule for rule in file.derived_state_rules]}
    original: Ast::DerivedStateRule = corrupted.derived_state_rules[1]
    corrupted.derived_state_rules[1] <- original{declaration_offset = 4294967295}
    corrupted_table: Semantic::SymbolTable = Semantic::collect_symbols(&corrupted)
    return 8 if corrupted_table.resolved_derived_state_rules[1].declaration_id.value != 4294967295
    return 9 if corrupted_table.resolved_derived_state_rules[0].declaration_id.value == 4294967295 or corrupted_table.resolved_derived_state_rules[2].declaration_id.value == 4294967295
    corrupted.derived_state_rules[1] <- original{module_name = "Right"}
    wrong_module: Semantic::SymbolTable = Semantic::collect_symbols(&corrupted)
    return 10 if wrong_module.resolved_derived_state_rules[1].declaration_id.value != 4294967295
    return 0
