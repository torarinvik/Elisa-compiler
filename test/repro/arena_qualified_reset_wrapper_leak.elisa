# A module-qualified reset wrapper must invalidate views owned by its Arena& argument.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"

module Storage:
    def reset_owner(owner: mutable Arena&) -> void:
        arena_reset(owner)

def main() -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release]:
    arena: mutable Arena = zeroed
    values: mutable darray[i64] @arena = [65]
    Storage::reset_owner(&arena)
    return values[0]
