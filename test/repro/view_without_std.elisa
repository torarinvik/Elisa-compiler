# Every `view[T]` USE declined unless elisacore_std/collections.elisa was in the unit, and the
# decline was SILENT: a non-`main` function whose body declines keeps its declaration, so the
# driver exited 0 and the program failed at LINK with `U _total`.
#
# The view fat pointer is `DynArrayView {data: void&?, len: usize}`, declared in the std.
# stage0 needs no source declaration for it; stage1 looked the layout up in the StructTable,
# found nothing without the std, and view_struct_type answered Unmodeled — so the View arm in
# the index emitter fell through and took the whole enclosing function with it.
#
# The original report blamed a `view[T]` PARAMETER. It is not parameter-specific: the LOCAL
# below declined identically, and both were already correct WITH the std included. Both
# spellings are kept here so that framing cannot come back.
#
# `DynArrayView` is now registered as a backend builtin when the name is absent — the same
# remedy `set[T]` needed, for the same reason. It must stay conditional: with the std in the
# unit that declaration is authoritative, and a second `DynArrayView` would be a distinct LLVM
# type no std function accepts.
#
# stage0 answers 21.
def total(v: view[i64]) -> i64:
    return v[0] + v[1]


def main() -> i64:
    xs: mutable darray[i64] = [3, 4]
    # Through a PARAMETER — the shape that was reported.
    via_parameter: i64 = total(xs[0:2])
    # Through a LOCAL — declined identically, which is what showed the diagnosis was wrong.
    ys: view[i64] = xs[0:2]
    via_local: i64 = ys[0] + ys[1]
    # 7 + 7 = 14
    return via_parameter + via_local + 7
