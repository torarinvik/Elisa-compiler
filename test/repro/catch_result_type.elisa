error E:
    X
    Y

struct S:
    value: i64

def fail() -> S error[E]:
    return S{value: 42}

def main() -> i64:
    source: S error[E] = fail()
    inline: i64 = catch fail():
        value:
            value.value
        E.X:
            1
        E.Y:
            2
    stored: i64 = catch source:
        value:
            value.value
        E.X:
            1
        E.Y:
            2
    return inline + stored
