module Outer:
    module Types:
        struct Slot:
            value: i64

        module Internal:
            type NestedBorrowedBase = sview

        type BorrowedBase = sview
        type PointerBase = mutable i64&
        type HandleBase = id[Slot]

    module Client:
        def invalid_view() -> i64:
            view: Types::BorrowedText = zeroed
            return 0

        def invalid_pointer() -> i64:
            pointer: Types::Pointer = zeroed
            return 0

        def invalid_nested_view() -> i64:
            nested_view: Types::NestedBorrowedText = zeroed
            return 0

        def invalid_handle() -> Types::SlotId:
            handle: Types::SlotId = zeroed
            return handle

extend Outer::Types:
    type BorrowedText = BorrowedBase
    type NestedBorrowedText = Internal::NestedBorrowedBase
    type Pointer = PointerBase
    type SlotId = HandleBase

def main() -> i64:
    return 42
