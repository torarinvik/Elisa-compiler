def equal(left: sview, right: sview) -> bool:
    return left == right

def unequal(left: sview, right: sview) -> bool:
    return left != right

def observe(value: sview, digit: i64, order: mutable i64&) -> sview:
    DECIMAL_BASE: i64 = 10
    order <- order * DECIMAL_BASE + digit
    return value

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    REPETITIONS: usize = 100000
    EXPECTED_ORDER: i64 = 12
    text: sview = "abcdef"
    same: sview = text
    prefix: sview = text[0:3]
    empty: sview = text[0:0]
    assert equal(text, same)
    assert equal(prefix, "abc")
    assert not equal(text, prefix)
    assert not equal("abc", "abd")
    assert equal(empty, "")
    assert unequal(text, prefix)
    assert not unequal(prefix, "abc")
    assert not unequal(empty, "")
    order: mutable i64 = 0
    assert observe(prefix, 1, order) == observe("abc", 2, order)
    assert order == EXPECTED_ORDER
    order <- 0
    assert observe(text, 1, order) != observe(prefix, 2, order)
    assert order == EXPECTED_ORDER
    iteration: mutable usize = 0
    while iteration < REPETITIONS |iteration|:
        assert equal(prefix, "abc") and unequal(text, prefix)
        iteration <- iteration + 1
    return 0
