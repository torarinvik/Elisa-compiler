module Owner:
    affine struct Lease[state Open | Closed]:
        value: u64
        transitions:
            Open -> Closed

    def open() -> Lease[Open]:
        return Lease[Open]{value: 41}

    struct Marker[state Fresh | Spent]:
        value: u8
        transitions:
            Fresh -> Spent

module Client:
    type MarkerPair = (marker: Owner::Marker[Fresh], count: i32)

    struct Holder:
        lease: mutable Owner::Lease[Open] = zeroed

    struct Bundle:
        marker: Owner::Marker[Fresh]

    struct Box[T]:
        value: T

    struct DeepBox[T]:
        box: Box[T]

    enum Packet:
        WithMarker(value: Owner::Marker[Fresh])
        Empty

    def consume(lease: Owner::Lease[Open]) -> i32:
        return 0

    def forge_zeroed_return() -> Owner::Lease[Open]:
        return zeroed

    def forge_zeroed_local() -> i32:
        lease: Owner::Lease[Open] = zeroed
        return 0

    def forge_zeroed_call() -> i32:
        return consume(zeroed)

    def forge_zeroed_assignment() -> i32:
        lease: mutable Owner::Lease[Open] = Owner::open()
        lease <- zeroed
        return 0

    def forge_zeroed_field_assignment() -> i32:
        holder: mutable Holder = Holder{lease: Owner::open()}
        holder.lease <- zeroed
        return 0

    def forge_zeroed_bundle() -> Bundle:
        return zeroed

    def forge_zeroed_array() -> Owner::Marker[Fresh][1]:
        return zeroed

    def forge_zeroed_explicit_array() -> array[Owner::Marker[Fresh], 1]:
        return zeroed

    def forge_zeroed_enum() -> Packet:
        return zeroed

    def forge_zeroed_generic_box() -> Box[Owner::Marker[Fresh]]:
        return zeroed

    def forge_zeroed_nested_generic_box() -> DeepBox[Owner::Marker[Fresh]]:
        return zeroed

    def forge_zeroed_dictionary_value() -> i32:
        values: dict[i32, Owner::Marker[Fresh]] = {1: zeroed}
        return 0

    def forge_zeroed_set_value() -> i32:
        values: set[Owner::Marker[Fresh]] = {zeroed}
        return 0

    def forge_zeroed_tuple_value() -> i32:
        values: (marker: Owner::Marker[Fresh], count: i32) = (zeroed, 0)
        return 0

    def forge_zeroed_tuple_alias_value() -> i32:
        values: MarkerPair = (zeroed, 0)
        return 0

global mutable forged_global: Owner::Marker[Fresh] = zeroed

def main() -> i32:
    return 0
