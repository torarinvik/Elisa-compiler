# A module alias declared in a nested namespace is visible from the root scope.
module AliasHome:
    module Provider:
        public:
            error Fault:
                Expected
                Missing
            extern load() -> i64 error[Fault]

    using Provider as Shared

extern aliased_family_load() -> i64 error[Shared::Fault]

def main() -> i64:
    catch Shared::load():
        value: 0
        AliasHome::Provider::Fault.Expected: 1
    catch aliased_family_load():
        value: 0
        AliasHome::Provider::Fault.Expected: 1
    return 0
