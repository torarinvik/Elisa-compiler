module Provider:
    public:
        error Fault:
            Available
            Busy

        def wrap_value_for_family[errorset R](value: i64 error[R]) -> i64 error[R]:
            return value

        def choose(value: i64) -> i64:
            return value

        def choose(value: bool) -> i64 error[Provider::Fault{Busy}]:
            raise Provider::Fault.Busy

def infallible_overload_is_empty_unit() -> i64 error[Provider::Fault{Available}]:
    return Provider::wrap_value_for_family(Provider::choose(1))

def fallible_overload_family_is_preserved() -> i64 error[Provider::Fault{Available}]:
    return Provider::wrap_value_for_family(Provider::choose(true))

def fallible_overload_matching_subset_is_accepted() -> i64 error[Provider::Fault{Busy}]:
    return Provider::wrap_value_for_family(Provider::choose(true))

def main() -> i64:
    return 0

module PairProvider:
    public:
        error Fault:
            Available
            Busy

        def wrap_value_for_family[errorset R](value: i64 error[R]) -> i64 error[R]:
            return value

        def choose_pair[T](value: T, marker: bool) -> i64 error[PairProvider::Fault{Busy}]:
            raise PairProvider::Fault.Busy

        def choose_pair(value: i64, marker: i64) -> i64 error[PairProvider::Fault{Available}]:
            raise PairProvider::Fault.Available

def first_argument_controls_overload() -> i64 error[PairProvider::Fault{Busy}]:
    # Core ranks a qualified non-primary concrete candidate from argument 0, then rejects argument 2.
    return PairProvider::wrap_value_for_family(PairProvider::choose_pair(1, true))
