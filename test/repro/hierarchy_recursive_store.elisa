enum Widget:
    pass

enum Container is Widget:
    Panel(first_child: Widget, next_sibling: Widget)

enum Control is Widget:
    Label(text: sview)

enum Button is Control:
    Push(label: sview)

def count_widgets(w: Widget) -> i64:
    match w:
        Container.Panel(first_child, next_sibling):
            return 1 + count_widgets(first_child) + count_widgets(next_sibling)
        Control.Label(text):
            return 1
        Button.Push(label):
            return 1

def build() -> Widget:
    leaf: Widget = Button.Push(label: "ok")
    lab: Widget = Control.Label(text: "hi")
    return Container.Panel(first_child: leaf, next_sibling: lab)

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        root: Widget = build()
        return count_widgets(root) - 3
