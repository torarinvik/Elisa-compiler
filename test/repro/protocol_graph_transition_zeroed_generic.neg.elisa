module Owner:
    affine struct Lease[state Open | Closed]:
        value: u64
        transitions:
            Open -> Closed

def erase_state_type[T]() -> T:
    return zeroed

def forge_through_generic() -> Owner::Lease[Open]:
    return erase_state_type[Owner::Lease[Open]]()

def main() -> i32:
