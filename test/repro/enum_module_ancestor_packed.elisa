module Right:
    packed enum Message:
        Some(left: i64, right: i64)
module Outer:
    module Right:
        packed enum Message:
            Empty(other: i64)
            Some(value: i64)
    module Worker:
        def answer(owner: Arena) -> i64:
            store: Right::Message.Store[Local] = Right::Message.Store(owner)
            result: mutable i64 = 0
            in store:
                message: Right::Message = new Right::Message.Some(value: 42)
                result <- match message:
                    Right::Message.Some(value): value
                    Right::Message.Empty(value): value
            return result
def main() -> i64:
    region r(4096):
        return Outer::Worker::answer(r)
