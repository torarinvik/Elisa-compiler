# Optional scalar probe for native Python-boundary ABI.
def maybe_int(value: i64?) -> i64?:
    return value

def maybe_float(value: f64?) -> f64?:
    return value

def maybe_bool(value: bool?) -> bool?:
    return value

def maybe_i8(value: i8?) -> i8?:
    return value

def maybe_u8(value: u8?) -> u8?:
    return value

def maybe_i32(value: i32?) -> i32?:
    return value

def maybe_f32(value: f32?) -> f32?:
    return value

export pymodule optional_scalar:
    fn maybe_int
    fn maybe_float
    fn maybe_bool
    fn maybe_i8
    fn maybe_u8
    fn maybe_i32
    fn maybe_f32
