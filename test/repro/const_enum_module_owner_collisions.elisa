# Identical bare enum and alias names in two modules must retain distinct owners.
module North:
    const enum Code of i64:
        Zero = 0
        Seven = 7

    type Token = Code

    def same_bare_owner(value: Code) -> bool:
        return value == Code.Seven

    def same_alias_owner(value: Token) -> bool:
        return value == Token.Seven

module South:
    const enum Code of i64:
        Zero = 0
        Seven = 7

    type Token = Code

def cross_module_bare_owner(value: North::Code) -> bool:
    return value == South::Code.Zero

def cross_module_alias_owner(value: North::Token) -> bool:
    return value == South::Token.Zero

def cross_module_local_owner() -> bool:
    value: North::Code = North::Code.Seven
    return value == South::Code.Zero

def cross_module_local_alias() -> bool:
    value: North::Token = North::Token.Seven
    return value == South::Token.Zero

def main() -> i64:
    return 0 if North::same_bare_owner(North::Code.Seven) and North::same_alias_owner(North::Token.Seven) else 1
