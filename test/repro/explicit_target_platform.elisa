static if ELISA_TARGET_OS_MACOS:
    extern selected_macos_branch() -> i64
    def selected_platform() -> i64:
        return selected_macos_branch()
static elif ELISA_TARGET_OS_LINUX:
    extern selected_linux_branch() -> i64
    def selected_platform() -> i64:
        return selected_linux_branch()
static elif ELISA_TARGET_OS_WINDOWS:
    extern selected_windows_branch() -> i64
    def selected_platform() -> i64:
        return selected_windows_branch()
static elif ELISA_TARGET_OS_FREEBSD:
    extern selected_freebsd_branch() -> i64
    def selected_platform() -> i64:
        return selected_freebsd_branch()
static elif ELISA_TARGET_OS_WASI:
    extern selected_wasi_branch() -> i64
    def selected_platform() -> i64:
        return selected_wasi_branch()
static else:
    extern selected_unknown_branch() -> i64
    def selected_platform() -> i64:
        return selected_unknown_branch()

static if ELISA_TARGET_ARCH_X86_64:
    extern selected_x86_64_arch() -> i64
    def selected_architecture() -> i64:
        return selected_x86_64_arch()
static elif ELISA_TARGET_ARCH_ARM64:
    extern selected_arm64_arch() -> i64
    def selected_architecture() -> i64:
        return selected_arm64_arch()
static elif ELISA_TARGET_ARCH_WASM32:
    extern selected_wasm32_arch() -> i64
    def selected_architecture() -> i64:
        return selected_wasm32_arch()
static elif ELISA_TARGET_ARCH_WASM64:
    extern selected_wasm64_arch() -> i64
    def selected_architecture() -> i64:
        return selected_wasm64_arch()
static else:
    extern selected_unknown_arch() -> i64
    def selected_architecture() -> i64:
        return selected_unknown_arch()

# Independent flags catch a second active OS hidden by an elif chain.
static if PLATFORM_LINUX:
    extern independent_linux_flag() -> i64
    def check_linux_flag() -> i64:
        return independent_linux_flag()
static if PLATFORM_APPLE:
    extern independent_macos_flag() -> i64
    def check_macos_flag() -> i64:
        return independent_macos_flag()
static if PLATFORM_WINDOWS:
    extern independent_windows_flag() -> i64
    def check_windows_flag() -> i64:
        return independent_windows_flag()
static if PLATFORM_FREEBSD:
    extern independent_freebsd_flag() -> i64
    def check_freebsd_flag() -> i64:
        return independent_freebsd_flag()

def main() -> i64:
    return selected_platform() + selected_architecture()
