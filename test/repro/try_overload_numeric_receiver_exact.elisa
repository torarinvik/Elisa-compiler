# Typed numeric receivers must match Core's exact/directional assignability rules.
# Stage1 must not treat every integer/float pair as a viable receiver overload.
module First:
    public:
        error Fault:
            Integer

module Second:
    public:
        error Fault:
            Float

module API:
    def choose(value: i64) -> i64 error[First::Fault]:
        return 1

    def choose(value: f64) -> i64 error[Second::Fault]:
        return 2

    def matching_integer(value: i64) -> i64 error[First::Fault]:
        return try choose(value)

    def mismatched_integer(value: i64) -> i64 error[Second::Fault]:
        return try choose(value)

    def matching_float(value: f64) -> i64 error[Second::Fault]:
        return try choose(value)

    def mismatched_float(value: f64) -> i64 error[First::Fault]:
        return try choose(value)

def main() -> i64:
    return 0
