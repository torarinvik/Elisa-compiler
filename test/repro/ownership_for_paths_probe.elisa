include "../../src/semantic/semantic.elisa"

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    source: u8& = "affine struct File[state Closed | Open]:\n    handle: i64\ndef empty(owner: File[Closed]) -> void:\n    for item in 0..<0:\n        _ = move owner\n    _ = move owner\ndef once(owner: File[Closed]) -> void:\n    for item in 0..<1:\n        _ = move owner\n    _ = move owner\ndef repeating(owner: File[Closed]) -> void:\n    for item in 0..<3:\n        _ = move owner\n    _ = move owner\ndef returning(owner: File[Closed], count: i64) -> void:\n    for item in 0..<count:\n        _ = move owner\n        return\n    _ = move owner\ndef shadow(owner: File[Closed], items: darray[i64]) -> void:\n    for owner in items:\n        _ = move owner\n    _ = move owner\ndef paired(owner: File[Closed], items: darray[i64]) -> void:\n    for item, index in items:\n        _ = move item\n        _ = move index\n    _ = move owner\n"
    tokens: darray[Lexer::Token] = frontend_tokenize(source, source)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    return 1 if file.errors.count != 0
    table: Semantic::SymbolTable = Semantic::check(&file)
    return 2 if table.ownership_function_flows.count != 6
    moves: mutable usize = 0
    once_moves: mutable usize = 0
    shadow_serial: mutable u64 = 0
    for occurrence in table.ownership_occurrences |moves, once_moves, shadow_serial|:
        continue if not occurrence.is_move
        return 3 if not occurrence.known
        name: sview = table.symbols[occurrence.binding_id.owner.value.usize()].name
        if name == "repeating":
            return 4 if occurrence.liveness_available
        elif name == "once":
            return 5 if occurrence.liveness_available != (once_moves == 0)
            once_moves <- once_moves + 1
        else:
            return 6 if not occurrence.liveness_available
        if name == "shadow":
            return 7 if shadow_serial != 0 and shadow_serial == occurrence.binding_id.serial
            shadow_serial <- occurrence.binding_id.serial
        moves <- moves + 1
    return 8 if moves != 12 or once_moves != 2
    for summary in table.ownership_function_flows:
        return 9 if not summary.coverage_complete or not summary.fallthrough_reachable
        name: sview = table.symbols[summary.owner.value.usize()].name
        expected: usize = 2 if name == "returning" or name == "shadow" or name == "paired" else 1
        return 10 if summary.facts_count != expected
    return 0
