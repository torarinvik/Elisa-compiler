# A concrete overload beats a generic overload for an i64 argument. The discarded-call
# checker must identify the same target, including through a `using` module alias.
module Provider:
    public:
        error Fault:
            Bad

        def consume[T](value: T) -> i64:
            return 0

        def consume(value: i64) -> i64 error[Fault]:
            raise Fault.Bad

using Provider as P

def discard_direct(value: i64):
    _ = Provider::consume(value)

def discard_aliased(value: i64):
    _ = P::consume(value)

# Core's free-call receiver rewrite ranks only argument zero. The int literal matches
# both concrete integer receivers at the same rank, so these module overloads remain
# tied despite differing in a later generic parameter.
module LaterProvider:
    public:
        error LaterFault:
            Bad

        def later_specificity[T](receiver: i32, value: T) -> i64:
            return 0

        def later_specificity(receiver: i64, value: i64) -> i64 error[LaterFault]:
            raise LaterFault.Bad

from LaterProvider import later_specificity

def discard_later_tie(receiver: i64, value: i64):
    _ = later_specificity(1, value)

def main() -> i64:
    return 0
