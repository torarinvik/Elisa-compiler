struct FrameCounter:
    value: mutable i64

def false_framed_result(counter: mutable FrameCounter&) -> i64:
    changes counter.value
    ensure result == 0
    counter.value <- 1
    return counter.value

def main() -> i64:
    counter: mutable FrameCounter = FrameCounter{value: 0}
    return false_framed_result(&counter)
