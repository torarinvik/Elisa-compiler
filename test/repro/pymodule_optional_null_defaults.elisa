struct OptionalDefaults:
    signed: i64? = null
    ratio: f64? = null
    enabled: bool? = null
    label: cstr? = null
    text: sview? = null
    payload: py::Object? = null

def roundtrip(options: OptionalDefaults) -> OptionalDefaults:
    return options

def defaulted(options: OptionalDefaults = OptionalDefaults{}) -> OptionalDefaults:
    return options

def scalar_default(value: i64? = null) -> i64?:
    return value

export pymodule optional_null_defaults:
    fn roundtrip
    fn defaulted
    fn scalar_default
