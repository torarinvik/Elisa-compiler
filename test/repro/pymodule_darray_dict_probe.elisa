# Lists of mappings are a natural Python shape for tabular/configuration APIs.
struct Row:
    value: i64

def roundtrip(values: darray[dict[i64, i64]]) -> darray[dict[i64, i64]]:
    return values

def roundtrip_rows(values: darray[dict[i64, Row]]) -> darray[dict[i64, Row]]:
    return values

def roundtrip_nested(values: darray[dict[i64, dict[cstr, i64]]]) -> darray[dict[i64, dict[cstr, i64]]]:
    return values

def count(values: darray[dict[i64, i64]]) -> i64:
    return values[0.usize()].count.i64()

export pymodule darray_dict_probe:
    fn roundtrip
    fn roundtrip_rows
    fn roundtrip_nested
    fn count
