include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/heap.elisa"

struct Cell:
    value: i64

def bad() -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release]:
    region scratch(4096):
        pool: mutable RegionPool[Cell] = region_pool_new((&scratch).cast[mutable Arena&])
        handle: Pooled[Cell] = pool.acquire()
        handle.ptr[0] <- Cell{value: 65}
        ptr: mutable heap i64& = &handle.ptr.value
        pool.release(move handle)
        return ptr[0]

def main() -> i64:
    return 0
