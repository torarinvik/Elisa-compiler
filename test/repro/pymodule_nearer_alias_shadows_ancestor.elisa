module Outer:
    module Mode:
        public:
            const enum Kind of i64:
                High = 11

    module Inner:
        module Actual:
            public:
                const enum Kind of i64:
                    High = 73

        using Actual as Mode

        def nearer_alias_wins(value: i64 = Mode::Kind.High) -> i64:
            return value

export pymodule nearer_alias_shadows_ancestor:
    fn nearer_alias_wins = Outer::Inner::nearer_alias_wins
