# The three selected payload slots make this error status too large for return registers.
error WideError:
    First(value: i64)
    Second(value: i64)
    Third(value: i64)

extern external_probe(code: i64) -> i64 error[WideError]

def main() -> i64:
    return catch external_probe(0):
        value: value
        WideError.First(first): first
        WideError.Second(second): second
        WideError.Third(third): third
