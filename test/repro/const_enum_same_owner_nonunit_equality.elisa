const enum OwnerA of i64:
    Zero = 0
    Seven = 7

def same_owner_equal(value: OwnerA) -> bool:
    return value == OwnerA.Seven

def same_owner_not_equal(value: OwnerA) -> bool:
    return value != OwnerA.Seven

def main() -> i64:
    return 0 if same_owner_equal(OwnerA.Seven) and not same_owner_equal(OwnerA.Zero) and same_owner_not_equal(OwnerA.Zero) else 1
