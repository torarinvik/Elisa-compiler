module Provider:
    public:
        error Fault:
            Available

        def get_available() -> i64 error[Provider::Fault.Available]:
            raise Provider::Fault.Available

        def wrap[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
            return try callback()

module Peer:
    public:
        error Fault:
            Available

module Other:
    public:
        error Fault:
            Available

def unique_short_name_is_accepted() -> i64 error[Peer::Fault]:
    return Provider::wrap(Provider::get_available)

def duplicate_short_name_is_ambiguous() -> i64 error[Peer::Fault, Other::Fault]:
    return Provider::wrap(Provider::get_available)

def main() -> i64:
    return 0
