# Read protocol_graph_codegen_probe.elisa on stdin. Exercise the actual parser
# and the semantic view copy, not source-text searches or sentinel annotations.
include "../../src/semantic/semantic.elisa"

extern read(fd: int, buf: void&, count: usize) -> isize can[Console]

def main() -> i32 can[Console, Memory.Allocate, Abort.Panic]:
    source: mutable darray[u8] = []
    chunk: mutable darray[u8] = [0 for _ in 0..<4096]
    while true |source, chunk|:
        length: isize = read(0, (&chunk[0]).cast[void&], chunk.count) can Console
        break if length <= 0
        for index in 0..<length.usize() |source, chunk, index|:
            source.push(chunk[index])
    source.push(0)
    tokens: darray[Lexer::Token] = frontend_tokenize_with_length(&source[0], &source[0], source.count - 1)
    file: Ast::File = frontend_parser_parse_file(&source[0], tokens)
    return 1 if file.errors.count != 0
    return 2 if file.state_families.count != 1 or file.state_transition_edges.count != 2
    family: Ast::StateFamily = file.state_families[0]
    return 3 if family.owner != "ProtocolHandle" or family.module_name != "" or family.has_derive
    return 4 if family.states.count != 2 or family.states[0] != "Closed" or family.states[1] != "Open" or family.affinity != "affine"
    first: Ast::StateTransitionEdge = file.state_transition_edges[0]
    second: Ast::StateTransitionEdge = file.state_transition_edges[1]
    return 5 if first.declaration_line != family.declaration_line or second.declaration_line != family.declaration_line
    return 6 if first.source_state != "Closed" or first.target_state != "Open" or second.source_state != "Open" or second.target_state != "Closed"
    return 7 if file.top_decls.count != 5
    view: Ast::File = Semantic::semantic_loop_view(&file)
    return 8 if view.state_families.count != 1 or view.state_transition_edges.count != 2
    other_source: u8& = "module Left:\n    affine struct File[state Closed | Open]:\n        handle: i64\n        transitions:\n            Closed -> Open\nmodule Right:\n    affine struct File[state Closed | Open]:\n        handle: i64\n        transitions:\n            Open -> Closed\n"
    other_tokens: darray[Lexer::Token] = frontend_tokenize(other_source, other_source)
    other: Ast::File = frontend_parser_parse_file(other_source, other_tokens)
    return 9 if other.errors.count != 0 or other.state_families.count != 2 or other.state_transition_edges.count != 2
    return 10 if other.state_families[0].module_name != "Left" or other.state_families[1].module_name != "Right"
    return 11 if other.state_transition_edges[0].module_name != "Left" or other.state_transition_edges[1].module_name != "Right"
    return 12 if other.state_transition_edges[0].declaration_line == other.state_transition_edges[1].declaration_line
    return 0
