# Literal scalar defaults are preserved at the Python boundary.
const enum NarrowMode of i64:
    Large = 300

def scaled(base: i64, factor: i64 = 3, offset: i64 = 5) -> i64:
    return base * factor + offset

def enabled(flag: bool = false) -> bool:
    return flag

def ratio(value: f64, scale: f64 = 0.5f64) -> f64:
    return value * scale

def count_from(start: usize = 0.usize()) -> usize:
    return start

def u64_max(value: u64 = 18446744073709551615) -> u64:
    return value

def i64_min(value: i64 = -9223372036854775808) -> i64:
    return value

def narrowed_u8(value: u64 = 257.u8()) -> u64:
    return value

def narrowed_bytes(values: darray[u8] = [257.u8()]) -> darray[u8]:
    return values

def wrapping_u8(value: u8 = (-1).u8()) -> u8:
    return value

def enum_narrowing(value: u8 = NarrowMode.Large.u8()) -> u8:
    return value

def signed_alias_cast(value: i64 = 257.s8()) -> i64:
    return value

def char_code(value: char = 65) -> char:
    return value

def cstr_default(value: cstr = "hello") -> cstr:
    return value

def sview_default(value: sview = "α") -> sview:
    return value

def escaped_default(value: cstr = "line\nnext") -> cstr:
    return value

def empty_list(values: darray[i64] = []) -> usize:
    return values.count

def empty_bytes(values: darray[u8] = []) -> usize:
    return values.count

def empty_dict(values: dict[i64, i64] = {}) -> usize:
    return values.count

def empty_set(values: set[i64] = {}) -> usize:
    return values.count

def empty_view(values: view[i64] = []) -> usize:
    return values.len

def empty_mix(values: darray[i64] = [], mapping: dict[i64, i64] = {}, unique: set[i64] = {}) -> usize:
    return values.count + mapping.count + unique.count

export pymodule defaults:
    fn scaled
    fn enabled
    fn ratio
    fn count_from
    fn u64_max
    fn i64_min
    fn narrowed_u8
    fn narrowed_bytes
    fn wrapping_u8
    fn enum_narrowing
    fn signed_alias_cast
    fn char_code
    fn cstr_default
    fn sview_default
    fn escaped_default
    fn empty_list
    fn empty_bytes
    fn empty_dict
    fn empty_set
    fn empty_view
    fn empty_mix
