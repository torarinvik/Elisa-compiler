# A module's ordinary struct whose BARE NAME matches a generic template.
#
# stage0 compiles this and exits 7. stage1 declined every function in the unit:
#
#     error: backend emitted no functions for this unit; declined 2: hold, count_of
#
# Two separate bare-name tests, one after the other:
#
#   * register_struct_names skipped any struct whose name matched a generic
#     TEMPLATE -- correct for the template itself, wrong for a module's own
#     concrete struct that merely shares the name. So no row was created.
#   * set_struct_bodies_from_metadata then set a body for the template, and
#     since the template has no row of its own, struct_index_of fell through
#     its owner lookups to the bare-name scan and wrote the template's fields
#     onto WHOEVER else was called that.
#
# Both now consult the template's OWNER, which the parser records alongside its
# name the way it already records struct_owners.
#
# This is not a contrived collision: elisacore_runtime declares a generic
# `Task[T, S]`, so any `module X: struct Task` in a program that includes the
# std hit it -- which is how it was found.
#
# Exits 7 = Probe::Widget's own field, not the template's.

include "../../elisacore_std/elisacore_runtime.elisa"

struct Widget[T, S]:
    handle: T
    state: S

module Probe:
    struct Widget:
        count: mutable i64

    def hold() -> Widget:
        can Abort.Panic:
            return Widget{count: 7}

    def count_of(w: mutable Widget&) -> i64:
        can Abort.Panic:
            return w.count

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        total: mutable i64 = 0
        region w(1024 * 1024)
        in w:
            t: mutable Probe::Widget = Probe::hold()
            total <- Probe::count_of(&t)
        destroy w
        return total
