module M:
    struct S:
        private:
            v: u8
        public:
            w: u8
    def make() -> S:
        return S{v: 1, w: 2}
type T = M::S
def make_t() -> T:
    return M::make()
def viacall() -> u8:
    return make_t().v
def viaparam(t: T) -> u8:
    return t.v
def okpublic(t: T) -> u8:
    return t.w + make_t().w
def main() -> i32:
    return 0
