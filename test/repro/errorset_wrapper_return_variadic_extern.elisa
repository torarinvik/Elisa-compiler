# Core's receiver candidate set includes callable variadic externs. The i64
# overload wins for this call; EWR uses the fixed extern formal to keep the
# cstr sibling from lending its ErrorSet to the selected variadic extern.
module VariadicExternProvider:
    public:
        error SelectedFault:
            Selected

        error SiblingFault:
            Sibling

        extern choose(value: i64, ...) -> i64 error[VariadicExternProvider::SelectedFault]
        extern choose(value: cstr, marker: i64) -> i64 error[VariadicExternProvider::SiblingFault]

from VariadicExternProvider import choose

module Consumer:
    public:
        def positional_extra(value: i64, extra: i64) -> i64 error[VariadicExternProvider::SiblingFault] can[Unsafe.RawExtern]:
            return choose(value, extra)

def main() -> i64:
    return 0
