# nopath

struct Text:
    value: mutable cstr?

struct Bundle:
    texts: darray[cstr?]

def bad_field_write(raw: u8&?) -> i64:
    mutable item: Text = Text{value: null}
    item.value <- raw
    return 0

def bad_darray_literal(raw: u8&?) -> i64:
    values: darray[cstr?] = [raw]
    return 0

def bad_fixed_array_literal(raw: u8&?) -> i64:
    values: cstr?[1] = [raw]
    return 0

def bad_dict_literal(raw: u8&?) -> i64:
    values: dict[cstr, cstr?] = {"key": raw}
    return 0

def bad_set_literal(raw: u8&?) -> i64:
    members: set[cstr?] = {raw}
    return 0

def bad_tuple_literal(raw: u8&?) -> i64:
    pair: (first: cstr?, second: i64) = (raw, 0)
    return 0

def bad_darray_comprehension(raw: u8&?) -> i64:
    generated: darray[cstr?] = [raw for index in 0..<1]
    return 0

def bad_darray_element_write(raw: u8&?) -> i64:
    mutable values: darray[cstr?] = [null]
    values[0] <- raw
    return 0

def bad_darray_push(raw: u8&?) -> i64:
    mutable values: darray[cstr?] = [null]
    values.push(raw)
    return 0

def bad_nested_struct_in_container(raw: u8&?) -> i64:
    values: darray[Text] = [Text{value: raw}]
    return 0

def bad_record_update(raw: u8&?, item: Text) -> i64:
    updated: Text = item{value = raw}
    return 0

def bad_nested_container_field(raw: u8&?) -> i64:
    bundle: Bundle = Bundle{texts: [raw]}
    return 0

def bad_nullable_string_branch(raw: u8&?) -> i64:
    nullable: cstr? = raw if true else null
    return 0

def bad_nullable_string_match(raw: u8&?, choose: i64) -> i64:
    matched: cstr? =
        match choose:
            1:
                raw
            _:
                null
    return 0

def main() -> i64:
    return 0
