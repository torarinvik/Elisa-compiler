# docs/119 §3: a loop expression written INLINE as an `=` RHS, rather than as a
# block opened on the next line. stage0 accepted this spelling and stage1 did
# not, so the same source compiled under one compiler and not the other.
#
# Both spellings must work and must agree. Exits 17 = 9 (container form, the
# matching cell's value) + 8 (range form, 2^3).

struct Cell:
    pid: i64
    value: i64

def find(cells: darray[Cell], position: i64) -> i64:
    can Abort.Panic:
        miss: Cell = Cell{pid: -1, value: 0}
        found: Cell = for cell in cells |found=miss| -> found:
            found <- cell if cell.pid == position
        return found.value

def doubled_inline(n: i64) -> i64:
    can Abort.Panic:
        span: i64 = for _step in 0..<n |span=1| -> span:
            span <- span * 2
        return span

# The multi-line spelling of the same thing, which already worked -- kept so a
# fix to one form cannot regress the other.
def doubled_block(n: i64) -> i64:
    can Abort.Panic:
        span: i64 =
            for _step in 0..<n |span=1| -> span:
                span <- span * 2
        return span

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        result: mutable i64 = 0
        region work(1024 * 1024)
        in work:
            cells: mutable darray[Cell] = []
            cells.push(Cell{pid: 3, value: 7})
            cells.push(Cell{pid: 5, value: 9})
            result <- find(cells, 5)
        destroy work
        return -1 if doubled_inline(3) != doubled_block(3)
        return result + doubled_inline(3)
