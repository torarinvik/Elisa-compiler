error Fault:
    Available
    Busy

def available() -> i64 error[Fault{Available}]:
    return 1

def wrap[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
    return try callback()

def same() -> i64 error[Fault{Available}]:
    return wrap(available)

def full() -> i64 error[Fault]:
    return wrap(available)

def wrong() -> i64 error[Fault{Busy}]:
    return wrap(available)
