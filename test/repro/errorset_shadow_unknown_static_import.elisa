# An unresolved static import must not be treated as a proven ErrorSet shadow.
module UnknownErrorProvider:
    public:
        error Fault:
            Failed

module ActiveStructProvider:
    public:
        struct Fault:
            code: i64

static if UNRESOLVED_TARGET_FLAG:
    from UnknownErrorProvider import Fault
static else:
    from ActiveStructProvider import Fault

def forward[errorset Fault](callback: fn() -> i64 error[Fault]) -> i64 error[Fault]:
    return try callback()

def main() -> i64:
    return 0
