# The condition belongs to App even though the import is nested in App::Client.
# The Client-local shadow must not deactivate the selected provider import.
module App:
    const PICK_A: bool = true

    module ProviderA:
        public:
            error FaultA:
                A

            def origin() -> i64 error[App::ProviderA::FaultA{A}]:
                raise App::ProviderA::FaultA.A

            def wrap[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
                return try callback()

    static if PICK_A:
        module Client:
            const PICK_A: bool = false

            using ProviderA as Selected

            public:
                error ExpectedFault:
                    Expected

                def caller() -> i64 error[App::Client::ExpectedFault{Expected}]:
                    return Selected::wrap(Selected::origin())

def main() -> i64:
    return 0
