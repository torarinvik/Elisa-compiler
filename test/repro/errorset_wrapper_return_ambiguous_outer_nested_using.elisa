# Distinct inherited and nested wildcard candidates make the bare callback ambiguous.
# EWR must not select one family by import depth and add a propagation cascade.
module OuterApi:
    public:
        error OuterFault:
            Outer

        def origin() -> i64 error[OuterApi::OuterFault]:
            return 1

module Wrapper:
    public:
        def propagate[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
            return try callback()

module Consumer:
    public:
        error Destination:
            Other

    module Inner:
        module NestedApi:
            public:
                error NestedFault:
                    Nested

                def origin() -> i64 error[Consumer::Inner::NestedApi::NestedFault]:
                    return 2

        using NestedApi

        public:
            def caller() -> i64 error[Consumer::Destination]:
                return Wrapper::propagate(origin)

using OuterApi

def main() -> i64:
    return 0
