def statement_match(value: sview) -> i64:
    MATCHED: i64 = 1
    EMPTY: i64 = 2
    OTHER: i64 = 3
    match value:
        "abc":
            return MATCHED
        "":
            return EMPTY
        _:
            return OTHER

def alternative_match(value: sview) -> bool:
    match value:
        "a" | "abc":
            return true
        _:
            return false

def expression_match(value: sview) -> bool:
    return when value:
        "abc" -> true
        "" -> true
        _ -> false

def membership(value: sview) -> bool:
    return value in ["a", "abc", ""]

def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    MATCHED: i64 = 1
    EMPTY: i64 = 2
    OTHER: i64 = 3
    REPETITIONS: usize = 10000
    text: sview = "abcdef"
    prefix: sview = text[0:3]
    assert statement_match(prefix) == MATCHED
    assert statement_match("") == EMPTY
    assert statement_match(text) == OTHER
    assert alternative_match(prefix)
    assert alternative_match("a")
    assert not alternative_match("ab")
    assert expression_match(prefix)
    assert expression_match("")
    assert not expression_match("abd")
    assert membership(prefix)
    assert membership("")
    assert not membership(text)
    iteration: mutable usize = 0
    while iteration < REPETITIONS |iteration|:
        assert membership(prefix) and expression_match(prefix)
        iteration <- iteration + 1
    return 0
