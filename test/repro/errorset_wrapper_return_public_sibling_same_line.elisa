# The two overloads have the same logical line after #line, but their visibility
# belongs to each declaration. EWR must keep the public sibling selectable.
module Api:
    public:
        error Fault:
            Failed

    private:
#line 9 api-private-sibling.elisa
        def dispatch(value: i64) -> i64 error[Fault]:
            raise Fault.Failed if value > 0
            return value

module Api:
    public:
#line 9 api-public-sibling.elisa
        def dispatch(value: bool) -> i64:
            return 1 if value
            return 0

module App:
    public:
        def public_sibling() -> i64:
            return Api::dispatch(true)

        def private_sibling() -> i64 error[Api::Fault]:
            return try Api::dispatch(1)

def main() -> i64:
    return App::public_sibling()
