def list_default(values: darray[i64?] = [1, null, -2]) -> darray[i64?]:
    return values

def dict_default(values: dict[cstr, i64?] = {"a": 1, "b": null}) -> dict[cstr, i64?]:
    return values

def text_default(values: darray[sview?] = ["hello", null, "a\0b"]) -> darray[sview?]:
    return values

def object_default(values: darray[py::Object?] = [null]) -> darray[py::Object?]:
    return values

def optional_scalar_default(value: i64? = 7) -> i64?:
    return value

def optional_text_default(value: sview? = "hello") -> sview?:
    return value

def optional_cstr_default(value: cstr? = "world") -> cstr?:
    return value

def optional_object_default(value: py::Object? = null) -> py::Object?:
    return value

export pymodule nullable_aggregate_defaults:
    fn list_default
    fn dict_default
    fn text_default
    fn object_default
    fn optional_scalar_default
    fn optional_text_default
    fn optional_cstr_default
    fn optional_object_default
