# Two same-name overloads CONFLICT when the shorter parameter-type list is a PREFIX of the
# longer — UNLESS the declaration is a CONSTRUCTOR (its return type names the function).
# stage1 used to accept the conflicting shape stage0 rejects: a missing diagnostic, i.e.
# stage1 more PERMISSIVE than the reference compiler. Found by adversarial differential
# testing, whose PERMISSIVE outcome exists for exactly this class.
#
# The rule was MEASURED, one stage0 probe per row:
#     (i64) vs (i64, i64)            REJECTED
#     (i64) vs (i64, bool)           REJECTED
#     (i64, i64) vs (i64)            REJECTED   order-independent
#     (i64) vs (bool, i64)           accepted   first type differs -> not a prefix
#     prefix pair inside `module M:` REJECTED   scope is NOT the factor
#     name is a type, returns i64    REJECTED   return type alone is not enough
#     name T, no type T declared     REJECTED   the name alone is not enough
#     struct T + def T(..) -> T      ACCEPTED   the constructor exemption
#
# "Same name + differing arity" is NOT the rule, and shipping that broke the self-host:
# src/lexer/tokens.elisa has `def Token(kind, position, start, text_end, suffix_end) -> Token`
# beside a 4-parameter `def Token(…) -> Token` — an exact prefix pair, legal because both are
# constructors.
#
# This fixture pins the ACCEPTED side; a program both compilers refuse cannot live in a
# corpus that compares answers, so the rejected side is a .pos fixture under
# test/fixtures/diagnostics/.
struct Box:
    v: i64

# Constructors: an exact prefix pair, exempt.
def Box(a: i64, b: i64) -> Box:
    return Box{v: a + b}

def Box(a: i64) -> Box:
    return Box{v: a}

# Not a prefix — the first parameter type differs, so these are distinct overloads.
def pick(x: i64) -> i64:
    return 1

def pick(x: bool, y: i64) -> i64:
    return 2

def main() -> i64:
    return Box(3).v + Box(4, 5).v * 10 + pick(1) + pick(true, 2) * 100
