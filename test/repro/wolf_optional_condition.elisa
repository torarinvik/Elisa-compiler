struct SDL_Window:
    opaque: u8
struct SDL_GLContextState:
    opaque: u8
struct SDL_Palette:
    opaque: u8
struct SDL_Surface:
    pitch: i32

global mutable sdlWindow: mutable SDL_Window&? = null
global mutable sdlGLContext: mutable SDL_GLContextState&? = null
global mutable sdlGamePalette: mutable SDL_Palette&? = null
global mutable screen: mutable SDL_Surface&? = null
global mutable screenBuffer: mutable SDL_Surface&? = null
global mutable screenWidth: u32 = zeroed
global mutable screenHeight: u32 = zeroed
global mutable fullscreen: i8 = zeroed
global mutable windowFlags: u64 = zeroed
global mutable scaleFactor: u32 = zeroed
global mutable pixelangle: mutable i16&? = null
global mutable wallheight: mutable i32&? = null
extern SDL_CreateWindow(title: u8&?, w: i32, h: i32, flags: u64) -> mutable SDL_Window&?
extern SDL_GL_CreateContext(window: mutable SDL_Window&?) -> i32
extern SDL_CreatePalette(n: i32) -> mutable SDL_Palette&?
extern SDL_CreateIndexedSurface(width: i32, height: i32) -> mutable SDL_Surface&?
extern malloc(size: u64) -> mutable void&?
extern Quit(message: u8&?, file: u8&?, line: i32) -> void
extern printf(fmt: u8&?, ...) -> i32

def create_window() -> void can[Abort.Panic, Global]:
    screenHeight <- ((screenWidth * 3) / 4)
    windowFlags <- 2
    if fullscreen != 0:
        windowFlags <- (windowFlags | 1)
    window: mutable u8&? = (&("x")[0])
    sdlWindow <- SDL_CreateWindow(window, screenWidth, screenHeight, windowFlags)
    if not sdlWindow != null:
        printf((&("bad")[0]))
        windowFlags <- windowFlags | 4
    sdlGLContext <- SDL_GL_CreateContext(sdlWindow)
    if not sdlGLContext != null:
        windowFlags <- windowFlags | 8
    if not sdlGamePalette != null:
        sdlGamePalette <- SDL_CreatePalette(256)
        if not sdlGamePalette != null:
            windowFlags <- windowFlags | 16
    if not screen != null:
        screen <- SDL_CreateIndexedSurface(screenWidth, screenHeight)
        if not screen != null:
            windowFlags <- windowFlags | 32
    if not screenBuffer != null:
        screenBuffer <- SDL_CreateIndexedSurface(screenWidth, screenHeight)
        if not screenBuffer != null:
            windowFlags <- windowFlags | 64
    if (screenHeight / 200) < scaleFactor:
        scaleFactor <- screenHeight / 200
    pixelangle <- (malloc((screenWidth * (size_of[i16]).u32()))).cast[mutable i16&?]
    if not pixelangle != null:
        Quit((&("Out")[0]), (&("file")[0]), 1)
    wallheight <- (malloc((screenWidth * (size_of[i32]).u32()))).cast[mutable i32&?]
    if not wallheight != null:
        Quit((&("Out")[0]), (&("file")[0]), 2)

def main() -> i64:
    create_window()
    return 0
