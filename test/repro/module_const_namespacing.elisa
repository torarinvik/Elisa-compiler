# Two modules, each declaring SIZE. Constants used to be keyed by BARE NAME in
# a single flat table, so the second registration overwrote the first and
# `Alpha::total()` returned Beta's 100 -- a WRONG ANSWER, not a decline, and
# qualifying the use site did not help because the collision was in the table
# rather than in the lookup.
#
# Exits 23 = Grade::value(10) + Score::value(10) + Score::borrowed(3).
#
# Struct names still share a flat table, so Grade's and Score's records are
# deliberately named differently: that is a SEPARATE bug and this fixture is
# not the place to also fail on it.

include "../../elisacore_std/elisacore_runtime.elisa"

module Grade:
    const SIZE: i64 = 3

    struct Work:
        total: mutable i64
        span: mutable i64

    def Work(span: i64) -> Work:
        can Abort.Panic:
            return Work{total: 0, span: span}

    def bump(w: mutable Work&, by: i64):
        can Abort.Panic:
            w.total <- w.total + by * SIZE

    def value(w: Work&) -> i64:
        can Abort.Panic:
            return w.total + w.span

module Score:
    const SIZE: i64 = 10

    struct Tally:
        tally: mutable i64

    def Tally() -> Tally:
        can Abort.Panic:
            return Tally{tally: SIZE}

    def value(t: Tally&) -> i64:
        can Abort.Panic:
            return t.tally

    # A qualified read of ANOTHER module's const must not find this module's.
    def borrowed() -> i64:
        can Abort.Panic:
            return Grade::SIZE

def main() -> i64:
    can Abort.Panic:
        g: mutable Grade::Work = Grade::Work(4)
        Grade::bump(&g, 2)
        s: Score::Tally = Score::Tally()
        return Grade::value(&g) + Score::value(&s) + Score::borrowed()
