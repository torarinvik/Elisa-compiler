# A reclaimed-span hint must not survive arena lifecycle transitions or leak across arenas.
include "../../elisacore_std/arena.elisa"

module ArenaFreeHintLifecycleRegression:
    private:
        const CAPACITY_SLOTS: usize = 16
        const INITIAL_SLOTS: usize = 4
        const FILLER_SLOTS: usize = 12
        const GROWN_SLOTS: usize = 20
        const SECOND_ALLOCATION_SLOTS: usize = 2
        const FIRST_REGION: usize = 0
        const SUCCESS_STATUS: i64 = 0
        const FAILURE_STATUS: i64 = 1

    public:
        def run() -> i64:
            first_backing: mutable heap Region& = new_region_backend(CAPACITY_SLOTS, ARENA_STRATEGY_CHAINED)
            first: mutable Arena = Arena{begin: first_backing, end: first_backing, end_index: FIRST_REGION, strategy: ARENA_STRATEGY_CHAINED}
            initial: mutable heap void& = arena_alloc(&first, INITIAL_SLOTS * size_of(uintptr))
            _ = arena_alloc(&first, FILLER_SLOTS * size_of(uintptr))
            _ = arena_realloc(&first, initial, INITIAL_SLOTS * size_of(uintptr), GROWN_SLOTS * size_of(uintptr))

            second_backing: mutable heap Region& = new_region_backend(CAPACITY_SLOTS, ARENA_STRATEGY_CHAINED)
            second: mutable Arena = Arena{begin: second_backing, end: second_backing, end_index: FIRST_REGION, strategy: ARENA_STRATEGY_CHAINED}
            before_reset: mutable heap void& = arena_alloc(&second, SECOND_ALLOCATION_SLOTS * size_of(uintptr))
            arena_reset(&first)
            after_reset: mutable heap void& = arena_alloc(&first, SECOND_ALLOCATION_SLOTS * size_of(uintptr))
            arena_free(&first)
            third_backing: mutable heap Region& = new_region_backend(CAPACITY_SLOTS, ARENA_STRATEGY_CHAINED)
            third: mutable Arena = Arena{begin: third_backing, end: third_backing, end_index: FIRST_REGION, strategy: ARENA_STRATEGY_CHAINED}
            after_cache_reuse: mutable heap void& = arena_alloc(&third, SECOND_ALLOCATION_SLOTS * size_of(uintptr))
            arena_free(&third)
            after_free: mutable heap void& = arena_alloc(&second, SECOND_ALLOCATION_SLOTS * size_of(uintptr))
            arena_free(&second)

            return FAILURE_STATUS if before_reset.cast[uintptr] == 0.uintptr()
            return FAILURE_STATUS if after_reset.cast[uintptr] == 0.uintptr()
            return FAILURE_STATUS if after_cache_reuse.cast[uintptr] == 0.uintptr()
            return FAILURE_STATUS if after_free.cast[uintptr] == 0.uintptr()
            return SUCCESS_STATUS

def main() -> i64:
    return ArenaFreeHintLifecycleRegression::run()
