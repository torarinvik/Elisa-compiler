# A real module named Mode has no Kind enum, so the visible alias supplies the missing leaf.
module Mode:
    public:
        const enum Unrelated of i64:
            High = 7

module Other:
    public:
        const enum Kind of i64:
            Ready = 57

using Other as Mode

def alias_fallback(value: Mode::Kind = Mode::Kind.Ready) -> Mode::Kind:
    return value

export pymodule alias_module_fallback:
    fn alias_fallback
