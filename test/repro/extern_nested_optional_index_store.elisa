struct Objstruct:
    flags: mutable u32

@link_name("actorat")
extern actorat: mutable array[array[mutable Objstruct&?, 64], 64]

def actor_store(x: i32, y: i32) -> void:
    trusted Unsafe.StaleRef:
        actorat[x][y] <- (64).cast[mutable Objstruct&?]

def main() -> i64:
    actor_store(0, 0)
    return 0
