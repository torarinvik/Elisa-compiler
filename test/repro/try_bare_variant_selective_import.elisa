# A selective import must resolve the bare name to the complete error set even
# when another family has a unique variant with that same spelling.
module SetProvider:
    public:
        error Expected:
            SetTag

error Fault:
    Expected

module Imported:
    # Deliberately declared below this module to exercise Core's program-wide imports.

    public:
        def origin() -> i64 error[Expected]:
            return 1

        def good_set_destination() -> i64 error[Expected]:
            return try origin()

        def wrong_variant_destination() -> i64 error[Fault]:
            return try origin()

from SetProvider import Expected

def main() -> i64:
    return 0
