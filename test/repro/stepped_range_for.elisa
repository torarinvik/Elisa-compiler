# A STEPPED range in a `for` — `LOW..<HIGH..STEP`.
#
# It parses as a bare `..` whose LEFT operand is itself a spelled range, which is the one legal
# bare `..` in the language. The backend's range loop only recognised the spelled operators, so
# the whole `for` declined and took its enclosing function with it. stage0 compiles all four
# spellings below.
#
# Every loop accumulates its indices as DIGITS, so the set of values visited AND their order
# are both encoded — a step that silently reverted to 1 would change the answer, not just the
# iteration count.
def ascending() -> i64:
    total: mutable i64 = 0
    for i in 0..<10..3 |total|:
        total <- total * 10 + i
    return total          # 0, 3, 6, 9 -> 369

def inclusive() -> i64:
    total: mutable i64 = 0
    for i in 0..=6..2 |total|:
        total <- total * 10 + i
    return total          # 0, 2, 4, 6 -> 246

def descending() -> i64:
    total: mutable i64 = 0
    for i in 9..>0..3 |total|:
        total <- total * 10 + i
    return total          # 9, 6, 3 -> 963

# A step of 1 must behave exactly like the unstepped form — the control case that a stepped
# loop is not silently off by one.
def step_one() -> i64:
    total: mutable i64 = 0
    for i in 0..<4..1 |total|:
        total <- total * 10 + i
    return total          # 0, 1, 2, 3 -> 123

def plain() -> i64:
    total: mutable i64 = 0
    for i in 0..<4 |total|:
        total <- total * 10 + i
    return total          # 123

def main() -> i64:
    # 369 + 246 + 963 + 123 + 123 = 1824; 1824 % 251 = 67
    return (ascending() + inclusive() + descending() + step_one() + plain()) % 251
