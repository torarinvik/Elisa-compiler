# Regression fixture for return's comma transition: the Element state must execute
# after More consumes the comma.
def divmod(a: i64, b: i64) -> (quotient: i64, remainder: i64):
    return a / b, a % b

def main() -> i64:
    result: (quotient: i64, remainder: i64) = divmod(17, 5)
    return result.quotient * 100 + result.remainder
