struct Point:
    x: i64
    label: sview

struct Catalog:
    rows: dict[i64, dict[cstr, darray[Point]]]
    views: dict[i64, dict[cstr, view[Point]]]

def roundtrip_lists(values: dict[i64, dict[cstr, darray[Point]]]) -> dict[i64, dict[cstr, darray[Point]]]:
    return values

def roundtrip_views(values: dict[i64, dict[cstr, view[Point]]]) -> dict[i64, dict[cstr, view[Point]]]:
    return values

def roundtrip_list_rows(values: darray[dict[i64, dict[cstr, darray[Point]]]]) -> darray[dict[i64, dict[cstr, darray[Point]]]]:
    return values

def roundtrip_view_rows(values: darray[dict[i64, dict[cstr, view[Point]]]]) -> darray[dict[i64, dict[cstr, view[Point]]]]:
    return values

def roundtrip_catalog(catalog: Catalog) -> Catalog:
    return catalog

export pymodule nested_dict_named_aggregates:
    fn roundtrip_lists
    fn roundtrip_views
    fn roundtrip_list_rows
    fn roundtrip_view_rows
    fn roundtrip_catalog
