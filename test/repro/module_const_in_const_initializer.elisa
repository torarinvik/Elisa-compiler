# A const INITIALIZER naming a module-qualified const.
#
# Consts got owners, and qualified reads were taught to resolve in the named
# module -- but only at expression USE sites. The two const FOLDERS still
# matched Expr.Ident alone, so `Space::HEIGHT` inside another const's
# initializer fell through every arm to `ok <- false`. An unresolved const
# declines every function that reads it, and one declined function drops the
# WHOLE unit, so this cost far more than the const itself: it took out
# menu_row_y and render_menu_frame the moment nw-core's display.elisa became
# `module Display:`.
#
# Both folders are covered here, because they are separate code paths:
# fold_const_atom for the integer leaf, fold_const_float_expr for the float.
#
# `Other` exists to prove the qualifier SELECTS: it declares the same two names
# with values that would be obvious if the wrong module won.
#
# Exits 104 = ROWS_TOP(48) + STRIDE(40) + Third::DERIVED(16).

include "../../elisacore_std/elisacore_runtime.elisa"

module Space:
    const HEIGHT: f64 = 60.0
    const COLUMNS: i64 = 8

module Other:
    const HEIGHT: f64 = 1000.0
    const COLUMNS: i64 = 999

# TOP-LEVEL consts folded from another module's consts.
const ROWS_TOP: f64 = Space::HEIGHT * 8.0 / 10.0
const STRIDE: i64 = Space::COLUMNS * 5

module Third:
    # And a MODULE-level const folded from a third module's const, so the
    # owner switch is exercised from inside a module as well as from top level.
    const DERIVED: i64 = Space::COLUMNS * 2

    def derived() -> i64:
        can Abort.Panic:
            return DERIVED

def main() -> i64:
    can Abort.Panic:
        return ROWS_TOP.i64() + STRIDE + Third::derived()
