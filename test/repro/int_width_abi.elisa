# `int` follows pointer width; `i32` and `i64` retain their explicit widths.
struct IntPair:
    left: int
    right: int

def int_identity(value: int) -> int:
    return value

def int_bytes() -> usize:
    return size_of(int)

def int_pair_bytes() -> usize:
    return size_of(IntPair)

def isize_bytes() -> usize:
    return size_of(isize)

def i32_bytes() -> usize:
    return size_of(i32)

def i64_identity(value: i64) -> i64:
    return value

export fn int_identity(value: int) -> int = int_identity
export fn int_bytes() -> usize = int_bytes
export fn int_pair_bytes() -> usize = int_pair_bytes
export fn isize_bytes() -> usize = isize_bytes
export fn i32_bytes() -> usize = i32_bytes
export fn i64_identity(value: i64) -> i64 = i64_identity
