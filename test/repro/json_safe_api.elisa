include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"
include "../../elisacore_std/elisacore_json.elisa"

def main() -> i64:
	can Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast:
		arena: mutable Arena = zeroed
		output_arena: mutable Arena = zeroed
		parsed: JsonParseResult[arena] = json_parse_checked(&arena, sview("[1]", 0, -1))
		value: JsonValueHandle[arena] = json_handle_from_result(parsed)
		qualified_value: JsonValueHandle[arena] = Json::json_handle_from_result(parsed)
		status: mutable i64 = 0
		status <- 1 if parsed.code != JsonErrorCode.OK
		status <- 2 if status == 0 and json_handle_kind(value) != JsonKind.ARRAY
		status <- 3 if status == 0 and json_handle_array_len(value) != 1
		status <- 7 if status == 0 and json_handle_array_len(qualified_value) != 1
		first: JsonValueHandle[arena] = try json_handle_at(value, 0) else json_handle_null(value)
		number: f64 = try json_handle_as_number(first) else -1.0
		status <- 4 if status == 0 and number != 1.0
		serialized: mutable darray[u8] = json_handle_write(&output_arena, value)
		status <- 5 if status == 0 and serialized.count == 0
		string_result: JsonParseResult[arena] = json_parse_checked(&arena, sview("\"ok\"", 0, -1))
		string_value: JsonValueHandle[arena] = json_handle_from_result(string_result)
		text: sview @arena = try json_handle_as_string(string_value) else sview("", 0, -1)
		status <- 6 if status == 0 and text.len != 2
		arena_free(&arena)
		arena_free(&output_arena)
		return status
