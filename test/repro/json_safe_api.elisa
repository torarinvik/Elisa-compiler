include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"
include "../../elisacore_std/elisacore_json.elisa"

def main() -> i64:
	can Memory.Allocate, Memory.Release, Abort.Panic, Console.Format, Unsafe.PointerCast:
		arena: mutable Arena = zeroed
		parsed: JsonParseResult = json_parse_checked(&arena, sview("[1]", 0, -1))
		value = parsed.value
		return 2 if json_kind(value) != JsonKind.ARRAY
		return 3 if json_array_len(value) != 1
		serialized: mutable darray[u8] = json_write(&arena, value)
		return 4 if serialized.count == 0
		arena_free(&arena)
		return 0 if parsed.code == JsonErrorCode.OK else 1
