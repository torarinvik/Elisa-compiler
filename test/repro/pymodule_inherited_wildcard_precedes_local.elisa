# Core collects the parent using before recursing into Inner, even though the local
# using appears earlier in source order than Outer::ParentValues.
module Outer:
    module Inner:
        module LocalValues:
            public:
                const enum Mode of i64:
                    High = 73
        using LocalValues
        def inherited_wildcard(value: i64 = Mode.High) -> i64:
            return value

    module ParentValues:
        public:
            const enum Mode of i64:
                High = 17
    using ParentValues

export pymodule inherited_wildcard_precedes_local:
    fn inherited_wildcard = Outer::Inner::inherited_wildcard
