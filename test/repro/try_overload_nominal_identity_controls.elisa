# A same-spelled nominal declaration that is private and unused must not make a
# caller-visible Provider.Widget look ambiguous to Try's overload resolver.
module HiddenTypes:
    private:
        struct Widget:
            value: i64

module Provider:
    public:
        error Fault:
            Failure

        error GenericFault:
            GenericFailure

        struct Widget:
            value: i64

        def singleton(value: Widget) -> i64 error[Provider::Fault]:
            return value.value

        def generic_only[T](value: T) -> i64 error[Provider::GenericFault]:
            return 1

        def generic_only(value: bool, marker: i64) -> i64 error[Provider::Fault]:
            return 2

        def overloaded(value: Widget) -> i64 error[Provider::Fault]:
            return value.value

        def overloaded[T](value: T) -> i64 error[Provider::GenericFault]:
            return 4

        def overloaded(value: i64) -> i64 error[Provider::GenericFault]:
            return 3

from Provider import Widget

module Consumer:
    public:
        def singleton_same_name(value: Widget) -> i64 error[Provider::Fault]:
            return try Provider::singleton(value)

        def generic_only_same_name(value: Widget) -> i64 error[Provider::GenericFault]:
            return try Provider::generic_only(value)

        def concrete_overload_same_name(value: Widget) -> i64 error[Provider::Fault]:
            return try Provider::overloaded(value)

        def concrete_overload_wrong_family(value: Widget) -> i64 error[Provider::GenericFault]:
            return try Provider::overloaded(value)

def main() -> i64:
    return 0
