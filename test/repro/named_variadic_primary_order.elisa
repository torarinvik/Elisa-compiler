def fixed_first(value: i64) -> i64:
    return value

def fixed_first(value: bool, ...) -> i64:
    return 0

def variadic_first(value: i64, ...) -> i64:
    return value

def variadic_first(value: bool) -> i64:
    return 0

def good() -> i64:
    return fixed_first(value: 1)

def bad() -> i64:
    return variadic_first(value: 1)

def main() -> i64:
    return 0

static if false:
    def conditional(value: i64, ...) -> i64:
        return value
static if true:
    def conditional(value: i64) -> i64:
        return value

def selected_fixed() -> i64:
    return conditional(value: 1)

def only(value: i64, ...) -> i64:
    return value

def only_named() -> i64:
    return only(value: 1)

def only_unknown() -> i64:
    return only(wrong: true)

def fixed_named(value: i64) -> i64:
    return value

def shadowed() -> i64:
    only = fixed_named
    return only(value: 1)
