module Backend:
    public:
        def touch() -> void:
            can Global.Write:
                Parent::bare <- 1
    module Parent:
        public:
            global mutable bare: i32 = 0
            def touch() -> void:
                can Global.Write:
                    bare <- 1
            module Nested:
                public:
                    global mutable qualified: i32 = 0
                    def touch() -> void:
                        can Global.Write:
                            qualified <- 1

module First:
    module Nested:
        public:
            global mutable decoy: i32 = 0
            def touch() -> void:
                pass
    public:
        def touch() -> void:
            pass

module Prefix:
    module Nested:
        public:
            def touch() -> void:
                pass

# Alias resolution precedes a same-spelled real module, and each target can itself
# begin with an alias. The qualified chain also exercises suffix lookup under the
# resolved alias prefix rather than under its textual spelling.
using Backend::Parent as RootAlias
using RootAlias as RootSecond
using Backend::Parent as Prefix
using Prefix::Nested as Qualified

module Client:
    module First:
        public:
            def touch() -> void:
                pass
    module Backend:
        module Parent:
            public:
                global mutable bare: i32 = 0
                def touch() -> void:
                    can Global.Write:
                        bare <- 1
    using Backend::Parent as First
    using First as Second
    public:
        def nested_alias_chain_write() -> void:
            can Global.Write:
                Second::bare <- 1

        def nested_alias_chain_call() -> void:
            can Global.Write:
                Second::touch()

def alias_chain_write() -> void:
    can Global.Write:
        RootSecond::bare <- 1

def qualified_alias_chain_write() -> void:
    can Global.Write:
        Qualified::qualified <- 1

def alias_chain_call() -> void:
    can Global.Write:
        RootSecond::touch()

def qualified_alias_chain_call() -> void:
    can Global.Write:
        Qualified::touch()

def main() -> i32:
    return 0
