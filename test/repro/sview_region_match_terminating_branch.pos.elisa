def good(choose: bool) -> i64:
    can Memory.Allocate, Abort.Panic:
        region outer(4096):
            outer_bytes: mutable darray[u8] @outer = [65.u8()]
            retained: mutable sview @outer = outer_bytes.as_sview()
            region inner(4096):
                inner_bytes: mutable darray[u8] @inner = [66.u8()]
                local: mutable sview = ""
                match choose:
                    true:
                        local <- inner_bytes.as_sview()
                        return 0
                    false:
                        local <- retained
                retained <- local
                return retained.len
            return retained.len

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        return good(true)
