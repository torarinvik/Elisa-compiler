include "../../elisacore_std/elisacore_runtime.elisa"
include "../../elisacore_std/collections.elisa"

module cpp:
    struct unordered_map[K, V]:
        storage: mutable dict[K, V]

    def nonnull[T](value: mutable T&?) -> mutable T&:
        if value == null:
            return zeroed
        return value

    impl[K, V] Index for unordered_map[K, V]:
        type Key = K
        type Elem = V

        def __index__(self: mutable unordered_map[K, V]&, key: K) -> V&:
            return nonnull(arena_dict_get_or_insert_or_panic(&perm_arena, self.storage, key, zeroed))

    def clear[K, V](self: mutable unordered_map[K, V]&):
        self.storage.clear()

    def size[K, V](self: unordered_map[K, V]&) -> usize:
        return self.storage.count

def main() -> i64:
    values: mutable cpp::unordered_map[i64, i64] = zeroed
    values[7] <- 42
    result: i64 = values[7]
    values.clear()
    return result + values.size().i64()
