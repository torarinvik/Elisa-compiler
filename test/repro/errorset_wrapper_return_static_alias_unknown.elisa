# Unknown branch selection must keep EWR from choosing either alias target.
module CandidateProvider:
    public:
        error CandidateFault:
            Candidate

        def origin() -> i64 error[CandidateProvider::CandidateFault{Candidate}]:
            raise CandidateProvider::CandidateFault.Candidate

        def wrap[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
            return try callback()

module OtherProvider:
    public:
        error OtherFault:
            Other

        def origin() -> i64 error[OtherProvider::OtherFault{Other}]:
            raise OtherProvider::OtherFault.Other

        def wrap[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
            return try callback()

        module Maybe:
            public:
                error NestedFault:
                    Nested

                def origin() -> i64 error[OtherProvider::Maybe::NestedFault{Nested}]:
                    raise OtherProvider::Maybe::NestedFault.Nested

                def wrap[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
                    return try callback()

error ExpectedFault:
    Expected

module Pick:
    public:
        error RawPathFault:
            Raw

        def origin() -> i64 error[Pick::RawPathFault{Raw}]:
            raise Pick::RawPathFault.Raw

        def wrap[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
            return try callback()

module LexicalScope:
    module Pick:
        public:
            error LexicalPathFault:
                Lexical

            def origin() -> i64 error[LexicalScope::Pick::LexicalPathFault{Lexical}]:
                raise LexicalScope::Pick::LexicalPathFault.Lexical

            def wrap[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
                return try callback()

    def lexical_path_beats_module_alias() -> i64 error[ExpectedFault{Expected}]:
        return Pick::wrap(Pick::origin())

static if UNKNOWN_PROVIDER_CHOICE:
    using OtherProvider as Maybe
static else:
    using CandidateProvider as Maybe

# Definite aliases keep precedence over unresolved branch aliases, including when
# the definite declaration appears earlier than the branch declaration.
using CandidateProvider as Stable
static if UNKNOWN_PROVIDER_CHOICE:
    using OtherProvider as Stable

# Among branch aliases at one scope, an earlier selected row beats a later unresolved row.
static if true:
    using CandidateProvider as Earlier
static if UNKNOWN_PROVIDER_CHOICE:
    using OtherProvider as Earlier

# A branch block pre-registers its direct alias before visiting nested branches,
# even when the nested branch alias appears earlier in the source text.
static if true:
    static if true:
        using OtherProvider as NestedBranchWinner
    using CandidateProvider as NestedBranchWinner

# The branch block also pre-registers its direct alias before descending into a
# nested module, even when the parent alias is textually later.
static if true:
    module CrossBranchInstaller:
        using OtherProvider as CrossScopeBranchWinner
    using CandidateProvider as CrossScopeBranchWinner

def unresolved_alias_call() -> i64 error[ExpectedFault{Expected}]:
    return Maybe::wrap(Maybe::origin())

def definite_alias_wins() -> i64 error[ExpectedFault{Expected}]:
    return Stable::wrap(Stable::origin())

def earlier_active_branch_alias_wins() -> i64 error[ExpectedFault{Expected}]:
    return Earlier::wrap(Earlier::origin())

def alias_spelling_in_non_head_segment_does_not_poison() -> i64 error[ExpectedFault{Expected}]:
    return OtherProvider::Maybe::wrap(OtherProvider::Maybe::origin())

def nested_global_alias_is_visible() -> i64 error[ExpectedFault{Expected}]:
    return NestedGlobal::wrap(NestedGlobal::origin())

def main() -> i64:
    return 0

# Core collects module aliases before checking function bodies, so this alias is
# available to the root call even though its declaration is in a nested module.
module AliasInstaller:
    public:
        module LocalProvider:
            public:
                error NestedGlobalFault:
                    NestedGlobal

                def origin() -> i64 error[AliasInstaller::LocalProvider::NestedGlobalFault{NestedGlobal}]:
                    raise AliasInstaller::LocalProvider::NestedGlobalFault.NestedGlobal

                def wrap[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
                    return try callback()
    using LocalProvider as NestedGlobal

# Core pre-registers aliases declared directly in a scope before descending into
# nested module bodies, so this root alias wins despite the nested declaration above.
module AliasShadowInstaller:
    using OtherProvider as RegistrationWinner
using CandidateProvider as RegistrationWinner
using CandidateProvider as Pick

def direct_alias_precedes_nested_registration() -> i64 error[ExpectedFault{Expected}]:
    return RegistrationWinner::wrap(RegistrationWinner::origin())

def module_alias_beats_raw_qualified_path() -> i64 error[ExpectedFault{Expected}]:
    return Pick::wrap(Pick::origin())

def nested_branch_parent_prepass_wins() -> i64 error[ExpectedFault{Expected}]:
    return NestedBranchWinner::wrap(NestedBranchWinner::origin())

def cross_scope_branch_parent_prepass_wins() -> i64 error[ExpectedFault{Expected}]:
    return CrossScopeBranchWinner::wrap(CrossScopeBranchWinner::origin())

module Detached:
    module Same:
        error DetachedFault:
            Detached

        def origin() -> i64 error[Detached::Same::DetachedFault{Detached}]:
            raise Detached::Same::DetachedFault.Detached

        def wrap[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
            return try callback()

def unrelated_same_leaf_module_does_not_match() -> i64 error[ExpectedFault{Expected}]:
    return Same::wrap(Same::origin())
