error Failure:
    Bad

struct Positive:
    value: mutable i64 where value > 0

def maybe(flag: i64) -> Positive error[Failure]:
    raise Failure.Bad if flag == 1
    return Positive{value: 1}

def main() -> i64:
    invalid: Positive = catch maybe(1):
        value:
            value
        Failure.Bad:
            zeroed
    return invalid.value
