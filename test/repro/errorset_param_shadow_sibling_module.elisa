# A same-named error set in another module is not visible here and must not
# trigger the errorset-parameter shadow warning.
module Provider:
    public:
        error Fault:
            Failed

module Consumer:
    def forward[errorset Fault](callback: fn() -> i64 error[Fault]) -> i64 error[Fault]:
        return try callback()

def main() -> i64:
    return 0
