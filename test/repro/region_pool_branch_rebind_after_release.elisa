include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/heap.elisa"

def bad(choose_second: bool) -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release]:
    region scratch(4096):
        pool: mutable RegionPool[i64] = region_pool_new((&scratch).cast[mutable Arena&])
        first: Pooled[i64] = pool.acquire()
        second: Pooled[i64] = pool.acquire()
        first.ptr[0] <- 65
        second.ptr[0] <- 66
        ptr: mutable heap i64& = first.ptr
        if choose_second:
            ptr as & <- second.ptr
        pool.release(move first)
        return ptr[0]

def main() -> i64:
    return 0
