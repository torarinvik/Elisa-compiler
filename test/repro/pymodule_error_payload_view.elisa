error ViewPayloadError:
    Empty(items: view[i64])
error ViewBytesPayloadError:
    Empty(data: view[u8])
error StructuredViewPayloadError:
    Empty(items: view[i64], label: sview)

def fail_view(values: view[i64]) -> i64 error[ViewPayloadError]:
    raise ViewPayloadError.Empty(values)

def fail_bytes(values: view[u8]) -> i64 error[ViewBytesPayloadError]:
    raise ViewBytesPayloadError.Empty(values)

def fail_structured(values: view[i64], label: sview) -> i64 error[StructuredViewPayloadError]:
    raise StructuredViewPayloadError.Empty(values, label)

export pymodule error_payload_view:
    fn fail_view
    fn fail_bytes
    fn fail_structured
