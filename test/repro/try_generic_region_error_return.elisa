include "../../elisacore_std/elisacore_runtime_prelude.elisa"

module Probe:
    error ProbeError:
        Failed

    struct RegionBox[@r]:
        value: i64& @r

    def make_fallible[@r](arena: mutable Arena& @r, value: RegionBox[r]) -> RegionBox[r] error[ProbeError]:
        return value

    def propagate[@r](arena: mutable Arena& @r, value: RegionBox[r]) -> RegionBox[r] error[ProbeError]:
        can Abort.Panic:
            return try make_fallible(arena, value)

def main() -> i64:
    return 0
