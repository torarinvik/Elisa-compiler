# A bare two-slot local cannot satisfy the required second-slot state.
struct AggregateFilterPair[?, ?]:
    value: i32

const AGGREGATE_FILTER_VALUE: i32 = 42

def aggregate_filter_require(value: AggregateFilterPair[?, &]) -> i32:
    return value.value

def main() -> i64:
    pair: AggregateFilterPair = AggregateFilterPair{value: AGGREGATE_FILTER_VALUE}
    return aggregate_filter_require(pair).i64()
