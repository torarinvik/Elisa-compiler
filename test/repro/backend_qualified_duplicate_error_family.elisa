# The same error-family and variant leaves can name different module-owned payload layouts.
# Qualified construction, catching, and try remapping must retain the source module identity.
module Outer:
    error Fault:
        Other(payload: i64)

    module Provider:
        error Fault:
            Bad(payload: i64)
            ExcludedFirst(values: i64[4])
            Zed(payload: i64)

module Second:
    error Fault:
        Bad(payload: u32)
        ExcludedSecond(values: u32[2])

module Alpha:
    error AliasFault:
        AlphaOnly(payload: i64)

module Zed:
    error AliasFault:
        ZedOnly(payload: i64)

module AliasNoise:
    using Second as Family

module API:
    using Outer as Root
    using Root::Provider as Family

    def restricted(code: i64) -> i64 error[Family """ path trivia """ :: Fault{Bad}, Second :: Fault{Bad}]:
        if code == 0:
            return 17
        if code == 1:
            raise Family::Fault.Bad(31)
        raise Second :: Fault.Bad(41)

    # Same-leaf families sort by their complete SetName. Keep this occurrence reversed
    # from the sorted order so registration must use `Outer::Provider::Fault`, not `Fault`.
    def reversed_family_order(code: i64) -> i64 error[Second::Fault{Bad}, Outer::Provider::Fault{Bad}]:
        if code == 0:
            raise Second::Fault.Bad(43)
        raise Outer::Provider::Fault.Bad(47)

    def canonical_family_order(code: i64) -> i64 error[Outer::Provider::Fault{Bad}, Second::Fault{Bad}]:
        return try reversed_family_order(code)

    def catch_canonical_family_order(code: i64) -> i64:
        return catch canonical_family_order(code):
            value: value
            Outer::Provider::Fault.Bad(payload): payload
            Second::Fault.Bad(payload): payload.i64()

    def reversed_trivia_family_order(code: i64) -> i64 error[Outer """ path trivia """ :: Provider::Fault{Bad}, Outer::Fault{Other}]:
        if code == 0:
            raise Outer::Provider::Fault.Bad(53)
        raise Outer::Fault.Other(59)

    def canonical_trivia_family_order(code: i64) -> i64 error[Outer::Fault{Other}, Outer::Provider::Fault{Bad}]:
        return try reversed_trivia_family_order(code)

    def catch_canonical_trivia_family_order(code: i64) -> i64:
        return catch canonical_trivia_family_order(code):
            value: value
            Outer::Fault.Other(payload): payload
            Outer::Provider::Fault.Bad(payload): payload

    # A dot-selected error set is a composite ABI row even with one family and one tag.
    # Zed is deliberately not the first source variant so lowering must map its source
    # ordinal into the filtered row before constructing and catching the error.
    def dot_selected_nonfirst_variant(code: i64) -> i64 error[Outer::Provider::Fault.Zed]:
        if code == 0:
            return 71
        raise Outer::Provider::Fault.Zed(79)

    def catch_dot_selected_nonfirst_variant(code: i64) -> i64:
        return catch dot_selected_nonfirst_variant(code):
            value: value
            Outer::Provider::Fault.Zed(payload): payload

    def zed_callback() -> i64 error[Outer::Provider::Fault.Zed]:
        raise Outer::Provider::Fault.Zed(83)

    def invoke_zed_callback(callback: fn() -> i64 error[Outer::Provider::Fault.Zed]) -> i64 error[Outer::Provider::Fault.Zed]:
        return try callback()

    def catch_zed_callback() -> i64:
        return catch invoke_zed_callback(zed_callback):
            value: value
            Outer::Provider::Fault.Zed(payload): payload

module AliasAPI:
    using Zed as A
    using Alpha as B

    def reversed_alias_family_order(code: i64) -> i64 error[B::AliasFault{AlphaOnly}, A::AliasFault{ZedOnly}]:
        if code == 0:
            raise B::AliasFault.AlphaOnly(61)
        raise A::AliasFault.ZedOnly(67)

    def source_alias_family_order(code: i64) -> i64 error[A::AliasFault{ZedOnly}, B::AliasFault{AlphaOnly}]:
        return try reversed_alias_family_order(code)

    def catch_source_alias_family_order(code: i64) -> i64:
        return catch source_alias_family_order(code):
            value: value
            A::AliasFault.ZedOnly(payload): payload
            B::AliasFault.AlphaOnly(payload): payload

    def first_callback() -> i64 error[Outer::Provider::Fault{Bad}]:
        return 23

    def first_callback_bad() -> i64 error[Outer::Provider::Fault{Bad}]:
        raise Outer::Provider::Fault.Bad(31)

    def second_callback_bad() -> i64 error[Second::Fault{Bad}]:
        raise Second::Fault.Bad(41)

    def callback_return(callback: fn() -> i64 error[Outer::Provider::Fault{Bad}], code: i64) -> i64 error[Outer::Provider::Fault{Bad}, Second::Fault{Bad}]:
        if code == 1:
            raise Second::Fault.Bad(41)
        return try callback()

    def catch_callback_return(code: i64) -> i64:
        return catch callback_return(first_callback, code):
            value: value
            Family::Fault.Bad(payload): payload
            Second::Fault.Bad(payload): payload.i64()

    def catch_callback_failure(code: i64) -> i64:
        catch callback_return(first_callback_bad, code):
            value:
                return value
            Outer::Provider::Fault.Bad(payload):
                return payload
            Second::Fault.Bad(payload):
                return payload.i64()
        return 0

    def callback_return_from_second(callback: fn() -> i64 error[Second::Fault{Bad}]) -> i64 error[Outer::Provider::Fault{Bad}, Second::Fault{Bad}]:
        return try callback()

    def catch_second_callback_failure() -> i64:
        catch callback_return_from_second(second_callback_bad):
            value:
                return value
            Outer::Provider::Fault.Bad(payload):
                return payload
            Second::Fault.Bad(payload):
                return payload.i64()
        return 0

    def catch_expression(code: i64) -> i64:
        return catch restricted(code):
            value: value
            Outer::Provider::Fault.Bad(payload): payload
            Second::Fault.Bad(payload): payload.i64()

    def catch_statement(code: i64) -> i64:
        catch restricted(code):
            value:
                return value
            Outer::Provider::Fault.Bad(payload):
                return payload
            Second::Fault.Bad(payload):
                return payload.i64()
        return 0

def main() -> i64:
    if API::catch_expression(0) != 17:
        return 1
    if API::catch_expression(1) != 31:
        return 2
    if API::catch_expression(2) != 41:
        return 3
    if API::catch_statement(0) != 17:
        return 4
    if API::catch_statement(1) != 31:
        return 5
    if API::catch_statement(2) != 41:
        return 6
    if API::catch_callback_return(0) != 23:
        return 7
    if API::catch_callback_return(1) != 41:
        return 8
    if API::catch_callback_failure(0) != 31:
        return 9
    if API::catch_callback_failure(1) != 41:
        return 10
    if API::catch_second_callback_failure() != 41:
        return 11
    if API::catch_canonical_family_order(0) != 43:
        return 12
    if API::catch_canonical_family_order(1) != 47:
        return 13
    if API::catch_canonical_trivia_family_order(0) != 53:
        return 14
    if API::catch_canonical_trivia_family_order(1) != 59:
        return 15
    if API::catch_dot_selected_nonfirst_variant(0) != 71:
        return 18
    if API::catch_dot_selected_nonfirst_variant(1) != 79:
        return 19
    if API::catch_zed_callback() != 83:
        return 20
    if AliasAPI::catch_source_alias_family_order(0) != 61:
        return 16
    if AliasAPI::catch_source_alias_family_order(1) != 67:
        return 17
    return 0
