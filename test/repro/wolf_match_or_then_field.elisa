const enum Kind of i32:
    none = 0
    bonus = 1
    other = 2

struct Stat:
    flags: mutable u32

struct Info:
    c_type: mutable Kind
    specialFlags: mutable u32

global mutable laststatobj: Stat&? = zeroed
global mutable statinfo: array[Info, 1] = zeroed

def elisa_nonnull[T](value: mutable T&?) -> mutable T&:
    if value == null:
        return zeroed
    return value

def SpawnStatic(c_type: i32) -> void:
    trusted Unsafe.StaleRef:
        match statinfo[c_type].c_type:
            Kind.bonus | Kind.other:
                elisa_nonnull(laststatobj).flags <- 0
            Kind.none:
                elisa_nonnull(laststatobj).flags <- 0
            _:
                pass
    trusted Unsafe.StaleRef:
        elisa_nonnull(laststatobj).flags <- 0

def main() -> i64:
    SpawnStatic(0)
    return 0
