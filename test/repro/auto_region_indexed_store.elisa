def bad(rows: mutable darray[darray[i64]]&) -> void:
    fresh: mutable darray[i64] = []
    fresh.push(1)
    rows[0] <- fresh

def local_only() -> void:
    rows: mutable darray[darray[i64]] = []
    inner: mutable darray[i64] = []
    rows.push(inner)
    rows[0] <- inner

def same_region[@r](rows: mutable darray[darray[i64]]& @r, supplied: darray[i64] @r) -> void:
    rows[0] <- supplied
