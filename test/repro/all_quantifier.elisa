# `all` and `any` are DIFFERENT quantifiers. The backend dropped the query head, so every
# empty-body bool Comprehension lowered as `any` — a silent wrong answer, not a decline.
#
# Each bit is a case that separates the two:
#   1  `all` over a darray with a FAILING element   — any=true, all=false
#   4  `all` over an EMPTY darray                   — any=false, all=true (vacuous)
# The `any` cases pin that fixing `all` did not break its sibling.
def main() -> i64:
    mixed: darray[i64] = [1, 0]
    positive: darray[i64] = [1, 2]
    empty: darray[i64] = []
    score: mutable i64 = 0
    score <- score + 1 if all x in mixed where x > 0
    score <- score + 2 if all x in positive where x > 0
    score <- score + 4 if all x in empty where x > 0
    score <- score + 8 if any x in mixed where x == 0
    score <- score + 16 if any x in positive where x == 0
    return score
