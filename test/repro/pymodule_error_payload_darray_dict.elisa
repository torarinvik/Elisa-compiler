error RowsPayloadError:
    Empty(rows: darray[dict[i64, i64]])

struct Point:
    x: i64
    label: sview

error StructRowsPayloadError:
    Empty(rows: darray[dict[i64, Point]])

error NestedRowsPayloadError:
    Empty(rows: darray[dict[i64, darray[dict[cstr, i64]]]])

def fail_rows(values: darray[dict[i64, i64]]) -> i64 error[RowsPayloadError]:
    raise RowsPayloadError.Empty(values)

def fail_struct_rows(values: darray[dict[i64, Point]]) -> i64 error[StructRowsPayloadError]:
    raise StructRowsPayloadError.Empty(values)

def fail_nested_rows(values: darray[dict[i64, darray[dict[cstr, i64]]]]) -> i64 error[NestedRowsPayloadError]:
    raise NestedRowsPayloadError.Empty(values)

export pymodule error_payload_darray_dict:
    fn fail_rows
    fn fail_struct_rows
    fn fail_nested_rows
