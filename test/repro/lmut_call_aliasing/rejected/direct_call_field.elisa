struct P:
    source: sview
    position: mutable usize

def eat(parser: lmut P, name: sview) -> bool:
    parser.position <- parser.position + 1
    return true

def eat2(name: sview, parser: lmut P) -> bool:
    parser.position <- parser.position + 1
    return true

def h(parser: lmut P) -> void:
    rebind ok: bool, parser = eat(parser, parser.source)

def main() -> i32:
    return 0
