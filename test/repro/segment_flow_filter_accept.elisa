# Segment facts must remain visible among unrelated annotation rows.
@segment_transition(guest)
extern segment_filter_load_guest() -> void can[Unsafe.SegmentMutation, Segment.Guest]
@segment_transition(host)
extern segment_filter_restore_host() -> void can[Unsafe.SegmentMutation, Segment.Host]
extern segment_filter_host_only() -> void can[Segment.Host]
extern segment_filter_guest_only() -> void can[Segment.Guest]

module SegmentFilterAccepted:
    private:
        const SUCCESS: i64 = 0
        @inline(never)
        def unrelated() -> i64:
            return SUCCESS
    public:
        def restored() -> void:
            can Unsafe.SegmentMutation, Segment.Guest:
                segment_filter_load_guest()
            can Segment.Guest:
                segment_filter_guest_only()
            _ = unrelated()
            can Unsafe.SegmentMutation, Segment.Host:
                segment_filter_restore_host()
            can Segment.Host:
                segment_filter_host_only()

def main() -> i64:
    return 0
