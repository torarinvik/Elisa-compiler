# A present optional value is not itself a reference to its payload. Require a
# payload binding before borrowing it for a `Ledger&` parameter.
struct Ledger:
    count: i64

global mutable ledger: Ledger? = null

def read_ledger(value: Ledger&) -> i64:
    return value.count

def main() -> i64 can[Global.Read]:
    return read_ledger(ledger)
