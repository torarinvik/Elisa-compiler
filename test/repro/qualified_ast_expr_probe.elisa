include "../../src/parser/parser.elisa"

using Ast

def parse_snippet(source: u8&) -> Ast::File:
    can Memory.Allocate, Abort.Panic:
        tokens: darray[Token] = frontend_tokenize(source, source)
        return frontend_parser_parse_file(source, tokens)

def shape_of(expression: Ast::Expr) -> i64:
    match expression:
        Expr.Field(object, field, _):
            if field != "Invalid":
                return 10
            match object:
                Expr.Scope(base, name, _):
                    return 20 if name == "Expr" and base is Expr.Ident(_, _)
                    return 21
                Expr.Invalid:
                    return 30
                _:
                    return 31
        Expr.Invalid:
            return 40
        _:
            return 41

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    file: Ast::File = parse_snippet("def f() -> i64:\n    return Ast::Expr.Invalid\n")
    return 1 if file.errors.count != 0 or file.top_decls.count == 0
    match file.top_decls[0]:
        Decl.Func(_, _, _, body, _, _, _):
            match body[0]:
                Stmt.Return(value, _):
                    if value is actual:
                        return 0 if shape_of(actual) == 20 else 5
                    return 4
                _:
                    return 2
        _:
            return 3
