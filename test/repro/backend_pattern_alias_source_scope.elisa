module First:
    enum Kind:
        Left(value: i64)
    error Fault:
        Left(value: i64)

module Second:
    enum Kind:
        Right(value: i64)
    error Fault:
        Right(value: i64)

def load_first() -> i64 error[First::Fault]:
    raise First::Fault.Left(11)

def load_second() -> i64 error[Second::Fault]:
    raise Second::Fault.Right(22)

module FirstUse:
    using First as E

    def match_statement(value: E::Kind) -> i64:
        match value:
            E::Kind.Left(payload):
                return payload
            _:
                return -1
        return -2

    def match_expression(value: E::Kind) -> i64:
        return match value:
            E::Kind.Left(payload): payload
            _: -1

    def catch_call() -> i64:
        return catch load_first():
            value: value
            E::Fault.Left(payload): payload

    def catch_value() -> i64:
        source: i64 error[First::Fault] = load_first()
        return catch source:
            value: value
            E::Fault.Left(payload): payload

module SecondUse:
    using Second as E

    def match_statement(value: E::Kind) -> i64:
        match value:
            E::Kind.Right(payload):
                return payload
            _:
                return -1
        return -2

    def match_expression(value: E::Kind) -> i64:
        return match value:
            E::Kind.Right(payload): payload
            _: -1

    def catch_call() -> i64:
        return catch load_second():
            value: value
            E::Fault.Right(payload): payload

    def catch_value() -> i64:
        source: i64 error[Second::Fault] = load_second()
        return catch source:
            value: value
            E::Fault.Right(payload): payload

def main() -> i64:
    return 1 if FirstUse::match_statement(First::Kind.Left(11)) != 11
    return 2 if SecondUse::match_statement(Second::Kind.Right(22)) != 22
    return 3 if FirstUse::match_expression(First::Kind.Left(11)) != 11
    return 4 if SecondUse::match_expression(Second::Kind.Right(22)) != 22
    return 5 if FirstUse::catch_call() != 11
    return 6 if SecondUse::catch_call() != 22
    return 7 if FirstUse::catch_value() != 11
    return 8 if SecondUse::catch_value() != 22
    return 0
