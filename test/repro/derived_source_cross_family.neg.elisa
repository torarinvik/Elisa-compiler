module First:
    struct Player[state Alive | Dead]:
        health: i64
        tag: i64
        derive state:
            Alive when self.health > 0
            Dead when self.health <= 0

module Second:
    struct Player[state Alive | Dead]:
        health: i64
        tag: i64
        derive state:
            Alive when self.health > 0
            Dead when self.health <= 0

def forge(player: Second::Player[Alive]) -> First::Player[Alive]:
    return player{tag = 1}
