error Failure:
    Bad

def read_value(fail: bool) -> i64 error[Failure]:
    raise Failure.Bad if fail
    return 42

def select_value(fail: bool, visits: mutable i64&) -> i64:
    value: i64 = 100
    chosen: i64 = catch read_value(fail):
        value:
            visits <- visits + 1
            value + 1
        error failure:
            _ = failure
            visits <- visits + 10
            9
    return chosen + value

def terminated(fail: bool) -> i64:
    return catch read_value(fail):
        value:
            _ = value
            return 7
        error failure:
            _ = failure
            return 9

def main() -> i64:
    visits: mutable i64 = 0
    return 1 if select_value(false, visits) != 143
    return 2 if visits != 1
    return 3 if select_value(true, visits) != 109
    return 4 if visits != 11
    return 5 if terminated(false) != 7 or terminated(true) != 9
    return 0
