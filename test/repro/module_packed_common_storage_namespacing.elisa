# Common storage annotations must be keyed by declaring module as well as enum and field.
# Alpha and Beta intentionally reuse both the enum and common-field names but request
# different physical storage modes.
module Alpha:
    packed enum Result:
        common:
            @storage(inline)
            value: i64
        Ok(payload: i64)

    def read(owner: Arena) -> i64:
        store: Alpha::Result.Store[Local] = Alpha::Result.Store(owner)
        result: mutable i64 = 0
        in store:
            value: Alpha::Result = new Alpha::Result.Ok(value: 11, payload: 101)
            result <- match value:
                Alpha::Result.Ok(v): value.value + v
        return result

module Beta:
    packed enum Result:
        common:
            @storage(side_table)
            value: i64
        Failed(payload: i64)

    def read(owner: Arena) -> i64:
        store: Beta::Result.Store[Local] = Beta::Result.Store(owner)
        result: mutable i64 = 0
        in store:
            value: Beta::Result = new Beta::Result.Failed(value: 11, payload: 11)
            result <- match value:
                Beta::Result.Failed(v): value.value + v
        return result

def main() -> i64:
    region r(4096):
        return 0 if Alpha::read(r) == 112 and Beta::read(r) == 22 else 1
