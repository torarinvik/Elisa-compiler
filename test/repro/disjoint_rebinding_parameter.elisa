# Even when callers pass distinct arrays, rebinding one mutable reference to the other makes
# accesses later in the callee alias. Parameter-origin alias scopes must not cross this body.
def update_pair(first: mutable darray[i64]&, second: mutable darray[i64]&) -> void:
    first <- second
    first[0] <- 7

def main() -> i64:
    left: mutable darray[i64] = [1]
    right: mutable darray[i64] = [2]
    update_pair(&left, &right)
    return right[0]
