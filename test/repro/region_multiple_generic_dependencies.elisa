include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"

struct Box[@r]:
    value: i64& @r

struct Pair[@a, @b]:
    left: Box[a]
    right: Box[b]

def main() -> i64:
    region first(64)
    first_value: i64& @first = new[first] 5
    region second(64)
    second_value: i64& @second = new[second] 6
    left: Box[first] = Box{value: first_value}
    right: Box[second] = Box{value: second_value}
    pair: Pair[first, second] = Pair{left: left, right: right}
    destroy first
    return pair.left.value[0]
