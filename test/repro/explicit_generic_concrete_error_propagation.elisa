# Concrete error sets must survive explicit generic propagation in statement
# and value positions. This mirrors the standard arena dictionary wrappers.
error ConcreteFailure:
    Rejected

def checked_value[T](value: T, fail: bool) -> T error[ConcreteFailure]:
    raise ConcreteFailure.Rejected if fail
    return value

def checked_void[T](value: T, fail: bool) -> void error[ConcreteFailure]:
    raise ConcreteFailure.Rejected if fail

def inferred_value[T](value: T, fail: bool) -> T error[ConcreteFailure]:
    return try checked_value(value, fail)

def inferred_void[T](value: T, fail: bool) -> void error[ConcreteFailure]:
    try checked_void(value, fail)

def forward_value(value: i64, fail: bool) -> i64 error[ConcreteFailure]:
    return try inferred_value[i64](value, fail)

def forward_void(fail: bool) -> void error[ConcreteFailure]:
    try inferred_void[i64](7, fail)

def observe_void(fail: bool) -> i64 error[ConcreteFailure]:
    try forward_void(fail)
    return 42

def main() -> i64:
    good: i64 = try forward_value(41, false) else -1
    bad: i64 = try forward_value(41, true) else 1
    void_bad: i64 = try observe_void(true) else 1
    void_good: i64 = try observe_void(false) else -1
    return 0 if good == 41 and bad == 1 and void_bad == 1 and void_good == 42 else 2
