# Regression: a value-if arm calling a function with an i32 -> i64 postfix cast
# must keep the call in the true arm at -O2 when compiled by stage1.
def convert_postfix_i32_call(value: i64) -> i64:
    return 62 + value

def conditional_postfix_i32_call(value: i32) -> i64:
    return convert_postfix_i32_call(value.i64()) if value != 1 else 1

export fn conditional_postfix_i32_call_api(value: i32) -> i64 = conditional_postfix_i32_call
