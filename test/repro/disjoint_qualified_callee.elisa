# The module-qualified call forwards the same arrays for both mutable parameters. A second
# source call with fresh arrays must not make the qualified call disappear from the proof.
module Ops:
    def update_pair(first: mutable darray[i64]&, second: mutable darray[i64]&) -> void:
        first[0] <- second[0]

def forward_same(first: mutable darray[i64]&, second: mutable darray[i64]&) -> void:
    Ops::update_pair(first, first)

def main() -> i64:
    left: mutable darray[i64] = [1]
    right: mutable darray[i64] = [2]
    Ops::update_pair(&left, &right)
    return 0
