# Growth inside `in a:` goes to the caller's arena: accepted, and every function keeps
# stage0's arity (no hidden slot for an Arena-taking function).
struct S:
    items: mutable darray[u32]

def grow_in(a: mutable Arena&, xs: mutable darray[u32]&):
    in a:
        xs.push(1)

def grow_amb(xs: mutable darray[u32]&):
    xs.push(1)

def field_in(a: mutable Arena&, s: mutable S&):
    in a:
        s.items.push(1)

def reserve_in(a: mutable Arena&, xs: mutable darray[u32]&):
    in a:
        _ = xs.reserve(10)

def main() -> int:
    xs: mutable darray[u32] = []
    grow_amb(xs)
    return 0
