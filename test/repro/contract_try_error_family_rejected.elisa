# An incompatible destination must still reject the real Failure family.
error Failure:
    Bad

def guarded(n: i64) -> i64 error[Failure] requires n >= 0:
    raise Failure.Bad if n == 0
    return n

error OtherFailure:
    Other

def relay(n: i64) -> i64 error[OtherFailure]:
    return try guarded(n)

def main() -> i64:
    return 0
