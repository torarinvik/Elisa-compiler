# The second family's zero ordinal must retain its composite-family offset.
error First:
    Bad
error Second:
    Bad

def choose(second: bool) -> i64 error[First, Second]:
    raise Second.Bad if second
    raise First.Bad

def classify(second: bool) -> i64:
    catch choose(second):
        value:
            return value
        error failure:
            return 22 if failure == Second.Bad
            return 11 if failure == First.Bad
            return 99

def main() -> i64:
    return 0 if classify(false) == 11 and classify(true) == 22 else 1
