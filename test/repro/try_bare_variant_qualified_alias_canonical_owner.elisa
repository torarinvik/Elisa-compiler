# A local type alias to a different error-set family must keep its canonical owner.
module SetProvider:
    public:
        error Expected:
            ProviderTag

module OtherProvider:
    public:
        error Actual:
            ActualTag

from SetProvider import Expected

module ImportedAlias:
    type Expected = OtherProvider::Actual

    public:
        def origin() -> i64 error[Expected]:
            return 1

        def actual_destination() -> i64 error[OtherProvider::Actual]:
            return try origin()

        def wrong_destination() -> i64 error[SetProvider::Expected]:
            return try origin()

# Qualified aliases preserve the ultimate ErrorSet owner across declaration hops.
module AliasA:
    public:
        type First = SetProvider::Expected

module AliasB:
    public:
        type Second = AliasA::First

        def chained_origin() -> i64 error[AliasB::Second]:
            return 2

def chained_destination() -> i64 error[SetProvider::Expected]:
    return try AliasB::chained_origin()

def main() -> i64:
    return 0
