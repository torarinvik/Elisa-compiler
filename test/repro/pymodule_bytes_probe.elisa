def byte_count(data: darray[u8]) -> usize:
    return data.count

def pair_count(first: darray[u8], second: darray[u8]) -> usize:
    return first.count + second.count

def byte_echo(data: darray[u8]) -> darray[u8]:
    return data

export pymodule bytesprobe:
    fn count = byte_count
    fn pair_count
    fn echo = byte_echo
