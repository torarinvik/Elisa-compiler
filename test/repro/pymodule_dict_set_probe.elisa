def roundtrip(values: dict[i64, set[i64]]) -> dict[i64, set[i64]]:
    return values

def roundtrip_text(values: dict[cstr, set[sview]]) -> dict[cstr, set[sview]]:
    return values

def roundtrip_nested(values: dict[i64, dict[i64, set[i64]]]) -> dict[i64, dict[i64, set[i64]]]:
    return values

def count_bool(values: set[bool]) -> usize:
    return values.count

def roundtrip_bool(values: set[bool]) -> set[bool]:
    return values

export pymodule dict_set_probe:
    fn roundtrip
    fn roundtrip_text
    fn roundtrip_nested
    fn count_bool
    fn roundtrip_bool
