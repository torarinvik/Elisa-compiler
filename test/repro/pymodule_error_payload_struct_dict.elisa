error StructDictPayloadError:
    Bad(code: i64, values: dict[i64, i64])

error TextStructDictPayloadError:
    Bad(label: sview, values: dict[sview, sview])

def fail_dict(code: i64, values: dict[i64, i64]) -> i64 error[StructDictPayloadError]:
    raise StructDictPayloadError.Bad(code, values)

def fail_text(label: sview, values: dict[sview, sview]) -> i64 error[TextStructDictPayloadError]:
    raise TextStructDictPayloadError.Bad(label, values)

export pymodule error_payload_struct_dict:
    fn fail_dict
    fn fail_text
