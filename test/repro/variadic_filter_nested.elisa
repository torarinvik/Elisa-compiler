# Recursive collection must share variadic markers without losing fixed arity.
module VariadicFilter:
    public:
        def accept_extra(required: i64, ...) -> i64:
            return required

        def fixed(value: i64) -> i64:
            return value

def main() -> i64:
    return VariadicFilter::fixed(VariadicFilter::accept_extra(42, 7, 9))
