# A struct field's `= default` initializer was PARSED and then DISCARDED, so a labeled
# literal that omitted the field stored a zero instead of the default. The parser kept only
# `has_default: bool` (enough to make the field omittable, which is why the programs below
# COMPILED) and threw the expression away, and the backend's `Expr.Construct` emitter starts
# from a zero aggregate — so `P{}` answered 0 where stage0 answers 42.
#
# The default now rides on the StructMember row into a StructTable SIDE TABLE keyed by
# (struct, field), and the construct emitter fills every omitted position that has one.
# A side table rather than an array parallel to `field_names`: six sites push field rows and
# only two of them have a Decl to read defaults from, so a parallel array would have to be
# kept in lockstep by all six or silently misindex every field past the gap.
#
# Two fallbacks to the zero are deliberate and are covered below: an omitted field with NO
# default (`Q.b`), and a positional literal, which supplies fields by order.
#
# stage0 answers 49.
struct P:
    x: i64 = 42
    y: i64 = 7


struct Q:
    a: i64 = 5
    b: i64


def main() -> i64:
    # Both fields defaulted, both omitted.
    p: P = P{}
    # One field given, one defaulted — the given value must WIN over the default.
    q: P = P{x: 10}
    # A defaulted field alongside a required one: `a` defaults, `b` is supplied.
    r: Q = Q{b: 3}
    # Every field supplied: no default is consulted at all.
    s: P = P{x: 1, y: 2}

    total: i64 = p.x + p.y + q.x + q.y + r.a + r.b + s.x + s.y
    # 42 + 7 + 10 + 7 + 5 + 3 + 1 + 2 = 77
    return total - 28
