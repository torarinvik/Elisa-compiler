# Named constants need the same branch choice as the backend's const folder. The public
# selective arm and wildcard fallback are active; private alternatives in their sibling
# arms must not hide those public candidates or the definite root functions below.
const USE_PUBLIC_IMPORT: bool = true
const USE_PRIVATE_WILDCARD: bool = false

module PrivateProvider:
    private:
        def pick(value: bool) -> i64:
            return 1

module PublicProvider:
    public:
        def pick(value: bool, marker: bool) -> i64:
            return 2

module PrivateWildcardProvider:
    private:
        def retrieve(value: bool) -> i64:
            return 4

module PublicWildcardProvider:
    public:
        def retrieve(value: bool, marker: bool) -> i64:
            return 5

static if USE_PUBLIC_IMPORT:
    from PublicProvider import pick
static else:
    from PrivateProvider import pick

static if USE_PRIVATE_WILDCARD:
    using PrivateWildcardProvider
static else:
    using PublicWildcardProvider

# These definite public root siblings have Core's direct lexical priority over imports,
# and remain callable alongside the selected public selective and wildcard rows.
def pick[T](value: T) -> i64:
    return 3

def retrieve[T](value: T) -> i64:
    return 6

def main() -> i64:
    return pick(true) + retrieve(true)
