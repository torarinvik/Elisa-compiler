# An ancestor module scope registers before its nested scopes, even when the nested
# module appears first in source order. The root alias is the analyzer-wide winner.
module Outer:
    module Safe:
        type Plain = i64

    module Wrong:
        type Plain = sview

    using Wrong as Pick

    static if true:
        module Inner:
            module Wrong:
                type Plain = sview

            using Wrong as BranchScopePick
        using Safe as BranchScopePick

module Safe:
    type Plain = i64

module Wrong:
    type Plain = sview

using Safe as Pick

def main() -> i64:
    value: Pick::Plain = zeroed
    branch_scope_value: BranchScopePick::Plain = zeroed
    return value + branch_scope_value
