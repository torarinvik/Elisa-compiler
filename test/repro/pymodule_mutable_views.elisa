def scale(values: mutable view[f64], factor: f64) -> i64:
    n: i64 = values.len.i64()
    for i in 0..<n:
        values[i] <- values[i] * factor
    return n

def bump(values: mutable view[i32]) -> i64:
    n: i64 = values.len.i64()
    for i in 0..<n:
        values[i] <- values[i] + 1
    return n

export pymodule mutable_views:
    fn scale
    fn bump
