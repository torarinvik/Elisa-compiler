# Isolation probe for a nonempty darray literal in a struct field.
include "../../elisacore_std/elisacore_runtime.elisa"

struct NestedArrayHolder:
    rows: mutable darray[i64]

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    holder: mutable NestedArrayHolder = NestedArrayHolder{rows: [1, 2]}
    return 1 if holder.rows.count != 2 or holder.rows[1] != 2
    return 0
