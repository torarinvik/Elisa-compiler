# A static parse function in Compile must neither suppress Runtime.parse's body walk nor make
# Runtime.caller's same-named runtime call look like a static call.
module Compile:
    static def parse() -> i64:
        return 1

module Runtime:
    static def helper() -> i64:
        return 2

    def parse() -> i64:
        return helper()

    def caller() -> i64:
        return parse()

module Outer:
    static def ancestor_helper() -> i64:
        return 3

    static def shadowed_helper() -> i64:
        return 7

    module Inner:
        def nested_caller() -> i64:
            return ancestor_helper()

    module RuntimeShadow:
        def shadowed_helper() -> i64:
            return 8

        def caller() -> i64:
            return shadowed_helper()

module NestedCalls:
    static def hidden() -> i64:
        return 9

    def comprehension() -> darray[i64]:
        return [hidden() for item in 0..<1]

    def matched() -> i64:
        return match 0:
            0: hidden()
            _: 0

    def loop_iterable() -> i64:
        for item in [hidden()]:
            pass
        return 0

    def indexed() -> i64:
        return [1][hidden().usize()]

    struct Box:
        value: i64 = hidden()

    def constructed() -> Box:
        return Box{value: hidden()}

    def constructed_default() -> Box:
        return Box{}

    def with_default(value: i64 = hidden()) -> i64:
        return value

    def omitted_default() -> i64:
        return with_default()

    def asserted() -> i64:
        assert hidden() == 9
        return 9

module BranchSelection:
    static def branch_static() -> i64:
        return 6

    static if false:
        static def branch_pick() -> i64:
            return 4
        def inactive_runtime_caller() -> i64:
            return branch_static()
    static else:
        def branch_pick() -> i64:
            return 5

    def runtime_branch_call() -> i64:
        return branch_pick()

module UnknownRuntimeShadow:
    static def compile_only() -> i64:
        return 10

    static def late_bound() -> i64:
        return 11

    module Inner:
        static if ELISA_TARGET_OS_WASI:
            def late_bound() -> i64:
                return 12

            def caller() -> i64:
                return late_bound() + compile_only()

module MixedOverloads:
    static def choose(value: i64) -> i64:
        return value

    def choose(value: f64) -> i64:
        return 1

    def runtime_caller() -> i64:
        return choose(1.5)
