struct Box:
    value: i64

def main() -> i64:
    region scratch(4096):
        scalar: i64 = new[scratch] 17
        box: Box = Box{value: new[scratch] 23}
        values: mutable darray[i64] = []
        values.push(new[scratch] 73)
        return scalar - 17 + box.value - 23 + values[0] - 73 can Unsafe.UncheckedIndex
