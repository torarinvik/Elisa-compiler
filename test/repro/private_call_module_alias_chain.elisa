# Private module ownership must survive a chain of using aliases.
module Secret:
    private:
        def hidden() -> i64:
            return 1

module Backend:
    module Nested:
        private:
            def nested_hidden() -> i64:
                return 2

using Secret as First
using First as Second
using Backend as BackendRoot
using BackendRoot::Nested as NestedSecret

module ProjectionWinner:
    public:
        def winner_only() -> i64:
            return 3

module ProjectionLoser:
    public:
        def loser_only() -> i64:
            return 4

using ProjectionWinner as ProjectionChoice
using ProjectionLoser as ProjectionChoice

def main() -> i64:
    return Second::hidden() + NestedSecret::nested_hidden() + ProjectionChoice::winner_only() + ProjectionChoice::loser_only()
