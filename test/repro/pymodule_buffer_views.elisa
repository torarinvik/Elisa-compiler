# Read-only views of fixed-width numbers borrow a matching one-dimensional, C-contiguous
# Python buffer instead of copying it element by element; any other argument (a list, a
# buffer of another format, a strided memoryview) still converts as a sequence.
def sum_f64(values: view[f64]) -> f64:
    total: mutable f64 = 0.0
    for value in values |total| -> total:
        total <- total + value
    return total

def sum_f32(values: view[f32]) -> f64:
    total: mutable f64 = 0.0
    for value in values |total| -> total:
        total <- total + value.f64()
    return total

def sum_i32(values: view[i32]) -> i64:
    total: mutable i64 = 0
    for value in values |total| -> total:
        total <- total + value.i64()
    return total

def sum_u64(values: view[u64]) -> u64:
    total: mutable u64 = 0
    for value in values |total| -> total:
        total <- total + value
    return total

# A u64 list converts with a range check on every element.
def sum_u64_list(values: darray[u64]) -> u64:
    total: mutable u64 = 0
    for value in values |total| -> total:
        total <- total + value
    return total

def identity_f64(values: view[f64]) -> view[f64]:
    return values

def count_u8(values: view[u8]) -> usize:
    total: mutable usize = 0
    for value in values |total| -> total:
        total <- total + 1
    return total

def scaled_sum(values: view[f64], scales: view[u8]) -> f64:
    total: mutable f64 = 0.0
    for value in values |total| -> total:
        total <- total + value
    return total * scales.len.f64()

export pymodule buffer_views:
    fn sum_f64
    fn sum_f32
    fn sum_i32
    fn sum_u64
    fn sum_u64_list
    fn identity_f64
    fn count_u8
    fn scaled_sum
