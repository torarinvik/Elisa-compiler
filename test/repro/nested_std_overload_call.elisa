include "../../elisacore_std/elisacore_runtime.elisa"

# A user function whose name the std also overloads generically (`add[T]`, `get`, `put`,
# `push`, `len`) was unusable in ARGUMENT position. Flat, `add(20, 22)` was always fine;
# nested, `add(add(20, 20), 2)` was a SIGTRAP inside LLVM for `add` and a plain decline for
# the other four. stage0 answers 42 for all of them.
#
# `exact_overload_exists` — "a non-generic overload matching the arguments EXACTLY beats the
# generic" — guarded the EMIT path (codegen_call.elisa) and not the TYPING path
# (codegen_scope.elisa, expression_type's Call arm). So the TYPE of a call to such a name was
# taken from the std template even when the user's own overload was the one being called.
# That is invisible at the top of a statement and fatal one level in: the inner call's wrong
# type made exact_overload_exists reject the OUTER call too, which then routed into the
# generic path and inferred a type argument from a size-less type — `getTypeSizeInBits` ->
# `brk #0x1`. Literal arguments never reach that arm, which is exactly why the flat call
# looked healthy.
#
# The controls matter as much as the repro: the guard must not make generics stop winning
# where there is no exact overload to prefer.
#
# stage0 answers 129.
def add(a: i64, b: i64) -> i64:
    return a + b


def get(a: i64, b: i64) -> i64:
    return a - b


def len(a: i64, b: i64) -> i64:
    return a * b


def identity[T](x: T) -> T:
    return x


def twice(v: i64) -> i64:
    return v + v


def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    # The reported crash, and two of the four declines beside it.
    nested_add: i64 = add(add(20, 20), 2)
    nested_get: i64 = get(get(20, 5), 5)
    nested_len: i64 = len(len(2, 3), 2)
    # The flat spelling stayed correct throughout — it must remain so.
    flat_add: i64 = add(20, 22)

    # CONTROL: a generic with NO exact overload, in argument position. Nothing here should
    # prefer a non-generic, so it must still resolve through the template.
    generic_nested: i64 = twice(identity(10))

    # 42 + 10 + 12 + 42 + 20 = 126
    return nested_add + nested_get + nested_len + flat_add + generic_nested + 3
