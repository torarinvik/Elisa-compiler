# Noncall source inference must use a parent-scoped alias for its sibling provider.
module Installer:
    module Provider::Nested:
        public:
            error SourceError:
                Bad

            def origin() -> i64 error[SourceError]:
                return 1

    from Provider::Nested import origin

    module Consumer:
        public:
            error Fault:
                Other

            def mismatched() -> i64 error[Fault]:
                payload = origin()
                return try payload

def main() -> i64:
    return 0
