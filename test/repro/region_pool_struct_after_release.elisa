include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/heap.elisa"

struct Holder:
    ptr: mutable heap i64&

def bad() -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release]:
    region scratch(4096):
        pool: mutable RegionPool[i64] = region_pool_new(&scratch)
        handle: Pooled[i64] = pool.acquire()
        handle.ptr[0] <- 65
        holder: Holder = Holder{ptr: handle.ptr}
        pool.release(move handle)
        return holder.ptr[0]

def main() -> i64:
    return 0
