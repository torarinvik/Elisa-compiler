# Read-only view parameters accept ordinary Python sequences while keeping the native
# two-word view ABI (data pointer plus element count).
def count_i64(values: view[i64]) -> usize:
    total: mutable usize = 0
    for value in values:
        total <- total + 1
    return total

def first_i64(values: view[i64]) -> i64:
    return values[0.usize()]

def identity_i64(values: view[i64]) -> view[i64]:
    return values

def identity_u8(values: view[u8]) -> view[u8]:
    return values

def sum_u16(values: view[u16]) -> u64:
    total: mutable u64 = 0
    for value in values:
        total <- total + value.u64()
    return total

def count_text(values: view[sview]) -> usize:
    total: mutable usize = 0
    for value in values:
        total <- total + 1
    return total

def count_objects(values: view[py::Object]) -> usize:
    total: mutable usize = 0
    for value in values:
        total <- total + 1
    return total

def count_nullable(values: view[i64?]) -> usize:
    total: mutable usize = 0
    for value in values:
        total <- total + 1
    return total

export pymodule views:
    fn count_i64
    fn first_i64
    fn identity_i64
    fn identity_u8
    fn sum_u16
    fn count_text
    fn count_objects
    fn count_nullable
