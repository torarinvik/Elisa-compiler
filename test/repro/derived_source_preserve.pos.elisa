struct Player[state Alive | Dead]:
    health: mutable i64
    tag: i64
    derive state:
        Alive when self.health > 0
        Dead when self.health <= 0

def retag(player: Player[Alive]) -> Player[Alive]:
    return player{tag = 1}

def retag_conditional(player: Player[Alive], choice: bool) -> Player[Alive]:
    return player{tag = 1} if choice else player{tag = 2}

def main() -> i32:
    original: Player[Alive] = Player[Alive]{health: 7, tag: 0}
    tagged: Player[Alive] = retag(original)
    other: Player[Alive] = retag_conditional(original, false)
    return 1 if tagged.health != 7 or tagged.tag != 1 or original.tag != 0
    return 2 if other.health != 7 or other.tag != 2
    return 0
