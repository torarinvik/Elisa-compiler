# A same-module error set is visible and should trigger the shadow warning.
error Fault:
    Failed

def forward[errorset Fault](callback: fn() -> i64 error[Fault]) -> i64 error[Fault]:
    return try callback()

module Outer:
    public:
        error NestedFault:
            Failed

    module Inner:
        def nested_forward[errorset NestedFault](callback: fn() -> i64 error[NestedFault]) -> i64 error[NestedFault]:
            return try callback()

def main() -> i64:
    return 0
