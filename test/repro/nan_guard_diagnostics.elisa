# Intentional IEEE NaN checks must not receive constant-self-comparison or
# tolerance/style diagnostics. Ordinary integer and float warnings remain.
include "../../src/semantic/semantic.elisa"

def count_kind(source: sview, kind: Semantic::DiagnosticKind) -> usize:
    raw: u8& = source.data
    tokens: darray[Token] = frontend_tokenize_with_length(raw, raw, source.len.usize())
    file: Ast::File = frontend_parser_parse_file(raw, tokens)
    table: Semantic::SymbolTable = Semantic::check(file)
    for diagnostic in table.diagnostics |count: usize = 0| -> count:
        count += 1 if diagnostic.kind == kind

def main() -> i64:
    guard: sview = "def valid(value: f32) -> bool:\n    ensure not result or not (value != value)\n    return false if value != value\n    return false if value < 0.0 or value >= 1.0\n    true\n"
    return 1 if count_kind(guard, Semantic::DiagnosticKind.SelfComparison) != 0
    return 2 if count_kind(guard, Semantic::DiagnosticKind.FloatEquality) != 0
    return 3 if count_kind(guard, Semantic::DiagnosticKind.NegatedComparison) != 0
    integer: sview = "def same(value: i64) -> bool:\n    value == value\n"
    return 4 if count_kind(integer, Semantic::DiagnosticKind.SelfComparison) == 0
    ordinary_float: sview = "def same(left: f32, right: f32) -> bool:\n    left == right\n"
    return 5 if count_kind(ordinary_float, Semantic::DiagnosticKind.FloatEquality) == 0
    negated_integer: sview = "def different(left: i64, right: i64) -> bool:\n    not (left == right)\n"
    return 6 if count_kind(negated_integer, Semantic::DiagnosticKind.NegatedComparison) == 0
    double_guard: sview = "def valid(value: f64) -> bool:\n    not (value != value)\n"
    return 10 if count_kind(double_guard, Semantic::DiagnosticKind.SelfComparison) != 0 or count_kind(double_guard, Semantic::DiagnosticKind.FloatEquality) != 0 or count_kind(double_guard, Semantic::DiagnosticKind.NegatedComparison) != 0
    scoped_integer: sview = "def same(value: f32) -> bool:\n    region integer_scope:\n        value: i64 = 4\n        return value == value\n    false\n"
    return 11 if count_kind(scoped_integer, Semantic::DiagnosticKind.SelfComparison) == 0
    integer_nan_spelling: sview = "def different(value: i64) -> bool:\n    not (value != value)\n"
    return 12 if count_kind(integer_nan_spelling, Semantic::DiagnosticKind.NegatedComparison) == 0
    # Runtime IEEE behavior is unchanged by the diagnostic policy.
    nan: f32 = 0.0 / 0.0
    infinity: f32 = 1.0 / 0.0
    finite: f32 = 0.5
    positive_zero: f32 = 0.0
    negative_zero: f32 = -0.0
    return 7 if not (nan != nan)
    return 8 if finite != finite or infinity != infinity
    return 9 if positive_zero != negative_zero
    return 0
