include "../../elisacore_std/debug_referee.elisa"

def debug_referee_wasm32_score() -> i64:
    score: mutable i64 = 0
    score <- score + 1 if not debug_referee_is_poison(0)
    score <- score + 2 if not debug_referee_is_noncanonical_x86_64(0)
    score <- score + 4 if debug_referee_pointer_reason(0) == DEBUG_REFEREE_REASON_OK
    return score

export fn wasm32_debug_referee_smoke() -> i64 = debug_referee_wasm32_score
