# A local ErrorSet alias must follow a selectively imported type-alias target.
module Provider:
    public:
        error Expected:
            Failed
        type Base = Expected

from Provider import Base
type AliasExpected = Base

module Consumer:
    public:
        error Other:
            Oops
        def origin() -> i64 error[AliasExpected]:
            return 1
        def bad() -> i64 error[Other]:
            return try origin()

def main() -> i64:
    return 0
