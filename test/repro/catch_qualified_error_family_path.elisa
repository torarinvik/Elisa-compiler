module Provider:
    error Fault:
        Broken
        ProviderOnly

module Caller:
    using Provider as P
    error Fault:
        Broken
        CallerOnly
    extern load() -> i64 error[P::Fault]
    def incomplete() -> i64:
        catch load():
            value: 0
            Provider::Fault.Broken: 1
        return 0
