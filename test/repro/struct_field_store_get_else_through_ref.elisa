# `holder.bag <- get make_bag(seed) else return false` stores the unwrapped result of an
# optional factory into a field reached through a `mutable T&` parameter. stage1 threaded
# the caller's region for a direct call but not through `get`, so the bag's darray was
# built in the callee's own region, freed on return, and read back as clobbered values.
# stage0 rejects this form ("value escapes its `in auto:` scope"); stage1 builds it in the
# caller's region and must exit 0.
struct Item:
    value: i64

struct Bag:
    items: mutable darray[Item]

struct Holder:
    bag: mutable Bag

def make_bag(seed: i64) -> Bag? can[Memory.Allocate]:
    items: mutable darray[Item] = []
    items.push(Item{value: seed})
    Bag{items: items}

def adopt(holder: mutable Holder&, seed: i64) -> bool can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate:
        holder.bag <- get make_bag(seed) else return false
    true

# Builds and drops scratch items in this call's own region, so a block freed by an earlier
# call's region is reused and overwritten here: a dangling bag then reads these values.
def clobber() -> i64 can[Memory.Allocate, Abort.Panic]:
    scratch: mutable darray[Item] = []
    for index in 0..<256 |scratch|:
        scratch.push(Item{value: -1})
    scratch.count.i64()

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    holder: mutable Holder = Holder{bag: Bag{items: []}}
    return 2 if not adopt(&holder, 7)
    _ = clobber()
    return 1 if holder.bag.items.count != 1 or holder.bag.items[0].value != 7
    0
