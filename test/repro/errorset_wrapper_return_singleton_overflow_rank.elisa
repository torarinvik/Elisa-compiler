# Core keeps a unique callable's return type after reporting positional overflow;
# EWR must not apply the overload-set arity prefilter to singleton calls.
module Provider:
    public:
        error Fault:
            Failed

        def select(value: i64) -> i64 error[Provider::Fault]:
            return value

from Provider import select

module Consumer:
    public:
        error Expected:
            Rejected

        def wrapper(value: i64) -> i64 error[Consumer::Expected]:
            return select(value, 3)

def main() -> i64:
    return 0
