# Core keeps alias spelling in bare import candidates. A missing F/W source path must
# fall through to the same-named root enum instead of expanding to the aliased module.
module RealSelective:
    public:
        const enum SelectiveMode of i64:
            High = 41

module RealWildcard:
    public:
        const enum WildMode of i64:
            High = 61

const enum SelectiveMode of i64:
    High = 47

const enum WildMode of i64:
    High = 67

using RealSelective as F
using F::SelectiveMode
using RealWildcard as W
using W

def selective_alias_source(value: i64 = SelectiveMode.High) -> i64:
    return value

def wildcard_alias_source(value: i64 = WildMode.High) -> i64:
    return value

export pymodule alias_import_source_spelling:
    fn selective_alias_source
    fn wildcard_alias_source
