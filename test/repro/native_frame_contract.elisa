struct FrameCounter:
    value: mutable i64
    stable: mutable i64

def increment_framed(counter: mutable FrameCounter&) -> i64:
    changes counter.value
    preserves counter.stable
    counter.value <- counter.value + 1
    return counter.value

def main() -> i64:
    counter: mutable FrameCounter = FrameCounter{value: 3, stable: 7}
    updated: i64 = increment_framed(&counter)
    return 1 if updated != 4 or counter.value != 4 or counter.stable != 7
    return 0
