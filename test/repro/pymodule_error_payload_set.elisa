error SetPayloadError:
    Bad(values: set[i64])

def fail(values: set[i64]) -> i64 error[SetPayloadError]:
    raise SetPayloadError.Bad(values)

error StructuredSetPayloadError:
    Bad(code: i64, values: set[i64], labels: set[sview])

def fail_structured(code: i64, values: set[i64], labels: set[sview]) -> i64 error[StructuredSetPayloadError]:
    raise StructuredSetPayloadError.Bad(code, values, labels)

struct Holder:
    values: set[i64]

error HolderSetPayloadError:
    Bad(holder: Holder)

def fail_holder(holder: Holder) -> i64 error[HolderSetPayloadError]:
    raise HolderSetPayloadError.Bad(holder)

export pymodule error_payload_set:
    fn fail
    fn fail_structured
    fn fail_holder
