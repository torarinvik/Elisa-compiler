struct Player[state Alive | Dead]:
    health: mutable i64
    tag: i64
    derive state:
        Alive when self.health > 0
        Dead when self.health <= 0

def kill_or_return(player: mutable Player[Alive], choice: bool) -> Player[Dead]:
    if choice:
        player.health <- 0
    else:
        return Player[Dead]{health: -1, tag: 1}
    return player{tag = 1}

def main() -> i32:
    original: Player[Alive] = Player[Alive]{health: 7, tag: 0}
    first: Player[Dead] = kill_or_return(original, true)
    second: Player[Dead] = kill_or_return(original, false)
    return 1 if first.health != 0 or second.health != -1
    return 2 if original.health != 7 or first.tag != 1 or second.tag != 1
    return 0
