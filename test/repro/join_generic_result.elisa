# `join[R]` must retrieve both scalar and aggregate worker results. The large
# record forces the aggregate return ABI through the generic join helper.
include "../../elisacore_std/elisacore_runtime.elisa"

module UnrelatedGlobal:
	global mutable slot: i64 = 0

affine struct WideJoinResult:
	first: mutable i64
	second: mutable i64
	third: mutable i64
	fourth: mutable i64
	values: mutable darray[i64]
	bytes: mutable u8[16]

module JoinResultFixture:
	public:
		struct Nested:
			value: mutable i64
			device: mutable u64
			digest: mutable u8[65]

		const enum State of i64:
			Unknown = 0
			Verified = 1

		affine struct Result:
			ticket: mutable i64
			path: mutable darray[u8]
			bytes: mutable u8[65]
			nested: mutable Nested
			state: mutable State

# The Studio callers instantiate the same generic reader for several
# owner-qualified `Result` types in one input. Include payload enums and nested
# dynamic arrays so the reducer covers that specialization table shape too.
module CandidateResultFixture:
	public:
		enum Evidence:
			Unknown
			Verified(value: darray[u8])

		struct Snapshot:
			outcome: Evidence
			rows: darray[Row]

		struct Row:
			artifact: i64
			path: darray[u8]
			identity: Evidence

		affine struct Result:
			ticket: i64
			snapshot: Snapshot

module OtherResultFixture:
	public:
		struct Result:
			ticket: i64
			operation: darray[u8]
			flags: u8[512]

def scalar_join_worker(value: i64) -> i64:
	return value + 1

def aggregate_join_worker(value: i64) -> WideJoinResult:
	mutable result: WideJoinResult = zeroed
	result.first <- value
	result.second <- value + 1
	result.third <- value + 2
	result.fourth <- value + 3
	result.bytes[0] <- 99
	return move result

def main() -> i64:
	can Thread.Spawn, Thread.Join, Memory.Allocate, Memory.Release, Abort.Panic, Atomics.Load, Atomics.Store, Atomics.CompareExchange:
		mutable composite_seed: JoinResultFixture::Result = zeroed
		composite_seed.ticket <- 73
		composite_seed.path.push(65)
		composite_seed.bytes[0] <- 66
		composite_seed.nested.value <- 67
		composite_seed.nested.device <- 68
		composite_seed.nested.digest[64] <- 69
		composite_seed.state <- JoinResultFixture::State.Verified
		composite_result: JoinResultFixture::Result = ctx_concurrency_result_read[JoinResultFixture::Result]((&composite_seed).cast[void&] can Unsafe.PointerCast)
		return 1 if composite_result.ticket != 73 or composite_result.path[0] != 65 or composite_result.bytes[0] != 66 or composite_result.nested.value != 67 or composite_result.nested.device != 68 or composite_result.nested.digest[64] != 69 or composite_result.state != JoinResultFixture::State.Verified
		mutable candidate_seed: CandidateResultFixture::Result = zeroed
		candidate_seed.ticket <- 74
		candidate_result: CandidateResultFixture::Result = ctx_concurrency_result_read[CandidateResultFixture::Result]((&candidate_seed).cast[void&] can Unsafe.PointerCast)
		return 1 if candidate_result.ticket != 74
		mutable other_seed: OtherResultFixture::Result = zeroed
		other_seed.ticket <- 75
		other_result: OtherResultFixture::Result = ctx_concurrency_result_read[OtherResultFixture::Result]((&other_seed).cast[void&] can Unsafe.PointerCast)
		return 1 if other_result.ticket != 75
		scalar_thread: Thread[i64, Joinable] = task(scalar_join_worker, 41)
		scalar_result: i64 = future_get(move scalar_thread)
		wide_thread: Thread[WideJoinResult, Joinable] = task(aggregate_join_worker, 10)
		wide_result: WideJoinResult = future_get(move wide_thread)
		return 0 if scalar_result == 42 and wide_result.first == 10 and wide_result.second == 11 and wide_result.third == 12 and wide_result.fourth == 13 and wide_result.bytes[0] == 99 else 1
