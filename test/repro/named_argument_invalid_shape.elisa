def sink(value: i64) -> i64:
    return value

def bad_literal() -> i64:
    return sink(value: true, value: false)

def bad_variable(flag: bool) -> i64:
    return sink(value: flag, value: flag)

def good() -> i64:
    return sink(value: 1)

def main() -> i64:
    return 0

def needs_two(left: bool, right: i64) -> i64:
    return right

def missing_required() -> i64:
    return needs_two(right: true)

def defaulted(left: bool = true, right: i64 = 1) -> i64:
    return right

def supplied_type_error() -> i64:
    return defaulted(right: true)
