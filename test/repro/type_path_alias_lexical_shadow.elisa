module RootProvider:
    struct Item:
        value: i64
module OuterProvider:
    module Nested:
        struct Item:
            value: i64
using RootProvider as Choice
module Scope:
    using OuterProvider as Choice
    def local(value: Choice::Nested.Item) -> i64:
        return 0
    module Child:
        def inherited(value: Choice::Nested.Item) -> i64:
            return 0
def outside(value: Choice.Item) -> i64:
    return 0
