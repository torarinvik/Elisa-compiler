packed enum Node:
    Leaf(value: i64)

def probe(owner: Arena) -> i64:
    first_store: Node.Store[Local] = Node.Store(owner)
    second_store: Node.Store[Local] = Node.Store(owner)
#line 0 packed-new-store-owner.elisa
    first: Node = new[first_store] Node.Leaf(value: 11)
#line 0 packed-new-store-owner.elisa
    second: Node = new[second_store] Node.Leaf(value: 22)
    first_value: mutable i64 = 0
    second_value: mutable i64 = 0
    in first_store:
        first_value <- match first:
            Node.Leaf(value): value
    in second_store:
        second_value <- match second:
            Node.Leaf(value): value
    return first_value + second_value

def main() -> i64:
    region arena(4096):
        return 0 if probe(arena) == 33 else 1
