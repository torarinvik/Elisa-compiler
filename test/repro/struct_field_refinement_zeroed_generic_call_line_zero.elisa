struct Positive:
    value: mutable i64 where value > 0

#line 0 zeroed-generic-call-line-zero.elisa
def prior[U](value: U) -> U:
    return value

#line 0 zeroed-generic-call-line-zero.elisa
def identity[T](value: T) -> T:
    return value

def main() -> i64:
    invalid: Positive = identity[Positive](zeroed)
    return invalid.value
