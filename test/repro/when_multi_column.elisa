# Multi-column `when` — the decision-table form (docs/125 §4).
#
# `when a, b:` desugars (in BOTH compilers' parsers) to a `match` over a tuple scrutinee with
# `Pattern.Tuple` rows. The stage1 backend had no lowering for it at any spelling, so every
# enclosing body declined — silently, until the driver started rejecting a program that drops
# a body something calls. The compiler's own lexer still carries a hand-rolled workaround
# with a comment naming this gap.
#
# Each case below returns a distinct value, so a row that matches the WRONG way is a wrong
# answer rather than a decline.

# Literal columns, plus the fall-through to `_`.
def grade(a: i64, b: i64) -> i64:
    return when a, b:
        0, 0 -> 1
        1, 1 -> 2
        _, _ -> 3

# A wildcard in one column only: `0, _` must hit for ANY b.
def left_only(a: i64, b: i64) -> i64:
    return when a, b:
        0, _ -> 4
        _, _ -> 5

# `|` binds WITHIN a column, so `1 | 2` is one column's option list — not two rows.
def or_column(a: i64, b: i64) -> i64:
    return when a, b:
        1 | 2, 7 -> 6
        _, _ -> 7

# A RANGE column alongside a literal one.
def ranged(a: i64, b: i64) -> i64:
    return when a, b:
        0..<10, 1 -> 8
        _, _ -> 9

# Three columns, and a `bool` column — `true`/`false` reach the backend as literal text, not
# as integers, so they need their own reading.
def triple(a: bool, b: i64, c: i64) -> i64:
    return when a, b, c:
        true, 2, 3 -> 10
        false, 2, 3 -> 11
        _, _, _ -> 12

# VALUE position in a local rather than a `return`, which routes through a different emitter.
def in_local(a: i64, b: i64) -> i64:
    result: i64 = when a, b:
        5, 5 -> 13
        _, _ -> 14
    return result + 1

def main() -> i64:
    total: mutable i64 = 0
    total <- total + grade(0, 0)          # 1
    total <- total + grade(1, 1)          # 2
    total <- total + grade(4, 9)          # 3
    total <- total + left_only(0, 99)     # 4
    total <- total + left_only(1, 99)     # 5
    total <- total + or_column(2, 7)      # 6
    total <- total + or_column(3, 7)      # 7
    total <- total + ranged(5, 1)         # 8
    total <- total + ranged(50, 1)        # 9
    total <- total + triple(true, 2, 3)   # 10
    total <- total + triple(false, 2, 3)  # 11
    total <- total + triple(true, 0, 0)   # 12
    total <- total + in_local(5, 5)       # 14
    total <- total + in_local(1, 2)       # 15
    return total                          # 1+2+…+12 = 78, +14+15 = 107
