global mutable generation_scan_root: darray[u8] = []

def main() -> i64:
	can Memory.Allocate, Global.Read, Global.Write, Abort.Panic:
		return 1 if generation_scan_root.count != 0
		generation_scan_root.push(65)
		generation_scan_root.push(66)
		return 2 if generation_scan_root.count != 2
		return 3 if generation_scan_root[0] != 65 or generation_scan_root[1] != 66
		return 0
