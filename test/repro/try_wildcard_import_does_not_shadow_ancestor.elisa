# Core checks every lexical namespace before any wildcard using candidate.
module Api:
    public:
        error ImportedFault:
            Imported

        def ping() -> i64 error[Api::ImportedFault]:
            return 1

module Consumer:
    public:
        error LocalFault:
            Local

        def ping() -> i64 error[Consumer::LocalFault]:
            return 2

    module Inner:
        using Api

        public:
            def caller() -> i64 error[Consumer::LocalFault]:
                return try ping()

            def cached_caller() -> i64 error[Consumer::LocalFault]:
                payload = ping()
                return try payload

def main() -> i64:
    return 0
