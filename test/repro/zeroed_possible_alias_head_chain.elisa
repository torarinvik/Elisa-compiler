# A possible alias target can begin with an earlier module alias and continue
# through a nested module. Its alias is declared in a nested module and used from
# the root, matching Stage0's analyzer-wide module alias map.
module Outer:
    public:
        module Nested:
            public:
                type Borrowed = sview

using Outer as First

module AliasInstaller:
    static if ELISA_TARGET_OS_WASI:
        using First::Nested as Maybe

def possible_alias_head_chain() -> i64:
    text: Maybe::Borrowed = zeroed
    return 0

def main() -> i64:
    return 42
