module Left:
    struct File[state Valid]:
        value: i64
        derive state:
            Valid when self.value > 0
module Right:
    struct File[state Valid]:
        value: i64
        derive state:
            Valid when self.value < 0
    def forge() -> i64:
        file: File[Valid] = File[Valid]{value: 1}
        return file.value
