module Provider:
    error Fault:
        OnlyProvider
        AlsoProvider
    extern load() -> i64 error[Provider::Fault]
    extern restricted() -> i64 error[Provider::Fault{OnlyProvider}]

module Peer:
    error Fault:
        OnlyPeer
    extern load() -> i64 error[Peer::Fault]
    extern restricted() -> i64 error[Peer::Fault{OnlyPeer}]

def qualified_load_incomplete() -> i64:
    catch Provider::load():
        value: 0
        Provider::Fault.OnlyProvider: 1
    return 0

def qualified_restricted_out_of_set() -> i64:
    catch Provider::restricted():
        value: 0
        Provider::Fault.AlsoProvider: 1
        Provider::Fault.OnlyProvider: 2
    return 0
