module Alpha:
    public:
        enum Node layout(handle: u32):
            pass
        enum Leaf is Node:
            Value(v: i64)
            Other(v: i64)

module Beta:
    public:
        enum Node layout(handle: u32):
            pass
        enum Leaf is Node:
            Other(v: i64)
            Value(v: i64)

def alpha() -> bool:
    can Memory.Allocate, Abort.Panic:
        region owner(65536):
            store: Alpha::Node.Store[Local] = Alpha::Node.Store(owner)
            in store:
                value: Alpha::Node = new Alpha::Leaf.Value(v: 42)
                return (value is Alpha::Leaf.Value) and not (value is Alpha::Leaf.Other)

def beta() -> bool:
    can Memory.Allocate, Abort.Panic:
        region owner(65536):
            store: Beta::Node.Store[Local] = Beta::Node.Store(owner)
            in store:
                value: Beta::Node = new Beta::Leaf.Value(v: 42)
                return (value is Beta::Leaf.Value) and not (value is Beta::Leaf.Other)

def main() -> i64:
    return 1 if not alpha()
    return 2 if not beta()
    return 0
