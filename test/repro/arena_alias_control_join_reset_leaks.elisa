# nopath
# A while/for/match path can leave an Arena& at its pre-branch owner before reset.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"

def skipped_while_case() -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release]:
    while_owner: mutable Arena = zeroed
    while_alloc: mutable Arena& = &while_owner
    while_values: mutable darray[i64] @while_alloc = [65]
    while_other_owner: mutable Arena = zeroed
    while_other: mutable Arena& = &while_other_owner
    mutable while_alias: mutable Arena& = while_alloc
    while while_values[0] == 64:
        while_alias <- while_other
    arena_reset(while_alias)
    while_replacement: mutable darray[i64] @while_alloc = [7]
    return while_values[0]

def empty_for_case() -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release]:
    for_owner: mutable Arena = zeroed
    for_alloc: mutable Arena& = &for_owner
    for_values: mutable darray[i64] @for_alloc = [65]
    for_other_owner: mutable Arena = zeroed
    for_other: mutable Arena& = &for_other_owner
    mutable for_alias: mutable Arena& = for_alloc
    for item in 0..<0:
        for_alias <- for_other
    arena_reset(for_alias)
    for_replacement: mutable darray[i64] @for_alloc = [7]
    return for_values[0]

def selected_match_case() -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release]:
    match_owner: mutable Arena = zeroed
    match_alloc: mutable Arena& = &match_owner
    match_values: mutable darray[i64] @match_alloc = [65]
    match_other_owner: mutable Arena = zeroed
    match_other: mutable Arena& = &match_other_owner
    mutable match_alias: mutable Arena& = match_alloc
    choice: i64 = 0
    match choice:
        1:
            match_alias <- match_other
        _:
            pass
    arena_reset(match_alias)
    match_replacement: mutable darray[i64] @match_alloc = [7]
    return match_values[0]

def main() -> i64:
    return 0
