# A function with a REGION PARAMETER `[@r]` must take the caller's arena.
#
# `prune[@r]` takes its darray BY VALUE — the header is copied, but the element storage is
# shared, so `boxes[i] <- b` IS visible to the caller. It builds `kept` in `@r`, i.e. in the
# CALLER's region, and stores it into an element. Nothing in the signature is a reference and
# the return type is void, so the "does this signature need an arena?" test that only looks at
# refs and the return type answers NO — the function then gets its own auto region, allocates
# `kept` there, and `arena_free`s it on return. The caller is left holding freed memory.
#
# Intermittent by nature: it only faults when the munmap'd block has not been remapped. This
# was the ~3% `easm_lockstep_parse_smoke` segfault, via
# `Easm::easm_prune_conditional_inputs[@r](variants: mutable darray[Function] @r)`.
#
# stage0 threads the arena whenever `[@r]` is present, and only then:
#     def prune[@r](boxes: mutable darray[Box] @r)  ->  void @prune(%DynArray__Box, ptr)
#     def prune(boxes: mutable darray[Box])         ->  void @prune(%DynArray__Box)
#
# Two elements, so the second one's allocation has to survive the first's bookkeeping too.
struct Box:
    items: mutable darray[i64]


def prune[@r](boxes: mutable darray[Box] @r) -> void:
    for i in 0..<boxes.count |boxes|:
        b: mutable Box = boxes[i]
        kept: mutable darray[i64] @r = []
        for v in b.items:
            kept.push(v * 10) if v != 2
        b.items <- kept
        boxes[i] <- b


def main() -> i64:
    boxes: mutable darray[Box] = []
    first: mutable darray[i64] = []
    first.push(1)
    first.push(2)
    first.push(3)
    second: mutable darray[i64] = []
    second.push(4)
    second.push(2)
    boxes.push(Box{items: first})
    boxes.push(Box{items: second})
    prune(boxes)
    # first  -> [10, 30]   second -> [40]
    total: mutable i64 = 0
    for box in boxes |total|:
        for value in box.items:
            total <- total + value
    return total + boxes[0].items.count.i64() + boxes[1].items.count.i64()
