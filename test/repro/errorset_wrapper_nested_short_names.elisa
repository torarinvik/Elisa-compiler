module Left:
    module Shared:
        error Fault:
            Failed
        def source() -> i64 error[Left::Shared::Fault]:
            return 1
module Right:
    module Shared:
        error Fault:
            Failed
    module Other:
        error Fault:
            Failed
    module SharedAgain:
        error Different:
            Failed
    def same_path() -> i64 error[Right::Shared::Fault]:
        return Left::Shared::source()
    def different_path() -> i64 error[Right::Other::Fault]:
        return Left::Shared::source()
    def different_family() -> i64 error[Right::SharedAgain::Different]:
        return Left::Shared::source()
