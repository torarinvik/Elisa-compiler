# The file-shared ForeignEnum family has no active producer when every closed
# extern enum that contributes it is under a proven-false static branch.
const ENABLE_INACTIVE_FOREIGN_ENUM_ORIGIN: bool = false
static if ENABLE_INACTIVE_FOREIGN_ENUM_ORIGIN:
    extern enum InactiveDeviceState of i32:
        Off = 0
        On = 1

extern inactive_foreign_enum_source() -> i64 error[ForeignEnum]

def all_foreign_enum_origins_inactive() -> i64:
    catch inactive_foreign_enum_source():
        value: 0
    return 0
