# Direct and fulfills-only frame fields must survive annotation compaction.
struct FrameFilterState:
    value: mutable i64
    other: mutable i64

law FrameFilterValue(self: FrameFilterState&) changes self.value

def frame_filter_direct(state: mutable FrameFilterState&) changes state.value:
    state.value <- 42

def frame_filter_inherited(state: mutable FrameFilterState&) fulfills state is FrameFilterValue:
    frame_filter_direct(state)

def frame_filter_caller(state: mutable FrameFilterState&) changes state.value:
    frame_filter_inherited(state)

def main() -> i64:
    state: mutable FrameFilterState = FrameFilterState{value: 0, other: 0}
    frame_filter_caller(&state)
    return state.value
