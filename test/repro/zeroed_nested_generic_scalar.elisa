struct ProbeSlot[Element]:
    value: mutable Element

struct ProbeCell[Element]:
    slot: mutable ProbeSlot[Element]

struct ProbeTask[Result, State]:
    handle: mutable uintptr
    state: mutable void&?

global mutable cell: ProbeCell[i32] = zeroed
global mutable slot: ProbeSlot[i32] = zeroed
global mutable task: ProbeTask[i64, i64] = zeroed

def zeroed_probe_task[Result, State]() -> ProbeTask[Result, State]:
    out: mutable ProbeTask[Result, State] = zeroed
    out.handle <- 0
    out.state <- null
    return move out

def main() -> i64:
    return 42 if cell.slot.value == 0 and slot.value == 0 and task.handle == 0 else 1
