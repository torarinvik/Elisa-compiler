# The backend must evaluate this row inside Outer: the root FEATURE is false,
# while the nearer module-owned FEATURE is true.
const FEATURE: bool = false

module Outer:
    const FEATURE: bool = true

    static if FEATURE:
        const SELECTED: i64 = 1
    static else:
        const SELECTED: i64 = 2

    public:
        def selected() -> i64:
            return SELECTED

def main() -> i64:
    return Outer::selected() - 1
