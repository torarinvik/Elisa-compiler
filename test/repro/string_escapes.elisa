include "../../elisacore_std/elisacore_runtime.elisa"

# The lexer leaves a string literal's escapes UNDECODED on purpose (its token carries the raw
# source interior), so the BACKEND owns decoding. stage1 did not decode at all: every literal
# reached LLVM with its backslashes intact, and a diagnostic written `f"… \"{name}\" …"`
# rendered as `\"name\"` where stage0 renders `"name"`.
#
# Length matters as much as content — an sview built from the SOURCE width would report 4 for
# `"a\nb"` and read one byte past the string.
def byte_count(literal: u8&) -> i64 can[Abort.Panic, Memory.Allocate]:
    n: mutable i64 = 0
    for _b in sview(literal, 0, -1) |n|:
        n <- n + 1
    return n


def byte_at(literal: u8&, index: i64) -> i64 can[Abort.Panic, Memory.Allocate]:
    n: mutable i64 = 0
    found: mutable i64 = -1
    for b in sview(literal, 0, -1) |n, found|:
        found <- b.i64() if n == index
        n <- n + 1
    return found


def main() -> i64 can[Abort.Panic, Memory.Allocate]:
    score: mutable i64 = 0
    score <- score + 1 if byte_count("a\"b") == 3
    score <- score + 2 if byte_at("a\"b", 1) == 34
    score <- score + 4 if byte_count("x\\y") == 3
    score <- score + 8 if byte_at("x\\y", 1) == 92
    score <- score + 16 if byte_count("p\nq") == 3
    score <- score + 32 if byte_at("p\nq", 1) == 10
    score <- score + 64 if byte_at("t\tu", 1) == 9
    return score
