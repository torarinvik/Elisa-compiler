law PositiveHandle(self: u64):
    return self > 0

type FeatureHandle = i64 is PositiveHandle

module Feature:
    def is_valid(handle: FeatureHandle) -> bool:
        return handle > 0

module Widgets:
    struct Handle:
        slot: u32

    def is_valid(handle: Handle) -> bool:
        return handle.slot > 0

    def check(handle: Handle) -> bool:
        # This resolves to Widgets::is_valid; Feature::is_valid must not donate
        # its unrelated refined parameter contract to the same-name call.
        return is_valid(handle)

    def check_refined(value: i64) -> bool:
        # The explicit module target really does require PositiveHandle.
        return Feature::is_valid(value)

module Container:
    module Feature:
        def is_valid_nested(value: FeatureHandle) -> bool:
            return value > 0

    module Widgets:
        def is_valid_nested(value: i64) -> bool:
            return value > 0

        def check_nested(value: i64) -> bool:
            # Same leaf module/function name, but under a different parent.
            return is_valid_nested(value)

        def check_nested_refined(value: i64) -> bool:
            return Feature::is_valid_nested(value)

def main() -> i64:
    return 0 if Widgets::check(Widgets::Handle{slot: 1}) and Widgets::check_refined(1) and Container::Widgets::check_nested(1) and Container::Widgets::check_nested_refined(1) else 1
