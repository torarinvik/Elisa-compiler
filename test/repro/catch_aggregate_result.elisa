# Regression: an expression-position catch may map an aggregate fallible payload
# to a scalar result. The success binding keeps the aggregate payload type while
# the catch itself is typed by the surrounding return expression.

error ProbeError:
    Failed

struct Box:
    value: i64

def produce(flag: bool) -> Box error[ProbeError]:
    raise ProbeError.Failed if flag
    return Box{value: 7}

def consume(flag: bool) -> i64:
    return catch produce(flag):
        ok:
            ok.value
        Failed:
            42

def main() -> i64:
    return consume(false) + consume(true)
