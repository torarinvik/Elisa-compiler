# The receiver overload search spans visible names imported from different modules.
# LibA's concrete i64 receiver outranks the generic alias candidate even though LibA's
# overload set is the only module-local overload set. The selective import is declared
# in a different module, matching Core's program-level import-alias behavior.
module LibA:
    public:
        error AError:
            Bad

        def choose[T](receiver: T) -> i64 error[AError]:
            return 1

        def choose(receiver: i64) -> i64 error[AError]:
            return 2

module AliasInstaller:
    from LibB import choose
    public:
        module LibB:
            public:
                error BError:
                    Other

                def choose[T](receiver: T) -> i64 error[BError]:
                    return 3

using LibA

module App:
    public:
        def mismatched(receiver: i64) -> i64 error[AliasInstaller::LibB::BError]:
            return try choose(receiver)

def main() -> i64:
    return 0
