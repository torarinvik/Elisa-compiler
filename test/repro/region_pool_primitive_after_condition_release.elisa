include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/heap.elisa"

def release_and_false(pool: mutable RegionPool[i64]&, handle: Pooled[i64]) -> bool can[Abort.Panic, Memory.Allocate, Memory.Release]:
    pool.release(move handle)
    return false

def bad() -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release]:
    region scratch(4096):
        pool: mutable RegionPool[i64] = region_pool_new(&scratch)
        handle: Pooled[i64] = pool.acquire()
        handle.ptr[0] <- 65
        ptr: mutable heap i64& = handle.ptr
        if release_and_false(&pool, move handle) or false:
            pass
        return ptr[0]

def main() -> i64:
    return 0
