# Signedness and width near 2^31 on a target whose usize is 32 bits. Every expected value is
# fixed by hand; an unsigned compare done signed, or a 32-bit value widened with sign, moves it.
def usize_gt(a: usize, b: usize) -> i32:
    return 1 if a > b else 0

def isize_lt(a: isize, b: isize) -> i32:
    return 1 if a < b else 0

def widen_u32(a: u32) -> u64:
    return a.u64()

def widen_i32(a: i32) -> i64:
    return a.i64()

def narrow_u64(a: u64) -> u32:
    return a.u32()

def count_up_to(n: usize) -> usize:
    seen: mutable usize = 0
    for i in 0..<n:
        seen <- seen + 1
    return seen

export fn usize_gt(a: usize, b: usize) -> i32 = usize_gt
export fn isize_lt(a: isize, b: isize) -> i32 = isize_lt
export fn widen_u32(a: u32) -> u64 = widen_u32
export fn widen_i32(a: i32) -> i64 = widen_i32
export fn narrow_u64(a: u64) -> u32 = narrow_u64
export fn count_up_to(n: usize) -> usize = count_up_to
