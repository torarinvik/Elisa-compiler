# Core chooses the concrete receiver overload before checking later arguments,
# then retains its ErrorSet even when a later argument type is invalid.
module Provider:
    public:
        error ConcreteFault:
            Concrete

        error GenericFault:
            Generic

        def choose(value: i64, later: bool) -> i64 error[Provider::ConcreteFault]:
            return value

        def choose[T](value: T, later: T) -> i64 error[Provider::GenericFault]:
            return 2

from Provider import choose

module Consumer:
    public:
        def wrapper(value: i64, later: i64) -> i64 error[Provider::GenericFault]:
            return choose(value, later)

def main() -> i64:
    return 0
