# A selective import of an ErrorSet alias in a sibling module is program-wide in Core.
module Provider:
    public:
        error Expected:
            Failed

module Origin:
    public:
        def origin() -> i64 error[AliasExpected]:
            return 1

module ImportSite:
    module AliasProvider:
        public:
            type AliasExpected = Provider::Expected

    from AliasProvider import AliasExpected

module Consumer:
    public:
        error Fault:
            Rejected

        def wrong_destination() -> i64 error[Fault]:
            return try Origin::origin()

def main() -> i64:
    return 0
