include "../../src/semantic/semantic.elisa"

extend Semantic:
    public:
        def derived_snapshot_probe(file: Ast::File&) -> i32 can[Memory.Allocate, Abort.Panic]:
            pos: Ast::Pos = Ast::pos_at_line(1)
            fields: darray[Ast::FieldInit] = [Ast::FieldInit{name: "low", value: Ast::Expr.IntLit(1, pos)}, Ast::FieldInit{name: "high", value: Ast::Expr.IntLit(3, pos)}]
            return 1 if file.derived_state_rules.count != 11
            for index in 0..<5:
                known: mutable bool = false
                holds: bool = derived_rule_holds(file.derived_state_rules[index].condition, &fields, known)
                return 2 if not known or not holds
            for index in 5..<11:
                known: mutable bool = true
                holds: bool = derived_rule_holds(file.derived_state_rules[index].condition, &fields, known)
                return 3 if known or holds
            duplicate: darray[Ast::FieldInit] = [fields[0], fields[1], fields[0]]
            known: mutable bool = true
            holds: mutable bool = derived_rule_holds(file.derived_state_rules[0].condition, &duplicate, known)
            return 4 if known or holds
            reversed: darray[Ast::FieldInit] = [fields[1], fields[0]]
            known <- false
            holds <- derived_rule_holds(file.derived_state_rules[0].condition, &reversed, known)
            return 5 if not known or not holds
            fuel: mutable u32 = 0
            known <- true
            holds <- derived_snapshot_predicate(file.derived_state_rules[0].condition, &fields, known, fuel, 0)
            return 6 if known or holds or fuel != 0
            fuel <- 8192
            known <- true
            holds <- derived_snapshot_predicate(file.derived_state_rules[0].condition, &fields, known, fuel, 128)
            return 7 if known or holds or fuel != 8192
            fuel <- 1
            known <- true
            holds <- derived_snapshot_predicate(file.derived_state_rules[0].condition, &fields, known, fuel, 0)
            return 8 if known or holds or fuel != 0
            return 0

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    source: u8& = "struct Pair[state Within | Equal | Both | Either | Negated | Foreign | Division | Missing | Overflow | OpaqueOr | OpaqueAnd]:\n    low: i64\n    high: i64\n    derive state:\n        Within when self.low < self.high\n        Equal when self.low + 2 == self.high\n        Both when self.low < self.high and self.high == 3\n        Either when self.low > self.high or self.high == 3\n        Negated when not (self.low >= self.high)\n        Foreign when other.low < 3\n        Division when self.low / 0 < 3\n        Missing when self.absent == 0\n        Overflow when self.low + 9223372036854775807 > 0\n        OpaqueOr when true or other.low < 3\n        OpaqueAnd when false and self.absent == 0\n"
    tokens: darray[Lexer::Token] = frontend_tokenize(source, source)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    return 9 if file.errors.count != 0
    return Semantic::derived_snapshot_probe(&file)
