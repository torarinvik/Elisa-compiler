struct NestedPoint:
    x: i64
    label: sview

struct NestedLists:
    values: darray[darray[i64]]
    cubes: darray[darray[darray[i64]]]
    weights: darray[darray[f64]]
    bytes: darray[darray[u8]]
    texts: darray[darray[sview]]
    labels: darray[darray[cstr]]
    objects: darray[darray[py::Object]]
    optional: darray[darray[i64?]]
    points: darray[darray[NestedPoint]]

def roundtrip(batch: NestedLists) -> NestedLists:
    return batch

export pymodule struct_nested_lists:
    fn roundtrip
