include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

# A request-scoped view cannot be kept in a session-scoped container.
struct RetainedViews[@session, @source]:
    views: mutable darray[sview @source] @session

def main() -> i64 can[Abort.Panic, Memory.Allocate, Unsafe{PointerArithmetic,PointerCast,RawExtern,UncheckedIndex}]:
    region session:
        region request:
            source: mutable darray[u8] @request = [65.u8()]
            borrowed: sview @request = source.as_sview()
            retained: RetainedViews[session, request] = RetainedViews{views: []}
            retained.views.push(borrowed)
            return 0
    return 0
