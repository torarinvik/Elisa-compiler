struct Batch:
    values: darray[i64]
    weights: darray[f64]
    flags: darray[bool]
    raw: darray[u8]

struct Envelope:
    batch: Batch
    name: sview

def make() -> Batch:
    values: mutable darray[i64] = []
    values.push(4)
    values.push(-2)
    weights: mutable darray[f64] = []
    weights.push(1.5)
    weights.push(2.5)
    flags: mutable darray[bool] = []
    flags.push(true)
    flags.push(false)
    raw: mutable darray[u8] = []
    raw.push(65)
    raw.push(0)
    raw.push(66)
    return Batch{values: values, weights: weights, flags: flags, raw: raw}

def make_envelope() -> Envelope:
    batch: Batch = make()
    return Envelope{batch: batch, name: "nested"}

export pymodule struct_list_returns:
    fn make
    fn make_envelope
