module ScopeAliasTarget:
    public:
        const enum Mode of i64:
            High = 10

module FallbackAlias:
    public:
        const enum Mode of i64:
            High = 20

module FirstAliasTarget:
    public:
        const enum AliasMode of i64:
            High = 41

module SecondAliasTarget:
    public:
        const enum AliasMode of i64:
            High = 52

module FirstAliasScope:
    using FirstAliasTarget as Shared
    def first_shared_alias(value: i64 = Shared::AliasMode.High) -> i64:
        return value

module SecondAliasScope:
    using SecondAliasTarget as Shared
    def second_shared_alias(value: i64 = Shared::AliasMode.High) -> i64:
        return value

module Scope:
    module Real:
        public:
            const enum Mode of i64:
                High = 30
    using ScopeAliasTarget as FallbackAlias
    using Real as LocalAlias
    def nested_alias_fallback(value: FallbackAlias::Mode = FallbackAlias::Mode.High) -> FallbackAlias::Mode:
        return value
    def nested_alias_local_target(value: LocalAlias::Mode = LocalAlias::Mode.High) -> LocalAlias::Mode:
        return value

export pymodule nested_alias_scope:
    fn nested_alias_fallback = Scope::nested_alias_fallback
    fn nested_alias_local_target = Scope::nested_alias_local_target
    fn first_shared_alias = FirstAliasScope::first_shared_alias
    fn second_shared_alias = SecondAliasScope::second_shared_alias
