module ScopeAliasTarget:
    public:
        const enum Mode of i64:
            High = 10

module FallbackAlias:
    public:
        const enum Mode of i64:
            High = 20

module Scope:
    module Real:
        public:
            const enum Mode of i64:
                High = 30
    using ScopeAliasTarget as FallbackAlias
    using Real as LocalAlias
    def nested_alias_fallback(value: FallbackAlias::Mode = FallbackAlias::Mode.High) -> FallbackAlias::Mode:
        return value
    def nested_alias_local_target(value: LocalAlias::Mode = LocalAlias::Mode.High) -> LocalAlias::Mode:
        return value

export pymodule nested_alias_scope:
    fn nested_alias_fallback = Scope::nested_alias_fallback
    fn nested_alias_local_target = Scope::nested_alias_local_target
