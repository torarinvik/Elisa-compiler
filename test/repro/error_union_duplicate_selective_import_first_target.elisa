# The first same-scope selective import remains authoritative when a later import
# names the same bare callable.
module First:
    public:
        error Fault:
            Bad

        def load() -> i64 error[Fault]:
            return 1

module Second:
    public:
        def load() -> i64:
            return 0

from First import load
from Second import load

def discard_imported():
    _ = load()

def main() -> i64:
    return 0
