# Equal logical declaration lines must not share their region pin selector.
#line 0 pin-first.elisa
def unused[@r](value: i64) -> mutable darray[i64] @r:
    result: mutable darray[i64] @r = []
    in r:
        result.push(value)
    return move result

#line 0 pin-second.elisa
def target[@s](young: mutable darray[i64]&, value: i64) -> mutable darray[i64] @s:
    result: mutable darray[i64] @s = []
    young.push(value)
    in s:
        result.push(value)
    return move result

def main() -> i64:
    region outer(4096)
    result: mutable darray[i64] @outer = []
    region inner(4096):
        young: mutable darray[i64] @inner = []
        result <- target[outer](young, 42)
    return 0 if result[0] == 42 else 1
