# A target predicate is deliberately unresolved by this source diagnostic pass. Catch
# diagnostics in such a branch remain conservative until target selection is known.
error Fault:
    Expected
    Other

extern expected_only() -> i64 error[Fault{Expected}]
extern all_faults() -> i64 error[Fault]

def active_tail_control() -> i64:
    result: mutable i64 = 0
    static if true:
        catch all_faults():
            value:
                result = value
            Fault.Expected:
                result = 0
            Fault.Other:
                result = 1
    return result

def unknown_statement_out_of_set() -> i64:
    static if ELISA_TARGET_OS_WASI:
        return catch expected_only():
            value: value
            Fault.Other: 0
            Phantom.Gone: 0
    return 0

def unknown_statement_param[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
    result: mutable i64 = 0
    static if ELISA_TARGET_OS_WASI:
        catch callback():
            value:
                result = value
            plain:
                result = 0
    return result

def main() -> i64:
    return 0
