# Function-value rows must follow exact module/import resolution for extern calls.
module A:
    public:
        extern Tick() -> void can[Console.Write]

module B:
    public:
        extern Tick() -> void can[Disk.Read]

module Runner:
    public:
        extern Run(callback: fn() -> void) -> void

from A import Tick

def from_a() -> void:
    A::Tick()

def from_b() -> void:
    B::Tick()

def shadows_import(Tick: fn() -> void) -> void:
    callback: fn() -> void = fn() => Tick()

def check_rows() -> void:
    # Declared functions use inferred source rows joined by exact (name, module).
    from_a_ok: fn() -> void can[Console] = from_a
    from_a_wrong: fn() -> void can[Disk] = from_a
    from_b_ok: fn() -> void can[Disk] = from_b

    # Lambda bodies resolve qualified and selectively imported extern calls at the call site.
    lambda_a_ok: fn() -> void can[Console] = fn() => A::Tick()
    lambda_a_wrong: fn() -> void can[Disk] = fn() => A::Tick()
    lambda_b_ok: fn() -> void can[Disk] = fn() => B::Tick()
    lambda_import_ok: fn() -> void can[Console] = fn() => Tick()
    lambda_import_wrong: fn() -> void can[Disk] = fn() => Tick()
    lambda_callback_arg_ok: fn() -> void can[Console] = fn() => Runner::Run(fn() => A::Tick())
