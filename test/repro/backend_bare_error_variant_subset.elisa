error Fault:
    Expected
    Other

def leaf(fail: bool) -> i64 error[Expected]:
    raise Fault.Expected if fail
    return 7

def widen(fail: bool) -> i64 error[Fault]:
    return try leaf(fail)

def main() -> i64:
    catch widen(true):
        value:
            return 1
        Fault.Expected:
            return 0
        Fault.Other:
