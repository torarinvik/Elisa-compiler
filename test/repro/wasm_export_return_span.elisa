include "../../src/semantic/semantic.elisa"
include "../../src/driver/wasm_export_return_span.elisa"
extern read(fd: i32, buf: void&, count: usize) -> isize can[Console]
def main() -> i32 can[Console, Memory.Allocate, Abort.Panic, Global{Read,Write}]:
    buf: mutable darray[u8] = [0 for _ in 0..<4096]
    n: isize = read(0, (&buf[0]).cast[void&], 4095) can Console
    return 2 if n <= 0
    tokens: darray[Lexer::Token] = frontend_tokenize_with_length(&buf[0], &buf[0], n.usize()) can Global{Read,Write}
    close: mutable usize = 0
    for i in 0..<tokens.count |tokens, close|:
        if tokens[i].kind == Lexer::TokenKind.RParen:
            close <- i
            break
    span: (start: usize, stop: usize) = wasm_export_return_span(tokens, &buf[0], close, tokens.count)
    return (span.stop - span.start).i32()
