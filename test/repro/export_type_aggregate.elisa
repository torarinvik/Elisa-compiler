struct ExportRecord layout(c):
    value: u8
    label: u8&?

export type ExportRecord as PublicExportRecord

def fill_export_record(out: mutable ExportRecord&) -> i32:
    out <- ExportRecord{value: 1, label: "A"}
    return 1

export fn fill_export_record_public(out: mutable ExportRecord&) -> i32 = fill_export_record
