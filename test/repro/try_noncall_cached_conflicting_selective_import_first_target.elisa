# Cached source inference must follow Core's first program-level selective alias.
module ProviderA:
    public:
        error SourceError:
            Bad

        def origin() -> i64 error[ProviderA::SourceError]:
            return 1

module ProviderB:
    public:
        error OtherSourceError:
            Bad

        def origin() -> i64 error[ProviderB::OtherSourceError]:
            return 2

from ProviderA import origin
from ProviderB import origin

module Consumer:
    public:
        error Fault:
            Other

        def mismatched() -> i64 error[Consumer::Fault]:
            payload = origin()
            return try payload

def main() -> i64:
    return 0
