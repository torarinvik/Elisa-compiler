include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"

struct Box[@r]:
    value: i64& @r

def id[@r](value: Box[r]) -> Box[r]:
    return value

def main() -> i64:
    region scratch(64):
        raw: i64& @scratch = new[scratch] 5
        boxed: Box[scratch] = Box{value: raw}
        forwarded: Box[scratch] = id(boxed)
        destroy scratch
        return forwarded.value[0]
