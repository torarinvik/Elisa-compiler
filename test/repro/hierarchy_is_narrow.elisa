# User-defined hierarchy tag refinement. The `is` form intentionally carries no binder:
# Stage0 exposes the payload through the refined value, while binding names in an `if`
# condition are not part of the accepted syntax.
enum Widget layout(handle: u32):
    common:
        x: f32
        y: f32
        w: f32
        h: f32
    pass

enum Control is Widget:
    Label(text: sview)

enum Button is Control:
    Push(value: i64)

def is_button(v: Widget) -> i64:
    if v is Button.Push:
        return 1
    return 0

def build(owner: Arena) -> i64:
    store: Widget.Store[Local] = Widget.Store(owner)
    result: mutable i64 = 0
    in store:
        b: Widget = new Button.Push(x: 1.0, y: 2.0, w: 30.0, h: 10.0, value: 42)
        result <- is_button(b)
    return result - 1

def main() -> i64:
    region r(4096):
        return build(r)
