# An aggregate returned with @r carries that region even when it is not itself a
# syntactic view type. Freeing the owner before returning the aggregate must fail.
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"

struct Payload:
    bytes: darray[u8]

module Owned:
    public:
        def make[@r](arena: mutable Arena& @r) -> Payload @r:
            can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
                in arena:
                    bytes: mutable darray[u8] = []
                    bytes.push(7)
                    return Payload{bytes: bytes}

def invalid_inferred() -> Payload can[Abort.Panic, Memory.Allocate, Memory.Release, Unsafe.PointerCast]:
    arena: mutable Arena = zeroed
    payload = Owned::make(&arena)
    arena_free(&arena)
    return payload

def invalid_explicit() -> Payload can[Abort.Panic, Memory.Allocate, Memory.Release, Unsafe.PointerCast]:
    arena: mutable Arena = zeroed
    payload: Payload = Owned::make(&arena)
    arena_free(&arena)
    return payload

def main() -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release, Unsafe.PointerCast]:
    return 0
