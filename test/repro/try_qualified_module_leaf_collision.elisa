error E:
    Expected
error F:
    WrongModule

# `Common` resolves through the caller's lexical parent to OuterA::Common. The
# earlier OuterB::Common declaration has the same leaf name but a different family.
module OuterB:
    public:
        module Common:
            public:
                def fail() -> i64 error[F]:
                    return 2

module OuterA:
    public:
        module Common:
            public:
                def fail() -> i64 error[E]:
                    return 1
        module Caller:
            public:
                def mismatch() -> i64 error[F]:
                    return try Common::fail()
