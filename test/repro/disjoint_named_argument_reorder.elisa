# The alias-scope proof must map named arguments to formal parameter positions.
# Source order deliberately makes argument 2 a fresh nonnumeric darray while the two
# numeric darray parameters (formal positions 0 and 2) both receive `values`.
struct Cell:
    value: i64

def update_pair(first: mutable darray[i64]&, first_decoy: mutable darray[Cell]&, second: mutable darray[i64]&, second_decoy: mutable darray[Cell]&) -> void:
    first[0] <- second[0]

def main() -> i64:
    values: mutable darray[i64] = [1]
    decoy_a: mutable darray[Cell] = [Cell{value: 2}]
    decoy_b: mutable darray[Cell] = [Cell{value: 3}]
    update_pair(first: &values, first_decoy: &decoy_a, second_decoy: &decoy_b, second: &values)
    return values[0]
