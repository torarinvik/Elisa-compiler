struct Hooks:
    allocate: (fn(usize) -> mutable void&?)?

def identity(value: usize) -> mutable void&?:
    return null

def invoke(hooks: Hooks&, size: usize) -> mutable void&?:
    if hooks.allocate != null:
        return hooks.allocate(size)
    return null

def invoke_local(callback: (fn(usize) -> mutable void&?)?, size: usize) -> mutable void&?:
    if callback != null:
        return callback(size)
    return null

def main() -> i64:
    hooks: Hooks = Hooks{allocate: identity}
    field_result: mutable void&? = invoke(&hooks, 4)
    local_result: mutable void&? = invoke_local(identity, 4)
    return 0 if field_result == null and local_result == null else 1
