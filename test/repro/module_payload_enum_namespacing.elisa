# Payload enum identity includes the declaring module. The two Result enums
# deliberately place the same variant at different tags, so resolving by the
# first leaf-name row is observably wrong.

module Alpha:
    enum Result:
        Ok(value: i64)
        Empty

module Beta:
    enum Result:
        Failed
        Ok(value: i64)

def main() -> i64:
    alpha: Alpha::Result = Alpha::Result.Ok(11)
    beta: Beta::Result = Beta::Result.Ok(22)
    return 0 if alpha is Alpha::Result.Ok and beta is Beta::Result.Ok and not (beta is Beta::Result.Failed) else 1
