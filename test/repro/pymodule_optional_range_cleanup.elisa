type MaybeUserId = i64?

def optional_then_narrow(value: i64? = 1234567890123456789, narrow: u8 = 0) -> i64?:
    return value

def aliased_optional_then_narrow(value: MaybeUserId = 1234567890123456789, narrow: u8 = 0) -> MaybeUserId:
    return value

def aliased_optional_then_bad_dict(value: MaybeUserId = 1234567890123456789, values: dict[u64, u64] = {}) -> MaybeUserId:
    return value

def borrowed_default_cstr(value: cstr? = "borrowed return default") -> cstr?:
    return value

def borrowed_default_plain_sview(value: sview = "borrowed direct sview return default") -> sview:
    return value

def borrowed_default_sview(value: sview? = "borrowed optional sview return default") -> sview?:
    return value

export pymodule optional_range_cleanup:
    fn optional_then_narrow
    fn aliased_optional_then_narrow
    fn aliased_optional_then_bad_dict
    fn borrowed_default_cstr
    fn borrowed_default_plain_sview
    fn borrowed_default_sview
