# COMP-010 scope matrix.
#
# The field-type channel intentionally retains bare names today.  These cases
# prove the safe resolution order without asking the compiler to invent a
# qualified semantic type identity:
#
#   * a module-local row beats both another module's row and a top-level row;
#   * a two-level module path carries the same owner boundary as a one-level
#     module path;
#   * `using MODULE::member` makes a module member visible without changing the
#     owner used while the member body is checked;
#   * a module alias remains a value-namespace alias.  The alias-qualified type
#     probe is kept in the parity harness as a deliberately conservative
#     compile-time case until qualified type identities are implemented.

struct Run:
    answer: mutable i64

module Other:
    struct Run:
        answer: mutable darray[i64]

module Outer::Inner::Scalar:
    struct Run:
        answer: mutable i64

    def read() -> i64:
        run: mutable Run = Run{answer: 40}
        if run.answer != 40:
            return 1
        run.answer <- run.answer + 1
        return run.answer

using Outer::Inner::Scalar as S
using Outer::Inner::Scalar::read

def top_level_read() -> i64:
    run: mutable Run = Run{answer: 7}
    run.answer <- run.answer + 1
    return run.answer

def main() -> i64:
    # Both calls execute the same module-owned body through two visibility
    # paths.  The top-level row is checked separately above.
    return S::read() + read() + top_level_read() - 90
