error OriginFault:
    Bad

error CallerFault:
    Other

enum Choice:
    Pair(value: i64)
    Other(value: i64)

def origin() -> i64 error[OriginFault]:
    return 1

def check(choice: Choice) -> i64 error[CallerFault]:
    payload = origin()
#line 0 variant-alias-owner.elisa
    if choice is Choice.Pair as payload:
        pass
#line 0 variant-alias-owner.elisa
    if choice is Choice.Other:
        return try payload
    return 0

def main() -> i64:
    return check(Choice.Other(2))
