# nopath
include "../../elisacore_std/elisacore_runtime_prelude.elisa"
include "../../elisacore_std/collections.elisa"
include "../../elisacore_std/elisacore_runtime_strings.elisa"

type Reader = fn() -> i64

def read_first(view: sview) -> i64:
    return sview_at(view, 0.usize()).i64()

def make_reader(view: sview) -> fn() -> i64:
    return fn() => read_first(view)

def main() -> i64 can[Abort.Panic, Memory.Allocate, Memory.Release]:
    arena: mutable Arena = zeroed
    alloc: mutable Arena& = &arena
    values: mutable darray[u8] @alloc = [65.u8()]
    view: sview @alloc = bytes_view(values)
    reader: Reader = make_reader(view)
    arena_free(alloc)
    return reader()
