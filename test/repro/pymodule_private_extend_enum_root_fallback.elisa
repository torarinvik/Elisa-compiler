# A private extension makes its namespace path inaccessible outside Api.
module Api:
    public:
        module Values:
            const enum Anchor of i64:
                One = 1
    private extend Values:
        const enum Mode of i64:
            High = 11

const enum Mode of i64:
    High = 97

using Api::Values

def root_fallback(value: i64 = Mode.High) -> i64:
    return value

export pymodule pymodule_private_extend_enum_root_fallback:
    fn root_fallback
