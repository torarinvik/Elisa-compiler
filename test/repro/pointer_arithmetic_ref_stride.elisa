# Pointer arithmetic over a nullable reference must index the referenced element,
# not the local pointer slot. The distinction is observable for i32: the slot stride
# is 8 bytes on this target, while the pointee stride is 4 bytes.

def elisa_nonnull[T](value: mutable T&?) -> mutable T&:
    if value == null:
        return zeroed
    return value

def cstr_second() -> u8:
    second: mutable u8& = &("abc")[1]
    return second[0]

def main() -> i64:
    values: mutable array[i32, 3] = [10, 20, 30]
    cursor: mutable i32&? = (&values[0])
    cursor <- (&elisa_nonnull(cursor)[1])
    return 0 if elisa_nonnull(cursor)[0] == 20 and cstr_second() == 98 else 1
