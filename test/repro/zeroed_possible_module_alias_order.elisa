# An earlier possible branch alias can win over an active branch alias, while a later
# possible branch alias cannot replace the first active branch registration.
module Safe:
    type Plain = i64

module Wrong:
    type Plain = sview

static if ELISA_TARGET_OS_WASI:
    using Wrong as PossibleFirst
static if true:
    using Safe as PossibleFirst

static if true:
    using Safe as PossibleLater
static if ELISA_TARGET_OS_WASI:
    using Wrong as PossibleLater

# An ancestor branch alias and a nested direct alias do not carry enough branch-block
# provenance here to prove the Stage0 winner; zeroed lookup must remain conservative.
static if ELISA_TARGET_OS_WASI:
    using Wrong as ParentPossibleFirst
module Outer:
    using Safe as ParentPossibleFirst

# Root direct aliases are pre-registered before nested modules, even when the root
# declaration appears later in source order, so this possible nested row loses.
module Inner:
    static if ELISA_TARGET_OS_WASI:
        using Wrong as NestedPossibleLater
using Safe as NestedPossibleLater

def possible_first() -> i64:
    value: PossibleFirst::Plain = zeroed
    return value

def possible_later() -> i64:
    value: PossibleLater::Plain = zeroed
    return value

def parent_possible_first() -> i64:
    value: ParentPossibleFirst::Plain = zeroed
    return value

def nested_possible_later() -> i64:
    value: NestedPossibleLater::Plain = zeroed
    return value

def main() -> i64:
    return possible_first() + possible_later() + parent_possible_first() + nested_possible_later()
