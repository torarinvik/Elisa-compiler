# Exact IEEE exemption oracle, including conservative unit-wide primitive shadowing.
include "../../src/semantic/semantic.elisa"

extend Semantic:
    private:
        def legacy_ieee_nan_parameter_names(params: darray[Ast::ParamDecl], body: darray[Ast::Stmt], table: SymbolTable&) -> darray[sview] can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                names: mutable darray[sview] = []
                return names if not ieee_nan_plain_body(body)
                # Spelling alone cannot authenticate a primitive if source declarations
                # reuse its name. Conservatively retain diagnostics across modules too.
                for symbol in table.symbols:
                    return names if symbol.line != 0 and (symbol.name == "f32" or symbol.name == "f64")
                for param in params |names|:
                    if param.type_expression is Ast::Expr.Ident(kind, _):
                        if kind == "f32" or kind == "f64":
                            names <- names.push(param.name)
                return names

    public:
        def ieee_names_match_legacy(params: darray[Ast::ParamDecl], body: darray[Ast::Stmt], table: SymbolTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                expected: darray[sview] = legacy_ieee_nan_parameter_names(params, body, table)
                actual: darray[sview] = ieee_nan_parameter_names(params, body, table)
                return false if expected.count != actual.count
                for index in 0..<expected.count:
                    return false if expected[index] != actual[index]
                return true

        def ieee_declarations_match_legacy(declarations: darray[Ast::Decl], table: SymbolTable&) -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                for declaration in declarations:
                    match declaration:
                        Ast::Decl.Func(_, params, _, body, _, _, _):
                            return false if not ieee_names_match_legacy(params, body, table)
                        Ast::Decl.Module(_, body, _) | Ast::Decl.Scoped(body, _):
                            return false if not ieee_declarations_match_legacy(body, table)
                        _:
                            pass
                return true

        def ieee_source_matches_legacy(source: sview) -> bool can[Abort.Panic, Memory.Allocate, Unsafe.PointerCast]:
            can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
                raw: u8& = source.data
                tokens: darray[Token] = frontend_tokenize_with_length(raw, raw, source.len.usize())
                file: Ast::File = frontend_parser_parse_file(raw, tokens) can Global{Read,Write}
                return false if file.errors.count != 0
                table: SymbolTable = check(file) can Global{Read,Write}
                return ieee_declarations_match_legacy(file.top_decls, &table)

        def ieee_manufactured_collision_matches_legacy() -> bool can[Abort.Panic, Memory.Allocate]:
            can Abort.Panic, Memory.Allocate:
                region owner(1048576):
                    store: Ast::Node.Store[Local] = Ast::Node.Store(owner)
                    in store:
                        pos: Ast::Pos = Ast::pos_at_line(7)
                        typed: Ast::Expr = Ast::Expr.Ident("f32", pos)
                        value: Ast::Expr = Ast::Expr.Ident("value", pos)
                        params: darray[Ast::ParamDecl] = [Ast::ParamDecl{name: "value", type_expression: typed, is_mutable: false, has_default: false, default_value: Ast::Expr.Invalid}]
                        body: darray[Ast::Stmt] = [Ast::Stmt.Return(value, pos)]
                        table: mutable SymbolTable = SymbolTable()
                        table <- seed_builtins(table)
                        return false if not ieee_names_match_legacy(params, body, &table)
                        collision_row: u32 = table.symbols.count.u32()
                        table <- table.add_symbol("unrelated", SymbolKind.Alias, 7)
                        # Manufacture the chain representation of an otherwise unrelated source name
                        # hashing to f32. Comparing the actual name must keep the IEEE exemption.
                        primitive_row: u32 = symbol_chain_head(&table, "f32")
                        table.symbol_name_next[primitive_row.usize()] <- collision_row
                        table.symbol_name_tail <- table.symbol_name_tail.put(name_hash("f32"), collision_row)
                        return false if not ieee_names_match_legacy(params, body, &table)
                        # A genuine source alias after the collision must still poison both float kinds.
                        table <- table.add_symbol("f32", SymbolKind.Alias, 9)
                        return false if not ieee_names_match_legacy(params, body, &table)
                        false_names: darray[sview] = ieee_nan_parameter_names(params, body, &table)
                        return false if false_names.count != 0
                        return true

def main() -> i32:
    can Abort.Panic, Memory.Allocate, Unsafe.PointerCast:
        return 1 if not (Semantic::ieee_source_matches_legacy("def valid(value: f32) -> bool:\n    not (value != value)\n") can Global{Read,Write})
        return 2 if not (Semantic::ieee_source_matches_legacy("def valid(value: f64) -> bool:\n    not (value != value)\n") can Global{Read,Write})
        return 3 if not (Semantic::ieee_source_matches_legacy("def valid(value: i64) -> bool:\n    not (value != value)\n") can Global{Read,Write})
        return 4 if not (Semantic::ieee_source_matches_legacy("def valid(value: f32) -> bool:\n    local: i64 = 0\n    value == value\n") can Global{Read,Write})
        return 5 if not (Semantic::ieee_source_matches_legacy("type f32 = i64\ndef valid(value: f32) -> bool:\n    not (value != value)\n") can Global{Read,Write})
        return 6 if not (Semantic::ieee_source_matches_legacy("struct f64:\n    value: i64\ndef valid(value: f64) -> bool:\n    not (value != value)\n") can Global{Read,Write})
        return 7 if not (Semantic::ieee_source_matches_legacy("module Hidden:\n    type f32 = i64\ndef valid(value: f64) -> bool:\n    not (value != value)\n") can Global{Read,Write})
        return 8 if not (Semantic::ieee_source_matches_legacy("module Hidden:\n    struct f64:\n        value: i64\ndef valid(value: f32) -> bool:\n    not (value != value)\n") can Global{Read,Write})
        return 9 if not (Semantic::ieee_source_matches_legacy("type Floating = f64\ndef valid(value: Floating) -> bool:\n    not (value != value)\n") can Global{Read,Write})
        return 10 if not (Semantic::ieee_source_matches_legacy("module Floats:\n    type Value = f32\ndef valid(value: Floats::Value) -> bool:\n    not (value != value)\n") can Global{Read,Write})
        return 11 if not (Semantic::ieee_source_matches_legacy("def valid(first: f64, second: f32) -> bool:\n    first != first or second == second\n") can Global{Read,Write})
        return 12 if not (Semantic::ieee_source_matches_legacy("module One:\n    def valid(value: f32) -> bool:\n        value != value\nmodule Two:\n    def valid(value: f64) -> bool:\n        value != value\n") can Global{Read,Write})
        return 13 if not (Semantic::ieee_source_matches_legacy("module One:\n    type f32 = i64\nmodule Two:\n    type f32 = i64\ndef valid(value: f64) -> bool:\n    not (value != value)\n") can Global{Read,Write})
        return 14 if not Semantic::ieee_manufactured_collision_matches_legacy()
        return 0
