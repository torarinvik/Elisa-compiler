module Outer:
    module Right:
        packed enum Message:
            A(x: i64)
            B(y: i64, z: i64)

def pick(m: Outer::Right::Message) -> i64:
    match m:
        Outer::Right::Message.A(x): return x
        Outer::Right::Message.B(y, z): return y + z

def main() -> i64:
    return 0
