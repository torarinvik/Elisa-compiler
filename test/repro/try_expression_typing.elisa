# A `try … else …` expression where its type must be INFERRED rather than annotated.
#
# The parser desugars both `try CALL else FALLBACK` and `get OPT else FALLBACK` into one
# node, Expr.Refinement(fallback, guarded). The backend's EMITTER models all three of its
# shapes; `expression_type` had no case for it at all and answered Unmodeled. Anywhere the
# type is supplied from outside — a VarDecl with an annotation — that went unnoticed; the
# `is` narrowing in an `if` STATEMENT dispatches on exactly that type, so
# `if (try f(3) else null) is v:` declined and took main with it.
#
# The ORDER of the three cases is the emitter's and is not the obvious one:
#
#   try CALL else F   where CALL is error-returning   -> the callee's payload, AS IS
#   get OPT else F    where OPT is optional           -> the payload, UNWRAPPED
#   try VALUE else F  where VALUE is an error union   -> the union's payload
#
# The first two disagree about an optional. `f` here returns `i64? error[E]`, so the first
# rule must keep the `?` (bits 1/2/4 below distinguish present, absent and raised); the
# `get` case must strip it (bit 8). Backwards, and the optional is silently dropped.
#
# stage0 answers 31.
error E:
    Bad


def guarded(n: i64) -> i64? error[E]:
    raise E.Bad if n < 0
    null return if n == 0
    return n


def plain(ok: bool) -> i64?:
    null return if not ok
    return 9


def main() -> i64:
    score: mutable i64 = 0

    # PRESENT: the call succeeds and the optional holds a value.
    if (try guarded(1) else null) is present:
        score <- score + 1 if present == 1

    # ABSENT: the call succeeds and the optional is empty — the `is` must NOT bind. A
    # dropped `?` would make this bind whatever the payload slot held.
    absent_bound: mutable bool = false
    if (try guarded(0) else null) is absent:
        absent_bound <- true
        score <- score + 64 + absent
    score <- score + 2 if not absent_bound

    # RAISED: the fallback supplies the null, so again nothing binds.
    raised_bound: mutable bool = false
    if (try guarded(-1) else null) is raised:
        raised_bound <- true
        score <- score + 128 + raised
    score <- score + 4 if not raised_bound

    # `get OPT else FALLBACK` UNWRAPS: an i64, not an i64?.
    taken: i64 = get plain(true) else 3
    fell_back: i64 = get plain(false) else 3
    score <- score + 8 if taken == 9 and fell_back == 3

    # The ANNOTATED spelling, which always worked — pinned so the fix cannot regress it.
    annotated: i64? = try guarded(5) else null
    score <- score + 16 if (v if annotated is v else 0) == 5

    return score
