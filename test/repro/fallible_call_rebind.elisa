# A propagating fallible call can be the right-hand side of a mutable rebind.
error RebindError:
    Failed

def next_value(value: i64) -> i64 error[RebindError]:
    raise RebindError.Failed if value < 0
    value + 1

def update(value: i64) -> i64 error[RebindError]:
    result: mutable i64 = 0
    result <- try next_value(value)
    result

def main() -> i64:
    success: i64 = try update(41) else -1
    failure: i64 = try update(-1) else -2
    return 0 if success == 42 and failure == -2 else 1
