# Two QUERY expressions on ONE LINE must each get their own head keyword.
#
# `Expr.Comprehension` drops the head (`count`/`sum`/`any`/`all`/`min`/`max`), so the backend
# recovers it from a parser side table — which was keyed by LINE, and whose lookup answers with
# the FIRST row for that line. Two queries sharing a line therefore both read the first one's
# keyword: `(count x in xs where x > 2) * 10 + (sum y in xs where y > 2)` computed the sum as a
# count and answered 33 where stage0 answers 42. Silent, and every generation of the compiler
# reproduced it identically because its own sources never put two queries on one line.
#
# The rows are now keyed by (line, BINDER). Both orderings are here: keying by line alone made
# the SECOND query wrong, so a fix that only repaired one direction would still pass one of
# these.
def folds_forward(xs: darray[i64]) -> i64:
    return (count x in xs where x > 2) * 10 + (sum y in xs where y > 2)

def folds_reversed(xs: darray[i64]) -> i64:
    return (sum y in xs where y > 2) * 10 + (count x in xs where x > 2)

# The bool quantifiers share the same marker table, and `any` vs `all` on one line is the pair
# whose confusion is invisible in a count.
def quantifiers(xs: darray[i64]) -> i64:
    return 10 if (any a in xs where a > 2) and (all b in xs where b > 0) else 20

# Controls: one query per line, which is the shape that always worked.
def one_per_line(xs: darray[i64]) -> i64:
    a: i64 = count x in xs where x > 2
    b: i64 = sum y in xs where y > 2
    return a * 10 + b

def main() -> i64:
    xs: darray[i64] = [1, 2, 3, 4, 5]
    # The two orderings are WEIGHTED apart on purpose. Summed plainly they cancel: the bug
    # turns 42 into 33 and 123 into 132, and 33 + 132 is exactly 42 + 123. A fixture that
    # cannot fail is worse than none, and this one could not until the weights differed.
    # (42 * 3) + 123 + 10 + 42 = 301; 301 % 251 = 50
    return ((folds_forward(xs) * 3) + folds_reversed(xs) + quantifiers(xs) + one_per_line(xs)) % 251
