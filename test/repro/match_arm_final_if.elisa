# A final `if` statement in a value-match arm leaves an open join block. The
# arm must branch that join to the match result block.
struct Result:
    value: i64

enum Input:
    Item(i64)
    Empty

def fallback() -> Result:
    Result{value: 0}

def choose(input: Input) -> Result:
    return match input:
        Input.Item(value):
            if value > 0:
                Result{value: value}
            else:
                fallback()
        _: fallback()

def main() -> i64:
    result: Result = choose(Input.Item(1))
    result.value
