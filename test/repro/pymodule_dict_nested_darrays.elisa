def roundtrip(values: dict[i64, darray[darray[i64]]]) -> dict[i64, darray[darray[i64]]]:
    return values

def roundtrip_text(values: dict[cstr, darray[darray[sview]]]) -> dict[cstr, darray[darray[sview]]]:
    return values

def roundtrip_objects(values: dict[i64, darray[darray[py::Object]]]) -> dict[i64, darray[darray[py::Object]]]:
    return values

def roundtrip_deep(values: dict[i64, darray[darray[darray[darray[i64]]]]]) -> dict[i64, darray[darray[darray[darray[i64]]]]]:
    return values

def roundtrip_rows(values: dict[i64, darray[dict[cstr,i64]]]) -> dict[i64, darray[dict[cstr,i64]]]:
    return values

def roundtrip_batches(values: darray[dict[i64,darray[dict[cstr,i64]]]]) -> darray[dict[i64,darray[dict[cstr,i64]]]]:
    return values

error NestedDictionaryError:
    Bad(values: dict[i64, darray[darray[i64]]])

def fail(values: dict[i64, darray[darray[i64]]]) -> i64 error[NestedDictionaryError]:
    raise NestedDictionaryError.Bad(values)

export pymodule dict_nested_darrays:
    fn roundtrip
    fn roundtrip_text
    fn roundtrip_objects
    fn roundtrip_deep
    fn roundtrip_rows
    fn roundtrip_batches
    fn fail
