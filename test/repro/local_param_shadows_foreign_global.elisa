# A parameter shadows a same-named global from another module, even a private one
# and even when the parameter's type is a reference the structural channel does not
# model. Before the fix `tokens[at]` typed as Tasks' `u32` global ("variable
# \"holder\" expects Token, got u32").

include "../../elisacore_std/elisacore_runtime.elisa"

module Tasks:
    public:
        def touch() -> u32:
            tokens[0] <- 7
            return tokens[0]

    private:
        global mutable tokens: u32[4] = zeroed

module Json:
    public:
        struct Token:
            kind: i64
            size: i64

        def size_at(tokens: darray[Token]&, at: usize) -> i64:
            holder: Token = tokens[at]
            return holder.size

def main() -> i32:
    seen: u32 = Tasks::touch()
    list: mutable darray[Json::Token] = []
    list.push(Json::Token{kind: 2, size: 5})
    return 1 if Json::size_at(&list, 0) != 5
    return 3 if seen != 7
    return 0
