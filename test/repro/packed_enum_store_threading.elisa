# A plain recursive packed enum passed ACROSS a function boundary.
#
# FIXED (this file now compiles under both): stage0 threads the store through the ABI: `define i64 @kind(i32 %0, %Tree__Store %1)`
# -- the value is a u32 handle and the store rides alongside it, and stage1 now emits the
# same shape. It previously supported only the LOCAL store model (construct and match
# inside ONE function), so any packed enum crossing a function boundary declined.
#
# This is NOT hierarchy-specific -- a flat `enum Tree` shows it, which is why it went
# unnoticed: the compiler's own AST is threaded through a SEPARATE, hardcoded path
# (function_needs_ast_store / the "Node" hidden parameter), so self-hosting never
# exercises the general case.
#
# Closing it means: wants_store true for any parameter carrying a user packed enum,
# caller-side store passing, and main-side store creation -- the AST's hidden-store ABI
# generalized to user types. Blocks the elisa-ui widget hierarchy, whose whole point is
# passing widget handles between functions over one shared arena (docs/77).
enum Tree:
    Leaf(v: i64)
    Branch(child: Tree)

def kind(t: Tree) -> i64:
    match t:
        Tree.Leaf(v):
            return v
        Tree.Branch(child):
            return 1

def main() -> i64:
    return 0
