include "../../elisacore_std/elisacore_runtime.elisa"

struct Box:
    values: mutable i64[4]

impl Index for Box:
    type Key = i64
    type Elem = i64

    def __index__(self: Box&, index: i64) -> i64&:
        return &self.values[index]

def main() -> i64:
    box: mutable Box = Box{values: [0, 0, 0, 0]}
    box[1] <- 42
    return box[1]
