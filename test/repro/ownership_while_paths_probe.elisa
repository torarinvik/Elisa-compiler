include "../../src/semantic/semantic.elisa"

def main() -> i32 can[Memory.Allocate, Abort.Panic]:
    source: u8& = "affine struct File[state Closed | Open]:\n    handle: i64\ndef never(owner: File[Closed]) -> void:\n    while false:\n        _ = move owner\n    _ = move owner\ndef returning_loop(owner: File[Closed], choice: bool) -> void:\n    while choice:\n        _ = move owner\n        return\n    _ = move owner\ndef infinite(owner: File[Closed]) -> void:\n    while true:\n        _ = move owner\n    _ = move owner\ndef unsupported_break(owner: File[Closed]) -> void:\n    while true:\n        break\n    _ = move owner\n"
    tokens: darray[Lexer::Token] = frontend_tokenize(source, source)
    file: Ast::File = frontend_parser_parse_file(source, tokens)
    return 1 if file.errors.count != 0
    table: Semantic::SymbolTable = Semantic::check(&file)
    return 2 if table.ownership_function_flows.count != 4
    never_count: mutable usize = 0
    returning_count: mutable usize = 0
    infinite_count: mutable usize = 0
    unsupported_count: mutable usize = 0
    for occurrence in table.ownership_occurrences |never_count, returning_count, infinite_count, unsupported_count|:
        continue if not occurrence.is_move
        name: sview = table.symbols[occurrence.binding_id.owner.value.usize()].name
        if name == "never":
            return 3 if not occurrence.known or not occurrence.liveness_available
            never_count <- never_count + 1
        elif name == "returning_loop":
            return 4 if not occurrence.known or not occurrence.liveness_available
            returning_count <- returning_count + 1
        elif name == "infinite":
            return 5 if not occurrence.known or occurrence.liveness_available
            infinite_count <- infinite_count + 1
        elif name == "unsupported_break":
            return 6 if occurrence.known or occurrence.liveness_available
            unsupported_count <- unsupported_count + 1
    return 7 if never_count != 1 or returning_count != 2 or infinite_count != 1 or unsupported_count != 1
    for summary in table.ownership_function_flows:
        name: sview = table.symbols[summary.owner.value.usize()].name
        return 8 if summary.coverage_complete != (name != "unsupported_break")
        return 9 if summary.fallthrough_reachable != (name != "infinite")
    return 0
