# The binary PRECEDENCE LADDER, measured against stage0's recursive descent:
#
#   parseBitwiseOr -> parseBitwiseXor -> parseBitwiseAnd -> parseShift -> parseAddSub -> parseMulDiv
#
# so `|` < `^` < `&` < `<<`/`>>` < `+`/`-` < `*`/`/`/`%`, the C ordering. stage1 had the
# SHIFTS binding tightest of all and the three bitwise operators collapsed onto ONE level,
# which is two silent wrong answers rather than a decline: an unparenthesised mix parses
# fine under either table and simply computes something else.
#
#   1 + 2 << 3   stage0 (1+2)<<3 = 24     old stage1 1+(2<<3) = 17
#   a | b ^ c    stage0 a|(b^c)           old stage1 (a|b)^c
#
# Every bit below is a pair the two tables disagree on; stage0 answers 63.
def main() -> i64:
    a: i64 = 3
    b: i64 = 6
    c: i64 = 5
    d: i64 = 4
    score: mutable i64 = 0
    # shift looser than `+`, `-` and `*`
    score <- score + 1 if 1 + 2 << 3 == 24
    score <- score + 2 if 16 >> 1 + 1 == 4
    score <- score + 4 if 1 << 2 * 2 == 16
    score <- score + 8 if d - 1 << 1 == 6
    # `^` tighter than `|`, `&` tighter than `^`
    score <- score + 16 if a ^ b & c == 7
    score <- score + 32 if a | b & c == 7
    # `&` looser than the shifts: `a & (b << 1)` is 0, not 3
    score <- score + 64 if a & b << 1 == 3
    return score
