# Equal variant names/ordinals in separate roots must not make this a tag-only test.
module Alpha:
    public:
        enum Node layout(handle: u32):
            pass
        enum Leaf is Node:
            Value(v: i64)
module Beta:
    public:
        enum Node layout(handle: u32):
            pass
        enum Leaf is Node:
            Value(v: i64)

def main() -> i64:
    can Memory.Allocate, Abort.Panic:
        region owner(65536):
            store: Alpha::Node.Store[Local] = Alpha::Node.Store(owner)
            in store:
                value: Alpha::Node = new Alpha::Leaf.Value(v: 42)
                return 1 if value is Beta::Leaf.Value
                return 0
