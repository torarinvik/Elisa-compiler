# A private wrapper imported from a sibling module must not supply EWR's callee.
module AliasInstaller:
    module Provider:
        public:
            error Fault:
                Available

            def origin() -> i64 error[AliasInstaller::Provider::Fault{Available}]:
                raise AliasInstaller::Provider::Fault.Available

        private:
            def wrap[errorset R](callback: fn() -> i64 error[R]) -> i64 error[R]:
                return try callback()

    from Provider import origin
    from Provider import wrap

module Peer:
    public:
        error Fault:
            Other

module App:
    public:
        def invalid_private_wrapper_call() -> i64 error[Peer::Fault{Other}]:
            return wrap(origin)

def main() -> i64:
    return 0
