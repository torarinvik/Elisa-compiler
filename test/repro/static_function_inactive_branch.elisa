# Static recursion checks must ignore statically unselected declarations and bodies.
static if false:
    static def inactive_partial(n: i32) -> i32:
        return inactive_partial(n)

static if true:
    static def active_partial(n: i32) -> i32:
        return active_partial(n)

    static def inactive_body_call(n: i32) -> i32:
        static if false:
            return inactive_body_call(n)
        return 0

# Same-spelled functions in separate modules must retain separate static identity.
module StaticIdentity:
    static def duplicate(n: i32) -> i32:
        return duplicate(n)

module RuntimeIdentity:
    def duplicate(n: i32) -> i32:
        return duplicate(n)

# A declaration in a proven-inactive arm must not make the active same-module
# declaration ambiguous to recursion/evaluation/static-error lookup.
static if false:
    def branch_shadow(n: i32) -> i32:
        return branch_shadow(n)

static if true:
    static def branch_shadow(n: i32) -> i32:
        if n <= 0:
            return 0
        return branch_shadow(n - 1)

static if false:
    def branch_error() -> i32:
        return 0

static if true:
    static def branch_error() -> i32:
        error("active branch")

static if false:
    static assert branch_error() == 0

static assert branch_error() == 0

module NestedErrorName:
    static def branch_error() -> i32:
        error("nested branch")

    static assert branch_error() == 0
