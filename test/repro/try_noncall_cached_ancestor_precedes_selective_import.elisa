# The lexical ancestor's declaration precedes the program-level selective alias.
module Provider:
    public:
        error ImportedFault:
            Imported

        def origin() -> i64 error[Provider::ImportedFault]:
            return 1

from Provider import origin

module Consumer:
    public:
        error LocalFault:
            Local

        def origin() -> i64 error[Consumer::LocalFault]:
            return 2

    module Inner:
        public:
            def ancestor_wins() -> i64 error[Consumer::LocalFault]:
                payload = origin()
                return try payload

def main() -> i64:
    return 0
