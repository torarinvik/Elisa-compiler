struct Item:
    value: mutable i32

def mutate_item(item: mutable Item&) -> void:
    item.value <- 42

extern invoke_optional_callback(item: mutable Item&, handler: mutable (fn(mutable Item&) -> void)?) -> void

def main() -> i64:
    item: mutable Item = Item{value: 0}
    invoke_optional_callback(&item, (mutate_item).cast[mutable (fn(mutable Item&) -> void)?])
    return 42 if item.value == 42 else 1
