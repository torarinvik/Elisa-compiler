# The native body needs a dictionary insertion helper that is intentionally absent here.
# The source-level type is otherwise valid; pymodule-so should report the missing native
# wrapper before producing an importable-but-broken extension.
struct DictBucket[K, T]:
    key: mutable K
    value: mutable T
    state: mutable u8

struct DynDict[K, T]:
    items: mutable DictBucket[K, T]&?
    count: usize
    used: usize
    capacity: usize
    arena: mutable i64

def unsupported_literal() -> dict[i64, i64]:
    return {1: 2}

def ok() -> i64:
    return 1

export pymodule unsupported_target:
    fn unsupported_literal
    fn ok
