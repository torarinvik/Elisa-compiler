# The SCOPE of a pattern binding — and stage0's rule is NOT uniform, which is the whole
# difficulty. Measured against stage0, three forms, two different rules:
#
#   `if e is E.A(v):`   the binding is scoped to the STATEMENT. After it, `v` is the outer
#                       local again.
#   `catch f():  v: …`  the binding is scoped to the ARM.
#   `match e: E.A(v):`  the binding SURVIVES the match, carrying the TAKEN arm's value.
#
# stage1 got all three wrong, in two different ways, from one shared cause: declare_local
# only ever PUSHES, and lookup_index scans BACKWARD. So a binding stayed live to the end of
# the function and shadowed any same-named outer local from that point on.
#
#   is    outer 100, bound 3  ->  stage0 100, stage1 3     silent wrong answer
#   catch outer 100, bound 42 ->  stage0 142, stage1 84    silent wrong answer
#   match outer 100, bound 3  ->  stage0 3,   stage1 139   SIGSEGV
#
# The match case failed differently because each ARM allocated its own slot, so the read
# after the match loaded a slot that does not dominate it — `opt -passes=verify` rejects the
# module ("Instruction does not dominate all uses"), and a variant that happens to take the
# LAST arm answers correctly while still emitting invalid IR. The fix is one shared slot per
# bound NAME across the arms, allocated in the entry block, which is also what makes the
# survives-the-match rule fall out naturally.
#
# Scoping the match arms like the other two would have been the obvious "fix" and would have
# introduced a fresh divergence: bit 4 below is exactly that trap.
#
# stage0 answers 63.
enum E:
    A(x: i64)
    B(x: i64)


error FE:
    Bad


def read(n: i64) -> i64 error[FE]:
    raise FE.Bad if n == 1
    return 42


def find(ok: bool) -> i64?:
    null return if not ok
    return 9


def main() -> i64:
    score: mutable i64 = 0

    # `is` — scoped to the statement, so the outer value survives it.
    outer_is: i64 = 100
    subject: E = E.A(3)
    if subject is E.A(outer_is):
        score <- score + 1 if outer_is == 3
    score <- score + 2 if outer_is == 100

    # `catch` — scoped to the arm.
    outer_catch: i64 = 100
    caught: i64 = catch read(0):
        outer_catch:
            outer_catch
        error e:
            7
    score <- score + 4 if caught + outer_catch == 142

    # `match` — the binding SURVIVES, carrying the taken arm's value. A shared slot, so the
    # value is well defined; reading it after the match is not a dominance violation.
    outer_match: i64 = 100
    match subject:
        E.A(outer_match):
            pass
        E.B(outer_match):
            pass
    score <- score + 8 if outer_match == 3

    # The binding is still usable INSIDE its arm, which the shared slot must not disturb.
    match E.B(7):
        E.A(inner):
            score <- score + 1000
        E.B(inner):
            score <- score + 16 if inner == 7

    # An optional `is` with no outer name in play — the ordinary case, pinned so the scope
    # restore cannot break it.
    if find(true) is present:
        score <- score + 32 if present == 9
    if find(false) is absent:
        score <- score + 1000 + absent

    return score
