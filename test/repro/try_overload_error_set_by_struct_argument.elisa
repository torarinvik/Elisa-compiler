module First:
    public:
        error Fault:
            Bad

module Second:
    public:
        error Fault:
            Other

module API:
    struct FirstArg:
        value: i64

    struct SecondArg:
        value: i64

    def choose(value: FirstArg) -> i64 error[First::Fault]:
        return 1

    def choose(value: SecondArg) -> i64 error[Second::Fault]:
        raise Second::Fault.Other

    def matching_first_overload(value: FirstArg) -> i64 error[First::Fault]:
        return try choose(value)

    def matching_second_overload(value: SecondArg) -> i64 error[Second::Fault]:
        return try choose(value)

    def mismatched_second_overload(value: SecondArg) -> i64 error[First::Fault]:
        return try choose(value)

def main() -> i64:
    return 0
