error FooError:
    Bad1
    Bad2

error BarError:
    Bad3
    Bad4(n: u32)

extern foo() -> i64 error[FooError{Bad1}, BarError{Bad3, Bad4}]

def use() -> i64:
    catch foo():
        n: return n
        FooError.Bad1: return 1
        BarError.Bad3: return 3
        BarError.Bad4(x): return x.i64()
    return 0
