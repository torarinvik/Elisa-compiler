error FooError:
    Bad1
    Bad2

error BarError:
    Bad3
    Bad4(n: u32)

extern foo() -> i64 error[FooError{Bad1}, BarError{Bad3, Bad4}]

def use() -> i64:
    return catch foo():
        n: n
        FooError.Bad1: 1
        BarError.Bad3: 3
        BarError.Bad4(x): x.i64()

def main() -> i64:
    return use()
