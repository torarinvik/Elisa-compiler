error Fault:
    Good(payload: i64)
    Other(payload: i64)

def produce_good() -> i64 error[Fault{Other}, Fault{Good}]:
    raise Fault.Good(37)

def produce_other() -> i64 error[Fault{Other}, Fault{Good}]:
    raise Fault.Other(53)

def forward(callback: fn() -> i64 error[Fault{Other}, Fault{Good}]) -> i64 error[Fault]:
    return try callback()

def catch_good() -> i64:
    return catch forward(produce_good):
        value: value
        Fault.Good(payload): payload
        Fault.Other(payload): payload

def catch_other() -> i64:
    return catch forward(produce_other):
        value: value
        Fault.Good(payload): payload
        Fault.Other(payload): payload

def main() -> i64:
    return 1 if catch_good() != 37
    return 2 if catch_other() != 53
    return 0
