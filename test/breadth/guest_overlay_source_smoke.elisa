# Driver probe: stage1 lowers GuestVAddr overlay accessors to MemoryManager_ReadU64.
# Built via emit_native IR text; the parity script greps for the expected symbols.
extern MemoryManager_ReadU64(mem: uintptr, addr: uintptr) -> u64

struct MemParamOverlay layout(guest, size: 48):
    size: u64 at 0
    ext2: u64 at 40

def read_ext2(raw: uintptr, memory: uintptr) -> u64:
    mem_param: GuestVAddr[MemParamOverlay] = raw.cast[GuestVAddr[MemParamOverlay]]
    return mem_param.ext2[memory]

def main() -> i64:
    return 0
