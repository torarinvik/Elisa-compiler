# Stage1 EASM parser smoke: explicit layout metadata and guarded fields survive parsing.
include "../../src/backend/codegen.elisa"

def main() -> i64:
    source: mutable darray[u8] = [109, 111, 100, 117, 108, 101, 32, 115, 109, 111, 107, 101, 10, 116, 97, 114, 103, 101, 116, 32, 120, 56, 54, 95, 54, 52, 10, 108, 97, 121, 111, 117, 116, 32, 72, 101, 97, 100, 101, 114, 32, 115, 105, 122, 101, 32, 51, 50, 58, 10, 32, 32, 56, 32, 118, 97, 108, 117, 101, 58, 32, 117, 54, 52, 10, 32, 32, 50, 52, 32, 116, 97, 105, 108, 58, 32, 117, 49, 54, 32, 114, 101, 113, 117, 105, 114, 101, 115, 32, 115, 105, 122, 101, 32, 62, 61, 32, 50, 54, 10]
    parsed: Easm::Module = Easm::parse_layout_module((&source[0]).cast[u8&], source.count.usize(), "smoke.easm")
    layout: Easm::Layout = parsed.layouts[0]
    first: Easm::LayoutField = layout.fields[0]
    second: Easm::LayoutField = layout.fields[1]
    42 return if parsed.name == "smoke" and parsed.target == "x86_64" and parsed.layouts.count == 1 and layout.size == 32 and layout.stride == 0 and layout.fields.count == 2 and first.width == 8 and second.width == 2 and second.requires_size_at_least == 26 and Easm::layout_size(layout) == 32
    return 1
