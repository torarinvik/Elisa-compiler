# EASM must reject signed-64-bit field-extent overflow before layout bounds are used.
include "../../src/backend/codegen.elisa"

def has_issue(issues: darray[Easm::Issue], code: sview) -> bool:
    for issue in issues:
        return true if issue.code == code
    return false

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        overflowing: Easm::LayoutField = Easm::LayoutField{offset: 9223372036854775807, name: "tail", type_name: "u64", width: 8, requires_size_at_least: 0, line: 2}
        inferred: Easm::Layout = Easm::Layout{name: "Inferred", fields: [overflowing], size: 0, stride: 0, line: 1}
        inferred_module: Easm::Module = Easm::Module{path: "inferred.easm", name: "inferred", target: "x86_64", issues: [], functions: [], fragments: [], protocols: [], templates: [], layouts: [inferred]}
        inferred_issues: darray[Easm::Issue] = Easm::verify_module(inferred_module)
        1 return if not has_issue(inferred_issues, "layout-field-extent-overflow")
        inferred_size: (valid: bool, value: i64) = Easm::layout_size_checked(inferred)
        2 return if inferred_size.valid or Easm::layout_size(inferred) != -1

        near_overflowing: Easm::LayoutField = Easm::LayoutField{offset: 9223372036854775804, name: "near_tail", type_name: "u64", width: 8, requires_size_at_least: 0, line: 2}
        explicit: Easm::Layout = Easm::Layout{name: "Explicit", fields: [near_overflowing], size: 16, stride: 0, line: 1}
        explicit_module: Easm::Module = Easm::Module{path: "explicit.easm", name: "explicit", target: "x86_64", issues: [], functions: [], fragments: [], protocols: [], templates: [], layouts: [explicit]}
        explicit_issues: darray[Easm::Issue] = Easm::verify_module(explicit_module)
        3 return if not has_issue(explicit_issues, "layout-field-extent-overflow")
        overlay_issues: mutable darray[Easm::Issue] = []
        access: Easm::GuestOverlayAccess = Easm::resolve_guest_overlay_access(explicit, "near_tail", 8, overlay_issues)
        4 return if not has_issue(overlay_issues, "layout-field-extent-overflow") or access.offset != -1

        boundary_field: Easm::LayoutField = Easm::LayoutField{offset: 9223372036854775799, name: "tail", type_name: "u64", width: 8, requires_size_at_least: 0, line: 2}
        boundary: Easm::Layout = Easm::Layout{name: "Boundary", fields: [boundary_field], size: 0, stride: 0, line: 1}
        boundary_module: Easm::Module = Easm::Module{path: "boundary.easm", name: "boundary", target: "x86_64", issues: [], functions: [], fragments: [], protocols: [], templates: [], layouts: [boundary]}
        boundary_issues: darray[Easm::Issue] = Easm::verify_module(boundary_module)
        5 return if has_issue(boundary_issues, "layout-field-extent-overflow") or has_issue(boundary_issues, "layout-field-out-of-bounds")
        boundary_size: (valid: bool, value: i64) = Easm::layout_size_checked(boundary)
        6 return if not boundary_size.valid or boundary_size.value != 9223372036854775807
        return 0
