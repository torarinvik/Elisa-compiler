# Stage1 EASM model smoke: exercises the shared typed layout primitives in the self-hosted
# compiler build. The full parser/emitter gate will extend this fixture as those slices land.
include "../../src/backend/codegen.elisa"

def main() -> i64:
    field: Easm::LayoutField = Easm::LayoutField{offset: 8, name: "value", type_name: "u64", width: 8, requires_size_at_least: 0, line: 2}
    fields: mutable darray[Easm::LayoutField] = [field]
    layout: Easm::Layout = Easm::Layout{name: "Header", fields: fields, size: 0, stride: 0, line: 1}
    42 return if Easm::layout_size(layout) == 16 and Easm::layout_access_is_valid(layout, "value", 8)
    return 1
