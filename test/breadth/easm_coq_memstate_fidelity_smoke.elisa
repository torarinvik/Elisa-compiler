# Executable stage1 mirror of the Coq EASM-TAL memory-state lattice.
include "../../src/backend/codegen.elisa"

def main() -> i64:
    # A join uses the weaker predecessor bound, never the stronger one.
    return 1 if:
        Easm::easm_memstate_join_min(64, 16) != 16
        Easm::easm_memstate_join_min(16, 64) != 16

    # Reads are typed exactly when the requested span is covered by the joined bound.
    return 1 if:
        not Easm::easm_memstate_guard_join(64, 16, 16)
        Easm::easm_memstate_guard_join(64, 16, 17)
        not Easm::easm_memstate_read_well_typed(0, 0)
        Easm::easm_memstate_read_well_typed(8, 0)
    return 0
