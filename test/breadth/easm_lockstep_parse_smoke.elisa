# Stage1 EASM lockstep parser smoke.
include "../../src/backend/codegen.elisa"

def main() -> i64:
    source: mutable darray[u8] = [109, 111, 100, 117, 108, 101, 32, 108, 115, 10, 116, 97, 114, 103, 101, 116, 32, 120, 56, 54, 95, 54, 52, 10, 101, 120, 112, 111, 114, 116, 32, 100, 101, 102, 32, 115, 116, 101, 112, 40, 120, 58, 32, 117, 54, 52, 41, 32, 45, 62, 32, 118, 111, 105, 100, 32, 97, 98, 105, 32, 99, 58, 10, 105, 110, 112, 117, 116, 115, 58, 10, 32, 32, 32, 32, 120, 32, 61, 32, 37, 114, 100, 105, 10, 98, 111, 100, 121, 58, 10, 32, 32, 32, 32, 109, 111, 118, 32, 37, 114, 100, 105, 44, 32, 37, 114, 97, 120, 10, 114, 101, 102, 101, 114, 101, 110, 99, 101, 58, 10, 32, 32, 32, 32, 109, 111, 118, 32, 37, 114, 100, 105, 44, 32, 37, 114, 97, 120, 10, 116, 97, 114, 103, 101, 116, 32, 120, 56, 54, 95, 54, 52, 32, 108, 111, 99, 107, 115, 116, 101, 112, 32, 114, 101, 102, 101, 114, 101, 110, 99, 101, 58, 10, 32, 32, 32, 32, 109, 111, 118, 32, 37, 114, 100, 105, 44, 32, 37, 114, 97, 120, 10]
    parsed: Easm::Module = Easm::parse_layout_module((&source[0]).cast[u8&], source.count.usize(), "lockstep.easm")
    if parsed.functions.count != 1: return 10
    if parsed.functions[0].reference.count != 1: return 11
    if parsed.functions[0].targets.count != 1: return 12
    if parsed.functions[0].instructions.count != 1: return 13
    if parsed.functions[0].targets[0].instructions.count != 1: return 14
    return 42
