# Stage1 native emitter driver: read an Elisa source file on stdin, run
# lex -> parse -> backend, and write the LLVM IR of the emitted module to stdout.
#
# This is the stage1 counterpart of stage0's `-emit llvm`. It exists so the backend port
# has an executable oracle: the IR it prints can be assembled, linked and RUN, so a
# fixture asserts real behavior (an exit code) rather than "the compiler didn't crash".
#
# Prints "UNSUPPORTED" (and exits non-zero) when the input is outside the backend's
# modeled subset, so a fixture can never mistake "declined to emit" for "emitted".
include "../../src/backend/codegen.elisa"
using Bytes

extern read(fd: int, buf: void&, count: usize) -> isize can[Console]
extern write(fd: int, buf: void&, count: usize) -> isize can[Console]


def read_all() -> darray[u8] can[Console, Memory.Allocate, Abort.Panic]:
    buf: mutable darray[u8] = []
    chunk: mutable darray[u8] = [0 for _ in 0..<8192]
    while true |buf|:
        n: isize = read(0, (&chunk[0]).cast[void&], 8192) can Console
        break if n <= 0
        for index in 0..<n.usize() |buf|:
            buf.push(chunk[index])
    buf.push(0)
    return buf


def main() -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    src: darray[u8] = read_all()
    1 return if src.count <= 1
    source_length: usize = src.count - 1
    tokens: darray[Lexer::Token] = frontend_tokenize_with_length(&src[0], &src[0], source_length)
    file: Ast::File = frontend_parser_parse_file(&src[0], tokens)
    1 return if file.errors.count != 0

    ctx: LLVMContextRef = LLVMContextCreate()
    module_handle: LLVMModuleRef = LLVMModuleCreateWithNameInContext("elisa_stage1", ctx)
    builder: LLVMBuilderRef = LLVMCreateBuilderInContext(ctx)

    emitted_count: i64 = Backend::emit_module(file, module_handle, ctx, builder)

    if emitted_count == 0:
        _ = puts("UNSUPPORTED") can Console
        return 2

    ir: cstr = LLVMPrintModuleToString(module_handle)
    _ = puts(ir) can Console
    LLVMDisposeBuilder(builder)
    LLVMDisposeModule(module_handle)
    LLVMContextDispose(ctx)
    return 0
