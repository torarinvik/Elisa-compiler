# Stage1 C-header driver. It shares the parser and backend registration path, then prints
# the generated NUL-terminated header so a shell test can compile it with a C consumer.
include "../../src/backend/codegen.elisa"

extern read(fd: int, buf: void&, count: usize) -> isize can[Console]
# `puts` is already declared by the included backend (src/backend/llvm_c.elisa);
# re-declaring it here is a duplicate-declaration error.

def read_all() -> darray[u8] can[Console, Memory.Allocate, Abort.Panic]:
    source: mutable darray[u8] = []
    chunk: mutable darray[u8] = [0 for _ in 0..<8192]
    while true |source|:
        count: isize = read(0, (&chunk[0]).cast[void&], 8192) can Console
        break if count <= 0
        for index in 0..<count.usize() |source|:
            source.push(chunk[index])
    source.push(0)
    return source


def main() -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    source: darray[u8] = read_all()
    1 return if source.count <= 1
    tokens: darray[Lexer::Token] = frontend_tokenize_with_length(&source[0], &source[0], source.count - 1)
    file: Ast::File = frontend_parser_parse_file(&source[0], tokens)
    2 return if file.errors.count != 0
    ctx: LLVMContextRef = LLVMContextCreate()
    module_handle: LLVMModuleRef = LLVMModuleCreateWithNameInContext("elisa_header", ctx)
    machine: LLVMTargetMachineRef = Backend::configure_module_target(module_handle)
    target_data: LLVMTargetDataRef = LLVMCreateTargetDataLayout(machine)
    header: darray[u8] = Backend::generate_c_header_for_file(file, module_handle, ctx, "ELISA_GENERATED_H", target_data)
    3 return if header.count == 0
    _ = puts((&header[0]).cast[cstr]) can Console
    LLVMDisposeModule(module_handle)
    LLVMContextDispose(ctx)
    return 0
