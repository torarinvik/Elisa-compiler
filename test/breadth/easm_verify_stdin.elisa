# Stage1 EASM stdin verifier: the host pipes a complete .easm module on stdin.
# Prints:
#   RESULT accept
# or
#   RESULT reject
#   CODE <code>
# for each error issue. Exit 0 on accept, 1 on reject (any Severity.Error).
include "../../src/backend/codegen.elisa"
using Bytes

extern read(fd: int, buf: void&, count: usize) -> isize can[Console]
extern write(fd: int, buf: void&, count: usize) -> isize can[Console]

def read_chunk(chunk: mutable darray[u8]&) -> isize can[Console, Unsafe{PointerCast, UncheckedIndex}]:
    can Console:
        can Unsafe{PointerCast, UncheckedIndex}:
            return read(0, (&chunk[0]).cast[void&], 4096) can Console

def read_all() -> darray[u8] can[Console, Memory.Allocate, Abort.Panic, Unsafe{PointerCast, UncheckedIndex}]:
    can Console, Memory.Allocate, Abort.Panic:
        source: mutable darray[u8] = []
        chunk: mutable darray[u8] = [0 for _ in 0..<4096]
        while true |source|:
            amount: mutable isize = 0
            can Unsafe{PointerCast, UncheckedIndex}:
                amount <- read_chunk(chunk)
            break if amount <= 0
            for index in 0..<amount.usize() |source|:
                source.push(chunk[index])
        return source

def append_text(out: mutable darray[u8]&, text: sview) -> void can[Memory.Allocate, Abort.Panic]:
    can Memory.Allocate, Abort.Panic:
        for index in 0..<sview_len(text) |out, text|:
            out.push(sview_at(text, index))

def parse_source(source: darray[u8]) -> Easm::Module can[Memory.Allocate, Abort.Panic, Unsafe{PointerCast, UncheckedIndex}]:
    can Memory.Allocate, Abort.Panic:
        can Unsafe{PointerCast, UncheckedIndex}:
            return Easm::parse_module((&source[0]).cast[u8&], source.count, "stdin.easm")

def main() -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe{PointerCast, UncheckedIndex}]:
    can Console, Memory.Allocate, Abort.Panic:
        source: darray[u8] = read_all()
        2 return if source.count == 0
        # parse_module returns the complete result: parser diagnostics plus the
        # module verifier diagnostics. Re-verifying the model alone would drop
        # errors that can only be reported while parsing numeric declarations.
        parsed: Easm::Module = parse_source(source)
        issues: darray[Easm::Issue] = parsed.issues
        out: mutable darray[u8] = []
        has_error: mutable bool = false
        for issue in issues |has_error|:
            has_error <- true if issue.severity == Easm::Severity.Error
        if has_error:
            append_text(out, "RESULT reject\n")
            for issue in issues |out|:
                if issue.severity == Easm::Severity.Error:
                    append_text(out, "CODE ")
                    append_text(out, issue.code)
                    append_text(out, "\n")
            can Unsafe{PointerCast, UncheckedIndex}:
                _ = write(1, (&out[0]).cast[void&], out.count.usize()) can Console
            return 1
        append_text(out, "RESULT accept\n")
        can Unsafe{PointerCast, UncheckedIndex}:
            _ = write(1, (&out[0]).cast[void&], out.count.usize()) can Console
        return 0
