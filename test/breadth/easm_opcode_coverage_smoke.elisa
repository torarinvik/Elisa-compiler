# Stage1 EASM operation-set parity smoke: stage0's xchg/FPU/SIMD operations are recognized and
# still require their declared machine capabilities.
include "../../src/backend/codegen.elisa"

def main() -> i64:
    0 return if Easm::operation_is_known("xchgq") and Easm::operation_is_known("fldcw") and Easm::operation_is_known("vzeroall") and Easm::operation_capability("xchgq") == "x86_64.atomic.rmw" and Easm::operation_capability("fldcw") == "x86_64.fpu_control" and Easm::operation_capability("vzeroall") == "x86_64.simd_state"
    2 return if Easm::operation_is_known("movgarbage") or Easm::operation_is_known("jnot_a_real_condition")
    3 return if Easm::operation_capability("xchg_fake") != "" or Easm::operation_capability("cpuid_extra") != ""
    add_effect: Easm::OperationEffect = Easm::easm_operation_effect("addq")
    4 return if not add_effect.known or not add_effect.clobbers_flags or add_effect.implicit_reads != 0
    cpuid_effect: Easm::OperationEffect = Easm::easm_operation_effect("cpuid")
    5 return if not cpuid_effect.result_defines or cpuid_effect.implicit_reads != 3 or cpuid_effect.implicit_writes != 15
    call_effect: Easm::OperationEffect = Easm::easm_operation_effect("callq")
    6 return if not call_effect.implicit_cc or call_effect.implicit_writes != 3895
    return 1
