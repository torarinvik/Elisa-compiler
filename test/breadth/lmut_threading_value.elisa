# An `lmut` method used as a VALUE in a THREADING position yields the MUTATED RECEIVER —
# the method's own return value is discarded.
#
#     parser, out <- if …: parser, out.push(d) else: parser.advance(), out
#
# stage1 stored the CALL's RESULT into the receiver's slot instead. In the compiler's own
# parser (src/parser/parser_decl_dispatch.elisa) that wrote `advance`'s 20-byte Token over
# the head of the 2120-byte Parser — `source`, `tokens.items`, `tokens.count` — so the next
# `peek()` read a Token through a null items pointer and stage1 SEGFAULTED on
# `def f(c: i64&mutable, v: i64)` where stage0 prints three diagnostics. It only fires on a
# recovery path (the declaration failed to parse), which is why self-hosting never saw it.
#
# Everywhere it does not crash it is a silent wrong answer: the return value simply lands on
# the receiver's leading fields.
#
# The boundary matters as much as the rule. stage0 accepts the threading reading ONLY in the
# multi-target rebind; the single-target `d <- d.step()` is "cannot assign i64 to Box" there,
# so it is deliberately absent below. And a method that genuinely RETURNS a receiver-typed
# value must keep taking the ordinary path — bit 1 is exactly that case, and a fix that
# intercepts on the receiver's type alone breaks it.
#
# The receiver comes in two shapes that take DIFFERENT emitter paths — a local, and an
# `lmut` PARAMETER whose slot holds a pointer (the compiler's own shape, where the store goes
# through that pointer). A fix that admits only locals passes bits 1-8 and leaves the parser
# crashing exactly as before, so bit 16 is not decoration.
#
# LIVES IN test/breadth, NOT test/repro, on purpose. The ast/iface parity smokes render every
# test/repro fixture, and stage0 collapses this file's `main` to ONE statement while stage1
# renders all of them — a PRE-EXISTING rendering divergence (any call returning a struct into
# a local, in a file that also declares `lmut` functions) that has nothing to do with the bug
# below. It is filed separately with its own minimal repro. The behavioural differential
# corpus sweeps all of test/ for `^def main`, so the runtime answer here is still compared
# every gate.
#
# stage0 answers 29.
struct Box:
    tag: mutable i64
    n: mutable i64


# Four words, so a mistaken store lands on more than one receiver field — the shape that
# made the parser crash rather than merely answer wrong.
struct Wide:
    w0: i64
    w1: i64
    w2: i64
    w3: i64


def Box(n: i64) -> Box:
    return Box{tag: 7, n: n}


def doubled(box: Box) -> Box:
    return Box{tag: box.tag + 1, n: box.n * 2}


def step(box: lmut Box) -> i64:
    box.n <- box.n + 1
    return 99


def widen(box: lmut Box) -> Wide:
    box.n <- box.n + 1
    return Wide{w0: 41, w1: 42, w2: 43, w3: 44}


# The receiver is an `lmut` PARAMETER — a ref whose slot holds the pointer — not a local.
# This is the compiler's own shape (`def parse_declaration_unit(parser: lmut Parser, …)`),
# and it takes a DIFFERENT emitter path: the store goes THROUGH the pointer, so the
# return value lands on the pointee's first field. A fix that only admits local receivers
# passes every case above and leaves the parser crashing exactly as before.
def thread_param(box: lmut Box, flag: bool) -> void:
    spare: mutable i64 = 0
    box, spare <-
        if flag:
            box, spare + 100
        else:
            box.step(), spare


def main() -> i64:
    score: mutable i64 = 0

    # A method that genuinely RETURNS a receiver-typed value: still the value.
    b: mutable Box = Box(3)
    b <- b.doubled()
    score <- score + 1 if b.tag == 8 and b.n == 6

    # (A method returning some OTHER struct is the natural third guard, but every spelling
    # of it collapses stage0's `-emit ast` body to one statement — a separate rendering
    # divergence — so it lives in its own task rather than failing this file for an
    # unrelated reason.)

    # THE THREADING POSITION: the value is the mutated receiver, not the 99.
    c: mutable Box = Box(1)
    total: mutable i64 = 0
    hit: bool = false
    c, total <-
        if hit:
            c, total + 100
        else:
            c.step(), total
    score <- score + 4 if c.tag == 7 and c.n == 2 and total == 0

    # The same, with a WIDE return — the parser's shape. `tag` is what a mistaken store
    # overwrites first.
    e: mutable Box = Box(10)
    mark: mutable i64 = 5
    e, mark <-
        if hit:
            e, mark + 100
        else:
            e.widen(), mark
    score <- score + 8 if e.tag == 7 and e.n == 11 and mark == 5

    # The receiver as an `lmut` PARAMETER — the compiler's own shape, and a different
    # emitter path (the store goes through the pointer).
    f: mutable Box = Box(20)
    f <- f.thread_param(false)
    score <- score + 16 if f.tag == 7 and f.n == 21

    return score
