# Stage1 EASM existential-handle verifier smoke.
include "../../src/backend/codegen.elisa"

def main() -> i64:
    parameter: Easm::Param = Easm::Param{name: "token", type_name: "Handle[Texture]"}
    empty: Easm::Substitution = Easm::Substitution{from: "", replacement: ""}
    input: Easm::Instruction = Easm::Instruction{op: "mov", text: "mov (%rax), %rcx", line: 4, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    fn: Easm::Function = Easm::Function{name: "bad_handle", params: [parameter], return_type: "void", abi: "c", effects: [], requires: [], changes: [], reads: [], clobbers: ["rcx", "memory"], preserves: [], facts: [], inputs: ["token = %rax"], outputs: [], stack_facts: [], control: [], labels: [], instructions: [input], reference: [], targets: [], line: 2, platform: "x86_64"}
    module: Easm::Module = Easm::Module{path: "handle.easm", name: "handle", target: "x86_64", issues: [], functions: [fn], fragments: [], protocols: [], templates: [], layouts: []}
    issues: darray[Easm::Issue] = Easm::verify_module(module)
    if issues.count == 0: return 1
    return 42
