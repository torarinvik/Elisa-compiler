include "../../src/backend/codegen.elisa"

def has_effect(effects: darray[sview], wanted: sview) -> bool:
    for effect in effects:
        true return if effect == wanted
    return false

def main() -> i64:
    empty: Easm::Substitution = Easm::Substitution{from: "", replacement: ""}
    state_guest: Easm::Instruction = Easm::Instruction{op: "state", text: "fs: guest", line: 1, pseudo: true, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    state_host: Easm::Instruction = Easm::Instruction{op: "state", text: "fs: host", line: 2, pseudo: true, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    reference_inst: Easm::Instruction = Easm::Instruction{op: "ret", text: "ret", line: 3, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    target_inst: Easm::Instruction = Easm::Instruction{op: "trap", text: "trap", line: 4, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    target: Easm::TargetBody = Easm::TargetBody{arch: "x86_64", lockstep: "reference", instructions: [target_inst], line: 4}
    fn: Easm::Function = Easm::Function{name: "api", params: [], return_type: "void", abi: "c", effects: [], requires: ["x86_64.segment.write", "control.indirect", "memory.base.untyped"], changes: [], reads: [], clobbers: [], preserves: [], facts: [], inputs: [], outputs: [], stack_facts: [], control: [], labels: [], instructions: [state_guest, state_host], reference: [reference_inst], targets: [target], line: 1, platform: "x86_64"}
    effects: darray[sview] = Easm::easm_derived_effects(fn)
    1 return if not has_effect(effects, "Unsafe.RawExtern") or not has_effect(effects, "Unsafe.SegmentMutation") or not has_effect(effects, "Unsafe.IndirectCall") or not has_effect(effects, "Unsafe.PointerCast")
    2 return if has_effect(effects, "Segment.Guest") or not has_effect(effects, "Segment.Host")
    body: mutable darray[Easm::Instruction] = Easm::easm_emitted_body(fn)
    3 return if body.count != 1 or body[0].op != "trap"
    fn.targets <- []
    fn.instructions <- []
    body <- Easm::easm_emitted_body(fn)
    4 return if body.count != 1 or body[0].op != "ret"
    return 0
