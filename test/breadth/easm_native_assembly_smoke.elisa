# Stage1 EASM native assembly text smoke.
include "../../src/backend/codegen.elisa"

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    empty: Easm::Substitution = Easm::Substitution{from: "", replacement: ""}
    instruction: Easm::Instruction = Easm::Instruction{op: "ret", text: "ret", line: 4, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    fn: Easm::Function = Easm::Function{name: "finish", params: [], return_type: "void", abi: "c", effects: [], requires: [], changes: [], reads: [], clobbers: [], preserves: [], facts: [], inputs: [], outputs: [], stack_facts: [], control: [], labels: [], instructions: [instruction], reference: [], targets: [], line: 3, platform: "any"}
    module: Easm::Module = Easm::Module{path: "native.easm", name: "native", target: "x86_64", issues: [], functions: [fn], fragments: [], protocols: [], templates: [], layouts: []}
    out: mutable darray[u8] = []
    arena: mutable Arena = zeroed
    in arena:
        Easm::emit_native_assembly(module, "x86_64", out)
        42 return if out.count > 0 and out[0] == 46
    return 1
