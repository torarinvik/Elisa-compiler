include "../../src/backend/codegen.elisa"

def bytes_equal(left: darray[u8], expected: sview) -> bool:
    false return if left.count != sview_len(expected)
    for index in 0..<left.count |left, expected|:
        false return if left[index] != expected[index]
    return true

def main() -> i64:
    field: Easm::LayoutField = Easm::LayoutField{offset: 64, name: "mem_param", type_name: "u64", width: 8, requires_size_at_least: 0, line: 1}
    layout: Easm::Layout = Easm::Layout{name: "ProcParamOverlay", fields: [field], size: 72, stride: 0, line: 1}
    issues: mutable darray[Easm::Issue] = []
    read: Easm::GuestOverlayDesugar = Easm::desugar_guest_overlay_accessor(layout, "proc_param.mem_param[memory]", issues)
    1 return if issues.count != 0 or read.is_write
    read_bytes: mutable darray[u8] = []
    Easm::emit_guest_overlay_call(read, read_bytes)
    2 return if not bytes_equal(read_bytes, "MemoryManager_ReadU64(memory, proc_param + 64)")

    issues <- []
    write: Easm::GuestOverlayDesugar = Easm::desugar_guest_overlay_accessor(layout, "proc_param.mem_param[memory] = new_val", issues)
    3 return if issues.count != 0 or not write.is_write
    write_bytes: mutable darray[u8] = []
    Easm::emit_guest_overlay_call(write, write_bytes)
    4 return if not bytes_equal(write_bytes, "MemoryManager_WriteU64(memory, proc_param + 64, new_val)")

    issues <- []
    _ = Easm::desugar_guest_overlay_accessor(layout, "proc_param.missing[memory]", issues)
    5 return if issues.count == 0
    return 0
