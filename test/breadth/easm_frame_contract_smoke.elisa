# Stage1 EASM verifier smoke: a declared frame must authorize the memory carrier used.
include "../../src/backend/codegen.elisa"

def main() -> i64:
    parameter: Easm::Param = Easm::Param{name: "src", type_name: "HostPtr[u64]"}
    empty: Easm::Substitution = Easm::Substitution{from: "", replacement: ""}
    load: Easm::Instruction = Easm::Instruction{op: "movq", text: "movq (%rax), %rcx", line: 5, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    fn: Easm::Function = Easm::Function{name: "bad_frame", params: [parameter], return_type: "void", abi: "c", effects: [], requires: [], changes: [], reads: ["other"], clobbers: ["rcx, memory"], preserves: [], facts: [], inputs: ["src = %rax"], outputs: [], stack_facts: [], control: [], labels: [], instructions: [load], reference: [], targets: [], line: 3, platform: "x86_64"}
    module: Easm::Module = Easm::Module{path: "frame.easm", name: "frame", target: "x86_64", issues: [], functions: [fn], fragments: [], protocols: [], templates: [], layouts: []}
    issues: darray[Easm::Issue] = Easm::verify_module(module)
    0 return if issues.count == 2
    return 1
