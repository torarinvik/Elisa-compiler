# Breadth reporter: read one source file on stdin, run the full stage1
# lex -> parse -> check pipeline, and print a terse machine-readable report:
#   P <n>                     number of parse errors
#     <kindcode> L<line> <context-token>   ... one per parse error
#   D <n>                     number of semantic diagnostics
#     <kindcode> L<line> <name>            ... one per diagnostic
# Used by breadth/run.sh to sweep the external corpora and surface real gaps.
include "../../src/semantic/semantic.elisa"
using Bytes

extern read(fd: int, buf: void&, count: usize) -> isize can[Console]
extern write(fd: int, buf: void&, count: usize) -> isize can[Console]


def read_all() -> darray[u8] can[Console, Memory.Allocate, Abort.Panic]:
    buf: mutable darray[u8] = []
    chunk: mutable darray[u8] = [0 for _ in 0..<8192]
    while true:
        n: isize = read(0, (&chunk[0]).cast[void&], 8192) can Console
        break if n <= 0
        i: mutable isize = 0
        while i < n:
            buf.push(chunk[i.usize()])
            i <- i + 1
    buf.push(0)
    return buf


def parse_kind_code(k: Ast::ParseErrorKind) -> i64:
    # docs/119 §4: a pure enum→code classifier reads best as a match expression.
    return match k:
        Ast::ParseErrorKind.ExpectedToken: 0
        Ast::ParseErrorKind.UnexpectedToken: 1
        Ast::ParseErrorKind.ExpectedDeclaration: 2
        _: 3


def emit(s: darray[u8]) -> void can[Console, Memory.Allocate, Abort.Panic]:
    return if s.count == 0
    _ = write(1, (&s[0]).cast[void&], s.count.usize()) can Console


# Detect the independent replay-mode header lines (`# strict`, `# flow-strict`, `# std`)
# across the leading comment block. Each `#` line is classified and its flag OR-ed in, so
# combinations (e.g. a strict trusted-stdlib source) are honoured. Only the first few lines
# are scanned — headers always lead the source.
def header_flags(src: darray[u8]&) -> (strict: bool, flow: bool, std: bool, flow_warn: bool, smt: bool, warn_discard: bool, progress: bool, extern_contracts: bool):
    can Abort.Panic:
        strict: mutable bool = false
        flow: mutable bool = false
        std: mutable bool = false
        flow_warn: mutable bool = false
        smt: mutable bool = false
        warn_discard: mutable bool = false
        progress: mutable bool = false
        extern_contracts: mutable bool = false
        base: mutable usize = 0
        line: mutable usize = 0
        while line < 5 and base < src.count |base, line, strict, flow, std, flow_warn, smt, warn_discard, progress, extern_contracts|:
            if src[base] == 35:
                # `# progress` — stage0's EnforceProgressSafety fingerprint.
                progress <- true if base + 5 < src.count and src[base + 2] == 112 and src[base + 3] == 114 and src[base + 4] == 111 and src[base + 5] == 103
                # `# strict` = base+2..7 spell "strict"; the char after must NOT be `-`
                # (that is `# strict-externs`, a distinct independent axis).
                spells_strict: bool = base + 7 < src.count and src[base + 2] == 115 and src[base + 3] == 116 and src[base + 4] == 114 and src[base + 5] == 105 and src[base + 6] == 99 and src[base + 7] == 116
                followed_by_dash: bool = base + 8 < src.count and src[base + 8] == 45
                extern_contracts <- true if spells_strict and followed_by_dash
                strict <- true if spells_strict and not followed_by_dash
                flow <- true if base + 7 < src.count and src[base + 2] == 102 and src[base + 3] == 108 and src[base + 4] == 111 and src[base + 5] == 119 and src[base + 6] == 45 and src[base + 7] == 115
                std <- true if base + 4 < src.count and src[base + 2] == 115 and src[base + 3] == 116 and src[base + 4] == 100 and (base + 5 >= src.count or src[base + 5] == 10 or src[base + 5] == 32)
                # `# flow` (mode 1, -Wflow) — distinguished from `# flow-strict` by the char
                # after `flow` being end-of-line/space, not `-`.
                flow_warn <- true if base + 5 < src.count and src[base + 2] == 102 and src[base + 3] == 108 and src[base + 4] == 111 and src[base + 5] == 119 and (base + 6 >= src.count or src[base + 6] == 10 or src[base + 6] == 32)
                # `# smt` — stage0's EnableSMT fingerprint; provability differs by tier.
                smt <- true if base + 4 < src.count and src[base + 2] == 115 and src[base + 3] == 109 and src[base + 4] == 116 and (base + 5 >= src.count or src[base + 5] == 10 or src[base + 5] == 32)
                # `# warn-discard` — stage0's WarnDiscardedValues (docs/119 W1) opt-in.
                warn_discard <- true if base + 5 < src.count and src[base + 2] == 119 and src[base + 3] == 97 and src[base + 4] == 114 and src[base + 5] == 110
            while base < src.count and src[base] != 10 |base|:
                base <- base + 1
            base <- base + 1
            line <- line + 1
        return (strict, flow, std, flow_warn, smt, warn_discard, progress, extern_contracts)


def main() -> void can[Console, Memory.Allocate, Abort.Panic]:
    src: darray[u8] = read_all()
    return if src.count <= 1
    slen: usize = src.count - 1
    tokens: darray[Lexer::Token] = frontend_tokenize_with_length(&src[0], &src[0], slen)
    file: Ast::File = frontend_parser_parse_file(&src[0], tokens)
    out: mutable darray[u8] = []
    push_str(out, "P ")
    push_int(out, file.errors.count.i64())
    out.push(10)
    for e in file.errors:
        push_str(out, "  ")
        push_int(out, parse_kind_code(e.kind))
        push_str(out, " L")
        push_int(out, e.line.i64())
        push_str(out, " ")
        push_sview(out, e.context)
        out.push(10)
    # Differential replay may request stage0 AnalyzeOptions modes via leading `#` comment
    # lines. They remain valid Elisa comments (the lexer ignores them) and keep the
    # reporter's stdin protocol usable by every existing smoke test. The three modes are
    # independent axes and may be combined (a case can be both `# strict` and `# std`), so
    # each is detected across the leading comment lines rather than only line 0.
    header: (strict: bool, flow: bool, std: bool, flow_warn: bool, smt: bool, warn_discard: bool, progress: bool, extern_contracts: bool) = header_flags(src)
    table: Semantic::SymbolTable = Semantic::check_full(file, header.strict, header.flow, header.std, header.flow_warn, header.smt, header.warn_discard, header.progress, header.extern_contracts)
    push_str(out, "D ")
    push_int(out, table.diagnostics.count.i64())
    out.push(10)
    for d in table.diagnostics:
        push_str(out, "  L")
        push_int(out, d.line.i64())
        push_str(out, " ")
        for b in Semantic::diagnostic_message(d):
            out.push(b)
        out.push(10)
    emit(out)
