include "../../src/parser/parser.elisa"
using Ast

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    source: mutable darray[u8] = []
    source.extend("effect Pair[A, B]:\n    def take(first: A, second: B) -> void\n\npermission Local:\n    Write\n\nhandler Sink() for Pair[darray[i64], i64&]:\n    def take(first: darray[i64], second: i64&) -> void:\n        return\n\ndef helper[T](first: darray[T], second: T&) -> void can[Pair[darray[T], T&] via Local.Write]:\n    return\n\ndef main() -> void:\n    can Pair[darray[i64], i64&] with Sink:\n        return\n")
    source.push(0)
    file: Ast::File = frontend_parse(&source[0])
    return 1 if file.errors.count != 0.usize()
    return 100 + file.effect_type_references.count.i64() if file.effect_type_references.count != 3.usize()
    generic_count: mutable usize = 0
    concrete_count: mutable usize = 0
    for reference in file.effect_type_references |generic_count, concrete_count|:
        return 3 if reference.position.line == 0
        return 17 if reference.lexical_owner != ""
        if reference.type_expression is Expr.IndexN(head, arguments, position):
            return 4 if arguments.count != 2.usize()
            if head is Expr.Ident(name, head_position):
                return 5 if name != "Pair"
            else:
                return 6
            if arguments[0] is Expr.Index(container, element, container_position):
                if container is Expr.Ident(container_name, container_name_position):
                    return 7 if container_name != "darray"
                else:
                    return 8
                if element is Expr.Ident(element_name, element_position):
                    if element_name == "T":
                        return 9 if reference.spelling != "Pair[darray[T], T&] via Local.Write"
                        generic_count <- generic_count + 1.usize()
                    elif element_name == "i64":
                        concrete_count <- concrete_count + 1.usize()
                    else:
                        return 10
                else:
                    return 11
            else:
                return 12
            if arguments[1] is Expr.Unary(operator, target, reference_position):
                return 13 if operator != TokenKind.Ampersand
            else:
                return 14
        else:
            return 15
    return 16 if generic_count != 1.usize() or concrete_count != 2.usize()
    forward_source: mutable darray[u8] = []
    forward_source.extend("module N:\n    def helper[T](value: T) -> void can[Later[T]]:\n        return\n\n    effect Later[T]:\n        def ping(value: T) -> void\n\ndef top[T](value: T) -> void can[N::Later[T]]:\n    return\n")
    forward_source.push(0)
    forward_file: Ast::File = frontend_parse(&forward_source[0])
    return 18 if forward_file.errors.count != 0.usize()
    return 19 if forward_file.effect_type_references.count != 2.usize()
    local_reference: Ast::EffectTypeReference = forward_file.effect_type_references[0]
    return 20 if local_reference.lexical_owner != "N"
    qualified_reference: Ast::EffectTypeReference = forward_file.effect_type_references[1]
    return 21 if qualified_reference.lexical_owner != ""
    if qualified_reference.type_expression is Expr.Index(qualified_head, argument, qualified_position):
        if qualified_head is Expr.Scope(namespace, family, family_position):
            return 22 if family != "Later"
            if namespace is Expr.Ident(namespace_name, namespace_position):
                return 23 if namespace_name != "N"
            else:
                return 24
        else:
            return 25
    else:
        return 26
    return 42
