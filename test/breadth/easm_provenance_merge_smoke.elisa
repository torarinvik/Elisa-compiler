include "../../src/backend/codegen.elisa"

def has_issue(issues: darray[Easm::Issue], code: sview) -> bool:
    for issue in issues:
        true return if issue.code == code
    return false

def main() -> i64:
    empty: Easm::Substitution = Easm::Substitution{from: "", replacement: ""}
    cmp: Easm::Instruction = Easm::Instruction{op: "cmpq", text: "cmpq $0, %rdi", line: 3, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    typed: Easm::Instruction = Easm::Instruction{op: "movq", text: "movq %rdi, %rcx", line: 4, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    branch: Easm::Instruction = Easm::Instruction{op: "je", text: "je join", line: 5, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    raw: Easm::Instruction = Easm::Instruction{op: "movq", text: "movq %rsi, %rcx", line: 6, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    label: Easm::Instruction = Easm::Instruction{op: "label", text: "join:", line: 7, pseudo: true, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    read: Easm::Instruction = Easm::Instruction{op: "movq", text: "movq (%rcx), %rax", line: 8, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    ret: Easm::Instruction = Easm::Instruction{op: "ret", text: "ret", line: 9, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    p: Easm::Param = Easm::Param{name: "p", type_name: "GuestVAddr[LayoutA]"}
    q: Easm::Param = Easm::Param{name: "q", type_name: "GuestVAddr[LayoutB]"}
    fn: Easm::Function = Easm::Function{name: "merge_provenance", params: [p, q], return_type: "void", abi: "c", effects: [], requires: [], changes: [], reads: [], clobbers: ["rax, rcx, cc, memory"], preserves: [], facts: [], inputs: ["p = %rdi", "q = %rsi"], outputs: ["result = %rax"], stack_facts: ["unchanged"], control: ["returns"], labels: [], instructions: [cmp, typed, branch, raw, label, read, ret], reference: [], targets: [], line: 2, platform: "x86_64"}
    module: Easm::Module = Easm::Module{path: "provenance_merge.elisa", name: "provenance_merge", target: "x86_64", issues: [], functions: [fn], fragments: [], protocols: [], templates: [], layouts: []}
    issues: darray[Easm::Issue] = Easm::verify_module(module)
    0 return if has_issue(issues, "provenance-merge-unsound")
    direct: mutable darray[Easm::Issue] = []
    Easm::easm_verify_provenance_merges(fn, direct)
    0 return if has_issue(direct, "provenance-merge-unsound")
    2 return if issues.count > 0
    return 1
