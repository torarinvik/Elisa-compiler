# Stage1 EASM conditional composition variant smoke.
include "../../src/backend/codegen.elisa"

def main() -> i64:
    source: mutable darray[u8] = [109, 111, 100, 117, 108, 101, 32, 99, 111, 109, 112, 10, 116, 97, 114, 103, 101, 116, 32, 120, 56, 54, 95, 54, 52, 10, 102, 114, 97, 103, 109, 101, 110, 116, 32, 99, 111, 112, 121, 40, 100, 115, 116, 58, 32, 72, 111, 115, 116, 80, 116, 114, 91, 117, 54, 52, 93, 41, 58, 10, 98, 111, 100, 121, 58, 10, 109, 111, 118, 32, 100, 115, 116, 44, 32, 37, 114, 97, 120, 10, 101, 120, 112, 111, 114, 116, 32, 100, 101, 102, 32, 99, 97, 108, 108, 101, 114, 40, 41, 32, 45, 62, 32, 118, 111, 105, 100, 32, 97, 98, 105, 32, 99, 58, 10, 98, 111, 100, 121, 58, 10, 99, 111, 109, 112, 111, 115, 101, 32, 87, 105, 116, 104, 70, 115, 32, 99, 111, 112, 121, 40, 37, 114, 100, 105, 41, 10]
    parsed: Easm::Module = Easm::parse_layout_module((&source[0]).cast[u8&], source.count.usize(), "composition_variant.easm")
    if parsed.functions.count != 2: return 1
    if parsed.functions[1].name != "caller__WithFs": return 1
    if parsed.functions[1].instructions.count != 1: return 1
    return 42
