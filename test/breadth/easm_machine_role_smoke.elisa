# Stage1 EASM verifier smoke: machine-role contracts reject raw scalar role parameters.
include "../../src/backend/codegen.elisa"

def main() -> i64:
    parameter: Easm::Param = Easm::Param{name: "selector", type_name: "u64"}
    fn: Easm::Function = Easm::Function{name: "bad_role", params: [parameter], return_type: "void", abi: "c", effects: [], requires: ["x86_64.segment.write"], changes: [], reads: [], clobbers: [], preserves: [], facts: [], inputs: [], outputs: [], stack_facts: [], control: [], labels: [], instructions: [], reference: [], targets: [], line: 2, platform: "x86_64"}
    module: Easm::Module = Easm::Module{path: "role.easm", name: "role", target: "x86_64", issues: [], functions: [fn], fragments: [], protocols: [], templates: [], layouts: []}
    issues: darray[Easm::Issue] = Easm::verify_module(module)
    0 return if issues.count == 1
    return 1
