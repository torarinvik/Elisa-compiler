# Stage1 EASM composition contract smoke.
include "../../src/backend/codegen.elisa"

def main() -> i64:
    p0: Easm::Param = Easm::Param{name: "dst", type_name: "HostPtr[u64]"}
    p1: Easm::Param = Easm::Param{name: "src", type_name: "HostPtr[u64]"}
    fragment: Easm::Function = Easm::Function{name: "copy", params: [p0, p1], return_type: "void", abi: "", effects: [], requires: [], changes: [], reads: [], clobbers: [], preserves: [], facts: [], inputs: [], outputs: [], stack_facts: [], control: [], labels: [], instructions: [], reference: [], targets: [], line: 2, platform: "any"}
    empty: Easm::Substitution = Easm::Substitution{from: "", replacement: ""}
    compose: Easm::Instruction = Easm::Instruction{op: "compose", text: "compose copy(dst)", line: 6, pseudo: true, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    fn: Easm::Function = Easm::Function{name: "caller", params: [], return_type: "void", abi: "c", effects: [], requires: [], changes: [], reads: [], clobbers: [], preserves: [], facts: [], inputs: [], outputs: [], stack_facts: [], control: [], labels: [], instructions: [compose], reference: [], targets: [], line: 5, platform: "any"}
    module: Easm::Module = Easm::Module{path: "composition.easm", name: "composition", target: "x86_64", issues: [], functions: [fn], fragments: [fragment], protocols: [], templates: [], layouts: []}
    issues: darray[Easm::Issue] = Easm::verify_module(module)
    42 return if issues.count > 0
    return 1
