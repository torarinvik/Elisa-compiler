# Stage1 template image patch smoke.
include "../../src/backend/codegen.elisa"

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    base: darray[u8] = [1, 0, 255]
    flipped: darray[u8] = [1, 52, 18]
    derived: mutable darray[Easm::PatchByte] = []
    1 return if not Easm::derive_template_patches(base, "addr", flipped, derived) or derived.count != 1 or derived[0].offset != 1 or derived[0].width != 2
    image: Easm::TemplateImage = Easm::TemplateImage{bytes: [1, 0, 255], patches: [Easm::PatchByte{hole: "addr", offset: 1, width: 2}]}
    values: darray[Easm::PatchValue] = [Easm::PatchValue{hole: "addr", value: 0x1234}]
    out: mutable darray[u8] = []
    arena: mutable Arena = zeroed
    in arena:
        ok: bool = Easm::instantiate_template(image, values, out)
        42 return if ok and out.count == 3 and out[0] == 1 and out[1] == 0x34 and out[2] == 0x12
    return 1
