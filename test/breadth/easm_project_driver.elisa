# Stage1 EASM project driver. The host discovery wrapper sends:
#   report\n
#   @file <byte-length> <path>\n
#   <exact source bytes>
# and repeats the framed file record. The compiler owns parsing, verification, target filtering,
# duplicate detection, reporting, and native assembly after the host has supplied the files.
include "../../src/backend/codegen.elisa"
using Bytes

extern read(fd: int, buf: void&, count: usize) -> isize can[Console]
extern write(fd: int, buf: void&, count: usize) -> isize can[Console]

def read_all() -> darray[u8] can[Console, Memory.Allocate, Abort.Panic]:
    source: mutable darray[u8] = []
    chunk: mutable darray[u8] = [0 for _ in 0..<4096]
    while true |source|:
        amount: isize = read(0, (&chunk[0]).cast[void&], 4096) can Console
        break if amount <= 0
        for index in 0..<amount.usize() |source|:
            source.push(chunk[index])
    return source

def byte_at(source: darray[u8], index: usize) -> u8:
    return source[index]

def line_end(source: darray[u8], start: usize) -> usize:
    cursor: mutable usize = start
    while cursor < source.count |cursor, source|:
        if source[cursor] == 10:
            return cursor
        cursor <- cursor + 1
    return source.count

def decimal(source: darray[u8], start: usize, end: usize) -> usize:
    value: mutable usize = 0
    for index in start..<end |value, source|:
        value <- value * 10.usize() + (source[index] - 48.u8()).usize()
    return value

def parse_project_input(source: darray[u8], target: sview) -> Easm::Project:
    sources: mutable darray[Easm::ProjectSource] = []
    first_end: usize = line_end(source, 0)
    cursor: mutable usize = first_end + 1.usize()
    while cursor < source.count |cursor, source, sources|:
        header_end: usize = line_end(source, cursor)
        continue if header_end <= cursor + 6.usize()
        continue if source[cursor] != 64.u8() or source[cursor + 1.usize()] != 102.u8()
        length_start: mutable usize = cursor + 6.usize()
        while length_start < header_end and source[length_start] == 32.u8():
            length_start <- length_start + 1.usize()
        length_end: mutable usize = length_start
        while length_end < header_end and source[length_end] != 32.u8():
            length_end <- length_end + 1.usize()
        path_start: mutable usize = length_end + 1.usize()
        while path_start < header_end and source[path_start] == 32.u8():
            path_start <- path_start + 1.usize()
        length: usize = decimal(source, length_start, length_end)
        body_start: usize = header_end + 1.usize()
        body_end: usize = body_start + length
        break if body_end > source.count
        path: sview = sview((&source[0]).cast[u8&], path_start.i64(), header_end.i64())
        body: mutable darray[u8] = []
        for index in body_start..<body_end |body, source|:
            body.push(source[index])
        sources.push(Easm::ProjectSource{path: path, bytes: body})
        cursor <- body_end
    return Easm::parse_project(sources, target)

def main() -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    source: darray[u8] = read_all()
    mode_end: usize = line_end(source, 0)
    mode: sview = sview((&source[0]).cast[u8&], 0, mode_end.i64())
    project: Easm::Project = parse_project_input(source, "x86_64")
    output: mutable darray[u8] = []
    if mode == "report":
        Easm::emit_project_report(project, output)
    else:
        2 return if not Easm::emit_project_native_assembly(project, output)
    3 return if output.count == 0
    _ = write(1, (&output[0]).cast[void&], output.count.usize()) can Console
    return 0
