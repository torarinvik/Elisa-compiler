# Isolation probe: parse a program and print the comprehension FILTER call's
# arguments.count WITHOUT running the semantic checker. If the count is garbage
# (or this SEGVs), the dangling `arguments` darray is a PARSER/region-inference
# bug; if it prints the correct count, the fault is in the semantic checker.
include "../../src/backend/codegen.elisa"
using Bytes

extern read(fd: int, buf: void&, count: usize) -> isize can[Console]
extern write(fd: int, buf: void&, count: usize) -> isize can[Console]


def read_all() -> darray[u8] can[Console, Memory.Allocate, Abort.Panic]:
    buf: mutable darray[u8] = []
    chunk: mutable darray[u8] = [0 for _ in 0..<8192]
    while true:
        n: isize = read(0, (&chunk[0]).cast[void&], 8192) can Console
        break if n <= 0
        i: mutable isize = 0
        while i < n:
            buf.push(chunk[i.usize()])
            i <- i + 1
    buf.push(0)
    return buf


def report_call(out: mutable darray[u8]&, e: Ast::Expr) -> void can[Memory.Allocate, Abort.Panic]:
    match e:
        Ast::Expr.Call(callee, arguments, argument_names, line):
            push_str(out, "FILTER-CALL arguments.count=")
            push_int(out, arguments.count.i64())
            out.push(10)
            n: mutable i64 = 0
            for argument in arguments:
                n <- n + 1
            push_str(out, "iterated=")
            push_int(out, n)
            out.push(10)
        _:
            push_str(out, "filter is not a call\n")


def walk_stmt(out: mutable darray[u8]&, s: Ast::Stmt) -> void can[Memory.Allocate, Abort.Panic]:
    match s:
        Ast::Stmt.Return(value, line):
            match value:
                Ast::Expr.Comprehension(loop_variable, iterable, condition, body, cline):
                    report_call(out, condition)
                _:
                    pass
        _:
            pass


def main() -> void can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    src: darray[u8] = read_all()
    return if src.count <= 1
    slen: usize = src.count - 1
    tokens: darray[Lexer::Token] = frontend_tokenize_with_length(&src[0], &src[0], slen)
    file: Ast::File = frontend_parser_parse_file(&src[0], tokens)
    # Stress: churn a lot of heap between parse and the walk, so if the filter's
    # `arguments` darray lives in a freed parser region, this reuses it and the
    # count read below comes back as garbage (mirrors the checker's allocations).
    churn: mutable darray[i64] = []
    for c in 0..<200000:
        churn.push(c)
    sink: mutable i64 = 0
    for c2 in churn:
        sink <- sink + c2
    out: mutable darray[u8] = []
    push_str(out, "sink=")
    push_int(out, sink % 7)
    out.push(10)
    for decl in file.top_decls:
        match decl:
            Ast::Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                for stmt in body:
                    walk_stmt(out, stmt)
            _:
                pass
    return if out.count == 0
    _ = write(1, (&out[0]).cast[void&], out.count.usize()) can Console
