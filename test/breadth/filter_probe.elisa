# Minimal repro of the stage0 packed-store miscompile. Parses a program, then
# RECURSIVELY walks it with a self-recursive walker that mirrors the checker's
# walk_expression shape: match Comprehension -> recurse into condition -> match
# Call -> iterate arguments. If this small program crashes at -O2 (like the full
# semantic checker) but the shallow read does not, the fault is a stage0 codegen
# bug in packed-store payload extraction under recursion — reproduced minimally.
include "../../src/backend/codegen.elisa"
using Bytes

extern read(fd: int, buf: void&, count: usize) -> isize can[Console]
extern write(fd: int, buf: void&, count: usize) -> isize can[Console]


def read_all() -> darray[u8] can[Console, Memory.Allocate, Abort.Panic]:
    buf: mutable darray[u8] = []
    chunk: mutable darray[u8] = [0 for _ in 0..<8192]
    while true:
        n: isize = read(0, (&chunk[0]).cast[void&], 8192) can Console
        break if n <= 0
        i: mutable isize = 0
        while i < n:
            buf.push(chunk[i.usize()])
            i <- i + 1
    buf.push(0)
    return buf


# Self-recursive walker mirroring semantic walk_expression_inner's shape: a match
# with several arms, recursing into children, iterating a darray side-table.
def walk_expr(e: Ast::Expr, acc: mutable i64&) -> void can[Memory.Allocate, Abort.Panic]:
    match e:
        Ast::Expr.Call(callee, arguments, argument_names, line):
            walk_expr(callee, acc)
            for argument in arguments:
                walk_expr(argument, acc)
                acc <- acc + 1
        Ast::Expr.Comprehension(loop_variable, iterable, condition, body, line):
            walk_expr(iterable, acc)
            walk_expr(condition, acc)
            walk_expr(body, acc)
        Ast::Expr.Binary(left, operator, right, line):
            walk_expr(left, acc)
            walk_expr(right, acc)
        Ast::Expr.Ident(name, line):
            acc <- acc + 0
        _:
            acc <- acc + 0


def walk_stmt(s: Ast::Stmt, acc: mutable i64&) -> void can[Memory.Allocate, Abort.Panic]:
    match s:
        Ast::Stmt.Return(value, line):
            walk_expr(return_value, acc) if value is return_value
        _:
            pass


def main() -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    src: darray[u8] = read_all()
    if src.count <= 1:
        return 0
    slen: usize = src.count - 1
    tokens: darray[Lexer::Token] = frontend_tokenize_with_length(&src[0], &src[0], slen)
    file: Ast::File = frontend_parser_parse_file(&src[0], tokens)
    acc: mutable i64 = 0
    for decl in file.top_decls:
        match decl:
            Ast::Decl.Func(name, parameters, return_type, body, effects, decorators, line):
                for stmt in body:
                    walk_stmt(stmt, acc)
            _:
                pass
    out: mutable darray[u8] = []
    push_str(out, "walked args=")
    push_int(out, acc)
    out.push(10)
    _ = write(1, (&out[0]).cast[void&], out.count.usize()) can Console
    return 0
