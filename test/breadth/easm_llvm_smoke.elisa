# Stage1 EASM -> LLVM inline-assembly driver smoke.
include "../../src/backend/codegen.elisa"
using Bytes

def main() -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    empty: Easm::Substitution = Easm::Substitution{from: "", replacement: ""}
    mov: Easm::Instruction = Easm::Instruction{op: "movq", text: "movq $42, %rax", line: 4, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    fn: Easm::Function = Easm::Function{name: "easm_answer", params: [], return_type: "i64", abi: "c", effects: [], requires: [], changes: [], reads: [], clobbers: [], preserves: [], facts: [], inputs: [], outputs: ["rax"], stack_facts: [], control: [], labels: [], instructions: [mov], reference: [], targets: [], line: 3, platform: "any"}
    module: Easm::Module = Easm::Module{path: "inline.easm", name: "inline", target: "x86_64", issues: [], functions: [fn], fragments: [], protocols: [], templates: [], layouts: []}
    ctx: LLVMContextRef = LLVMContextCreate()
    llvm_module: LLVMModuleRef = LLVMModuleCreateWithNameInContext("easm_inline", ctx)
    builder: LLVMBuilderRef = LLVMCreateBuilderInContext(ctx)
    count: i64 = Backend::emit_easm_module(module, "x86_64", llvm_module, ctx, builder)
    2 return if count != 1
    _ = LLVMPrintModuleToString(llvm_module)
    verify: i32 = LLVMVerifyModule(llvm_module, 2, null)
    3 return if verify != 0
    LLVMDisposeBuilder(builder)
    LLVMDisposeModule(llvm_module)
    LLVMContextDispose(ctx)
    return 0
