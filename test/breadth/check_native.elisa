# Native integration probe for the complete current semantic pass.
# Reads an already-expanded source unit from stdin. Includes are intentionally
# the driver's responsibility, as in the production semantic API.
include "../../src/semantic/semantic.elisa"
using Bytes
extern read(fd: int, buf: void&, count: usize) -> isize can[Console]
extern printf(format: cstr, ...) -> int can[Console]

def native_check_errors_only() -> bool:
    can Abort.Panic:
        if phase_timer_getenv("ELISA_CHECKER_ERRORS_ONLY") is value_bytes:
            first: u8 = value_bytes
            return first != 0 and first != 48
        return false

def read_all() -> darray[u8] @source can[Console, Memory.Allocate, Abort.Panic]:
    buf: mutable darray[u8] @source = []
    chunk: mutable darray[u8] = [0 for _ in 0..<8192]
    while true |buf|:
        n: isize = read(0, (&chunk[0]).cast[void&], 8192) can Console
        break if n <= 0
        for index in 0..<n.usize() |buf|:
            buf.push(chunk[index])
    buf.push(0)
    return buf


def main() -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    src: darray[u8] @source = read_all()
    return 1 if src.count <= 1
    source_length: usize = src.count - 1
    tokens: darray[Lexer::Token] = frontend_tokenize_with_length(&src[0], &src[0], source_length) can Global{Read,Write}
    file: Ast::File = frontend_parser_parse_file(&src[0], tokens) can Global{Read,Write}
    _ = printf("parse-errors=%llu\n", file.errors.count.u64()) can Console
    return 2 if file.errors.count != 0
    table: Semantic::SymbolTable = Semantic::check(&file) can Global{Read,Write}
    errors_only: bool = native_check_errors_only()
    errors: mutable usize = 0
    for diagnostic in table.diagnostics:
        severity: u8 = Semantic::diagnostic_severity(diagnostic)
        errors <- errors + 1 if severity == 1
        continue if errors_only and severity != 1
        message: mutable darray[u8] = Semantic::diagnostic_message(diagnostic)
        message.push(0)
        _ = printf("%u:%u: %s\n", diagnostic.kind.u32(), diagnostic.line, (&message[0]).cast[cstr] can Unsafe.PointerCast) can Console
    _ = printf("diagnostics=%llu\n", table.diagnostics.count.u64()) can Console
    if errors_only:
        _ = printf("errors=%llu\n", errors.u64()) can Console
        return 1 if errors > 0 else 0
    return 1 if table.diagnostics.count != 0 else 0
