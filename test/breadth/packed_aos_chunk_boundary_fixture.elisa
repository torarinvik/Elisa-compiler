include "../../src/parser/parser_tokens.elisa"
include "../../src/parser/parser_token_position.elisa"

packed enum TinyNode:
    Leaf(value: i64)

def main() -> i64 can[Memory.Allocate, Abort.Panic]:
    region owner(1048576):
        ast_store: Ast::Expr.Store[Local] = Ast::Expr.Store(owner)
        ast_sum: mutable i64 = 0
        in ast_store:
            for index in 0..<257:
                node: Ast::Expr = new Ast::Expr.IntLit(value: index.i64(), pos: zeroed)
                if index == 255 or index == 256:
                    ast_sum <- ast_sum + match node:
                        Ast::Expr.IntLit(value, _): value
                        _: 0

        fixed_store: TinyNode.Store[Local] = TinyNode.Store(owner)
        fixed_sum: mutable i64 = 0
        in fixed_store:
            for index in 0..<257:
                node: TinyNode = new TinyNode.Leaf(value: index.i64())
                if index == 255 or index == 256:
                    fixed_sum <- fixed_sum + match node:
                        TinyNode.Leaf(value): value

        return 0 if ast_sum == 511 and fixed_sum == 511 else 1
