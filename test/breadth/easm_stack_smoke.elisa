# Stage1 EASM frame invariant smoke.
include "../../src/backend/codegen.elisa"

def main() -> i64:
    empty: Easm::Substitution = Easm::Substitution{from: "", replacement: ""}
    push: Easm::Instruction = Easm::Instruction{op: "push", text: "push", line: 3, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    fn: Easm::Function = Easm::Function{name: "unbalanced", params: [], return_type: "void", abi: "c", effects: [], requires: [], changes: [], reads: [], clobbers: [], preserves: [], facts: [], inputs: [], outputs: [], stack_facts: [], control: [], labels: [], instructions: [push], reference: [], targets: [], line: 2, platform: "x86_64"}
    module: Easm::Module = Easm::Module{path: "stack.easm", name: "stack", target: "x86_64", issues: [], functions: [fn], fragments: [], protocols: [], templates: [], layouts: []}
    issues: darray[Easm::Issue] = Easm::verify_module(module)
    42 return if issues.count == 1
    return 1
