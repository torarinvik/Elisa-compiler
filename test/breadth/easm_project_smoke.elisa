# Stage1 EASM project aggregation smoke: configured project/dependency sources become one
# target-filtered module set before native assembly emission.
include "../../src/backend/codegen.elisa"

def main() -> i64:
    first: mutable darray[u8] = [109, 111, 100, 117, 108, 101, 32, 111, 110, 101, 10, 116, 97, 114, 103, 101, 116, 32, 120, 56, 54, 95, 54, 52, 10, 101, 120, 112, 111, 114, 116, 32, 100, 101, 102, 32, 111, 110, 101, 40, 41, 32, 45, 62, 32, 118, 111, 105, 100, 32, 97, 98, 105, 32, 99, 58, 10, 32, 32, 32, 32, 114, 101, 116, 10]
    second: mutable darray[u8] = [109, 111, 100, 117, 108, 101, 32, 116, 119, 111, 10, 116, 97, 114, 103, 101, 116, 32, 120, 56, 54, 95, 54, 52, 10, 101, 120, 112, 111, 114, 116, 32, 100, 101, 102, 32, 116, 119, 111, 40, 41, 32, 45, 62, 32, 118, 111, 105, 100, 32, 97, 98, 105, 32, 99, 58, 10, 32, 32, 32, 32, 114, 101, 116, 10]
    sources: darray[Easm::ProjectSource] = [Easm::ProjectSource{path: "one.easm", bytes: first}, Easm::ProjectSource{path: "two.easm", bytes: second}]
    project: Easm::Project = Easm::parse_project(sources, "x86_64")
    output: mutable darray[u8] = []
    ok: bool = Easm::emit_project_native_assembly(project, output)
    duplicate_sources: darray[Easm::ProjectSource] = [Easm::ProjectSource{path: "one-a.easm", bytes: first}, Easm::ProjectSource{path: "one-b.easm", bytes: first}]
    duplicate_project: Easm::Project = Easm::parse_project(duplicate_sources, "x86_64")
    0 return if ok and not Easm::project_has_errors(project) and project.modules.count == 2 and output.count > 0 and Easm::project_has_errors(duplicate_project)
    return 1
