include "../../src/parser/parser.elisa"
extern read(fd: int, buf: void&, count: usize) -> isize can[Console]
extern printf(fmt: cstr, ...) -> int can[Console]

def read_all() -> darray[u8] can[Console, Memory.Allocate, Abort.Panic]:
    buf: mutable darray[u8] = []
    chunk: mutable darray[u8] = [0 for _ in 0..<8192]
    while true |buf|:
        n: isize = read(0, (&chunk[0]).cast[void&], 8192) can Console
        break if n <= 0
        for index in 0..<n.usize() |buf|:
            buf.push(chunk[index])
    buf.push(0)
    return buf

def main() -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    src: darray[u8] = read_all()
    1 return if src.count <= 1
    tokens: darray[Lexer::Token] = frontend_tokenize_with_length(&src[0], &src[0], src.count - 1)
    file: Ast::File = frontend_parser_parse_file(&src[0], tokens)
    _ = printf("errors=%lld tokens=%lld decls=%lld\n", file.errors.count.i64(), tokens.count.i64(), file.top_decls.count.i64()) can Console
    return file.errors.count.i64() if file.errors.count.i64() < 250 else 250
