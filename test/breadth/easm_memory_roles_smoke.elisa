# Stage1 EASM typed memory-role and layout-field verifier smoke.
include "../../src/backend/codegen.elisa"

def main() -> i64:
    parameter: Easm::Param = Easm::Param{name: "base", type_name: "HostPtr[Header]"}
    field: Easm::LayoutField = Easm::LayoutField{offset: 8, name: "value", type_name: "u64", width: 8, requires_size_at_least: 0, line: 2}
    layout: Easm::Layout = Easm::Layout{name: "Header", fields: [field], size: 16, stride: 0, line: 1}
    empty: Easm::Substitution = Easm::Substitution{from: "", replacement: ""}
    access: Easm::Instruction = Easm::Instruction{op: "movq", text: "movq 8(%rax), %rcx", line: 8, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    fn: Easm::Function = Easm::Function{name: "read_value", params: [parameter], return_type: "void", abi: "c", effects: [], requires: [], changes: [], reads: [], clobbers: ["rcx", "memory"], preserves: [], facts: [], inputs: ["base = %rax"], outputs: [], stack_facts: [], control: [], labels: [], instructions: [access], reference: [], targets: [], line: 4, platform: "x86_64"}
    module: Easm::Module = Easm::Module{path: "memory_roles.easm", name: "memory_roles", target: "x86_64", issues: [], functions: [fn], fragments: [], protocols: [], templates: [], layouts: [layout]}
    issues: darray[Easm::Issue] = Easm::verify_module(module)
    42 return if issues.count == 0
    return 1
