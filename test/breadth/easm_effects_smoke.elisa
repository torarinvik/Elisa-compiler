# Stage1 EASM effect-contract smoke.
include "../../src/backend/codegen.elisa"

def main() -> i64:
    empty: Easm::Substitution = Easm::Substitution{from: "", replacement: ""}
    load: Easm::Instruction = Easm::Instruction{op: "mov", text: "mov (%rax), %rcx", line: 3, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    fn: Easm::Function = Easm::Function{name: "bad_memory", params: [], return_type: "void", abi: "c", effects: [], requires: [], changes: [], reads: [], clobbers: ["rcx"], preserves: [], facts: [], inputs: ["base = %rax"], outputs: [], stack_facts: [], control: [], labels: [], instructions: [load], reference: [], targets: [], line: 2, platform: "x86_64"}
    module: Easm::Module = Easm::Module{path: "effects.easm", name: "effects", target: "x86_64", issues: [], functions: [fn], fragments: [], protocols: [], templates: [], layouts: []}
    issues: darray[Easm::Issue] = Easm::verify_module(module)
    42 return if issues.count == 1
    return 1
