include "../../src/backend/codegen.elisa"

# Stage0 enforcement-fuzz / relation-property mirror: fully-declared bodies are accepted;
# dropping a required clobber or capability is rejected. Exercises the shipped verify_module.

def has_code(issues: darray[Easm::Issue], code: sview) -> bool:
    for issue in issues:
        true return if issue.code == code
    return false

def has_error(issues: darray[Easm::Issue]) -> bool:
    for issue in issues:
        true return if issue.severity == Easm::Severity.Error
    return false

def empty_sub() -> Easm::Substitution:
    return Easm::Substitution{from: "", replacement: ""}

def insn(op: sview, text: sview, line: u32) -> Easm::Instruction:
    e: Easm::Substitution = empty_sub()
    return Easm::Instruction{op: op, text: text, line: line, pseudo: false, substitution_count: 0, substitution0: e, substitution1: e, substitution2: e, substitution3: e}

def main() -> i64:
    e: Easm::Substitution = empty_sub()
    # Fully declared: movq + addq + ret with clobbers and cc.
    i0: Easm::Instruction = insn("movq", "movq $1, %rax", 3)
    i1: Easm::Instruction = insn("addq", "addq $2, %rax", 4)
    i2: Easm::Instruction = insn("ret", "ret", 5)
    full: Easm::Function = Easm::Function{name: "full", params: [], return_type: "void", abi: "c", effects: [], requires: [], changes: [], reads: [], clobbers: ["rax", "cc"], preserves: [], facts: [], inputs: [], outputs: [], stack_facts: ["unchanged"], control: ["returns"], labels: [], instructions: [i0, i1, i2], reference: [], targets: [], line: 2, platform: "x86_64"}
    full_mod: Easm::Module = Easm::Module{path: "full.easm", name: "full", target: "x86_64", issues: [], functions: [full], fragments: [], protocols: [], templates: [], layouts: []}
    full_issues: darray[Easm::Issue] = Easm::verify_module(full_mod)
    1 return if has_error(full_issues)

    # Drop cc clobber: addq sets flags.
    no_cc: Easm::Function = Easm::Function{name: "no_cc", params: [], return_type: "void", abi: "c", effects: [], requires: [], changes: [], reads: [], clobbers: ["rax"], preserves: [], facts: [], inputs: [], outputs: [], stack_facts: ["unchanged"], control: ["returns"], labels: [], instructions: [i0, i1, i2], reference: [], targets: [], line: 2, platform: "x86_64"}
    no_cc_mod: Easm::Module = Easm::Module{path: "no_cc.easm", name: "no_cc", target: "x86_64", issues: [], functions: [no_cc], fragments: [], protocols: [], templates: [], layouts: []}
    no_cc_issues: darray[Easm::Issue] = Easm::verify_module(no_cc_mod)
    2 return if not has_error(no_cc_issues)

    # Drop rax clobber: written without declaration.
    no_rax: Easm::Function = Easm::Function{name: "no_rax", params: [], return_type: "void", abi: "c", effects: [], requires: [], changes: [], reads: [], clobbers: ["cc"], preserves: [], facts: [], inputs: [], outputs: [], stack_facts: ["unchanged"], control: ["returns"], labels: [], instructions: [i0, i1, i2], reference: [], targets: [], line: 2, platform: "x86_64"}
    no_rax_mod: Easm::Module = Easm::Module{path: "no_rax.easm", name: "no_rax", target: "x86_64", issues: [], functions: [no_rax], fragments: [], protocols: [], templates: [], layouts: []}
    no_rax_issues: darray[Easm::Issue] = Easm::verify_module(no_rax_mod)
    3 return if not has_error(no_rax_issues)

    # Uninitialized read: addq %rcx without establishing rcx.
    bad_read: Easm::Instruction = insn("addq", "addq %rcx, %rax", 4)
    uninit: Easm::Function = Easm::Function{name: "uninit", params: [], return_type: "void", abi: "c", effects: [], requires: [], changes: [], reads: [], clobbers: ["rax", "cc"], preserves: [], facts: [], inputs: [], outputs: [], stack_facts: ["unchanged"], control: ["returns"], labels: [], instructions: [i0, bad_read, i2], reference: [], targets: [], line: 2, platform: "x86_64"}
    uninit_mod: Easm::Module = Easm::Module{path: "uninit.easm", name: "uninit", target: "x86_64", issues: [], functions: [uninit], fragments: [], protocols: [], templates: [], layouts: []}
    uninit_issues: darray[Easm::Issue] = Easm::verify_module(uninit_mod)
    4 return if not has_error(uninit_issues)

    # rdtsc requires capability.
    rdtsc: Easm::Instruction = insn("rdtsc", "rdtsc", 3)
    ret: Easm::Instruction = insn("ret", "ret", 4)
    no_cap: Easm::Function = Easm::Function{name: "no_cap", params: [], return_type: "void", abi: "c", effects: [], requires: [], changes: [], reads: [], clobbers: ["rax", "rdx"], preserves: [], facts: [], inputs: [], outputs: [], stack_facts: ["unchanged"], control: ["returns"], labels: [], instructions: [rdtsc, ret], reference: [], targets: [], line: 2, platform: "x86_64"}
    no_cap_mod: Easm::Module = Easm::Module{path: "no_cap.easm", name: "no_cap", target: "x86_64", issues: [], functions: [no_cap], fragments: [], protocols: [], templates: [], layouts: []}
    no_cap_issues: darray[Easm::Issue] = Easm::verify_module(no_cap_mod)
    5 return if not has_code(no_cap_issues, "missing-capability") and not has_error(no_cap_issues)

    return 0
