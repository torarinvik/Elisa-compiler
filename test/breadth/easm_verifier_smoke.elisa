# Stage1 EASM verifier smoke: malformed layout bounds and instruction mnemonic are rejected.
include "../../src/backend/codegen.elisa"

def main() -> i64:
    bad_field: Easm::LayoutField = Easm::LayoutField{offset: 12, name: "too_far", type_name: "u64", width: 8, requires_size_at_least: 0, line: 4}
    layout: Easm::Layout = Easm::Layout{name: "Header", fields: [bad_field], size: 16, stride: 0, line: 3}
    empty: Easm::Substitution = Easm::Substitution{from: "", replacement: ""}
    bad_instruction: Easm::Instruction = Easm::Instruction{op: "bogus", text: "bogus", line: 8, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    fn: Easm::Function = Easm::Function{name: "bad", params: [], return_type: "void", abi: "c", effects: [], requires: [], changes: [], reads: [], clobbers: [], preserves: [], facts: [], inputs: [], outputs: [], stack_facts: [], control: [], labels: [], instructions: [bad_instruction], reference: [], targets: [], line: 7, platform: "any"}
    module: Easm::Module = Easm::Module{path: "verifier.easm", name: "verifier", target: "x86_64", issues: [], functions: [fn], fragments: [], protocols: [], templates: [], layouts: [layout]}
    issues: darray[Easm::Issue] = Easm::verify_module(module)
    42 return if issues.count == 2
    return 1
