# Integration controls for EASM decimal parsing and invalid-number rejection.
include "../../src/backend/codegen.elisa"

def module_has_issue(source_text: sview, expected_code: sview) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    can Memory.Allocate, Abort.Panic:
        source: mutable darray[u8] = []
        source.extend(source_text)
        return false if source.count == 0
        parsed: Easm::Module = Easm::parse_layout_module((&source[0]).cast[u8&], source.count.usize(), "decimal.easm") can Unsafe.PointerCast
        for issue in parsed.issues:
            return true if issue.code == expected_code
        return false

def module_has_no_invalid_decimal_issue(source_text: sview) -> bool can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    can Memory.Allocate, Abort.Panic:
        source: mutable darray[u8] = []
        source.extend(source_text)
        return true if source.count == 0
        parsed: Easm::Module = Easm::parse_layout_module((&source[0]).cast[u8&], source.count.usize(), "decimal.easm") can Unsafe.PointerCast
        for issue in parsed.issues:
            return false if issue.code == "invalid-layout-size" or issue.code == "invalid-layout-stride" or issue.code == "invalid-layout-field-offset" or issue.code == "invalid-layout-required-size"
        return true

def main() -> i64 can[Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    maximum: (valid: bool, value: i64) = Easm::easm_parse_i64_checked("9223372036854775807")
    minimum: (valid: bool, value: i64) = Easm::easm_parse_i64_checked("-9223372036854775808")
    1 return if not maximum.valid or maximum.value != EasmCheckedDecimal::I64_MAX
    2 return if not minimum.valid or minimum.value != EasmCheckedDecimal::I64_MIN

    can Memory.Allocate, Abort.Panic, Unsafe.PointerCast:
        3 return if not module_has_issue("module bad_required_suffix\nlayout Header size 16:\n    0 value: u64 requires size >= 8junk\n", "invalid-layout-required-size")
        4 return if not module_has_issue("module bad_required_overflow\nlayout Header size 16:\n    0 value: u64 requires size >= 9223372036854775808\n", "invalid-layout-required-size")
        5 return if not module_has_issue("module bad_required_underflow\nlayout Header size 16:\n    0 value: u64 requires size >= -9223372036854775809\n", "invalid-layout-required-size")
        6 return if not module_has_issue("module bad_offset\nlayout Header size 16:\n    0junk value: u64\n", "invalid-layout-field-offset")
        7 return if not module_has_issue("module bad_size\nlayout Header size 8junk:\n", "invalid-layout-size")
        8 return if not module_has_issue("module overflowing_size\nlayout Header size 9223372036854775808:\n", "invalid-layout-size")
        9 return if not module_has_issue("module bad_stride\nlayout Header stride -9223372036854775809:\n", "invalid-layout-stride")
        10 return if not module_has_issue("module bad_stack_adjustment\nexport def adjust() -> void abi c:\n    clobbers:\n        cc\n    stack:\n        balanced\n    body:\n        sub $8junk, %rsp\n        add $8, %rsp\n        ret\n", "invalid-stack-adjustment")
        11 return if not module_has_issue("module bad_displacement\ntarget x86_64\nlayout Header size 16:\n    0 value: u64\nexport def read(p: HostPtr[Header]) -> void abi c:\n    inputs:\n        p = %rdi\n    clobbers:\n        rax, memory\n    stack:\n        unchanged\n    control:\n        returns\n    body:\n        movq 0junk(%rdi), %rax\n        ret\n", "invalid-memory-displacement")
        12 return if not module_has_no_invalid_decimal_issue("module good_boundaries\nlayout Header size 9223372036854775807:\n    0 value: u64 requires size >= 9223372036854775807\n")
        return 0
