@packed_profile(build_heavy)
packed enum Node:
    Leaf(v: i64)
    Tag(t: i64)

def build(owner: Arena) -> i64:
    store: Node.Store[Local] = Node.Store(owner)
    result: mutable i64 = 0
    in store:
        n: Node = new Node.Leaf(v: 42)
        result <- match n:
            Node.Leaf(v): v
            Node.Tag(t): t
    return result

def main() -> i64:
    region r(4096):
        return build(r)
