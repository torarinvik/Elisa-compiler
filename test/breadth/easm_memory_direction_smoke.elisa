# Stage1 EASM verifier smoke: RMW memory access requires both directions.
include "../../src/backend/codegen.elisa"

def main() -> i64:
    parameter: Easm::Param = Easm::Param{name: "p", type_name: "HostPtr[u64]"}
    empty: Easm::Substitution = Easm::Substitution{from: "", replacement: ""}
    update: Easm::Instruction = Easm::Instruction{op: "addq", text: "addq $1, (%rdi)", line: 5, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    fn: Easm::Function = Easm::Function{name: "bump", params: [parameter], return_type: "void", abi: "c", effects: [], requires: [], changes: [], reads: [], clobbers: ["cc, memory.write"], preserves: [], facts: [], inputs: ["p = %rdi"], outputs: [], stack_facts: [], control: [], labels: [], instructions: [update], reference: [], targets: [], line: 3, platform: "x86_64"}
    module: Easm::Module = Easm::Module{path: "direction.easm", name: "direction", target: "x86_64", issues: [], functions: [fn], fragments: [], protocols: [], templates: [], layouts: []}
    issues: darray[Easm::Issue] = Easm::verify_module(module)
    0 return if issues.count == 1
    return 1
