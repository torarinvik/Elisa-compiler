# Stage1 EASM linear register-liveness smoke.
include "../../src/backend/codegen.elisa"

def main() -> i64:
    empty: Easm::Substitution = Easm::Substitution{from: "", replacement: ""}
    read_before_input: Easm::Instruction = Easm::Instruction{op: "mov", text: "mov %rdi, %rax", line: 3, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    fn: Easm::Function = Easm::Function{name: "bad_read", params: [], return_type: "void", abi: "c", effects: [], requires: [], changes: [], reads: [], clobbers: ["rax"], preserves: [], facts: [], inputs: [], outputs: [], stack_facts: [], control: [], labels: [], instructions: [read_before_input], reference: [], targets: [], line: 2, platform: "x86_64"}
    module: Easm::Module = Easm::Module{path: "liveness.easm", name: "liveness", target: "x86_64", issues: [], functions: [fn], fragments: [], protocols: [], templates: [], layouts: []}
    issues: darray[Easm::Issue] = Easm::verify_module(module)
    42 return if issues.count == 1
    return 1
