# Minimal stage1 backend driver for the stage0-compatible execution trace hook.
include "../../src/backend/codegen.elisa"
using Bytes

extern read(fd: int, buf: void&, count: usize) -> isize can[Console]
# `puts` is already declared by the included backend (src/backend/llvm_c.elisa);
# re-declaring it here is a duplicate-declaration error.

def read_all() -> darray[u8] can[Console, Memory.Allocate, Abort.Panic]:
    result: mutable darray[u8] = []
    chunk: mutable darray[u8] = [0 for _ in 0..<8192]
    while true |result|:
        count: isize = read(0, (&chunk[0]).cast[void&], 8192) can Console
        break if count <= 0
        for index in 0..<count.usize() |result|:
            result.push(chunk[index])
    result.push(0)
    return result

def main() -> i64 can[Console, Memory.Allocate, Abort.Panic, Unsafe.PointerCast]:
    source: darray[u8] = read_all()
    1 return if source.count <= 1
    length: usize = source.count - 1
    tokens: darray[Lexer::Token] = frontend_tokenize_with_length(&source[0], &source[0], length)
    file: Ast::File = frontend_parser_parse_file(&source[0], tokens)
    1 return if file.errors.count != 0
    ctx: LLVMContextRef = LLVMContextCreate()
    module: LLVMModuleRef = LLVMModuleCreateWithNameInContext("elisa_trace", ctx)
    builder: LLVMBuilderRef = LLVMCreateBuilderInContext(ctx)
    machine: LLVMTargetMachineRef = Backend::configure_module_target(module)
    target_data: LLVMTargetDataRef = LLVMCreateTargetDataLayout(machine)
    emitted: i64 = Backend::emit_module_with_debug_trace(file, module, ctx, builder, target_data, false, true, "trace.elisa")
    if emitted <= 0:
        _ = puts("UNSUPPORTED") can Console
        return 2
    ir: cstr = LLVMPrintModuleToString(module)
    _ = puts(ir) can Console
    LLVMDisposeBuilder(builder)
    LLVMDisposeModule(module)
    LLVMContextDispose(ctx)
    return 0
