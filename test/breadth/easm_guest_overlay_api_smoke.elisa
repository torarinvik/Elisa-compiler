# Stage1 EASM guest-overlay resolver smoke.
include "../../src/backend/codegen.elisa"

def main() -> i64:
    head: Easm::LayoutField = Easm::LayoutField{offset: 0, name: "head", type_name: "u64", width: 8, requires_size_at_least: 0, line: 2}
    tail_field: Easm::LayoutField = Easm::LayoutField{offset: 12, name: "tail", type_name: "u64", width: 8, requires_size_at_least: 0, line: 3}
    layout: Easm::Layout = Easm::Layout{name: "Overlay", fields: [head, tail_field], size: 16, stride: 0, line: 1}
    issues: mutable darray[Easm::Issue] = []
    access: Easm::GuestOverlayAccess = Easm::resolve_guest_overlay_access(layout, "head", 8, issues)
    1 return if issues.count != 0 or access.offset != 0 or access.width != 8
    issues <- []
    _ = Easm::resolve_guest_overlay_access(layout, "tail", 8, issues)
    1 return if issues.count != 1
    issues <- []
    _ = Easm::resolve_guest_overlay_access(layout, "head", 4, issues)
    1 return if issues.count != 1
    issues <- []
    _ = Easm::resolve_guest_overlay_access(layout, "missing", 8, issues)
    0 return if issues.count == 1
    return 1
