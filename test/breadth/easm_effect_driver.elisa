# Stage1 EASM effect-table dumper used by the LLVM-MC parity check.
include "../../src/backend/codegen.elisa"
using Bytes

extern write(fd: int, buf: void&, count: usize) -> isize can[Console]

def append_text(out: mutable darray[u8]&, text: sview) -> void:
    for index in 0..<sview_len(text) |out, text|:
        out.push(sview_at(text, index))

def append_i64(out: mutable darray[u8]&, value: i64) -> void:
    if value < 0:
        out.push(45)
        append_i64(out, 0 - value)
        return
    if value >= 10:
        append_i64(out, value / 10)
    out.push((48 + value % 10).u8())

def append_effect(out: mutable darray[u8]&, op: sview) -> void:
    effect: Easm::OperationEffect = Easm::easm_operation_effect(op)
    append_text(out, op)
    append_text(out, "|")
    append_i64(out, 1 if effect.known else 0)
    append_text(out, "|")
    append_i64(out, 1 if effect.clobbers_flags else 0)
    append_text(out, "|")
    append_i64(out, 1 if effect.implicit_cc else 0)
    append_text(out, "|")
    append_i64(out, effect.implicit_reads)
    append_text(out, "|")
    append_i64(out, effect.implicit_writes)
    append_text(out, "|")
    append_i64(out, 1 if effect.result_defines else 0)
    append_text(out, "|")
    append_text(out, effect.capability)
    append_text(out, "\n")

def main() -> i64 can[Console, Memory.Allocate, Abort.Panic]:
    ops: darray[sview] = ["movq", "movl", "lea", "leaq", "pushq", "popq", "xchgq", "addq", "subq", "andq", "orq", "xorq", "notq", "negq", "shlq", "salq", "shrq", "sarq", "cmpq", "testq", "incq", "decq", "callq", "jmpq", "retq", "cpuid", "cld", "std", "lfence", "rdtsc", "pause", "fldcw", "fnstcw", "stmxcsr", "ldmxcsr", "emms", "vzeroall", "trap"]
    out: mutable darray[u8] = []
    for op in ops |out|:
        append_effect(out, op)
    _ = write(1, (&out[0]).cast[void&], out.count) can Console
    return 0
