# Stage1 EASM branch-merge verification smoke.
include "../../src/backend/codegen.elisa"

def main() -> i64:
    empty: Easm::Substitution = Easm::Substitution{from: "", replacement: ""}
    branch: Easm::Instruction = Easm::Instruction{op: "je", text: "je join", line: 3, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    write: Easm::Instruction = Easm::Instruction{op: "mov", text: "mov $1, %rax", line: 4, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    label: Easm::Instruction = Easm::Instruction{op: "label", text: "join:", line: 5, pseudo: true, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    read: Easm::Instruction = Easm::Instruction{op: "mov", text: "mov %rax, %rdi", line: 6, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    fn: Easm::Function = Easm::Function{name: "merge", params: [], return_type: "void", abi: "c", effects: [], requires: [], changes: [], reads: [], clobbers: ["rax", "rdi", "cc"], preserves: [], facts: [], inputs: [], outputs: [], stack_facts: [], control: [], labels: [], instructions: [branch, write, label, read], reference: [], targets: [], line: 2, platform: "x86_64"}
    module: Easm::Module = Easm::Module{path: "merge.easm", name: "merge", target: "x86_64", issues: [], functions: [fn], fragments: [], protocols: [], templates: [], layouts: []}
    issues: darray[Easm::Issue] = Easm::verify_module(module)
    if issues.count == 0: return 1
    return 42
