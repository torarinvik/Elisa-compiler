# Stage1 EASM verifier smoke: invalid clobber/preserve atoms are rejected.
include "../../src/backend/codegen.elisa"

def main() -> i64:
    fn: Easm::Function = Easm::Function{name: "bad_contract", params: [], return_type: "void", abi: "c", effects: [], requires: [], changes: [], reads: [], clobbers: ["r99"], preserves: ["not_a_register"], facts: [], inputs: [], outputs: [], stack_facts: [], control: [], labels: [], instructions: [], reference: [], targets: [], line: 2, platform: "x86_64"}
    module: Easm::Module = Easm::Module{path: "contract.easm", name: "contract", target: "x86_64", issues: [], functions: [fn], fragments: [], protocols: [], templates: [], layouts: []}
    issues: darray[Easm::Issue] = Easm::verify_module(module)
    0 return if issues.count == 2
    return 1
