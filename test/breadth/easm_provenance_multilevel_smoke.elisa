include "../../src/backend/codegen.elisa"

def has_issue(issues: darray[Easm::Issue], code: sview) -> bool:
    for issue in issues:
        true return if issue.code == code
    return false

def main() -> i64:
    empty: Easm::Substitution = Easm::Substitution{from: "", replacement: ""}
    # Multi-hop conflicting carriers meet at join.
    mov1: Easm::Instruction = Easm::Instruction{op: "movq", text: "movq %rsi, %r8", line: 3, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    mov2: Easm::Instruction = Easm::Instruction{op: "movq", text: "movq %r8, %rcx", line: 4, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    cmp: Easm::Instruction = Easm::Instruction{op: "cmpq", text: "cmpq $0, %rdi", line: 5, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    branch: Easm::Instruction = Easm::Instruction{op: "je", text: "je join", line: 6, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    mov3: Easm::Instruction = Easm::Instruction{op: "movq", text: "movq %rdx, %rcx", line: 7, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    label: Easm::Instruction = Easm::Instruction{op: "label", text: "join:", line: 8, pseudo: true, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    read: Easm::Instruction = Easm::Instruction{op: "movq", text: "movq (%rcx), %rax", line: 9, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    ret: Easm::Instruction = Easm::Instruction{op: "ret", text: "ret", line: 10, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    p: Easm::Param = Easm::Param{name: "p", type_name: "HostPtr[u64]"}
    q: Easm::Param = Easm::Param{name: "q", type_name: "GuestVAddr[LayoutB]"}
    flag: Easm::Param = Easm::Param{name: "flag", type_name: "u64"}
    fn: Easm::Function = Easm::Function{name: "merge_chain", params: [flag, p, q], return_type: "u64", abi: "c", effects: [], requires: ["compare.unsigned", "control.direct"], changes: [], reads: [], clobbers: ["rax, rcx, r8, cc, memory"], preserves: [], facts: [], inputs: ["flag = %rdi", "p = %rsi", "q = %rdx"], outputs: ["ret = %rax"], stack_facts: ["unchanged"], control: ["returns"], labels: [], instructions: [mov1, mov2, cmp, branch, mov3, label, read, ret], reference: [], targets: [], line: 2, platform: "x86_64"}
    module: Easm::Module = Easm::Module{path: "multilevel.easm", name: "multilevel", target: "x86_64", issues: [], functions: [fn], fragments: [], protocols: [], templates: [], layouts: []}
    issues: darray[Easm::Issue] = Easm::verify_module(module)
    1 return if not has_issue(issues, "provenance-merge-unsound")
    # Same-type multi-hop chain must not flag.
    ok1: Easm::Instruction = Easm::Instruction{op: "movq", text: "movq %rdi, %r8", line: 3, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    ok2: Easm::Instruction = Easm::Instruction{op: "leaq", text: "leaq 0(%r8), %rcx", line: 4, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    ok3: Easm::Instruction = Easm::Instruction{op: "movq", text: "movq (%rcx), %rax", line: 5, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    ok4: Easm::Instruction = Easm::Instruction{op: "ret", text: "ret", line: 6, pseudo: false, substitution_count: 0, substitution0: empty, substitution1: empty, substitution2: empty, substitution3: empty}
    hp: Easm::Param = Easm::Param{name: "p", type_name: "HostPtr[u64]"}
    okfn: Easm::Function = Easm::Function{name: "chain_ok", params: [hp], return_type: "u64", abi: "c", effects: [], requires: [], changes: [], reads: [], clobbers: ["rax, rcx, r8, memory"], preserves: [], facts: [], inputs: ["p = %rdi"], outputs: ["ret = %rax"], stack_facts: ["unchanged"], control: ["returns"], labels: [], instructions: [ok1, ok2, ok3, ok4], reference: [], targets: [], line: 2, platform: "x86_64"}
    okmod: Easm::Module = Easm::Module{path: "ok.easm", name: "ok", target: "x86_64", issues: [], functions: [okfn], fragments: [], protocols: [], templates: [], layouts: []}
    ok_issues: darray[Easm::Issue] = Easm::verify_module(okmod)
    2 return if has_issue(ok_issues, "provenance-merge-unsound")
    3 return if has_issue(ok_issues, "raw-memory-base")
    return 0
